
// Внешняя обработка "Выгрузка остатков складов УТ (панель BL)" для базы "Управление торговлей" (УТ 10.3).
// Выгружает в BUSINESS LINE SMART PANEL остатки складов (см. КодыСкладов): "Главный розничный склад",
// "Новь БЦ ВСС" (склад вторичной сортировки), "Вторичный сбыт склад", "Новь БЦ РЦ" (два элемента
// справочника - остатки суммируются): итоги по складам и строки по товарам с
// характеристиками в ценах "Розничная БЛ базовая" (код типа цен 000000006).
// На панели склады появляются на вкладке "Аналитика остатков" после включения галочек:
// Администрирование -> Настройки -> "Склады УТ (аналитика остатков)" (по умолчанию скрыты).
// Адрес панели и ключ подставляются при сборке (make_epf.py, config.json панели).

// Адресов панели два: внутренний 10.28.2.164:8086 (сервер, приоритет - обработка работает на bl-isoflex)
// и внешний 109.195.203.146:8090 (запасной). Выбирается первый отвечающий на /api/health.
//Леонтьев Е.Е. 17.11.2026 - панель переехала с 8080 на 8086 (на 8080 была старая, мёртвая)
Функция АдресПанелиПоУмолчанию() Экспорт

	Адреса = Новый Массив;
	Адреса.Добавить("10.28.2.164:8086");       // внутренний (сервер панели)
	Адреса.Добавить("109.195.203.146:8090");   // внешний (удалённые магазины, узлы РИБ)
	Сборочный = "BL-IT-100:8086";
	Если Адреса.Найти(Сборочный) = Неопределено Тогда
		Адреса.Добавить(Сборочный);
	КонецЕсли;
	Для Каждого Адрес Из Адреса Цикл
		Если ПанельОтвечает(Адрес) Тогда
			Возврат Адрес;
		КонецЕсли;
	КонецЦикла;
	Возврат Сборочный;

КонецФункции

// Проверка доступности панели по адресу (GET /api/health, короткий таймаут - чтобы не висеть при недоступной сети).
//Леонтьев Е.Е. 11.11.2026
Функция ПанельОтвечает(Адрес)

	Попытка
		П = РазобратьАдрес(Адрес);
		Если П.Защищенно Тогда
			Соединение = Новый HTTPСоединение(П.Хост, П.Порт, , , Новый ИнтернетПрокси(Ложь), 3, Новый ЗащищенноеСоединениеOpenSSL);
		Иначе
			Соединение = Новый HTTPСоединение(П.Хост, П.Порт, , , Новый ИнтернетПрокси(Ложь), 3);
		КонецЕсли;
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/api/health"));
		Возврат Ответ.КодСостояния = 200;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ВерсияОбработки() Экспорт
	Возврат "v3 (склады: УТ0000389 ""Главный розничный склад"", УТ0000891 ""Новь БЦ ВСС"", УТ0000358 ""Вторичный сбыт склад"", УТ0000903/УТ0000910 ""Новь БЦ РЦ"", УТ0000090 ""Оптовый склад хранения ЕВ""; цены 000000006 ""Розничная БЛ базовая"")";
КонецФункции

Функция КлючПанели()
	Возврат "91f251272f27a89c671d97e0c48294c1f37dd49c947d1d96";
КонецФункции

// Коды складов выгрузки (справочник "Склады"). "Новь БЦ РЦ" заведён в базе дважды (УТ0000903 и УТ0000910):
// остатки обоих элементов суммируются под одним наименованием.
Функция КодыСкладов()

	Коды = Новый Массив;
	Коды.Добавить("УТ0000389");   // Главный розничный склад
	Коды.Добавить("УТ0000891");   // Новь БЦ ВСС (склад вторичной сортировки)
	Коды.Добавить("УТ0000358");   // Вторичный сбыт склад
	Коды.Добавить("УТ0000903");   // Новь БЦ РЦ
	Коды.Добавить("УТ0000910");   // Новь БЦ РЦ (дубль элемента справочника)
	Коды.Добавить("УТ0000090");   // Оптовый склад хранения ЕВ
	Возврат Коды;

КонецФункции

// Наименования складов выгрузки без повторов (для формы и для списка stockItemsWh: склад регистрируется
// в настройках панели, даже если остаток по нему нулевой).
Функция СкладыВыгрузки() Экспорт

	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Коды", КодыСкладов());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Склады КАК С
	|ГДЕ
	|	С.Код В (&Коды)
	|	И НЕ С.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	С.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = СокрЛП(Выборка.Наименование);
		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Остатки складов по товарам с характеристиками и ценой "Розничная БЛ базовая" (код 000000006):
// сначала цена по характеристике, если её нет - цена без характеристики. Серии суммируются.
Функция ОстаткиСкладов()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Коды", КодыСкладов());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.Склад КАК Склад,
	|	О.Номенклатура КАК Номенклатура,
	|	О.ХарактеристикаНоменклатуры КАК Характеристика,
	|	СУММА(О.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад.Код В (&Коды)) КАК О
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Склад,
	|	О.Номенклатура,
	|	О.ХарактеристикаНоменклатуры
	|
	|ИМЕЮЩИЕ
	|	СУММА(О.КоличествоОстаток) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Склад.Наименование КАК Склад,
	|	О.Номенклатура.Наименование КАК Товар,
	|	О.Номенклатура.Артикул КАК Артикул,
	|	О.Номенклатура.Родитель.Наименование КАК Группа,
	|	О.Характеристика.Наименование КАК Характеристика,
	|	О.Количество КАК Количество,
	|	ЕСТЬNULL(Ц.Цена, ЕСТЬNULL(Ц0.Цена, 0)) КАК Цена
	|ИЗ
	|	Остатки КАК О
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ТипЦен.Код = ""000000006"") КАК Ц
	|		ПО Ц.Номенклатура = О.Номенклатура
	|			И Ц.ХарактеристикаНоменклатуры = О.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ТипЦен.Код = ""000000006"") КАК Ц0
	|		ПО Ц0.Номенклатура = О.Номенклатура
	|			И Ц0.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)";
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

// Один пакет для панели: итоги по складам (stock с признаком wh) и строки по товарам (stockItems).
// Склады - массив наименований из СкладыВыгрузки().
Функция СобратьПакет(Склады)

	День = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd");
	Итоги = Новый Соответствие;   // склад -> Структура(qty, sum)
	Строки = Новый Массив;
	Выборка = ОстаткиСкладов();
	Пока Выборка.Следующий() Цикл
		Склад = СокрЛП(Выборка.Склад);
		Количество = Выборка.Количество;
		Сумма = Окр(Количество * Выборка.Цена, 2);
		Итог = Итоги.Получить(Склад);
		Если Итог = Неопределено Тогда
			Итог = Новый Структура("qty,sum", 0, 0);
			Итоги.Вставить(Склад, Итог);
		КонецЕсли;
		Итог.qty = Итог.qty + Количество;
		Итог.sum = Итог.sum + Сумма;
		Строки.Добавить(Новый Структура("store,date,item,sku,char,grp,qty,sum,wh",
			Склад, День,
			СокрЛП(Выборка.Товар), СокрЛП(Выборка.Артикул), СокрЛП(Выборка.Характеристика), СокрЛП(Выборка.Группа),
			Количество, Сумма, Истина));
	КонецЦикла;

	ИтогиМассив = Новый Массив;
	Для Каждого Склад Из Склады Цикл
		Итог = Итоги.Получить(Склад);
		ИтогиМассив.Добавить(Новый Структура("date,store,qty,sum,plan,wh",
			День, Склад, ?(Итог = Неопределено, 0, Итог.qty), ?(Итог = Неопределено, 0, Окр(Итог.sum, 2)), 0, Истина));
	КонецЦикла;
	Возврат Новый Структура("stock,stockItems,stockItemsWh", ИтогиМассив, Строки, Склады);

КонецФункции

// Самопроверка без отправки (параметр запуска "selftest:<файл>"): собирает пакет и отчитывается о составе.
Функция Самопроверка() Экспорт

	Склады = СкладыВыгрузки();
	Если Склады.Количество() = 0 Тогда
		Возврат "ERROR: склады выгрузки не найдены в справочнике ""Склады"" (коды УТ0000389, УТ0000891, УТ0000358, УТ0000903, УТ0000910, УТ0000090).";
	КонецЕсли;
	Пакет = СобратьПакет(Склады);
	Json = ВJson(Пакет);
	Итог = "OK. " + ВерсияОбработки() + "." + Символы.ПС
		+ "Склады: " + СтрСоединить(Склады, "; ") + "; строк по товарам: " + Пакет.stockItems.Количество()
		+ "; размер пакета: " + СтрДлина(Json) + " симв.";
	Для Каждого ИтогСклада Из Пакет.stock Цикл
		Итог = Итог + Символы.ПС + "- " + ИтогСклада.store + ": " + Формат(ИтогСклада.qty, "ЧДЦ=3; ЧН=0") + " шт., "
			+ Формат(ИтогСклада.sum, "ЧДЦ=2; ЧН=0") + " руб. (" + ИтогСклада.date + ")";
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Кнопка "Выгрузить": собирает остатки складов и отправляет одним пакетом на панель. Возвращает текст-итог.
Функция ВыгрузитьОстаткиСкладов(Адрес) Экспорт

	Склады = СкладыВыгрузки();
	Если Склады.Количество() = 0 Тогда
		Возврат "Склады выгрузки не найдены в справочнике ""Склады"" (коды УТ0000389, УТ0000891, УТ0000358, УТ0000903, УТ0000910, УТ0000090).";
	КонецЕсли;
	П = РазобратьАдрес(Адрес);
	Состояние("Выгрузка остатков складов УТ: чтение остатков...");
	Пакет = СобратьПакет(Склады);
	Состояние("Выгрузка остатков складов УТ: отправка на панель...");
	Ответ = ОтправитьПакет(ВJson(Пакет), П.Хост, П.Порт, П.Защищенно);
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат "Панель вернула код " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	КонецЕсли;

	Итог = "Выгрузка остатков складов завершена. Обработка " + ВерсияОбработки() + "." + Символы.ПС
		+ "Строк по товарам: " + Пакет.stockItems.Количество() + ".";
	Для Каждого ИтогСклада Из Пакет.stock Цикл
		Итог = Итог + Символы.ПС + "- " + ИтогСклада.store + ": " + Формат(ИтогСклада.qty, "ЧДЦ=3; ЧН=0") + " шт., "
			+ Формат(ИтогСклада.sum, "ЧДЦ=2; ЧН=0") + " руб. (" + ИтогСклада.date + ")";
	КонецЦикла;
	Итог = Итог + Символы.ПС + "Склады видны на вкладке ""Аналитика остатков"" после включения галочек:"
		+ Символы.ПС + "Администрирование -> Настройки -> ""Склады УТ (аналитика остатков)"" (по умолчанию скрыты).";
	Возврат Итог;

КонецФункции

// Регистрация обработки в справочнике "Внешние обработки" (внешние отчеты и обработки): создаёт или
// обновляет элемент "Выгрузка остатков складов УТ (панель BL)" с двоичными данными этого файла.
Функция ЗарегистрироватьВБазе() Экспорт

	Имя = "Выгрузка остатков складов УТ (панель BL)";
	Файл = ЭтотОбъект.ИспользуемоеИмяФайла;
	Если НРег(Прав(СокрЛП(Файл), 4)) <> ".epf" Тогда
		Возврат "Ошибка: регистрация возможна только при запуске из файла .epf (сейчас: " + Файл + ").";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", Имя);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	В.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВнешниеОбработки КАК В
	|ГДЕ
	|	В.Наименование = &Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		Элемент = Справочники.ВнешниеОбработки.СоздатьЭлемент();
		Элемент.Наименование = Имя;
	КонецЕсли;

	Элемент.ХранилищеВнешнейОбработки = Новый ХранилищеЗначения(Новый ДвоичныеДанные(Файл), Новый СжатиеДанных(9));
	Попытка
		Элемент.ВидОбработки = Перечисления.ВидыДополнительныхВнешнихОбработок.Обработка;
	Исключение
	КонецПопытки;
	Попытка
		Элемент.Комментарий = ВерсияОбработки() + ". Обновлено " + Формат(ТекущаяДата(), "ДЛФ=DT") + " из файла " + Файл;
	Исключение
	КонецПопытки;
	Элемент.Записать();

	Возврат "Обработка зарегистрирована в справочнике ""Внешние обработки"": " + Имя + "."
		+ Символы.ПС + "Открытие: Сервис -> Дополнительные отчеты и обработки -> Дополнительные внешние обработки.";

КонецФункции

// Адрес: "хост:порт", "http://хост:порт" или "https://хост" (панель за Apache с HTTPS)
Функция РазобратьАдрес(Адрес)

	Защищенно = Ложь;
	Строка_ = СокрЛП(Адрес);
	Если НРег(Лев(Строка_, 8)) = "https://" Тогда
		Защищенно = Истина;
		Строка_ = Сред(Строка_, 9);
	ИначеЕсли НРег(Лев(Строка_, 7)) = "http://" Тогда
		Строка_ = Сред(Строка_, 8);
	КонецЕсли;
	Позиция = СтрНайти(Строка_, "/");
	Если Позиция > 0 Тогда
		Строка_ = Лев(Строка_, Позиция - 1);
	КонецЕсли;
	Части = СтрРазделить(Строка_, ":");
	Порт = ?(Части.Количество() > 1, Число(СокрЛП(Части[1])), ?(Защищенно, 443, 80));
	Возврат Новый Структура("Хост,Порт,Защищенно", СокрЛП(Части[0]), Порт, Защищенно);

КонецФункции

Функция ОтправитьПакет(Json, Хост, Порт, Защищенно = Ложь)

	Если Защищенно Тогда
		Соединение = Новый HTTPСоединение(Хост, Порт, , , Новый ИнтернетПрокси(Ложь), 600, Новый ЗащищенноеСоединениеOpenSSL);
	Иначе
		Соединение = Новый HTTPСоединение(Хост, Порт, , , Новый ИнтернетПрокси(Ложь), 600);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос("/api/ingest");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("X-Api-Key", КлючПанели());
	Запрос.УстановитьТелоИзСтроки(Json, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Соединение.ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ВJson(Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции
