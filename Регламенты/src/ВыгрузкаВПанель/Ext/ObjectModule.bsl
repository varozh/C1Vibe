Функция ХарактеристикиОстатковИнфо() Экспорт

	СвойствоСостав = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду("УТ0000020");
	Если СвойствоСостав.Пустая() Тогда
		СвойствоСостав = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("07.Состав", Истина);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаСреза", ТекущаяДата());
	Запрос.УстановитьПараметр("Магазины", МагазиныВыгрузкиСсылки());
	Запрос.УстановитьПараметр("СвойствоСостав", СвойствоСостав);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	О.Номенклатура КАК Номенклатура,
	|	О.ХарактеристикаНоменклатуры КАК Характеристика
	|ПОМЕСТИТЬ ВТПары
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаСреза, Склад.Магазин В (&Магазины)) КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0
	|	И О.ХарактеристикаНоменклатуры <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	П.Номенклатура КАК Номенклатура,
	|	П.Характеристика КАК Характеристика,
	|	Ш.Штрихкод КАК Штрихкод,
	|	ЗС.Значение КАК Состав
	|ИЗ
	|	ВТПары КАК П
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Ш
	|		ПО Ш.Владелец = П.Номенклатура
	|			И Ш.ХарактеристикаНоменклатуры = П.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗС
	|		ПО ЗС.Объект = П.Характеристика
	|			И ЗС.Свойство = &СвойствоСостав";

	Пары = Новый Соответствие;
	Порядок = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = Строка(Выборка.Номенклатура.УникальныйИдентификатор()) + "|" + Строка(Выборка.Характеристика.УникальныйИдентификатор());
		Запись = Пары.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = Новый Структура("item,sku,char,bc,comp", СокрЛП(Выборка.Номенклатура.Наименование), СокрЛП(Выборка.Номенклатура.Артикул),
				СокрЛП(Выборка.Характеристика.Наименование), "", ?(Выборка.Состав = Null, "", СокрЛП(Строка(Выборка.Состав))));
			Пары.Вставить(Ключ, Запись);
			Порядок.Добавить(Запись);
		КонецЕсли;
		Код = СокрЛП(Выборка.Штрихкод);
		Если Код <> "" И СтрНайти(";" + Запись.bc + ";", ";" + Код + ";") = 0 Тогда
			Запись.bc = Запись.bc + ?(Запись.bc = "", "", ";") + Код;
		КонецЕсли;
	КонецЦикла;
	Возврат Порядок;

