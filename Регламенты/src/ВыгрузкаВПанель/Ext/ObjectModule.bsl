Функция ПредставлениеОтправки(Запись) Экспорт

	Метка = СокрЛП(Запись.Получить("ts"));   // "2026-10-24 19:30:00"
	Время = Сред(Метка, 9, 2) + "." + Сред(Метка, 6, 2) + " " + Сред(Метка, 12, 5);
	Канал = ?(Запись.Получить("channel") = "email", "E-mail", "SMS");
	Возврат Канал + " " + Время + ": " + СокрЛП(Запись.Получить("text"));

КонецФункции

Функция ЗаписатьОтправкиВЖурнал(Записи) Экспорт

	Успешно = Новый Массив;
	Ошибки = Новый Массив;
	Длина = 200;
	Попытка
		Квалификаторы = Метаданные.РегистрыСведений.ЖурналЗвонковСгорающихБонусов.Ресурсы.Комментарий.Тип.КвалификаторыСтроки;
		Если Квалификаторы.Длина > 0 Тогда
			Длина = Квалификаторы.Длина;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Для Каждого Запись Из Записи Цикл
		Попытка
			Код = СокрЛП(Запись.Получить("personCode"));
			ФизЛицо = Справочники.ФизическиеЛица.НайтиПоКоду(Код);
			Если ФизЛицо.Пустая() Тогда
				Ошибки.Добавить(Новый Структура("id,error", Запись.Получить("id"), "физическое лицо с кодом " + Код + " не найдено"));
				Продолжить;
			КонецЕсли;

			Набор = РегистрыСведений.ЖурналЗвонковСгорающихБонусов.СоздатьНаборЗаписей();
			Набор.Отбор.ФизическиеЛица.Установить(ФизЛицо);
			Набор.Прочитать();
			Дозвонились = Ложь;
			Комментарий = "";
			Если Набор.Количество() > 0 Тогда
				Дозвонились = Набор[0].Дозвонились;
				Комментарий = СокрЛП(Набор[0].Комментарий);
			КонецЕсли;

			Новая = Лев(ПредставлениеОтправки(Запись), Длина);
			Если СтрНайти(Комментарий, Новая) = 0 Тогда   // повторная передача той же отправки ничего не меняет
				Комментарий = Комментарий + ?(Комментарий = "", "", " | ") + Новая;
				Если СтрДлина(Комментарий) > Длина Тогда
					Комментарий = Прав(Комментарий, Длина);   // старые записи вытесняются новыми
				КонецЕсли;
				Набор.Очистить();
				НоваяЗапись = Набор.Добавить();
				НоваяЗапись.ФизическиеЛица = ФизЛицо;
				НоваяЗапись.Дозвонились = Дозвонились;
				НоваяЗапись.Комментарий = Комментарий;
				Набор.Записать();
			КонецЕсли;
			Успешно.Добавить(Запись.Получить("id"));
		Исключение
			Ошибки.Добавить(Новый Структура("id,error", Запись.Получить("id"), Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 190)));
		КонецПопытки;
	КонецЦикла;

	Возврат Новый Структура("Успешно,Ошибки", Успешно, Ошибки);

КонецФункции

Функция ГруппаХлебныеКрошки(Группа1, Группа2, Группа3, Группа4)

	Уровни = Новый Массив;
	Если Группа4 <> "" Тогда
		Уровни.Добавить(Группа4);
	КонецЕсли;
	Если Группа3 <> "" Тогда
		Уровни.Добавить(Группа3);
	КонецЕсли;
	Если Группа2 <> "" Тогда
		Уровни.Добавить(Группа2);
	КонецЕсли;
	Если Группа1 <> "" Тогда
		Уровни.Добавить(Группа1);
	КонецЕсли;
	Возврат СтрСоединить(Уровни, "/");

