	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаСреза, Склад.Магазин В (&Магазины)) КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Х.Ссылка КАК Файл,
	|	Х.ИмяФайла КАК ИмяФайла,
	|	ЕСТЬNULL(Т.Номенклатура.Артикул, """") КАК Артикул,
	|	ЕСТЬNULL(Т.Номенклатура.Наименование, """") КАК Товар,
	|	ВЫБОР КОГДА Т.Номенклатура.ОсновноеИзображение = Х.Ссылка ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК Порядок
	|ИЗ
	|	ВТТовары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХранилищеДополнительнойИнформации КАК Х
	|		ПО Х.Объект = Т.Номенклатура
	|ГДЕ
	|	Х.ВидДанных = &Изображение
	|	И НЕ Х.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Х.Наименование";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Артикул = СокрЛП(Выборка.Артикул);
		Результат.Добавить(Новый Структура("Файл,key,sku,item,name", Выборка.Файл, ?(Артикул = "", "#" + СокрЛП(Выборка.Товар), Артикул),
			Артикул, СокрЛП(Выборка.Товар), СокрЛП(Выборка.ИмяФайла)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЖурналЗвонковПоМагазинам() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналЗвонков.ФизическиеЛица КАК ФизЛицо,
	|	ЖурналЗвонков.Дозвонились КАК Дозвонились,
	|	ЖурналЗвонков.Комментарий КАК Комментарий
	|ПОМЕСТИТЬ ВТЖурнал
	|ИЗ
	|	РегистрСведений.ЖурналЗвонковСгорающихБонусов КАК ЖурналЗвонков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ФизЛицо КАК ФизЛицо,
	|	ВТ.ФизЛицо.Код КАК ФизЛицоКод,
	|	ВТ.Дозвонились КАК Дозвонились,
	|	ВТ.Комментарий КАК Комментарий
	|ИЗ
	|	ВТЖурнал КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Карты.ВладелецКарты КАК ФизЛицо,
	|	ЕСТЬNULL(Карты.Магазин.Наименование, """") КАК Магазин
	|ИЗ
	|	Справочник.ИнформационныеКарты КАК Карты
	|ГДЕ
	|	НЕ Карты.ЭтоГруппа
	|	И Карты.ДатаБлокировки = ДАТАВРЕМЯ(1, 1, 1)
	|	И Карты.ВладелецКарты В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Ж.ФизЛицо
	|			ИЗ
	|				ВТЖурнал КАК Ж)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Карты.ДатаОткрытия";
	Пакет = Запрос.ВыполнитьПакет();

	// карты упорядочены по дате открытия по возрастанию - последняя перезаписывает, остаётся самая свежая
	Магазины = Новый Соответствие;
	Выборка = Пакет[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Магазины.Вставить(Выборка.ФизЛицо, СокрЛП(Выборка.Магазин));
	КонецЦикла;

	Результат = Новый Массив;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Магазин = Магазины.Получить(Выборка.ФизЛицо);
		Результат.Добавить(Новый Структура("personCode,store,called,comment",
			СокрЛП(Выборка.ФизЛицоКод), ?(Магазин = Неопределено, "", Магазин), Выборка.Дозвонились = Истина, СокрЛП(Выборка.Комментарий)));
	КонецЦикла;
	Возврат Результат;

