	Коды.Добавить("ЦБР00026798"); // 7.1. ВНУТРЕННИЕ ПОДАРОЧНЫЕ СЕРТИФИКАТЫ
	Коды.Добавить("ЦБР00001473"); // 8. ОБОРУДОВАНИЕ
	Коды.Добавить("УТ000008451"); // 9.1. ПАКЕТЫ
	Коды.Добавить("УТ000026899"); // 3. SoLi's
	Коды.Добавить("ЦБР00026800"); // 4. DUTY STYLE

	Список = Новый СписокЗначений;
	Для Каждого Код Из Коды Цикл
		Группа = Справочники.Номенклатура.НайтиПоКоду(Код);
		Если Не Группа.Пустая() Тогда
			Список.Добавить(Группа);
		КонецЕсли;
	КонецЦикла;
	Возврат Список;

