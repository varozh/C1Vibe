Функция ПланыПродажЗаПериод(Начало, Конец)

	Результат = Новый Массив;
	МесяцНачало = НачалоМесяца(Начало);
	Пока МесяцНачало <= Конец Цикл
		МесяцКонец = КонецМесяца(МесяцНачало);

		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МесяцНачало", МесяцНачало);
		Запрос.УстановитьПараметр("МесяцКонец", МесяцКонец);
		Запрос.УстановитьПараметр("Магазины", МагазиныВыгрузкиСсылки());
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Магазин.Наименование КАК Магазин,
		|	Т.План КАК План,
		|	Т.Конверсия КАК Конверсия,
		|	Т.КПЧ КАК КПЧ,
		|	Т.СреднийЧек КАК СреднийЧек,
		|	ЕСТЬNULL(Т.КоэффицентКонверсии, 1) КАК КоэффицентКонверсии,
		|	ЕСТЬNULL(Т.КолПродавцов, 1) КАК КолПродавцов,
		|	ЕСТЬNULL(Т.ПланПоСопутствующимТоварам, 0) КАК ПланСопутки
		|ИЗ
		|	Документ.ПланПродаж.ТЧМагазины КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.ПериодС <= &МесяцКонец
		|	И Т.Ссылка.ПериодПо >= &МесяцНачало
		|	И Т.Магазин В (&Магазины)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.Ссылка.Дата";

		Последние = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Последние.Вставить(Строка(Выборка.Магазин), Новый Структура("month,store,plan,conversion,kpch,avgCheck,coef,sellers,planAcc",
				Формат(МесяцНачало, "ДФ=yyyy-MM"), Строка(Выборка.Магазин), Выборка.План, Выборка.Конверсия, Выборка.КПЧ, Выборка.СреднийЧек, Выборка.КоэффицентКонверсии,
				Выборка.КолПродавцов, Выборка.ПланСопутки));
		КонецЦикла;
		Для Каждого Пара Из Последние Цикл
			Результат.Добавить(Пара.Значение);
		КонецЦикла;

		МесяцНачало = КонецМесяца(МесяцНачало) + 1;
	КонецЦикла;
	Возврат Результат;

