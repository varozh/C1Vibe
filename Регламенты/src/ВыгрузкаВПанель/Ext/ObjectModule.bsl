Функция ОписаниеТерриторийВыгрузки()

	Территории = ТерриторииВыгрузки();
	Если Территории.Количество() = 0 Тогда
		Возврат "Территории с кодами 000000001, 000000003, 000000012, 000000009 в справочнике УмКо_Территории не найдены - выгружать нечего.";
	КонецЕсли;
	Имена = "";
	Для Каждого Элемент Из Территории Цикл
		Имена = Имена + ?(Имена = "", "", ", ") + СокрЛП(Элемент.Значение.Наименование) + " (" + СокрЛП(Элемент.Значение.Код) + ")";
	КонецЦикла;
