
// Внешняя обработка "Выгрузка в BUSINESS LINE SMART PANEL" - ручная выгрузка за период (для теста и презентации).
// Функции выборки данных скопированы из расширения BL_SmartPanel при сборке (см. make_epf.py), поэтому
// обработка работает сама по себе, без установленного расширения.
// Адрес панели и ключ подставляются при сборке из config.json.

// Адресов панели два: внутренний 10.28.2.164:8086 (сервер, приоритет) и внешний 109.195.203.146:8090
// (для удалённых баз магазинов). Выбирается первый отвечающий на /api/health; если не отвечают оба -
// возвращается сборочный, ошибку покажет сама выгрузка.
//Леонтьев Е.Е. 11.11.2026
Функция АдресПанелиПоУмолчанию() Экспорт

	Адреса = Новый Массив;
	Адреса.Добавить("10.28.2.164:8086");       // внутренний (сервер панели)
	Адреса.Добавить("109.195.203.146:8090");   // внешний (удалённые магазины, узлы РИБ)
	Сборочный = "http://10.28.2.164:8086";
	Если Адреса.Найти(Сборочный) = Неопределено Тогда
		Адреса.Добавить(Сборочный);
	КонецЕсли;
	Для Каждого Адрес Из Адреса Цикл
		Если ПанельОтвечает(Адрес) Тогда
			Возврат Адрес;
		КонецЕсли;
	КонецЦикла;
	Возврат Сборочный;

КонецФункции

// Проверка доступности панели по адресу (GET /api/health, короткий таймаут - чтобы не висеть при недоступной сети).
//Леонтьев Е.Е. 11.11.2026
Функция ПанельОтвечает(Адрес)

	Попытка
		П = РазобратьАдрес(Адрес);
		Если П.Защищенно Тогда
			Соединение = Новый HTTPСоединение(П.Хост, П.Порт, , , , 3, Новый ЗащищенноеСоединениеOpenSSL);
		Иначе
			Соединение = Новый HTTPСоединение(П.Хост, П.Порт, , , , 3);
		КонецЕсли;
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/api/health"));
		Возврат Ответ.КодСостояния = 200;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ВерсияОбработки() Экспорт
	Возврат "v18 (realtime-режим rt и регламентный auto за вчера: всплывающее окно чека на панели; непроведённые и удалённые возвраты убираются с панели; магазины только 4 территорий; чеки/товары, возвраты от покупателей с товарами и дисконтной картой, трафик, план, персонал, остатки по магазинам и по товарам, штрихкоды и состав характеристик, фото номенклатуры, маркетинговые акции, журнал звонков; клиенты карт new2025/new2016 без повторов; бонусы не выгружаются - панель берёт их из ws1/ws2)";   //Леонтьев Е.Е. 11.11.2026
КонецФункции

Функция КлючПанели()
	Возврат "91f251272f27a89c671d97e0c48294c1f37dd49c947d1d96";
КонецФункции

// Наименования магазинов для выбора на форме. Магазины с пометкой удаления (в том числе помеченные
// через родительскую группу) и группы справочника в список не попадают.
Функция СписокМагазинов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Ссылка,
	|	Н.Родитель КАК Родитель,
	|	Н.ЭтоГруппа КАК ЭтоГруппа,
	|	Н.ПометкаУдаления КАК ПометкаУдаления,
	|	Н.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Магазины КАК Н
	|
	|УПОРЯДОЧИТЬ ПО
	|	Н.Наименование";

	Узлы = Новый Соответствие;
	Порядок = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Узлы.Вставить(Выборка.Ссылка, Новый Структура("Родитель,ЭтоГруппа,Удален,Имя", Выборка.Родитель, Выборка.ЭтоГруппа, Выборка.ПометкаУдаления, СокрЛП(Выборка.Наименование)));
		Порядок.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Разрешенные = МагазиныВыгрузкиСсылки();
	Результат = Новый Массив;
	Для Каждого Ссылка Из Порядок Цикл
		Узел = Узлы.Получить(Ссылка);
		Если Узел.ЭтоГруппа Или Разрешенные.НайтиПоЗначению(Ссылка) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Удален = Ложь;
		Текущий = Ссылка;
		Пока ЗначениеЗаполнено(Текущий) Цикл
			Т = Узлы.Получить(Текущий);
			Если Т = Неопределено Тогда
				Прервать;
			КонецЕсли;
			Если Т.Удален Тогда
				Удален = Истина;
				Прервать;
			КонецЕсли;
			Текущий = Т.Родитель;
		КонецЦикла;

		Если Не Удален И Результат.Найти(Узел.Имя) = Неопределено Тогда
			Результат.Добавить(Узел.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Оставляет в массиве структур только элементы выбранных магазинов (поле store).
Функция ОтфильтроватьПоМагазинам(Элементы, Магазины)

	Если Магазины = Неопределено Тогда
		Возврат Элементы;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Если Магазины.Найти(Элемент.store) <> Неопределено Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отправляет остатки по товарам и характеристикам (товародвижение): панель заменяет срез только магазинов из
// stockItemsStores. Возвращает число отправленных строк; тексты ошибок дописываются в Ошибки.
Функция ОтправитьОстаткиТоваров(Хост, Порт, Защищенно, Магазины, Ошибки)

	Состояние("Выгрузка: остатки по товарам");
	Отправлено = 0;
	ПоМагазинам = Новый Соответствие;
	Для Каждого Стр Из ОтфильтроватьПоМагазинам(ОстаткиТоваровПоМагазинам(), Магазины) Цикл
		Список = ПоМагазинам.Получить(Стр.store);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоМагазинам.Вставить(Стр.store, Список);
		КонецЕсли;
		Список.Добавить(Стр);
	КонецЦикла;
	Для Каждого КЗ Из ПоМагазинам Цикл
		ОдинМагазин = Новый Массив;
		ОдинМагазин.Добавить(КЗ.Ключ);
		Ответ = ОтправитьПакет(ВJson(Новый Структура("stockItems,stockItemsStores", КЗ.Значение, ОдинМагазин)), Хост, Порт, Защищенно);
		Если Ответ.КодСостояния = 200 Тогда
			Отправлено = Отправлено + КЗ.Значение.Количество();
		Иначе
			Ошибки = Ошибки + Символы.ПС + "Остатки по товарам: панель вернула код " + Ответ.КодСостояния + " (" + КЗ.Ключ + ")";
		КонецЕсли;
	КонецЦикла;

	// штрихкоды и состав характеристик - порциями по 2000; ошибка не прерывает выгрузку остатков
	Попытка
		Состояние("Выгрузка: штрихкоды и состав характеристик");
		Инфо = ХарактеристикиОстатковИнфо();
		Порция = Новый Массив;
		Для Каждого Запись Из Инфо Цикл
			Порция.Добавить(Запись);
			Если Порция.Количество() >= 2000 Тогда
				ОтправитьПакет(ВJson(Новый Структура("charInfo", Порция)), Хост, Порт, Защищенно);
				Порция = Новый Массив;
			КонецЕсли;
		КонецЦикла;
		Если Порция.Количество() > 0 Тогда
			ОтправитьПакет(ВJson(Новый Структура("charInfo", Порция)), Хост, Порт, Защищенно);
		КонецЕсли;
	Исключение
		Ошибки = Ошибки + Символы.ПС + "Штрихкоды и состав: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Отправлено;

КонецФункции

// Выгружает только остатки (кнопка "Только остатки"): итоги по магазинам с планом и остатки по товарам.
// Чеки, трафик, клиенты и прочее не отправляются. Магазины - массив наименований; Неопределено - все.
Функция ВыгрузитьОстатки(Адрес, Магазины = Неопределено) Экспорт

	Если МагазиныВыгрузкиСсылки().Количество() = 0 Тогда
		Возврат ОписаниеТерриторийВыгрузки();
	КонецЕсли;

	П = РазобратьАдрес(Адрес);
	Ошибки = "";
	Итоги = ОтфильтроватьПоМагазинам(ОстаткиИПланПродаж(), Магазины);
	Ответ = ОтправитьПакет(ВJson(Новый Структура("stock", Итоги)), П.Хост, П.Порт, П.Защищенно);
	Если Ответ.КодСостояния <> 200 Тогда
		Ошибки = Ошибки + Символы.ПС + "Остатки по магазинам: панель вернула код " + Ответ.КодСостояния;
	КонецЕсли;
	Строк = 0;
	Попытка
		Строк = ОтправитьОстаткиТоваров(П.Хост, П.Порт, П.Защищенно, Магазины, Ошибки);
	Исключение
		Ошибки = Ошибки + Символы.ПС + "Остатки по товарам: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Итог = "Выгрузка остатков завершена. Обработка " + ВерсияОбработки() + "." + Символы.ПС
		+ "Отправлено: остатков по магазинам " + Итоги.Количество() + "; строк остатков по товарам " + Строк + ".";
	Если Ошибки <> "" Тогда
		Итог = Итог + Символы.ПС + "ОШИБКИ:" + Ошибки;
	Иначе
		Итог = Итог + Символы.ПС + "Откройте панель и обновите страницу.";
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Выгружает чеки, посетителей и трафик по часам за период порциями по 3 дня.
// Магазины - массив наименований; Неопределено - все магазины. Возвращает текст-итог.
Функция ВыгрузитьЗаПериод(НачалоПериода, КонецПериода, Адрес, Магазины = Неопределено, ВыгружатьЧеки = Истина, ВыгружатьЖурнал = Истина, ВыгружатьОстатки = Истина) Экспорт

	Если МагазиныВыгрузкиСсылки().Количество() = 0 Тогда
		Возврат ОписаниеТерриторийВыгрузки();
	КонецЕсли;

	П = РазобратьАдрес(Адрес);
	Хост = П.Хост;
	Порт = П.Порт;
	Защищенно = П.Защищенно;

	ЧековВсего = 0;
	ВозвратовВсего = 0;
	ТрафикЗаписей = 0;
	ПосетителейДней = 0;
	ПлановСтрок = 0;
	Ошибки = "";
	Планы = ОтфильтроватьПоМагазинам(ПланыПродажЗаПериод(НачалоДня(НачалоПериода), КонецПериода), Магазины);
	ПлановСтрок = Планы.Количество();
	Территории = ТерриторииМагазинов();   // всегда полный перечень магазинов выбранных территорий
	Остатки = ?(ВыгружатьОстатки, ОтфильтроватьПоМагазинам(ОстаткиИПланПродаж(), Магазины), Новый Массив);   // срез остатков - на текущий момент, отправляется один раз
	ОстатковСтрок = Остатки.Количество();
	// без флажка журнал звонков не отправляется вовсе (на панели остаётся прежний - ключ callLog в пакет не попадает)
	ЖурналЗвонков = ?(ВыгружатьЖурнал, ОтфильтроватьПоМагазинам(ЖурналЗвонковПоМагазинам(), Магазины), Новый Массив);
	ЗвонковСтрок = ЖурналЗвонков.Количество();
	// сотрудники (дата трудоустройства - из регистра "ФИО физических лиц") - один раз, в первой порции; ошибка не прерывает выгрузку
	Сотрудники = Новый Массив;
	Попытка
		Сотрудники = СотрудникиДляПанели();
	Исключение
		Ошибки = Ошибки + Символы.ПС + "Сотрудники (отчёт Новички): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	СменВсего = 0;

	ПерваяПорция = Истина;
	Начало = НачалоДня(НачалоПериода);
	Пока Начало <= КонецПериода Цикл
		Конец = КонецДня(Мин(Начало + 2 * 86400, КонецПериода));
		Состояние("Выгрузка: " + Формат(Начало, "ДФ=dd.MM.yyyy"));
		Попытка
			Чеки = ?(ВыгружатьЧеки, ОтфильтроватьПоМагазинам(ЧекиЗаПериод(Начало, Конец), Магазины), Новый Массив);
			Возвраты = ?(ВыгружатьЧеки, ОтфильтроватьПоМагазинам(ВозвратыЗаПериод(Начало, Конец), Магазины), Новый Массив);
			Посетители = ОтфильтроватьПоМагазинам(ПосетителиЗаПериод(Начало, Конец), Магазины);
			Трафик = ОтфильтроватьПоМагазинам(ТрафикПоЧасам(Начало, Конец), Магазины);
			Смены = ОтфильтроватьПоМагазинам(СменыЗаПериод(Начало, Конец), Магазины);
			Данные = Новый Структура("checks,returns,visitors,traffic,plans,territories,staff,shifts,stock", Чеки, Возвраты, Посетители, Трафик, Планы, Территории, ДолжностиПродавцов(Начало, Конец), Смены, Остатки);
			// возвраты порции заменяют возвраты панели за те же дни и магазины: непроведённые, помеченные на удаление
			// и удалённые в 1С документы, загруженные раньше, панель удаляет
			Если ВыгружатьЧеки Тогда
				Данные.Вставить("returnsReplace", Новый Структура("from,to,stores", ДатаJson(Начало), ДатаJson(Конец), Магазины));
			КонецЕсли;
			// срез журнала звонков панель заменяет целиком, поэтому они уходят ТОЛЬКО в первой порции -
			// в следующих порциях этого ключа нет, иначе пустой массив стёр бы только что загруженное
			Если ПерваяПорция Тогда
				Данные.Вставить("employees", Сотрудники);
				Данные.Вставить("storeCodes", КодыМагазинов(Магазины));   // коды магазинов в 1С: по ним панель сама запрашивает бонусы у ws2
				Если ВыгружатьЖурнал Тогда
					Данные.Вставить("callLog", ЖурналЗвонков);
				КонецЕсли;
				Если Магазины <> Неопределено Тогда
					Данные.Вставить("snapshotStores", Магазины);   // срезы заменяют данные только этих магазинов
				КонецЕсли;
			КонецЕсли;
			ПерваяПорция = Ложь;
			СменВсего = СменВсего + Смены.Количество();
			Планы = Новый Массив; // планы, территории, остатки и журнал звонков уходят один раз, в первой порции
			Территории = Новый Массив;
			Остатки = Новый Массив;
			ЖурналЗвонков = Новый Массив;
			Ответ = ОтправитьПакет(ВJson(Данные), Хост, Порт, Защищенно);
			Если Ответ.КодСостояния = 200 Тогда
				ЧековВсего = ЧековВсего + Чеки.Количество();
				ВозвратовВсего = ВозвратовВсего + Возвраты.Количество();
				ТрафикЗаписей = ТрафикЗаписей + Трафик.Количество();
				ПосетителейДней = ПосетителейДней + Посетители.Количество();
			Иначе
				Ошибки = Ошибки + Символы.ПС + "Панель вернула код " + Ответ.КодСостояния + " (" + Формат(Начало, "ДФ=dd.MM.yyyy") + ")";
			КонецЕсли;
		Исключение
			Ошибки = Ошибки + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Начало = НачалоДня(Конец + 1);
	КонецЦикла;

	// остатки по товарам и характеристикам (товародвижение) - отдельными пакетами на каждый магазин
	ТоварныхОстатков = 0;
	Попытка
		Если ВыгружатьОстатки Тогда
			ТоварныхОстатков = ОтправитьОстаткиТоваров(Хост, Порт, Защищенно, Магазины, Ошибки);
		КонецЕсли;
	Исключение
		Ошибки = Ошибки + Символы.ПС + "Остатки по товарам: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Итог ="Выгрузка завершена. Обработка " + ВерсияОбработки() + "." + ?(ВыгружатьЧеки, "", " Чеки и товары НЕ выгружались (снят флажок).") + Символы.ПС
		+ "Отправлено: чеков " + ЧековВсего + "; возвратов " + ВозвратовВсего + "; записей трафика по часам " + ТрафикЗаписей + " (магазино-дней " + ПосетителейДней + "); строк плана продаж " + ПлановСтрок + "; смен " + СменВсего + "; остатков по магазинам " + ОстатковСтрок + "; строк остатков по товарам " + ТоварныхОстатков + "; записей журнала звонков " + ЗвонковСтрок + "; сотрудников " + Сотрудники.Количество() + ".";
	Итог = Итог + Символы.ПС + ОписаниеТерриторийВыгрузки();
	Итог = Итог + Символы.ПС + ДиагностикаТрафикаИПлана(НачалоДня(НачалоПериода), КонецПериода);
	Если Ошибки <> "" Тогда
		Итог = Итог + Символы.ПС + "ОШИБКИ:" + Ошибки;
	Иначе
		Итог = Итог + Символы.ПС + "Откройте панель и обновите страницу.";
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Режим realtime-догрузки (планировщик Windows каждые несколько минут, параметр запуска "rt:<лог>"): чеки, возвраты,
// посетители и трафик за сегодня одним пакетом с признаком rt - панель показывает каждый новый чек во всплывающем окне
// BI панели. Ключи replace/returnsReplace НЕ отправляются: пакет только добавляет/обновляет (идемпотентно, ключ - GUID),
// поэтому частый запуск безопасен и ничего не удаляет с панели.
//Леонтьев Е.Е. 11.11.2026
Функция ВыгрузитьТекущиеЧеки(Адрес) Экспорт

	Если МагазиныВыгрузкиСсылки().Количество() = 0 Тогда
		Возврат ОписаниеТерриторийВыгрузки();
	КонецЕсли;

	П = РазобратьАдрес(Адрес);
	Начало = НачалоДня(ТекущаяДата());
	Конец = КонецДня(ТекущаяДата());
	Данные = Новый Структура("rt,checks,returns,visitors,traffic", Истина,
		ЧекиЗаПериод(Начало, Конец), ВозвратыЗаПериод(Начало, Конец),
		ПосетителиЗаПериод(Начало, Конец), ТрафикПоЧасам(Начало, Конец));
	Ответ = ОтправитьПакет(ВJson(Данные), П.Хост, П.Порт, П.Защищенно);
	Если Ответ.КодСостояния = 200 Тогда
		Возврат "OK: чеков " + Данные.checks.Количество() + ", возвратов " + Данные.returns.Количество()
			+ ", посетителей " + Данные.visitors.Количество() + ", трафика " + Данные.traffic.Количество() + " (за сегодня, rt).";
	КонецЕсли;
	Возврат "ERROR: панель вернула код " + Ответ.КодСостояния;

КонецФункции

// Кнопка "Отправки -> журнал": SMS и письма, отправленные клиентам из панели, записываются в регистр сведений
// "Журнал звонков сгорающих бонусов" (комментарий клиента) и подтверждаются панели.
Функция ЗаписатьОтправкиПанелиВЖурнал(Адрес) Экспорт

	П = РазобратьАдрес(Адрес);
	Запрос = Новый HTTPЗапрос("/api/ingest/sms-pending");
	Запрос.Заголовки.Вставить("X-Api-Key", КлючПанели());
	Соединение = НовоеСоединение(П);
	Ответ = Соединение.Получить(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Панель не отдала список отправок (код " + Ответ.КодСостояния + "). Обновите server.py панели.";
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Записи = Данные.Получить("items");
	Если Записи = Неопределено Или Записи.Количество() = 0 Тогда
		Возврат "Новых отправок для записи в журнал нет.";
	КонецЕсли;

	Результат = ЗаписатьОтправкиВЖурнал(Записи);

	ЗапросАск = Новый HTTPЗапрос("/api/ingest/sms-ack");
	ЗапросАск.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗапросАск.Заголовки.Вставить("X-Api-Key", КлючПанели());
	ЗапросАск.УстановитьТелоИзСтроки(ВJson(Новый Структура("ids,failed", Результат.Успешно, Результат.Ошибки)), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Соединение.ОтправитьДляОбработки(ЗапросАск);

	Текст = "Записано в журнал сгорающих бонусов: " + Результат.Успешно.Количество() + " из " + Записи.Количество() + ".";
	Для Каждого Ошибка Из Результат.Ошибки Цикл
		Текст = Текст + Символы.ПС + Ошибка.error;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Коды выгружаемых магазинов: Соответствие "наименование" -> "код" (для вызова веб-сервиса ws2 панелью).
Функция КодыМагазинов(Магазины)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", МагазиныВыгрузкиСсылки());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	М.Код КАК Код,
	|	М.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Магазины КАК М
	|ГДЕ
	|	М.Ссылка В (&Ссылки)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = СокрЛП(Выборка.Наименование);
		Если Магазины = Неопределено Или Магазины.Найти(Имя) <> Неопределено Тогда
			Результат.Вставить(Имя, СокрЛП(Выборка.Код));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Адрес: "хост:порт", "http://хост:порт" или "https://хост" (панель за Apache с HTTPS)
Функция РазобратьАдрес(Адрес)

	Защищенно = Ложь;
	Строка_ = СокрЛП(Адрес);
	Если НРег(Лев(Строка_, 8)) = "https://" Тогда
		Защищенно = Истина;
		Строка_ = Сред(Строка_, 9);
	ИначеЕсли НРег(Лев(Строка_, 7)) = "http://" Тогда
		Строка_ = Сред(Строка_, 8);
	КонецЕсли;
	Позиция = СтрНайти(Строка_, "/");
	Если Позиция > 0 Тогда
		Строка_ = Лев(Строка_, Позиция - 1);
	КонецЕсли;
	Части = СтрРазделить(Строка_, ":");
	Порт = ?(Части.Количество() > 1, Число(СокрЛП(Части[1])), ?(Защищенно, 443, 80));
	Возврат Новый Структура("Хост,Порт,Защищенно", СокрЛП(Части[0]), Порт, Защищенно);

КонецФункции

Функция НовоеСоединение(П)

	Если П.Защищенно Тогда
		Возврат Новый HTTPСоединение(П.Хост, П.Порт, , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
	КонецЕсли;
	Возврат Новый HTTPСоединение(П.Хост, П.Порт, , , , 60);

КонецФункции

// Двоичные данные изображения из значения хранилища: изображения номенклатуры в этой базе хранятся как Картинка
// (форма «Форма данных об изображении»), присоединённые файлы - как ДвоичныеДанные. Неопределено - данных нет.
Функция ДвоичныеДанныеИзображения(Значение)

	Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Картинка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение.Вид = ВидКартинки.Пустая Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Значение.ПолучитьДвоичныеДанные();
	Исключение
		// старые версии платформы - через временный файл
	КонецПопытки;
	Файл = ПолучитьИмяВременногоФайла("img");
	Значение.Записать(Файл);
	Данные = Новый ДвоичныеДанные(Файл);
	УдалитьФайлы(Файл);
	Возврат Данные;

КонецФункции

// Артикулы, у которых на панели уже есть фото: Соответствие ключ -> число фото.
Функция АртикулыСФотоНаПанели(П)

	Запрос = Новый HTTPЗапрос("/api/ingest/photo-keys");
	Запрос.Заголовки.Вставить("X-Api-Key", КлючПанели());
	Ответ = НовоеСоединение(П).Получить(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Панель не ответила на сверку фото (код " + Ответ.КодСостояния + "). Обновите server.py панели.";
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Результат = Данные.Получить("keys");
	Возврат ?(Результат = Неопределено, Новый Соответствие, Результат);

КонецФункции

// Выгружает фото номенклатуры (флажок "Выгружать фото из 1С"): по каждому артикулу с остатком - до 4 фото, каждое не более
// 1 МБ. Артикулы, у которых на панели уже есть фото, пропускаются (повторно не отправляются, фото, добавленные
// вручную на панели, не затираются). Магазины - массив наименований; Неопределено - все. Возвращает текст-итог.
Функция ВыгрузитьФото(Адрес, Магазины = Неопределено) Экспорт

	МаксРазмер = 1048576;
	МаксФото = 4;
	П = РазобратьАдрес(Адрес);
	Состояние("Фото: сверка с панелью...");
	Известные = АртикулыСФотоНаПанели(П);

	Отправлено = 0;
	Артикулов = 0;
	Крупных = 0;
	Пустых = 0;
	Пропущено = 0;
	Ошибки = "";
	Счетчик = Новый Соответствие;     // ключ -> сколько фото этого артикула уже взято в эту выгрузку
	Для Каждого Запись Из ФотоНоменклатурыСписок() Цикл
		Если Известные.Получить(Запись.key) <> Неопределено Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Взято = Счетчик.Получить(Запись.key);
		Если Взято = Неопределено Тогда
			Взято = 0;
		КонецЕсли;
		Если Взято >= МаксФото Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Данные = ДвоичныеДанныеИзображения(Запись.Файл.Хранилище.Получить());
			Если Данные = Неопределено Тогда
				Пустых = Пустых + 1;
				Продолжить;
			КонецЕсли;
			Если Данные.Размер() > МаксРазмер Тогда
				Крупных = Крупных + 1;
				Продолжить;
			КонецЕсли;
			Если Взято = 0 Тогда
				Артикулов = Артикулов + 1;
				Состояние("Фото: " + Запись.key);
			КонецЕсли;
			Текст = СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символы.ПС, ""), Символы.ВК, "");
			Массив = Новый Массив;
			Массив.Добавить(Новый Структура("sku,item,name,data", Запись.sku, Запись.item, Запись.name, Текст));
			Ответ = ОтправитьПакет(ВJson(Новый Структура("photos", Массив)), П.Хост, П.Порт, П.Защищенно);
			Если Ответ.КодСостояния = 200 Тогда
				Счетчик.Вставить(Запись.key, Взято + 1);
				Отправлено = Отправлено + 1;
			Иначе
				Ошибки = Ошибки + Символы.ПС + Запись.key + ": панель вернула код " + Ответ.КодСостояния;
			КонецЕсли;
		Исключение
			Ошибки = Ошибки + Символы.ПС + Запись.key + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;

	Итог = "Фото номенклатуры: отправлено " + Отправлено + " (артикулов " + Артикулов + "); пропущено файлов (у артикула уже есть фото на панели): " + Пропущено
		+ "; файлов больше 1 МБ не отправлено: " + Крупных + ?(Пустых > 0, "; без данных: " + Пустых, "") + ".";
	Если Ошибки <> "" Тогда
		Итог = Итог + Символы.ПС + "ОШИБКИ фото:" + Ошибки;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Отпечаток записи клиента (MD5 от всех полей): по нему панель и обработка понимают, выгружалась ли карта
// раньше и изменилось ли что-нибудь с прошлой выгрузки.
Функция ОтпечатокКлиента(Клиент)

	Текст = Клиент.cardCode + "|" + Клиент.cardNumber + "|" + Клиент.cardType + "|" + Клиент.name + "|" + Клиент.personCode + "|"
		+ Клиент.phone + "|" + Клиент.email + "|" + Клиент.birthday + "|" + Клиент.gender + "|" + Клиент.store + "|"
		+ Клиент.opened + "|" + Клиент.blocked;
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Текст);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));

КонецФункции

// Отпечатки уже выгруженных на панель клиентов: Соответствие код карты -> отпечаток.
Функция ВыгруженныеКлиенты(П)

	Запрос = Новый HTTPЗапрос("/api/ingest/clients-known");
	Запрос.Заголовки.Вставить("X-Api-Key", КлючПанели());
	Ответ = НовоеСоединение(П).Получить(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Панель не ответила на сверку клиентов (код " + Ответ.КодСостояния + "). Обновите server.py панели.";
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Результат = Данные.Получить("sigs");
	Возврат ?(Результат = Неопределено, Новый Соответствие, Результат);

КонецФункции

// Кнопка "Клиенты": информация о держателях карт new2025 / new2016 (ФИО, телефон, e-mail, дата рождения, пол,
// магазин). Сначала у панели запрашивается, какие карты уже выгружены, - отправляются только новые и изменившиеся.
Функция ВыгрузитьКлиентов(Адрес, Магазины = Неопределено) Экспорт

	Если МагазиныВыгрузкиСсылки().Количество() = 0 Тогда
		Возврат ОписаниеТерриторийВыгрузки();
	КонецЕсли;

	П = РазобратьАдрес(Адрес);
	Состояние("Клиенты: сверка с панелью...");
	Выгруженные = ВыгруженныеКлиенты(П);

	Состояние("Клиенты: выборка карт new2025 / new2016...");
	Клиенты = ОтфильтроватьПоМагазинам(КлиентыДляПанели(), Магазины);

	Новых = 0;
	Изменено = 0;
	БезИзменений = 0;
	КОтправке = Новый Массив;
	Для Каждого Клиент Из Клиенты Цикл
		Отпечаток = ОтпечатокКлиента(Клиент);
		Был = Выгруженные.Получить(Клиент.cardCode);
		Если Был = Отпечаток Тогда
			БезИзменений = БезИзменений + 1;
			Продолжить;
		КонецЕсли;
		Если Был = Неопределено Тогда
			Новых = Новых + 1;
		Иначе
			Изменено = Изменено + 1;
		КонецЕсли;
		Клиент.Вставить("sig", Отпечаток);
		КОтправке.Добавить(Клиент);
	КонецЦикла;

	Отправлено = 0;
	Ошибки = "";
	Порция = Новый Массив;
	Для Индекс = 0 По КОтправке.ВГраница() Цикл
		Порция.Добавить(КОтправке[Индекс]);
		Если Порция.Количество() < 2000 И Индекс < КОтправке.ВГраница() Тогда
			Продолжить;
		КонецЕсли;
		Состояние("Клиенты: отправка " + (Отправлено + Порция.Количество()) + " из " + КОтправке.Количество());
		Попытка
			Ответ = ОтправитьПакет(ВJson(Новый Структура("clients", Порция)), П.Хост, П.Порт, П.Защищенно);
			Если Ответ.КодСостояния = 200 Тогда
				Отправлено = Отправлено + Порция.Количество();
			Иначе
				Ошибки = Ошибки + Символы.ПС + "Панель вернула код " + Ответ.КодСостояния;
			КонецЕсли;
		Исключение
			Ошибки = Ошибки + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Порция = Новый Массив;
	КонецЦикла;

	Итог = "Выгрузка клиентов завершена. Обработка " + ВерсияОбработки() + "." + Символы.ПС
		+ "Карт new2025 / new2016 в выбранных магазинах: " + Клиенты.Количество() + Символы.ПС
		+ "Уже были на панели без изменений (пропущено): " + БезИзменений + Символы.ПС
		+ "Новых: " + Новых + "; изменившихся: " + Изменено + "; отправлено: " + Отправлено + ".";
	Если Ошибки <> "" Тогда
		Итог = Итог + Символы.ПС + "ОШИБКИ:" + Ошибки;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Диагностика: почему могло не быть трафика или плана (количества записей в источниках).
Функция ДиагностикаТрафикаИПлана(Начало, Конец)

	Текст = "";
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Начало", Начало);
		Запрос.УстановитьПараметр("Конец", Конец);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего,
		|	МИНИМУМ(С.Период) КАК Мин,
		|	МАКСИМУМ(С.Период) КАК Макс
		|ИЗ
		|	РегистрСведений.УмКо_СтатистикаПосещаемости КАК С
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК ЗаПериод
		|ИЗ
		|	РегистрСведений.УмКо_СтатистикаПосещаемости КАК С
		|ГДЕ
		|	С.Период МЕЖДУ &Начало И &Конец
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Привязано
		|ИЗ
		|	РегистрСведений.УмКо_СтатистикаПосещаемости КАК С
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УмКо_МагазиныУстройства.СрезПоследних(&Конец, ) КАК МУ
		|		ПО С.Устройство = МУ.Устройство
		|ГДЕ
		|	С.Период МЕЖДУ &Начало И &Конец
		|	И МУ.Магазин <> ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК СтрокПлана
		|ИЗ
		|	Документ.ПланПродаж.ТЧМагазины КАК Т
		|ГДЕ
		|	Т.Ссылка.Проведен
		|	И Т.Ссылка.ПериодС <= &Конец
		|	И Т.Ссылка.ПериодПо >= &Начало";
		Пакет = Запрос.ВыполнитьПакет();

		В1 = Пакет[0].Выбрать();
		В1.Следующий();
		В2 = Пакет[1].Выбрать();
		В2.Следующий();
		В3 = Пакет[2].Выбрать();
		В3.Следующий();
		В4 = Пакет[3].Выбрать();
		В4.Следующий();

		Текст = "Диагностика:" + Символы.ПС
			+ "- регистр УмКо_СтатистикаПосещаемости: записей всего " + В1.Всего
			+ ?(В1.Всего > 0, " (по дням с " + Формат(В1.Мин, "ДФ=dd.MM.yyyy") + " по " + Формат(В1.Макс, "ДФ=dd.MM.yyyy") + ")", "")
			+ "; за период " + В2.ЗаПериод + "; из них привязано к магазинам (УмКо_МагазиныУстройства) " + В3.Привязано + Символы.ПС
			+ "- проведённый план продаж (строк магазинов, пересекающихся с периодом): " + В4.СтрокПлана;
	Исключение
		Текст = "Диагностика недоступна: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Текст;

КонецФункции

Функция ОтправитьПакет(Json, Хост, Порт, Защищенно = Ложь)

	Если Защищенно Тогда
		Соединение = Новый HTTPСоединение(Хост, Порт, , , , 600, Новый ЗащищенноеСоединениеOpenSSL);
	Иначе
		Соединение = Новый HTTPСоединение(Хост, Порт, , , , 600);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос("/api/ingest");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("X-Api-Key", КлючПанели());
	Запрос.УстановитьТелоИзСтроки(Json, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Соединение.ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ЧекиЗаПериод(Начало, Конец)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Пробитый", Перечисления.СтатусыЧековККМ.Пробитый);
	Запрос.УстановитьПараметр("Архивный", Перечисления.СтатусыЧековККМ.Архивный);
	Запрос.УстановитьПараметр("Возврат", Перечисления.ВидыОперацийЧекККМ.Возврат);
	Запрос.УстановитьПараметр("ГруппыИсключения", ГруппыИсключенияКПЧ());
	Запрос.УстановитьПараметр("ГруппыРасчета", ГруппыРасчетаПерсонала());
	Запрос.УстановитьПараметр("ГруппыСопутки", ГруппыСопутки());
	// KPI по эталону «Отчет по показателям сотрудников АТТ (новые правила) v_1.02»
	Запрос.УстановитьПараметр("ГруппыKPI", ГруппыKPI());
	Запрос.УстановитьПараметр("Плащ", ПлащИсключениеKPI());
	Запрос.УстановитьПараметр("ПодарочныеКарты", ПодарочныеКартыKPI());

	Запрос.УстановитьПараметр("Магазины", МагазиныВыгрузкиСсылки());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Продавец.Наименование КАК Продавец,
	|	ЕСТЬNULL(Т.Количество * ВЫБОР КОГДА Т.Коэффициент = 0 ТОГДА 1 ИНАЧЕ Т.Коэффициент КОНЕЦ, 0) КАК Количество,
	|	ВЫБОР
	|		КОГДА Т.Номенклатура.Родитель В ИЕРАРХИИ (&ГруппыKPI)
	|			И НЕ Т.Номенклатура = &Плащ
	|			ТОГДА ЕСТЬNULL(Т.Количество * ВЫБОР КОГДА Т.Коэффициент = 0 ТОГДА 1 ИНАЧЕ Т.Коэффициент КОНЕЦ, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоКПЧ,
	|	ВЫБОР КОГДА Т.Номенклатура В (&ПодарочныеКарты) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоПодарочнаяКарта,
	|	Т.Сумма КАК Сумма,
	|	ЕСТЬNULL(Т.Номенклатура.Наименование, """") КАК Товар,
	|	ЕСТЬNULL(Т.Номенклатура.Артикул, """") КАК Артикул,
	|	ЕСТЬNULL(Т.ХарактеристикаНоменклатуры.Наименование, """") КАК Характеристика,
	|	ВЫБОР КОГДА Т.Номенклатура.Родитель В ИЕРАРХИИ (&ГруппыРасчета) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Расчет,
	|	ВЫБОР КОГДА Т.Номенклатура.Родитель В ИЕРАРХИИ (&ГруппыСопутки) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Сопутка,
	|	ВЫБОР КОГДА Т.Номенклатура.Родитель В ИЕРАРХИИ (&ГруппыИсключения) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Галантерея,
	|	ЕСТЬNULL(Т.Номенклатура.Родитель.Наименование, """") КАК Группа1,
	|	ЕСТЬNULL(Т.Номенклатура.Родитель.Родитель.Наименование, """") КАК Группа2,
	|	ЕСТЬNULL(Т.Номенклатура.Родитель.Родитель.Родитель.Наименование, """") КАК Группа3,
	|	ЕСТЬNULL(Т.Номенклатура.Родитель.Родитель.Родитель.Родитель.Наименование, """") КАК Группа4
	|ПОМЕСТИТЬ Позиции
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Проведен
	|	И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|	И Т.Ссылка.СтатусЧекаККМ В (&Пробитый, &Архивный)
	|	И Т.Ссылка.Магазин В (&Магазины)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ч.Ссылка КАК Ссылка,
	|	Ч.НомерЧекаККМ КАК Номер,
	|	Ч.Дата КАК Дата,
	|	Ч.Магазин.Наименование КАК Магазин,
	|	Ч.Продавец.Наименование КАК Продавец,
	|	ВЫБОР КОГДА Ч.ВидОперации = &Возврат ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоВозврат,
	|	Ч.СуммаДокумента КАК Сумма,
	|	Ч.ЧекККМПродажа КАК ЧекПродажи,
	|	ЕСТЬNULL(Ч.ЧекККМПродажа.СуммаДокумента, 0) КАК СуммаЧекаПродажи,
	|	Ч.ИспользованныеБонусы КАК Бонусы,
	|	Ч.ДопБонус КАК БонусыДоп,
	|	Ч.БонусДР КАК БонусыДР,
	|	ВЫБОР КОГДА Ч.ДисконтнаяКарта = ЗНАЧЕНИЕ(Справочник.ИнформационныеКарты.ПустаяСсылка) ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК ЕстьКарта,
	|	Ч.ВыданаДК КАК КартаВыдана,
	|	ЕСТЬNULL(Ч.ДисконтнаяКарта.Код, """") КАК КодКарты,
	|	ЕСТЬNULL(Ч.Магазин.УмКо_ЧасоваяЗона, 0) КАК ЧасоваяЗона
	|ИЗ
	|	Документ.ЧекККМ КАК Ч
	|ГДЕ
	|	Ч.Проведен
	|	И Ч.Дата МЕЖДУ &Начало И &Конец
	|	И Ч.СтатусЧекаККМ В (&Пробитый, &Архивный)
	|	И Ч.Магазин В (&Магазины)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(П.Продавец, """") КАК Продавец,
	|	П.Количество КАК Количество,
	|	П.КоличествоКПЧ КАК КоличествоКПЧ,
	|	П.ЭтоПодарочнаяКарта КАК ЭтоПодарочнаяКарта,
	|	П.Сумма КАК Сумма,
	|	П.Товар КАК Товар,
	|	П.Артикул КАК Артикул,
	|	П.Характеристика КАК Характеристика,
	|	П.Расчет КАК Расчет,
	|	П.Сопутка КАК Сопутка,
	|	П.Галантерея КАК Галантерея,
	|	П.Группа1 КАК Группа1,
	|	П.Группа2 КАК Группа2,
	|	П.Группа3 КАК Группа3,
	|	П.Группа4 КАК Группа4
	|ИЗ
	|	Позиции КАК П
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	С.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(С.СкидкаНаценка.Наименование, """") КАК Акция,
	|	ЕСТЬNULL(С.СкидкаНаценка.Код, """") КАК КодАкции,
	|	СУММА(С.Сумма) КАК Сумма
	|ИЗ
	|	Документ.ЧекККМ.Скидки КАК С
	|ГДЕ
	|	С.Ссылка.Проведен
	|	И С.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|	И С.Ссылка.СтатусЧекаККМ В (&Пробитый, &Архивный)
	|	И С.Ссылка.Магазин В (&Магазины)
	|	И С.СкидкаНаценка <> ЗНАЧЕНИЕ(Справочник.СкидкиНаценки.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	С.Ссылка, С.СкидкаНаценка.Наименование, С.СкидкаНаценка.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// Оплаты подарочным сертификатом по чекам (эталон v_1.02: сумма вычитается из выручки при расчёте среднего чека)
	|ВЫБРАТЬ
	|	О.Ссылка КАК Ссылка,
	|	СУММА(О.Сумма) КАК Сумма
	|ИЗ
	|	Документ.ЧекККМ.Оплата КАК О
	|ГДЕ
	|	О.Ссылка.Проведен
	|	И О.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|	И О.Ссылка.СтатусЧекаККМ В (&Пробитый, &Архивный)
	|	И О.Ссылка.Магазин В (&Магазины)
	|	И О.ВидОплаты = ЗНАЧЕНИЕ(Справочник.ВидыОплатЧекаККМ.ОплатаПодарочнымСертификатом)
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Ссылка";

	Пакет = Запрос.ВыполнитьПакет();

	// оплаты подарочным сертификатом по чекам (сумма по чеку)
	ОплатыСерт = Новый Соответствие;
	Выборка = Пакет[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		ОплатыСерт.Вставить(Выборка.Ссылка, Выборка.Сумма);
	КонецЦикла;

	Акции = Новый Соответствие;
	Выборка = Пакет[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = Акции.Получить(Выборка.Ссылка);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Акции.Вставить(Выборка.Ссылка, Список);
		КонецЕсли;
		Список.Добавить(Новый Структура("name,code,sum", Строка(Выборка.Акция), Строка(Выборка.КодАкции), Выборка.Сумма));
	КонецЦикла;

	Позиции = Новый Соответствие;
	Выборка = Пакет[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = Позиции.Получить(Выборка.Ссылка);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Позиции.Вставить(Выборка.Ссылка, Список);
		КонецЕсли;
		Список.Добавить(Новый Структура("seller,sum,qty,upt,item,sku,char,calc,acc,excl,grp,gc", Строка(Выборка.Продавец), Выборка.Сумма, Выборка.Количество, Выборка.КоличествоКПЧ,
			Строка(Выборка.Товар), Строка(Выборка.Артикул), Строка(Выборка.Характеристика), Выборка.Расчет, Выборка.Сопутка, Выборка.Галантерея,
			ГруппаХлебныеКрошки(Выборка.Группа1, Выборка.Группа2, Выборка.Группа3, Выборка.Группа4), Выборка.ЭтоПодарочнаяКарта));
	КонецЦикла;

	Результат = Новый Массив;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = Позиции.Получить(Выборка.Ссылка);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
		КонецЕсли;
		Кол = 0;
		КолКПЧ = 0;
		КолКарт = 0;
		СуммаКарт = 0;
		Для Каждого П Из Список Цикл
			Кол = Кол + П.qty;
			КолКПЧ = КолКПЧ + П.upt;
			Если П.gc Тогда
				КолКарт = КолКарт + П.qty;
				СуммаКарт = СуммаКарт + П.sum;
			КонецЕсли;
			Если П.seller = "" Тогда
				П.seller = Строка(Выборка.Продавец);
			КонецЕсли;
		КонецЦикла;
		Акц = Акции.Получить(Выборка.Ссылка);
		Если Акц = Неопределено Тогда
			Акц = Новый Массив;
		КонецЕсли;
		ОплатаСерт = ОплатыСерт.Получить(Выборка.Ссылка);
		Если ОплатаСерт = Неопределено Тогда
			ОплатаСерт = 0;
		КонецЕсли;
		// полный возврат (эталон v_1.02): чек-возврат ссылается на чек продажи с той же суммой - такой чек продажи не считается в ЧековПродажБезКарт
		ЧекПродажи = "";
		Если Выборка.ЭтоВозврат И ЗначениеЗаполнено(Выборка.ЧекПродажи) И Выборка.СуммаЧекаПродажи = Выборка.Сумма Тогда
			ЧекПродажи = Строка(Выборка.ЧекПродажи.УникальныйИдентификатор());
		КонецЕсли;
		Результат.Добавить(Новый Структура("id,number,date,store,seller,kind,sum,qty,uptQty,bon,bonAdd,bonBd,card,cardNew,lines,promos,cc,certPay,gcSum,gcQty,retOf,tz",
			Строка(Выборка.Ссылка.УникальныйИдентификатор()), Формат(Выборка.Номер, "ЧГ=0"), ДатаJson(Выборка.Дата),
			Строка(Выборка.Магазин), Строка(Выборка.Продавец), ?(Выборка.ЭтоВозврат, "return", "sale"),
			Выборка.Сумма, Кол, КолКПЧ, Выборка.Бонусы, Выборка.БонусыДоп, Выборка.БонусыДР, Выборка.ЕстьКарта, Выборка.КартаВыдана, Список, Акц, СокрЛП(Выборка.КодКарты),
			ОплатаСерт, СуммаКарт, КолКарт, ЧекПродажи,
			?(Выборка.ЧасоваяЗона > 0, Выборка.ЧасоваяЗона + 1, 0)));   //Леонтьев Е.Е. 11.11.2026 - пояс магазина: 2 - МСК (UTC+3), 3 - Самара (UTC+4), 4 - ЕКБ (UTC+5)
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВозвратыЗаПериод(Начало, Конец)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Магазины", МагазиныВыгрузкиСсылки());
	// KPI по эталону «Отчет по показателям сотрудников АТТ (новые правила) v_1.02»
	Запрос.УстановитьПараметр("ГруппыKPI", ГруппыKPI());
	Запрос.УстановитьПараметр("Плащ", ПлащИсключениеKPI());
	Запрос.УстановитьПараметр("ПодарочныеКарты", ПодарочныеКартыKPI());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Воз.Ссылка КАК Ссылка,
	|	Воз.Номер КАК Номер,
	|	Воз.Дата КАК Дата,
	|	Воз.Магазин.Наименование КАК Магазин,
	|	Воз.Продавец.Наименование КАК Продавец,
	|	Воз.СуммаДокумента КАК Сумма,
	|	ЕСТЬNULL(Воз.ДисконтнаяКарта.Код, """") КАК КодКарты,
	|	ЕСТЬNULL(Воз.ДисконтнаяКарта.Наименование, """") КАК Карта,
	|	ПРЕДСТАВЛЕНИЕ(Воз.ВладелецДисконтнойКарты) КАК ВладелецКарты,
	|	Воз.ФИО КАК ФИО,
	|	Воз.Телефон КАК Телефон,
	|	ВЫРАЗИТЬ(Воз.Комментарий КАК СТРОКА(300)) КАК Комментарий,
	|	ЕСТЬNULL(Воз.Магазин.УмКо_ЧасоваяЗона, 0) КАК ЧасоваяЗона
	|ИЗ
	|	Документ.ВозвратТоваровОтПокупателя КАК Воз
	|ГДЕ
	|	Воз.Дата МЕЖДУ &Начало И &Конец
	|	И Воз.Магазин В (&Магазины)
	|	И Воз.Проведен
	|	И НЕ Воз.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(Т.Количество * ВЫБОР КОГДА Т.Коэффициент = 0 ТОГДА 1 ИНАЧЕ Т.Коэффициент КОНЕЦ, 0) КАК Количество,
	|	ВЫБОР
	|		КОГДА Т.Номенклатура.Родитель В ИЕРАРХИИ (&ГруппыKPI)
	|			И НЕ Т.Номенклатура = &Плащ
	|			ТОГДА ЕСТЬNULL(Т.Количество * ВЫБОР КОГДА Т.Коэффициент = 0 ТОГДА 1 ИНАЧЕ Т.Коэффициент КОНЕЦ, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоКПЧ,
	|	ВЫБОР КОГДА Т.Номенклатура В (&ПодарочныеКарты) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоПодарочнаяКарта,
	|	Т.Сумма КАК Сумма,
	|	ЕСТЬNULL(Т.Номенклатура.Наименование, """") КАК Товар,
	|	ЕСТЬNULL(Т.Номенклатура.Артикул, """") КАК Артикул,
	|	ЕСТЬNULL(Т.ХарактеристикаНоменклатуры.Наименование, """") КАК Характеристика,
	|	Т.Цена КАК Цена,
	|	ЕСТЬNULL(Т.ДисконтнаяКарта.Код, """") КАК КодКарты,
	|	ЕСТЬNULL(Т.ДокументПродажи.Номер, """") КАК НомерПродажи,
	|	ЕСТЬNULL(Т.Номенклатура.Родитель.Наименование, """") КАК Группа1,
	|	ЕСТЬNULL(Т.Номенклатура.Родитель.Родитель.Наименование, """") КАК Группа2,
	|	ЕСТЬNULL(Т.Номенклатура.Родитель.Родитель.Родитель.Наименование, """") КАК Группа3,
	|	ЕСТЬNULL(Т.Номенклатура.Родитель.Родитель.Родитель.Родитель.Наименование, """") КАК Группа4
	|ИЗ
	|	Документ.ВозвратТоваровОтПокупателя.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|	И Т.Ссылка.Магазин В (&Магазины)
	|	И Т.Ссылка.Проведен
	|	И НЕ Т.Ссылка.ПометкаУдаления";

	Пакет = Запрос.ВыполнитьПакет();

	Позиции = Новый Соответствие;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = Позиции.Получить(Выборка.Ссылка);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Позиции.Вставить(Выборка.Ссылка, Список);
		КонецЕсли;
		Список.Добавить(Новый Структура("sum,qty,kpiQty,gc,price,item,sku,char,grp,cc,saleDoc", Выборка.Сумма, Выборка.Количество, Выборка.КоличествоКПЧ, Выборка.ЭтоПодарочнаяКарта, Выборка.Цена,
			Строка(Выборка.Товар), Строка(Выборка.Артикул), Строка(Выборка.Характеристика),
			ГруппаХлебныеКрошки(Выборка.Группа1, Выборка.Группа2, Выборка.Группа3, Выборка.Группа4),
			СокрЛП(Выборка.КодКарты), СокрЛП(Строка(Выборка.НомерПродажи))));
	КонецЦикла;

	Результат = Новый Массив;
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = Позиции.Получить(Выборка.Ссылка);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
		КонецЕсли;
		Кол = 0;
		КолКПЧ = 0;
		КолКарт = 0;
		СуммаКарт = 0;
		КодКарты = СокрЛП(Выборка.КодКарты);
		Для Каждого П Из Список Цикл
			Кол = Кол + П.qty;
			КолКПЧ = КолКПЧ + П.kpiQty;
			Если П.gc Тогда
				КолКарт = КолКарт + П.qty;
				СуммаКарт = СуммаКарт + П.sum;
			КонецЕсли;
			Если КодКарты = "" И П.cc <> "" Тогда
				КодКарты = П.cc;      // карта не указана в шапке - берём из строки товаров
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(Новый Структура("id,number,date,store,seller,sum,qty,kpiQty,gcSum,gcQty,lines,cc,card,cardOwner,fio,phone,comment,tz",
			Строка(Выборка.Ссылка.УникальныйИдентификатор()), Формат(Выборка.Номер, "ЧГ=0"), ДатаJson(Выборка.Дата),
			Строка(Выборка.Магазин), Строка(Выборка.Продавец), Выборка.Сумма, Кол, КолКПЧ, СуммаКарт, КолКарт, Список,
			КодКарты, СокрЛП(Выборка.Карта), СокрЛП(Строка(Выборка.ВладелецКарты)), СокрЛП(Выборка.ФИО), СокрЛП(Выборка.Телефон), СокрЛП(Выборка.Комментарий),
			?(Выборка.ЧасоваяЗона > 0, Выборка.ЧасоваяЗона + 1, 0)));   //Леонтьев Е.Е. 11.11.2026 - пояс магазина (как у чеков)
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ГруппыИсключенияКПЧ()

	// Список сверен с эталонным отчётом УмКо_ПоказателиСотрудниковАТТНовыеПравила (функция
	// ПолучитьИсключаемыеГруппыТоваров): эти группы (с подгруппами) не участвуют в расчёте
