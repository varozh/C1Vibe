Функция ОстаткиИПланПродаж(ПроцентПлана = 25, ШагОкругления = 10000) Экспорт

	ДатаСреза = ТекущаяДата();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	// цены - только вид цен ЦБР000005 "Розничная БЛ базовая"
	Запрос.УстановитьПараметр("ТипЦенКод", "ЦБР000005");
	Запрос.УстановитьПараметр("ТипЦенНаименование", "Розничная БЛ базовая");
	Запрос.УстановитьПараметр("ПроцентПлана", ПроцентПлана);
	Запрос.УстановитьПараметр("Магазины", МагазиныВыгрузкиСсылки());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ц.Номенклатура КАК Номенклатура,
	|	Ц.ХарактеристикаНоменклатуры КАК Характеристика,
	|	Ц.Цена КАК Цена
	|ПОМЕСТИТЬ ВТЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаСреза, (ТипЦен.Код = &ТипЦенКод ИЛИ ТипЦен.Наименование = &ТипЦенНаименование)) КАК Ц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Склад.Магазин КАК Магазин,
	|	СУММА(О.КоличествоОстаток) КАК Количество,
	|	СУММА(О.КоличествоОстаток * ЕСТЬNULL(Ц.Цена, ЕСТЬNULL(Ц0.Цена, 0))) КАК Сумма
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаСреза, ) КАК О
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК Ц
	|		ПО О.Номенклатура = Ц.Номенклатура
	|			И О.ХарактеристикаНоменклатуры = Ц.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК Ц0
	|		ПО О.Номенклатура = Ц0.Номенклатура
	|			И Ц0.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|ГДЕ
	|	О.Склад.Магазин В (&Магазины)
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Склад.Магазин
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Магазин.Наименование КАК Магазин,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма,
	|	ВЫРАЗИТЬ(Т.Сумма * &ПроцентПлана / 100 КАК ЧИСЛО(15, 2)) КАК Расчет
	|ИЗ
	|	ВТОстатки КАК Т
	|ГДЕ
	|	НЕ Т.Магазин.ПометкаУдаления";

	Пакет = Запрос.ВыполнитьПакет();
	Результат = Новый Массив;
	ДатаТекст = Формат(ДатаСреза, "ДФ=yyyy-MM-dd");
	Выборка = Пакет[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Расчет = Выборка.Расчет;
		Если ШагОкругления > 0 Тогда
			Частное = Цел(Расчет / ШагОкругления);
			Если Частное * ШагОкругления < Расчет Тогда
				Частное = Частное + 1;
			КонецЕсли;
			План = Частное * ШагОкругления;
		Иначе
			План = Расчет;
		КонецЕсли;
		Результат.Добавить(Новый Структура("date,store,qty,sum,plan", ДатаТекст, Строка(Выборка.Магазин), Выборка.Количество, Выборка.Сумма, План));
	КонецЦикла;
	Возврат Результат;

