Функция ДолжностиПродавцов(Начало, Конец)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Пусто", Справочники.ФизическиеЛица.ПустаяСсылка());
	Запрос.УстановитьПараметр("Магазины", МагазиныВыгрузкиСсылки());
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ч.Продавец.Наименование КАК Имя,
	|	Ч.Продавец.Должность КАК Должность
	|ИЗ
	|	Документ.ЧекККМ КАК Ч
	|ГДЕ
	|	Ч.Проведен
	|	И Ч.Дата МЕЖДУ &Начало И &Конец
	|	И Ч.Продавец <> &Пусто
	|	И Ч.Магазин В (&Магазины)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Продавец.Наименование КАК Имя,
	|	Т.Продавец.Должность КАК Должность
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Проведен
	|	И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|	И Т.Продавец <> &Пусто
	|	И Т.Ссылка.Магазин В (&Магазины)";

	Найденные = Новый Соответствие;
	Для Каждого Часть Из Запрос.ВыполнитьПакет() Цикл
		Выборка = Часть.Выбрать();
		Пока Выборка.Следующий() Цикл
			Найденные.Вставить(СокрЛП(Выборка.Имя), СокрЛП(Выборка.Должность));
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Пара Из Найденные Цикл
		Результат.Добавить(Новый Структура("name,position", Пара.Ключ, Пара.Значение));
	КонецЦикла;
	Возврат Результат;

