Функция КлиентыДляПанели() Экспорт

	ВидыКарт = Новый Массив;
	ВидыКарт.Добавить("ЦБР000024");   // new2025
	ВидыКарт.Добавить("ЦБР000016");   // new2016

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидыКарт", ВидыКарт);
	Запрос.УстановитьПараметр("Магазины", МагазиныВыгрузкиСсылки());
	Запрос.УстановитьПараметр("Телефон", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("Почта", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Карты.Код КАК Код,
	|	Карты.КодКарты КАК КодКарты,
	|	Карты.ВидДисконтнойКарты.Наименование КАК ВидКарты,
	|	Карты.ВладелецКарты КАК Владелец,
	|	ПРЕДСТАВЛЕНИЕ(Карты.ВладелецКарты) КАК ВладелецИмя,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Карты.ВладелецКарты КАК Справочник.ФизическиеЛица).Код, """") КАК ВладелецКод,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Карты.ВладелецКарты КАК Справочник.ФизическиеЛица).ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРождения,
	|	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(Карты.ВладелецКарты КАК Справочник.ФизическиеЛица).Пол) КАК Пол,
	|	ЕСТЬNULL(Карты.Магазин.Наименование, """") КАК Магазин,
	|	Карты.ДатаОткрытия КАК ДатаОткрытия,
	|	Карты.ДатаБлокировки КАК ДатаБлокировки
	|ПОМЕСТИТЬ ВТКарты
	|ИЗ
	|	Справочник.ИнформационныеКарты КАК Карты
	|ГДЕ
	|	НЕ Карты.ЭтоГруппа
	|	И НЕ Карты.ПометкаУдаления
	|	И Карты.ВидДисконтнойКарты.Код В (&ВидыКарт)
	|	И Карты.Магазин В (&Магазины)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КИ.Объект КАК Объект,
	|	КИ.Тип КАК Тип,
	|	МАКСИМУМ(ВЫРАЗИТЬ(КИ.Представление КАК СТРОКА(100))) КАК Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.Объект В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВТ.Владелец
	|			ИЗ
	|				ВТКарты КАК ВТ)
	|	И КИ.Тип В (&Телефон, &Почта)
	|
	|СГРУППИРОВАТЬ ПО
	|	КИ.Объект,
	|	КИ.Тип
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Код КАК Код,
	|	ВТ.КодКарты КАК КодКарты,
	|	ВТ.ВидКарты КАК ВидКарты,
	|	ВТ.Владелец КАК Владелец,
	|	ВТ.ВладелецИмя КАК ВладелецИмя,
	|	ВТ.ВладелецКод КАК ВладелецКод,
	|	ВТ.ДатаРождения КАК ДатаРождения,
	|	ВТ.Пол КАК Пол,
	|	ВТ.Магазин КАК Магазин,
	|	ВТ.ДатаОткрытия КАК ДатаОткрытия,
	|	ВТ.ДатаБлокировки КАК ДатаБлокировки
	|ИЗ
	|	ВТКарты КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.Код";
	Пакет = Запрос.ВыполнитьПакет();

	Телефоны = Новый Соответствие;
	Почта = Новый Соответствие;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Телефоны.Вставить(Выборка.Объект, СокрЛП(Выборка.Представление));
		Иначе
			Почта.Вставить(Выборка.Объект, СокрЛП(Выборка.Представление));
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Выборка = Пакет[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Телефон = Телефоны.Получить(Выборка.Владелец);
		Адрес = Почта.Получить(Выборка.Владелец);
		Результат.Добавить(Новый Структура("cardCode,cardNumber,cardType,name,personCode,phone,email,birthday,gender,store,opened,blocked",
			СокрЛП(Выборка.Код), СокрЛП(Выборка.КодКарты), СокрЛП(Выборка.ВидКарты), СокрЛП(Выборка.ВладелецИмя),
			СокрЛП(Выборка.ВладелецКод), ?(Телефон = Неопределено, "", Телефон), ?(Адрес = Неопределено, "", Адрес),
			?(ЗначениеЗаполнено(Выборка.ДатаРождения), Формат(Выборка.ДатаРождения, "ДФ=yyyy-MM-dd"), ""), СокрЛП(Выборка.Пол),
			СокрЛП(Выборка.Магазин), ?(ЗначениеЗаполнено(Выборка.ДатаОткрытия), Формат(Выборка.ДатаОткрытия, "ДФ=yyyy-MM-dd"), ""),
			?(ЗначениеЗаполнено(Выборка.ДатаБлокировки), Формат(Выборка.ДатаБлокировки, "ДФ=yyyy-MM-dd"), "")));
	КонецЦикла;
	Возврат Результат;

