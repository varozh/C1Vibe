Функция ТрафикПоЧасам(Начало, Конец)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Магазины", МагазиныВыгрузкиСсылки());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(С.Период, ДЕНЬ) КАК День,
	|	ЧАС(С.ОтрезокВремени) КАК Час,
	|	МагазиныУстройства.Магазин.Наименование КАК Магазин,
	|	СУММА(С.КоличествоВходов) КАК Входов
	|ИЗ
	|	РегистрСведений.УмКо_СтатистикаПосещаемости КАК С
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УмКо_МагазиныУстройства.СрезПоследних(&Конец, ) КАК МагазиныУстройства
	|		ПО С.Устройство = МагазиныУстройства.Устройство
	|ГДЕ
	|	С.Период МЕЖДУ &Начало И &Конец
	|	И МагазиныУстройства.Магазин <> ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка)
	|	И МагазиныУстройства.Магазин В (&Магазины)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(С.Период, ДЕНЬ),
	|	ЧАС(С.ОтрезокВремени),
	|	МагазиныУстройства.Магазин.Наименование";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("day,store,hour,count", Формат(Выборка.День, "ДФ=yyyy-MM-dd"), Строка(Выборка.Магазин), Выборка.Час, Выборка.Входов));
	КонецЦикла;
	Возврат Результат;

