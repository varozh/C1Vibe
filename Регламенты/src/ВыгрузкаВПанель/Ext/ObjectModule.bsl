Функция ПосетителиЗаПериод(Начало, Конец)

	Накопление = Новый Соответствие;
	Для Каждого Запись Из ТрафикПоЧасам(Начало, Конец) Цикл
		Ключ = Запись.day + "|" + Запись.store;
		Накопление.Вставить(Ключ, ?(Накопление.Получить(Ключ) = Неопределено, 0, Накопление.Получить(Ключ)) + Запись.count);
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Пара Из Накопление Цикл
		Части = СтрРазделить(Пара.Ключ, "|");
		Результат.Добавить(Новый Структура("day,store,count", Части[0], Части[1], Пара.Значение));
	КонецЦикла;
	Возврат Результат;

