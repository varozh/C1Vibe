
// Общий модуль "БЛ_ПанельОстатковУТ" конфигурации 1С:Управление торговлей 10.3 (bl-isoflex/trade).
// Регламентное задание "БЛ_ВыгрузкаОстатковНаПанель": остатки складов на текущий момент -> BUSINESS LINE SMART PANEL.
// Расписание: ежедневно 08:00, 13:00, 18:00, 21:00. Код перенесён из внешней обработки ВыгрузкаОстатковСкладовУТ.epf (v3)
// без формы и регистрации в справочнике: склады, цены и формат пакета те же.
// Расширения здесь невозможны (режим совместимости 8.2.16), поэтому модуль и задание добавлены в конфигурацию.

// Точка входа регламентного задания. Итог пишется в журнал регистрации (событие "БЛ_ПанельОстатковУТ.ВыгрузкаОстатков");
// при ошибке вызывается исключение, чтобы задание получило состояние "Завершено аварийно" и перезапустилось.
Процедура ВыгрузкаОстатковНаПанель() Экспорт

	Событие = "БЛ_ПанельОстатковУТ.ВыгрузкаОстатков";
	Попытка
		Результат = ВыгрузитьОстаткиСкладов(АдресПанелиПоУмолчанию());
	Исключение
		Результат = "ERROR: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Лев(Результат, 2) = "OK" Тогда
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Информация, , , Результат);
	Иначе
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , Результат);
		ВызватьИсключение Результат;
	КонецЕсли;

КонецПроцедуры

// Адреса панели по порядку: внутренний 10.28.2.164:8086 (сервер панели, приоритет), внешний 109.195.203.146:8090
// (запасной), имя хоста панели BL-IT-100:8086. Выбирается первый отвечающий на /api/health; если не отвечает
// ни один - BL-IT-100:8086 (ошибку покажет сама выгрузка).
// 1.1 (18.11.2026, по ВыгрузкаОстатковСкладовУТ.epf от Леонтьева Е.Е. 17.11.2026): добавлен BL-IT-100:8086,
// все HTTP-соединения - без прокси (Новый ИнтернетПрокси(Ложь)): системный прокси сервера 1С не пропускал
// запросы к внутренней панели.
Функция АдресПанелиПоУмолчанию() Экспорт

	Адреса = Новый Массив;
	Адреса.Добавить("10.28.2.164:8086");       // внутренний (сервер панели)
	Адреса.Добавить("109.195.203.146:8090");   // внешний
	Адреса.Добавить("BL-IT-100:8086");         // имя хоста панели
	Для Каждого Адрес Из Адреса Цикл
		Если ПанельОтвечает(Адрес) Тогда
			Возврат Адрес;
		КонецЕсли;
	КонецЦикла;
	Возврат "BL-IT-100:8086";

КонецФункции

// Проверка доступности панели (GET /api/health, таймаут 3 с, без прокси).
Функция ПанельОтвечает(Адрес)

	Попытка
		П = РазобратьАдрес(Адрес);
		Если П.Защищенно Тогда
			Соединение = Новый HTTPСоединение(П.Хост, П.Порт, , , Новый ИнтернетПрокси(Ложь), 3, Новый ЗащищенноеСоединениеOpenSSL);
		Иначе
			Соединение = Новый HTTPСоединение(П.Хост, П.Порт, , , Новый ИнтернетПрокси(Ложь), 3);
		КонецЕсли;
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/api/health"));
		Возврат Ответ.КодСостояния = 200;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ВерсияВыгрузки() Экспорт
	Возврат "БЛ_ПанельОстатковУТ 1.1 (без прокси; как ВыгрузкаОстатковСкладовУТ v3 от 17.11.2026: склады УТ0000389, УТ0000891, УТ0000358, УТ0000903/УТ0000910, УТ0000090; цены 000000006 ""Розничная БЛ базовая"")";
КонецФункции

Функция КлючПанели()
	Возврат "91f251272f27a89c671d97e0c48294c1f37dd49c947d1d96";
КонецФункции

// Коды складов выгрузки (справочник "Склады"). "Новь БЦ РЦ" заведён в базе дважды (УТ0000903 и УТ0000910):
// остатки обоих элементов суммируются под одним наименованием.
Функция КодыСкладов()

	Коды = Новый Массив;
	Коды.Добавить("УТ0000389");   // Главный розничный склад
	Коды.Добавить("УТ0000891");   // Новь БЦ ВСС (склад вторичной сортировки)
	Коды.Добавить("УТ0000358");   // Вторичный сбыт склад
	Коды.Добавить("УТ0000903");   // Новь БЦ РЦ
	Коды.Добавить("УТ0000910");   // Новь БЦ РЦ (дубль элемента справочника)
	Коды.Добавить("УТ0000090");   // Оптовый склад хранения ЕВ
	Возврат Коды;

КонецФункции

// Наименования складов выгрузки без повторов (список stockItemsWh: склад регистрируется в настройках панели,
// даже если остаток по нему нулевой).
Функция СкладыВыгрузки() Экспорт

	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Коды", КодыСкладов());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Склады КАК С
	|ГДЕ
	|	С.Код В (&Коды)
	|	И НЕ С.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	С.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = СокрЛП(Выборка.Наименование);
		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Остатки складов по товарам с характеристиками и ценой "Розничная БЛ базовая" (код 000000006):
// сначала цена по характеристике, если её нет - цена без характеристики. Серии суммируются.
Функция ОстаткиСкладов()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Коды", КодыСкладов());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.Склад КАК Склад,
	|	О.Номенклатура КАК Номенклатура,
	|	О.ХарактеристикаНоменклатуры КАК Характеристика,
	|	СУММА(О.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад.Код В (&Коды)) КАК О
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Склад,
	|	О.Номенклатура,
	|	О.ХарактеристикаНоменклатуры
	|
	|ИМЕЮЩИЕ
	|	СУММА(О.КоличествоОстаток) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Склад.Наименование КАК Склад,
	|	О.Номенклатура.Наименование КАК Товар,
	|	О.Номенклатура.Артикул КАК Артикул,
	|	О.Номенклатура.Родитель.Наименование КАК Группа,
	|	О.Характеристика.Наименование КАК Характеристика,
	|	О.Количество КАК Количество,
	|	ЕСТЬNULL(Ц.Цена, ЕСТЬNULL(Ц0.Цена, 0)) КАК Цена
	|ИЗ
	|	Остатки КАК О
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ТипЦен.Код = ""000000006"") КАК Ц
	|		ПО Ц.Номенклатура = О.Номенклатура
	|			И Ц.ХарактеристикаНоменклатуры = О.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ТипЦен.Код = ""000000006"") КАК Ц0
	|		ПО Ц0.Номенклатура = О.Номенклатура
	|			И Ц0.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)";
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

// Один пакет для панели: итоги по складам (stock с признаком wh) и строки по товарам (stockItems).
Функция СобратьПакет(Склады) Экспорт

	День = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd");
	Итоги = Новый Соответствие;   // склад -> Структура(qty, sum)
	Строки = Новый Массив;
	Выборка = ОстаткиСкладов();
	Пока Выборка.Следующий() Цикл
		Склад = СокрЛП(Выборка.Склад);
		Количество = Выборка.Количество;
		Сумма = Окр(Количество * Выборка.Цена, 2);
		Итог = Итоги.Получить(Склад);
		Если Итог = Неопределено Тогда
			Итог = Новый Структура("qty,sum", 0, 0);
			Итоги.Вставить(Склад, Итог);
		КонецЕсли;
		Итог.qty = Итог.qty + Количество;
		Итог.sum = Итог.sum + Сумма;
		Строки.Добавить(Новый Структура("store,date,item,sku,char,grp,qty,sum,wh",
			Склад, День,
			СокрЛП(Выборка.Товар), СокрЛП(Выборка.Артикул), СокрЛП(Выборка.Характеристика), СокрЛП(Выборка.Группа),
			Количество, Сумма, Истина));
	КонецЦикла;

	ИтогиМассив = Новый Массив;
	Для Каждого Склад Из Склады Цикл
		Итог = Итоги.Получить(Склад);
		ИтогиМассив.Добавить(Новый Структура("date,store,qty,sum,plan,wh",
			День, Склад, ?(Итог = Неопределено, 0, Итог.qty), ?(Итог = Неопределено, 0, Окр(Итог.sum, 2)), 0, Истина));
	КонецЦикла;
	Возврат Новый Структура("stock,stockItems,stockItemsWh", ИтогиМассив, Строки, Склады);

КонецФункции

// Собирает остатки складов и отправляет одним пакетом на панель (прежний срез этих складов на панели заменяется).
// Возвращает текст-итог: "OK..." при успехе, иначе "ERROR: ...".
Функция ВыгрузитьОстаткиСкладов(Адрес) Экспорт

	Склады = СкладыВыгрузки();
	Если Склады.Количество() = 0 Тогда
		Возврат "ERROR: склады выгрузки не найдены в справочнике ""Склады"" (коды " + СтрСоединить(КодыСкладов(), ", ") + ").";
	КонецЕсли;
	П = РазобратьАдрес(Адрес);
	Пакет = СобратьПакет(Склады);
	Ответ = ОтправитьПакет(ВJson(Пакет), П.Хост, П.Порт, П.Защищенно);
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат "ERROR: панель " + Адрес + " вернула код " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	КонецЕсли;

	Итог = "OK. Выгрузка остатков складов на " + Адрес + " завершена. " + ВерсияВыгрузки() + "." + Символы.ПС
		+ "Строк по товарам: " + Пакет.stockItems.Количество() + ".";
	Для Каждого ИтогСклада Из Пакет.stock Цикл
		Итог = Итог + Символы.ПС + "- " + ИтогСклада.store + ": " + Формат(ИтогСклада.qty, "ЧДЦ=3; ЧН=0") + " шт., "
			+ Формат(ИтогСклада.sum, "ЧДЦ=2; ЧН=0") + " руб. (" + ИтогСклада.date + ")";
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Адрес: "хост:порт", "http://хост:порт" или "https://хост" (панель за Apache с HTTPS)
Функция РазобратьАдрес(Адрес)

	Защищенно = Ложь;
	Строка_ = СокрЛП(Адрес);
	Если НРег(Лев(Строка_, 8)) = "https://" Тогда
		Защищенно = Истина;
		Строка_ = Сред(Строка_, 9);
	ИначеЕсли НРег(Лев(Строка_, 7)) = "http://" Тогда
		Строка_ = Сред(Строка_, 8);
	КонецЕсли;
	Позиция = СтрНайти(Строка_, "/");
	Если Позиция > 0 Тогда
		Строка_ = Лев(Строка_, Позиция - 1);
	КонецЕсли;
	Части = СтрРазделить(Строка_, ":");
	Порт = ?(Части.Количество() > 1, Число(СокрЛП(Части[1])), ?(Защищенно, 443, 80));
	Возврат Новый Структура("Хост,Порт,Защищенно", СокрЛП(Части[0]), Порт, Защищенно);

КонецФункции

Функция ОтправитьПакет(Json, Хост, Порт, Защищенно = Ложь)

	// без прокси: системный прокси сервера 1С не пропускает запросы к внутренней панели
	Если Защищенно Тогда
		Соединение = Новый HTTPСоединение(Хост, Порт, , , Новый ИнтернетПрокси(Ложь), 600, Новый ЗащищенноеСоединениеOpenSSL);
	Иначе
		Соединение = Новый HTTPСоединение(Хост, Порт, , , Новый ИнтернетПрокси(Ложь), 600);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос("/api/ingest");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("X-Api-Key", КлючПанели());
	Запрос.УстановитьТелоИзСтроки(Json, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Соединение.ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ВJson(Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции
