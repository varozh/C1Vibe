#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура Заполнить(Команда)

	Если ЗначениеЗаполнено(ЭтотОбъект["ПериодКонец"]) И ЭтотОбъект["ПериодНачало"] > ЭтотОбъект["ПериодКонец"] Тогда
		ПоказатьПредупреждение(, "Дата начала периода больше даты окончания.");
		Возврат;
	КонецЕсли;
	Состояние("Подбор корректировок реализации...");
	Найдено = ЗаполнитьНаСервере();
	Если Найдено >= ЭтотОбъект["МаксимумСтрок"] И ЭтотОбъект["МаксимумСтрок"] > 0 Тогда
		ПоказатьПредупреждение(, "Показаны первые " + Формат(Найдено, "ЧГ=") + " документов (ограничение «Не более строк»)."
			+ Символы.ПС + "Сузьте отбор или увеличьте ограничение.");
	КонецЕсли;

КонецПроцедуры

