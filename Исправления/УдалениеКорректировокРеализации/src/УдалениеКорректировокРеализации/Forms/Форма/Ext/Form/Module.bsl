&НаКлиенте
Процедура ОчиститьОтборы(Команда)

	ЭтотОбъект["ОтборОрганизация"] = Неопределено;
	ЭтотОбъект["ОтборКонтрагенты"].Очистить();
	ЭтотОбъект["ОтборИНН"] = "";
	ЭтотОбъект["ОтборДоговор"] = Неопределено;
	ЭтотОбъект["ОтборСклад"] = Неопределено;
	ЭтотОбъект["ОтборВидОперации"] = Неопределено;
	ЭтотОбъект["ОтборОтветственный"] = Неопределено;
	ЭтотОбъект["ОтборНомер"] = "";
	ЭтотОбъект["ОтборКомментарий"] = "";
	ЭтотОбъект["ОтборПроведен"] = "Все";
	ЭтотОбъект["ОтборПометка"] = "Все";
	ЭтотОбъект["ОтборСФ"] = "Все";

КонецПроцедуры

&НаКлиенте
Процедура УдалитьОтмеченные(Команда)

	КоличествоКорр = 0;
	КоличествоСФ = 0;
	Для Каждого Строка Из ЭтотОбъект["Документы"] Цикл
		Если Строка.Пометка И Не Строка.Удален Тогда
			КоличествоКорр = КоличествоКорр + 1;
			КоличествоСФ = КоличествоСФ + Строка.КоличествоСФ;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоКорр = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одного документа.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Будут БЕЗВОЗВРАТНО удалены (не пометкой, а физически, вместе с движениями):" + Символы.ПС
		+ "   корректировок реализации: " + Формат(КоличествоКорр, "ЧГ=") + Символы.ПС
		+ "   счетов-фактур выданных: " + Формат(КоличествоСФ, "ЧГ=") + Символы.ПС + Символы.ПС;
	Если ЭтотОбъект["УдалятьПриНаличииСсылок"] Тогда
		ТекстВопроса = ТекстВопроса + "ВНИМАНИЕ: включено «Удалять, даже если на документы ссылаются другие объекты» —"
			+ " в базе могут остаться битые ссылки." + Символы.ПС + Символы.ПС;
	КонецЕсли;
	ТекстВопроса = ТекстВопроса + "Отменить удаление будет нельзя. Копия базы сделана? Продолжить?";

	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьОтмеченныеПослеВопроса", ЭтотОбъект), ТекстВопроса,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Удаление документов");

КонецПроцедуры

&НаКлиенте
Процедура УдалитьОтмеченныеПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	НастройкиУдаления = Новый Структура;
	НастройкиУдаления.Вставить("ПроверятьСсылки", ЭтотОбъект["ПроверятьСсылки"]);
	НастройкиУдаления.Вставить("УдалятьЗаписиРегистров", ЭтотОбъект["УдалятьЗаписиРегистров"]);
	НастройкиУдаления.Вставить("УдалятьПриНаличииСсылок", ЭтотОбъект["УдалятьПриНаличииСсылок"]);

	РазмерПакета = Макс(1, ЭтотОбъект["РазмерПакета"]);

	Отмеченные = Новый Массив;
	Для Каждого Строка Из ЭтотОбъект["Документы"] Цикл
		Если Строка.Пометка И Не Строка.Удален Тогда
			Отмеченные.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Всего = Отмеченные.Количество();
	Удалено = 0;
	Пропущено = 0;
	Обработано = 0;
	Прервано = Ложь;

	Пакет = Новый Массив;
	СтрокиПакета = Новый Соответствие;
	Для Индекс = 0 По Всего - 1 Цикл

		Строка = Отмеченные[Индекс];
		Пакет.Добавить(Строка.Корректировка);
		СтрокиПакета.Вставить(Строка.Корректировка, Строка);

		Если Пакет.Количество() < РазмерПакета И Индекс < Всего - 1 Тогда
			Продолжить;
		КонецЕсли;

		Состояние("Удаление документов: " + Формат(Обработано, "ЧН=0; ЧГ=") + " из " + Формат(Всего, "ЧГ=")
			+ " (удалено " + Удалено + ", пропущено " + Пропущено + ")",
			Окр(Обработано * 100 / Всего), "Для прерывания нажмите Ctrl+Break");

		Результаты = УдалитьПакетНаСервере(Пакет, НастройкиУдаления);

		Для Каждого КлючИЗначение Из Результаты Цикл
			СтрокаТаблицы = СтрокиПакета.Получить(КлючИЗначение.Ключ);
			Если СтрокаТаблицы = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТаблицы.Результат = КлючИЗначение.Значение.Текст;
			Если КлючИЗначение.Значение.Удален Тогда
				СтрокаТаблицы.Удален = Истина;
				СтрокаТаблицы.Пометка = Ложь;
				Удалено = Удалено + 1;
			Иначе
				Пропущено = Пропущено + 1;
				Сообщить(СтрокаТаблицы.Номер + " от " + Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy") + ": "
					+ КлючИЗначение.Значение.Текст);
			КонецЕсли;
		КонецЦикла;

		Обработано = Обработано + Пакет.Количество();
		Пакет = Новый Массив;
		СтрокиПакета = Новый Соответствие;

		Попытка
			ОбработкаПрерыванияПользователя();
		Исключение
			Прервано = Истина;
			Прервать;
		КонецПопытки;

	КонецЦикла;

	ОбновитьИтог(ЭтотОбъект);

	ПоказатьПредупреждение(, ?(Прервано, "Прервано пользователем." + Символы.ПС, "Готово." + Символы.ПС)
		+ "Удалено корректировок: " + Удалено + Символы.ПС
		+ "Не удалено: " + Пропущено + ?(Пропущено > 0, " (причины — в колонке «Результат» и в сообщениях)", ""));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = ЭтотОбъект["Документы"].НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка = Неопределено Или Строка.Удален Тогда
		Возврат;
	КонецЕсли;
	Если Поле.Имя = "ДокументыПометка" Тогда
		Строка.Пометка = Не Строка.Пометка;
		ОбновитьИтог(ЭтотОбъект);
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, Строка.Корректировка);

КонецПроцедуры

&НаКлиенте
Процедура ДокументыПометкаПриИзменении(Элемент)

	Строка = Элементы.Документы.ТекущиеДанные;
	Если Строка <> Неопределено И Строка.Удален Тогда
		Строка.Пометка = Ложь;
	КонецЕсли;
	ОбновитьИтог(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПометку(Значение)

	Таблица = ЭтотОбъект["Документы"];
	Выделенные = Элементы.Документы.ВыделенныеСтроки;
	Если Выделенные.Количество() > 1 Тогда
		Для Каждого Идентификатор Из Выделенные Цикл
			Строка = Таблица.НайтиПоИдентификатору(Идентификатор);
			Если Строка <> Неопределено И Не Строка.Удален Тогда
				Строка.Пометка = Значение;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Строка Из Таблица Цикл
			Если Не Строка.Удален Тогда
				Строка.Пометка = Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ОбновитьИтог(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтог(Форма)

	Всего = 0;
	Отмечено = 0;
	ОтмеченоСФ = 0;
	СуммаОтмеченных = 0;
	Удалено = 0;
	Для Каждого Строка Из Форма["Документы"] Цикл
		Если Строка.Удален Тогда
			Удалено = Удалено + 1;
			Продолжить;
		КонецЕсли;
		Всего = Всего + 1;
		Если Строка.Пометка Тогда
			Отмечено = Отмечено + 1;
			ОтмеченоСФ = ОтмеченоСФ + Строка.КоличествоСФ;
			СуммаОтмеченных = СуммаОтмеченных + Строка.Сумма;
		КонецЕсли;
	КонецЦикла;

	Форма["Итог"] = "В списке: " + Формат(Всего, "ЧН=0; ЧГ=3,0")
		+ "   Отмечено: " + Формат(Отмечено, "ЧН=0; ЧГ=3,0") + " корректировок на сумму " + Формат(СуммаОтмеченных, "ЧДЦ=2; ЧН=0")
		+ ", счетов-фактур: " + Формат(ОтмеченоСФ, "ЧН=0; ЧГ=3,0")
		+ ?(Удалено > 0, "   Удалено: " + Формат(Удалено, "ЧГ=3,0"), "");

КонецПроцедуры

&НаСервере
Функция ЗаполнитьНаСервере()

	Запрос = Новый Запрос;
	Условия = Новый Массив;

	ПериодНачало = ЭтотОбъект["ПериодНачало"];
	ПериодКонец = ЭтотОбъект["ПериодКонец"];
	Если ЗначениеЗаполнено(ПериодНачало) Тогда
		Условия.Добавить("К.Дата >= &ПериодНачало");
		Запрос.УстановитьПараметр("ПериодНачало", НачалоДня(ПериодНачало));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПериодКонец) Тогда
		Условия.Добавить("К.Дата <= &ПериодКонец");
		Запрос.УстановитьПараметр("ПериодКонец", КонецДня(ПериодКонец));
	КонецЕсли;

	ДобавитьУсловиеПоЗначению(Запрос, Условия, "К.Организация", "Организация", ЭтотОбъект["ОтборОрганизация"]);
	ДобавитьУсловиеПоЗначению(Запрос, Условия, "К.ДоговорКонтрагента", "Договор", ЭтотОбъект["ОтборДоговор"]);
	ДобавитьУсловиеПоЗначению(Запрос, Условия, "К.Склад", "Склад", ЭтотОбъект["ОтборСклад"]);
	ДобавитьУсловиеПоЗначению(Запрос, Условия, "К.ВидОперации", "ВидОперации", ЭтотОбъект["ОтборВидОперации"]);
	ДобавитьУсловиеПоЗначению(Запрос, Условия, "К.Ответственный", "Ответственный", ЭтотОбъект["ОтборОтветственный"]);

	Контрагенты = Новый Массив;
	Для Каждого Элемент Из ЭтотОбъект["ОтборКонтрагенты"] Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			Контрагенты.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Контрагенты.Количество() > 0 Тогда
		Условия.Добавить("К.Контрагент В (&Контрагенты)");
		Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	КонецЕсли;

	СтрокаИНН = СтрЗаменить(СтрЗаменить(ЭтотОбъект["ОтборИНН"], ";", ","), " ", ",");
	СписокИНН = Новый Массив;
	Для Каждого ИНН Из СтрРазделить(СтрокаИНН, ",", Ложь) Цикл
		СписокИНН.Добавить(СокрЛП(ИНН));
	КонецЦикла;
	Если СписокИНН.Количество() > 0 Тогда
		Условия.Добавить("К.Контрагент.ИНН В (&СписокИНН)");
		Запрос.УстановитьПараметр("СписокИНН", СписокИНН);
	КонецЕсли;

	Если ЗначениеЗаполнено(ЭтотОбъект["ОтборНомер"]) Тогда
		Условия.Добавить("К.Номер ПОДОБНО &Номер");
		Запрос.УстановитьПараметр("Номер", "%" + ЭкранироватьПодобно(СокрЛП(ЭтотОбъект["ОтборНомер"])) + "%");
	КонецЕсли;
	Если ЗначениеЗаполнено(ЭтотОбъект["ОтборКомментарий"]) Тогда
		Условия.Добавить("К.Комментарий ПОДОБНО &Комментарий");
		Запрос.УстановитьПараметр("Комментарий", "%" + ЭкранироватьПодобно(СокрЛП(ЭтотОбъект["ОтборКомментарий"])) + "%");
	КонецЕсли;

	Если ЭтотОбъект["ОтборПроведен"] = "Проведенные" Тогда
		Условия.Добавить("К.Проведен");
	ИначеЕсли ЭтотОбъект["ОтборПроведен"] = "Непроведенные" Тогда
		Условия.Добавить("НЕ К.Проведен");
	КонецЕсли;
	Если ЭтотОбъект["ОтборПометка"] = "Помеченные на удаление" Тогда
		Условия.Добавить("К.ПометкаУдаления");
	ИначеЕсли ЭтотОбъект["ОтборПометка"] = "Не помеченные на удаление" Тогда
		Условия.Добавить("НЕ К.ПометкаУдаления");
	КонецЕсли;

	ТекстУсловий = "";
	Для Каждого Условие Из Условия Цикл
		ТекстУсловий = ТекстУсловий + ?(ТекстУсловий = "", "ГДЕ" + Символы.ПС + "	", Символы.ПС + "	И ") + Условие;
	КонецЦикла;

	УсловиеСФ = "";
	Если ЭтотОбъект["ОтборСФ"] = "Есть счет-фактура" Тогда
		УсловиеСФ = "ГДЕ ЕСТЬNULL(КоличествоСФ.Количество, 0) > 0";
	ИначеЕсли ЭтотОбъект["ОтборСФ"] = "Нет счета-фактуры" Тогда
		УсловиеСФ = "ГДЕ ЕСТЬNULL(КоличествоСФ.Количество, 0) = 0";
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТКорр
	|ИЗ
	|	Документ.КорректировкаРеализации КАК К
	|" + ТекстУсловий + "
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Связи.Корр КАК Корр,
	|	Связи.СФ КАК СФ
	|ПОМЕСТИТЬ ВТСвязи
	|ИЗ
	|	(ВЫБРАТЬ
	|		Основания.ДокументОснование КАК Корр,
	|		Основания.Ссылка КАК СФ
	|	ИЗ
	|		Документ.СчетФактураВыданный.ДокументыОснования КАК Основания
	|	ГДЕ
	|		Основания.ДокументОснование В
	|				(ВЫБРАТЬ
	|					ВТКорр.Ссылка
	|				ИЗ
	|					ВТКорр)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		СФ.ДокументОснование,
	|		СФ.Ссылка
	|	ИЗ
	|		Документ.СчетФактураВыданный КАК СФ
	|	ГДЕ
	|		СФ.ДокументОснование В
	|				(ВЫБРАТЬ
	|					ВТКорр.Ссылка
	|				ИЗ
	|					ВТКорр)) КАК Связи
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Корр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ " + Формат(?(ЭтотОбъект["МаксимумСтрок"] > 0, ЭтотОбъект["МаксимумСтрок"], 1000000), "ЧГ=") + "
	|	К.Ссылка КАК Корректировка,
	|	К.Дата КАК Дата,
	|	К.Номер КАК Номер,
	|	К.Организация КАК Организация,
	|	К.Контрагент КАК Контрагент,
	|	К.Контрагент.ИНН КАК ИНН,
	|	К.ДоговорКонтрагента КАК Договор,
	|	К.СуммаДокумента КАК Сумма,
	|	К.Проведен КАК Проведен,
	|	К.ПометкаУдаления КАК ПометкаУдаления,
	|	ВЫРАЗИТЬ(К.Комментарий КАК СТРОКА(300)) КАК Комментарий,
	|	ЕСТЬNULL(КоличествоСФ.Количество, 0) КАК КоличествоСФ
	|ИЗ
	|	ВТКорр КАК ВТКорр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК К
	|		ПО ВТКорр.Ссылка = К.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТСвязи.Корр КАК Корр,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТСвязи.СФ) КАК Количество
	|		ИЗ
	|			ВТСвязи КАК ВТСвязи
	|		СГРУППИРОВАТЬ ПО
	|			ВТСвязи.Корр) КАК КоличествоСФ
	|		ПО ВТКорр.Ссылка = КоличествоСФ.Корр
	|" + УсловиеСФ + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Корректировка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСвязи.Корр КАК Корр,
	|	ВТСвязи.СФ КАК СФ,
	|	ВТСвязи.СФ.Номер КАК Номер,
	|	ВТСвязи.СФ.Дата КАК Дата,
	|	ВТСвязи.СФ.ВидСчетаФактуры КАК Вид
	|ИЗ
	|	ВТСвязи КАК ВТСвязи
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[2].Выбрать();
	ВыборкаСФ = Пакет[3].Выбрать();

	ПредставленияСФ = Новый Соответствие;
	Пока ВыборкаСФ.Следующий() Цикл
		Текст = ПредставленияСФ.Получить(ВыборкаСФ.Корр);
		Представление = СокрЛП(ВыборкаСФ.Номер) + " от " + Формат(ВыборкаСФ.Дата, "ДФ=dd.MM.yyyy")
			+ ?(ВыборкаСФ.Вид = Перечисления.ВидСчетаФактурыВыставленного.Корректировочный, "", " (" + ВыборкаСФ.Вид + ")");
		ПредставленияСФ.Вставить(ВыборкаСФ.Корр, ?(Текст = Неопределено, "", Текст + "; ") + Представление);
	КонецЦикла;

	Таблица = ЭтотОбъект["Документы"];
	Таблица.Очистить();
	Пока Выборка.Следующий() Цикл
		Строка = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.СчетаФактуры = ПредставленияСФ.Получить(Выборка.Корректировка);
	КонецЦикла;

	ОбновитьИтог(ЭтотОбъект);

	Возврат Таблица.Количество();

КонецФункции

&НаСервере
Процедура ДобавитьУсловиеПоЗначению(Запрос, Условия, Поле, ИмяПараметра, Значение)

	Если ЗначениеЗаполнено(Значение) Тогда
		Условия.Добавить(Поле + " = &" + ИмяПараметра);
		Запрос.УстановитьПараметр(ИмяПараметра, Значение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЭкранироватьПодобно(Знач Текст)

	Для Каждого Символ Из СтрРазделить("~,%,_,[,]", ",") Цикл
		Текст = СтрЗаменить(Текст, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Удаляет пакет корректировок вместе с их счетами-фактурами.
// Возвращает Соответствие: Корректировка -> Структура(Удален, Текст).
&НаСервереБезКонтекста
Функция УдалитьПакетНаСервере(Знач Корректировки, Знач НастройкиУдаления)

	Результаты = Новый Соответствие;

	// Счета-фактуры каждой корректировки и прочие основания этих счетов-фактур
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Корректировки", Корректировки);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Связи.Корр КАК Корр,
	|	Связи.СФ КАК СФ
	|ПОМЕСТИТЬ ВТСвязи
	|ИЗ
	|	(ВЫБРАТЬ
	|		Основания.ДокументОснование КАК Корр,
	|		Основания.Ссылка КАК СФ
	|	ИЗ
	|		Документ.СчетФактураВыданный.ДокументыОснования КАК Основания
	|	ГДЕ
	|		Основания.ДокументОснование В (&Корректировки)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		СФ.ДокументОснование,
	|		СФ.Ссылка
	|	ИЗ
	|		Документ.СчетФактураВыданный КАК СФ
	|	ГДЕ
	|		СФ.ДокументОснование В (&Корректировки)) КАК Связи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСвязи.Корр КАК Корр,
	|	ВТСвязи.СФ КАК СФ,
	|	ВТСвязи.СФ.Номер КАК Номер,
	|	ВТСвязи.СФ.Дата КАК Дата,
	|	ЕСТЬNULL(ЧужиеОснования.Количество, 0) КАК ЧужихОснований
	|ИЗ
	|	ВТСвязи КАК ВТСвязи
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Основания.СФ КАК СФ,
	|			Основания.Корр КАК Корр,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Прочие.ДокументОснование) КАК Количество
	|		ИЗ
	|			ВТСвязи КАК Основания
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК Прочие
	|				ПО Основания.СФ = Прочие.Ссылка
	|					И Основания.Корр <> Прочие.ДокументОснование
	|		СГРУППИРОВАТЬ ПО
	|			Основания.СФ,
	|			Основания.Корр) КАК ЧужиеОснования
	|		ПО ВТСвязи.СФ = ЧужиеОснования.СФ
	|			И ВТСвязи.Корр = ЧужиеОснования.Корр";

	СФКорректировок = Новый Соответствие;
	ОшибкиСводных = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = СФКорректировок.Получить(Выборка.Корр);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			СФКорректировок.Вставить(Выборка.Корр, Список);
		КонецЕсли;
		Список.Добавить(Выборка.СФ);
		Если Выборка.ЧужихОснований > 0 Тогда
			ОшибкиСводных.Вставить(Выборка.Корр, "Не удалено: счет-фактура " + СокрЛП(Выборка.Номер) + " от "
				+ Формат(Выборка.Дата, "ДФ=dd.MM.yyyy") + " оформлен и на другие документы (сводный).");
		КонецЕсли;
	КонецЦикла;

	// Владелец каждого удаляемого документа (корректировка, к которой он относится)
	Владельцы = Новый Соответствие;
	ВсеДокументы = Новый Массив;
	Для Каждого Корр Из Корректировки Цикл
		Если ОшибкиСводных.Получить(Корр) <> Неопределено Тогда
			Результаты.Вставить(Корр, Новый Структура("Удален, Текст", Ложь, ОшибкиСводных.Получить(Корр)));
			Продолжить;
		КонецЕсли;
		Владельцы.Вставить(Корр, Корр);
		ВсеДокументы.Добавить(Корр);
		СписокСФ = СФКорректировок.Получить(Корр);
		Если СписокСФ <> Неопределено Тогда
			Для Каждого СФ Из СписокСФ Цикл
				Владельцы.Вставить(СФ, Корр);
				ВсеДокументы.Добавить(СФ);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	// Поиск ссылок на удаляемые документы
	ЗаписиРегистров = Новый Соответствие; // Корр -> Массив Структура(Метаданные, Ключ)
	ВнешниеСсылки = Новый Соответствие;   // Корр -> Массив строк
	Если НастройкиУдаления.ПроверятьСсылки И ВсеДокументы.Количество() > 0 Тогда
		НайденныеСсылки = НайтиПоСсылкам(ВсеДокументы);
		Для Каждого Найденная Из НайденныеСсылки Цикл
			Корр = Владельцы.Получить(Найденная.Ссылка);
			Если Корр = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Данные = Найденная.Данные;
			ДокументДанных = ДокументИзДанных(Данные);
			Если ДокументДанных <> Неопределено И Владельцы.Получить(ДокументДанных) <> Неопределено Тогда
				Продолжить; // движения удаляемых документов и их ссылки друг на друга
			КонецЕсли;
			Если НастройкиУдаления.УдалятьЗаписиРегистров И Метаданные.РегистрыСведений.Содержит(Найденная.Метаданные)
				И Не ЭтоСсылкаНаОбъект(ТипЗнч(Данные)) Тогда
				ДобавитьВСписок(ЗаписиРегистров, Корр, Новый Структура("Метаданные, Ключ", Найденная.Метаданные, Данные));
				Продолжить;
			КонецЕсли;
			ДобавитьВСписок(ВнешниеСсылки, Корр, Найденная.Метаданные.Представление() + ": " + Строка(Данные));
		КонецЦикла;
	КонецЕсли;

	// Удаление
	Для Каждого Корр Из Корректировки Цикл

		Если Результаты.Получить(Корр) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Ссылки = ВнешниеСсылки.Получить(Корр);
		ТекстСсылок = "";
		Если Ссылки <> Неопределено Тогда
			Для Индекс = 0 По Мин(Ссылки.ВГраница(), 4) Цикл
				ТекстСсылок = ТекстСсылок + ?(ТекстСсылок = "", "", "; ") + Ссылки[Индекс];
			КонецЦикла;
			Если Ссылки.Количество() > 5 Тогда
				ТекстСсылок = ТекстСсылок + " и еще " + (Ссылки.Количество() - 5);
			КонецЕсли;
			Если Не НастройкиУдаления.УдалятьПриНаличииСсылок Тогда
				Результаты.Вставить(Корр, Новый Структура("Удален, Текст", Ложь, "Не удалено, есть ссылки: " + ТекстСсылок));
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		СписокСФ = СФКорректировок.Получить(Корр);
		Если СписокСФ = Неопределено Тогда
			СписокСФ = Новый Массив;
		КонецЕсли;
		Записи = ЗаписиРегистров.Получить(Корр);
		Если Записи = Неопределено Тогда
			Записи = Новый Массив;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка
			Для Каждого Запись Из Записи Цикл
				УдалитьЗаписьРегистраСведений(Запись.Метаданные, Запись.Ключ);
			КонецЦикла;
			Для Каждого СФ Из СписокСФ Цикл
				УдалитьДокумент(СФ);
			КонецЦикла;
			УдалитьДокумент(Корр);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Результаты.Вставить(Корр, Новый Структура("Удален, Текст", Ложь,
				"Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Продолжить;
		КонецПопытки;

		Текст = "Удалено" + ?(СписокСФ.Количество() > 0, ", счетов-фактур: " + СписокСФ.Количество(), ", без СФ")
			+ ?(Записи.Количество() > 0, ", записей регистров: " + Записи.Количество(), "")
			+ ?(ТекстСсылок <> "", ". Остались ссылки: " + ТекстСсылок, "");
		Результаты.Вставить(Корр, Новый Структура("Удален, Текст", Истина, Текст));

		ЗаписьЖурналаРегистрации("УдалениеКорректировокРеализации", УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.КорректировкаРеализации, , "Удалена корректировка " + Строка(Корр) + ". " + Текст);

	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Ссылка на документ-владелец найденных данных: сама ссылка или регистратор записи регистра.
&НаСервереБезКонтекста
Функция ДокументИзДанных(Данные)

	Если ЭтоСсылкаНаОбъект(ТипЗнч(Данные)) Тогда
		Возврат Данные;
	КонецЕсли;
	Попытка
		Возврат Данные.Регистратор;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьВСписок(Соответствие, Ключ, Значение)

	Список = Соответствие.Получить(Ключ);
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Соответствие.Вставить(Ключ, Список);
	КонецЕсли;
	Список.Добавить(Значение);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьЗаписьРегистраСведений(МетаданныеРегистра, Ключ)

	МенеджерЗаписи = РегистрыСведений[МетаданныеРегистра.Имя].СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Ключ);
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Удалить();
	КонецЕсли;

КонецПроцедуры

// Физическое удаление документа с очисткой всех его движений. Обработчики объекта не выполняются (режим загрузки).
&НаСервереБезКонтекста
Процедура УдалитьДокумент(Ссылка)

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Тогда
		Возврат; // уже удален
	КонецЕсли;

	Для Каждого НаборЗаписей Из ДокументОбъект.Движения Цикл
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать(Истина); // пустой набор с отбором по регистратору — очищает движения
	КонецЦикла;

	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Удалить();

КонецПроцедуры

// Истина, если тип — ссылка на объект (справочник, документ, ПВХ, план счетов и т. п.), а не ключ записи регистра.
&НаСервереБезКонтекста
Функция ЭтоСсылкаНаОбъект(ПроверяемыйТип)

	Если ПроверяемыйТип = Тип("Неопределено") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или Документы.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
