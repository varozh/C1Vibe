// Удаление документов «Корректировка реализации» вместе со связанными «Счет-фактура выданный»
// (корректировочными и исправительными) — 1С:Бухгалтерия предприятия 3.0.
//
// Документы удаляются НАПРЯМУЮ (не пометкой), вместе с движениями. Отменить нельзя — перед запуском сделайте копию базы.
//
// Связь «корректировка → счет-фактура»: табличная часть «Документы-основания» счета-фактуры
// или реквизит шапки «Документ-основание».
//
// Перед удалением (если включено «Проверять ссылки») выполняется поиск ссылок на корректировку и ее счета-фактуры:
//  - движения самих документов и ссылки корректировки и СФ друг на друга не мешают удалению;
//  - записи независимых регистров сведений (статусы ЭДО, оригиналы документов и т. п.) удаляются вместе с документом,
//    если включено «Удалять записи регистров сведений»;
//  - ссылки из других документов и справочников блокируют удаление, если не включено «Удалять, даже если есть ссылки».
// Каждая пара «корректировка + ее СФ» удаляется в своей транзакции.
//
// Реквизиты и элементы формы создаются программно в ПриСозданииНаСервере, поэтому обращение к ним — через ЭтотОбъект["Имя"].

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не РольДоступна("ПолныеПрава") Тогда
		ВызватьИсключение "Обработку может запускать только пользователь с ролью «Полные права».";
	КонецЕсли;

	СоздатьРеквизиты();
	СоздатьКоманды();
	СоздатьЭлементы();

	ЭтотОбъект["ПериодНачало"] = НачалоМесяца(ТекущаяДатаСеанса());
	ЭтотОбъект["ПериодКонец"] = КонецМесяца(ТекущаяДатаСеанса());
	ЭтотОбъект["ОтборПроведен"] = "Все";
	ЭтотОбъект["ОтборПометка"] = "Все";
	ЭтотОбъект["ОтборСФ"] = "Все";
	ЭтотОбъект["МаксимумСтрок"] = 5000;
	ЭтотОбъект["РазмерПакета"] = 50;
	ЭтотОбъект["ПроверятьСсылки"] = Истина;
	ЭтотОбъект["УдалятьЗаписиРегистров"] = Истина;
	ЭтотОбъект["УдалятьПриНаличииСсылок"] = Ложь;
	ЭтотОбъект["ОтборКонтрагенты"].ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");

	ОбновитьИтог(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СозданиеФормы

&НаСервере
Процедура СоздатьРеквизиты()

	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0));
	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ТипДатаВремя = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипЦелое = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0));
	ТипСумма = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));

	Реквизиты = Новый Массив;

	// Отборы
	Реквизиты.Добавить(Новый РеквизитФормы("ПериодНачало", ТипДата, , "Период с"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПериодКонец", ТипДата, , "по"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборОрганизация",
		Новый ОписаниеТипов("СправочникСсылка.Организации"), , "Организация"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборКонтрагенты",
		Новый ОписаниеТипов("СписокЗначений"), , "Контрагенты"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборИНН", ТипСтрока, , "ИНН контрагентов"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборДоговор",
		Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"), , "Договор"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборСклад",
		Новый ОписаниеТипов("СправочникСсылка.Склады"), , "Склад"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборВидОперации",
		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийИсправленияПоступленияРеализации"), , "Вид операции"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборОтветственный",
		Новый ОписаниеТипов("СправочникСсылка.Пользователи"), , "Ответственный"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборНомер", ТипСтрока, , "Номер содержит"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборКомментарий", ТипСтрока, , "Комментарий содержит"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборПроведен", ТипСтрока, , "Проведение"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборПометка", ТипСтрока, , "Пометка удаления"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборСФ", ТипСтрока, , "Счет-фактура"));
	Реквизиты.Добавить(Новый РеквизитФормы("МаксимумСтрок", ТипЦелое, , "Не более строк"));

	// Параметры удаления
	Реквизиты.Добавить(Новый РеквизитФормы("ПроверятьСсылки", ТипБулево, , "Проверять ссылки перед удалением"));
	Реквизиты.Добавить(Новый РеквизитФормы("УдалятьЗаписиРегистров", ТипБулево, ,
		"Удалять записи регистров сведений, ссылающиеся на документы"));
	Реквизиты.Добавить(Новый РеквизитФормы("УдалятьПриНаличииСсылок", ТипБулево, ,
		"Удалять, даже если на документы ссылаются другие объекты"));
	Реквизиты.Добавить(Новый РеквизитФормы("РазмерПакета", ТипЦелое, , "Документов в пакете"));
	Реквизиты.Добавить(Новый РеквизитФормы("Итог", ТипСтрока, , "Итог"));

	// Таблица документов
	Реквизиты.Добавить(Новый РеквизитФормы("Документы", Новый ОписаниеТипов("ТаблицаЗначений"), , "Документы"));
	Т = "Документы";
	Реквизиты.Добавить(Новый РеквизитФормы("Пометка", ТипБулево, Т, "Удалить"));
	Реквизиты.Добавить(Новый РеквизитФормы("Корректировка",
		Новый ОписаниеТипов("ДокументСсылка.КорректировкаРеализации"), Т, "Корректировка реализации"));
	Реквизиты.Добавить(Новый РеквизитФормы("Дата", ТипДатаВремя, Т, "Дата"));
	Реквизиты.Добавить(Новый РеквизитФормы("Номер", ТипСтрока, Т, "Номер"));
	Реквизиты.Добавить(Новый РеквизитФормы("Организация",
		Новый ОписаниеТипов("СправочникСсылка.Организации"), Т, "Организация"));
	Реквизиты.Добавить(Новый РеквизитФормы("Контрагент",
		Новый ОписаниеТипов("СправочникСсылка.Контрагенты"), Т, "Контрагент"));
	Реквизиты.Добавить(Новый РеквизитФормы("ИНН", ТипСтрока, Т, "ИНН"));
	Реквизиты.Добавить(Новый РеквизитФормы("Договор",
		Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"), Т, "Договор"));
	Реквизиты.Добавить(Новый РеквизитФормы("Сумма", ТипСумма, Т, "Сумма"));
	Реквизиты.Добавить(Новый РеквизитФормы("Проведен", ТипБулево, Т, "Проведен"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПометкаУдаления", ТипБулево, Т, "Помечен на удаление"));
	Реквизиты.Добавить(Новый РеквизитФормы("КоличествоСФ", ТипЦелое, Т, "Кол-во СФ"));
	Реквизиты.Добавить(Новый РеквизитФормы("СчетаФактуры", ТипСтрока, Т, "Счета-фактуры выданные"));
	Реквизиты.Добавить(Новый РеквизитФормы("Комментарий", ТипСтрока, Т, "Комментарий"));
	Реквизиты.Добавить(Новый РеквизитФормы("Удален", ТипБулево, Т, "Удален"));
	Реквизиты.Добавить(Новый РеквизитФормы("Результат", ТипСтрока, Т, "Результат"));

	ИзменитьРеквизиты(Реквизиты);

КонецПроцедуры

&НаСервере
Процедура СоздатьКоманды()

	ДобавитьКоманду("Заполнить", "Заполнить", "Подобрать корректировки реализации по отборам", "Обновить");
	ДобавитьКоманду("УдалитьОтмеченные", "Удалить отмеченные",
		"Безвозвратно удалить отмеченные корректировки реализации и их счета-фактуры", "Удалить,УдалитьНепосредственно");
	ДобавитьКоманду("ОтметитьВсе", "Отметить все", "Отметить все строки (или выделенные)",
		"УстановитьФлажки,ОтметитьВсе,ОтметитьВсеФлажки");
	ДобавитьКоманду("СнятьВсе", "Снять все", "Снять отметку со всех строк (или выделенных)",
		"СнятьФлажки,СнятьОтметкуСоВсех,СнятьВсеФлажки");
	ДобавитьКоманду("ОчиститьОтборы", "Очистить отборы", "Сбросить все отборы", "");

КонецПроцедуры

// Картинка из библиотеки по первому найденному имени; если ни одной нет — Неопределено.
&НаСервере
Функция КартинкаПоИмени(ИменаКартинок)

	Для Каждого ИмяКартинки Из СтрРазделить(ИменаКартинок, ",", Ложь) Цикл
		Попытка
			Возврат БиблиотекаКартинок[СокрЛП(ИмяКартинки)];
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура ДобавитьКоманду(Имя, Заголовок, Подсказка, ИменаКартинок)

	Команда = Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Подсказка = Подсказка;
	Команда.Действие = Имя;
	Картинка = КартинкаПоИмени(ИменаКартинок);
	Если Картинка <> Неопределено Тогда
		Команда.Картинка = Картинка;
		Команда.Отображение = ОтображениеКнопки.КартинкаИТекст;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементы()

	// Командная панель формы
	Панель = Элементы.ФормаКоманднаяПанель;
	Кнопка = ДобавитьКнопку("ФормаЗаполнить", "Заполнить", Панель);
	Кнопка.КнопкаПоУмолчанию = Истина;
	ДобавитьКнопку("ФормаУдалитьОтмеченные", "УдалитьОтмеченные", Панель);
	ДобавитьКнопку("ФормаОчиститьОтборы", "ОчиститьОтборы", Панель);

	// Отборы: две колонки
	ГруппаОтборы = ДобавитьГруппу("ГруппаОтборы", "Отбор корректировок реализации", Элементы,
		ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная, Истина);
	Колонка1 = ДобавитьГруппу("ГруппаОтборыКолонка1", "", ГруппаОтборы, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	Колонка2 = ДобавитьГруппу("ГруппаОтборыКолонка2", "", ГруппаОтборы, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);

	ГруппаПериод = ДобавитьГруппу("ГруппаПериод", "", Колонка1, ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная);
	ДобавитьПоле("ПериодНачало", ГруппаПериод);
	ДобавитьПоле("ПериодКонец", ГруппаПериод);
	ДобавитьПоле("ОтборОрганизация", Колонка1);
	Поле = ДобавитьПоле("ОтборКонтрагенты", Колонка1);
	Поле.Подсказка = "Список контрагентов. Пустой — все контрагенты.";
	Поле = ДобавитьПоле("ОтборИНН", Колонка1);
	Поле.Подсказка = "Один или несколько ИНН через запятую, пробел или точку с запятой.";
	Поле = ДобавитьПоле("ОтборДоговор", Колонка1);
	Связи = Новый Массив;
	Связи.Добавить(Новый СвязьПараметраВыбора("Отбор.Организация", "ОтборОрганизация",
		РежимИзмененияСвязанногоЗначения.НеИзменять));
	Поле.СвязиПараметровВыбора = Новый ФиксированныйМассив(Связи);
	ДобавитьПоле("ОтборСклад", Колонка1);
	ДобавитьПоле("ОтборВидОперации", Колонка1);

	ДобавитьПоле("ОтборОтветственный", Колонка2);
	ДобавитьПоле("ОтборНомер", Колонка2);
	ДобавитьПоле("ОтборКомментарий", Колонка2);
	ДобавитьПолеСписка("ОтборПроведен", Колонка2, "Все,Проведенные,Непроведенные");
	ДобавитьПолеСписка("ОтборПометка", Колонка2, "Все,Помеченные на удаление,Не помеченные на удаление");
	ДобавитьПолеСписка("ОтборСФ", Колонка2, "Все,Есть счет-фактура,Нет счета-фактуры");
	ДобавитьПоле("МаксимумСтрок", Колонка2);

	// Параметры удаления
	ГруппаПараметры = ДобавитьГруппу("ГруппаПараметры", "Параметры удаления", Элементы,
		ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная, Истина);
	Колонка3 = ДобавитьГруппу("ГруппаПараметрыКолонка1", "", ГруппаПараметры, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	Колонка4 = ДобавитьГруппу("ГруппаПараметрыКолонка2", "", ГруппаПараметры, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	ДобавитьФлажок("ПроверятьСсылки", Колонка3);
	ДобавитьФлажок("УдалятьЗаписиРегистров", Колонка3);
	ДобавитьФлажок("УдалятьПриНаличииСсылок", Колонка4);
	Поле = ДобавитьПоле("РазмерПакета", Колонка4);
	Поле.Подсказка = "Сколько корректировок обрабатывать за один вызов сервера (поиск ссылок выполняется на весь пакет сразу).";

	// Таблица
	Таблица = Элементы.Добавить("Документы", Тип("ТаблицаФормы"));
	Таблица.ПутьКДанным = "Документы";
	Таблица.ИзменятьСоставСтрок = Ложь;
	Таблица.ИзменятьПорядокСтрок = Ложь;
	Таблица.РежимВыделения = РежимВыделенияТаблицы.Множественный;
	Таблица.УстановитьДействие("Выбор", "ДокументыВыбор");
	ДобавитьКнопку("ДокументыОтметитьВсе", "ОтметитьВсе", Таблица.КоманднаяПанель);
	ДобавитьКнопку("ДокументыСнятьВсе", "СнятьВсе", Таблица.КоманднаяПанель);

	Флажок = Элементы.Добавить("ДокументыПометка", Тип("ПолеФормы"), Таблица);
	Флажок.Вид = ВидПоляФормы.ПолеФлажка;
	Флажок.ПутьКДанным = "Документы.Пометка";
	Флажок.УстановитьДействие("ПриИзменении", "ДокументыПометкаПриИзменении");

	Для Каждого ИмяКолонки Из СтрРазделить(
		"Корректировка,Дата,Номер,Организация,Контрагент,ИНН,Договор,Сумма,Проведен,ПометкаУдаления,КоличествоСФ,СчетаФактуры,Комментарий,Результат", ",") Цикл
		Колонка = Элементы.Добавить("Документы" + ИмяКолонки, Тип("ПолеФормы"), Таблица);
		Если ИмяКолонки = "Проведен" Или ИмяКолонки = "ПометкаУдаления" Тогда
			Колонка.Вид = ВидПоляФормы.ПолеФлажка;
		Иначе
			Колонка.Вид = ВидПоляФормы.ПолеВвода;
		КонецЕсли;
		Колонка.ПутьКДанным = "Документы." + ИмяКолонки;
		Колонка.ТолькоПросмотр = Истина;
	КонецЦикла;
	Элементы.ДокументыКорректировка.Видимость = Ложь; // документ открывается двойным щелчком по строке
	Элементы.ДокументыСчетаФактуры.Ширина = 30;
	Элементы.ДокументыРезультат.Ширина = 40;

	// Удаленные строки — серым
	Оформление = УсловноеОформление.Элементы.Добавить();
	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Документы.Удален");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	ПолеОформления = Оформление.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("Документы");

	Надпись = Элементы.Добавить("Итог", Тип("ПолеФормы"));
	Надпись.Вид = ВидПоляФормы.ПолеНадписи;
	Надпись.ПутьКДанным = "Итог";
	Надпись.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;

КонецПроцедуры

&НаСервере
Функция ДобавитьГруппу(Имя, Заголовок, Родитель, Группировка, ПоказыватьЗаголовок = Ложь)

	Если Родитель = Элементы Тогда
		Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"));
	Иначе
		Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	КонецЕсли;
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = Заголовок;
	Группа.ОтображатьЗаголовок = ПоказыватьЗаголовок;
	Группа.Группировка = Группировка;
	Если Не ПоказыватьЗаголовок Тогда
		Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	КонецЕсли;
	Возврат Группа;

КонецФункции

&НаСервере
