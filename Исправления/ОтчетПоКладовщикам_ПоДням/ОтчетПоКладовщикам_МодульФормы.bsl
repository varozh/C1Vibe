Процедура ПриОткрытии()

	ПараметрСклады = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Склады");

	Если ПараметрСклады.Значение.Количество() = 0 Тогда

		Склады = Новый СписокЗначений;
		Склады.Добавить(Справочники.Склады.НайтиПоКоду("УТ0000358")); // Вторичный сбыт склад
		Склады.Добавить(Справочники.Склады.НайтиПоКоду("УТ0000389")); // Главный розничный склад
		Склады.Добавить(Справочники.Склады.НайтиПоКоду("УТ0000090")); // Оптовый склад хранения

		ПараметрСклады.Значение = Склады;

	КонецЕсли;

	Ответственные = Справочники.Пользователи.НайтиПоКоду("SKLAD");

	КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Ответственные").Значение = Ответственные;

КонецПроцедуры

Процедура ДействияФормыСформировать(Кнопка)

	ЭлементыФормы.Результат.Очистить();

	// В обычном режиме запрос не делит строки по дням (поле «День» пустое) — отчет такой же, как раньше.
	СхемаКомпоновкиДанных.Параметры.Найти("ПоДням").Значение = ПоДням;

	НастройкиКомпоновкиДанных = КомпоновщикНастроек.ПолучитьНастройки();

	Если ПоДням Тогда
		НастроитьВыводПоДням(НастройкиКомпоновкиДанных);
	КонецЕсли;

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Ложь);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ЭлементыФормы.Результат);
	ПроцессорВывода.НачатьВывод();
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	ПроцессорВывода.ЗакончитьВывод();

КонецПроцедуры

// Флажок «По дням»: таблица, в строках ответственный и склад, в колонках дни периода
// (принятые и собранные за каждый день). Итог за период — первой и последней колонкой, дни между ними.
Процедура НастроитьВыводПоДням(Настройки)

	Настройки.Выбор.Элементы.Очистить();
	ДобавитьВыбранноеПоле(Настройки.Выбор, "КоличествоПриход");
	ДобавитьВыбранноеПоле(Настройки.Выбор, "КоличествоРасход");

	Настройки.Структура.Очистить();
	Таблица = Настройки.Структура.Добавить(Тип("ТаблицаКомпоновкиДанных"));
	Таблица.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Таблица.ПараметрыВывода.УстановитьЗначениеПараметра("ГоризонтальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.НачалоИКонец);

	Строки = ДобавитьГруппировку(Таблица.Строки, "Ответственный");
	ДобавитьГруппировку(Строки.Структура, "Склад");

	Колонки = ДобавитьГруппировку(Таблица.Колонки, "День");
	Если ЗначениеЗаполнено(ДатаНач) И ЗначениеЗаполнено(ДатаКон) Тогда
		// Колонки на все дни периода, в том числе дни без движений.
		ПолеДня = Колонки.ПоляГруппировки.Элементы[0];
		ПолеДня.ТипДополнения = ТипДополненияПериодаКомпоновкиДанных.День;
		ПолеДня.НачалоПериода = НачалоДня(ДатаНач);
		ПолеДня.КонецПериода  = НачалоДня(ДатаКон);
	КонецЕсли;
	Колонки.Порядок.Элементы.Очистить();
	ЭлементПорядка = Колонки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("День");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	ЭлементПорядка.Использование = Истина;

КонецПроцедуры

Процедура ДобавитьВыбранноеПоле(Выбор, ИмяПоля)

	ВыбранноеПоле = Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ВыбранноеПоле.Использование = Истина;

КонецПроцедуры

Функция ДобавитьГруппировку(Коллекция, ИмяПоля)

	Группировка = Коллекция.Добавить();
	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ПолеГруппировки.Использование = Истина;
	Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Группировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));

	Возврат Группировка;

КонецФункции

Процедура ДатаНачПриИзменении(Элемент)

	КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ДатаНач").Значение = ДатаНач;

КонецПроцедуры

Процедура ДатаКонПриИзменении(Элемент)

	Если ЗначениеЗаполнено(ДатаКон) Тогда
		ДатаКон = КонецДня(ДатаКон);
	КонецЕсли;

	КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ДатаКон").Значение = ДатаКон;

КонецПроцедуры

Процедура ВыбратьПериодНажатие(Элемент)

	НастройкаПериода                          = Новый НастройкаПериода;
	НастройкаПериода.РедактироватьКакИнтервал = Ложь;
	НастройкаПериода.ВариантНастройки         = ВариантНастройкиПериода.Период;

	НастройкаПериода.УстановитьПериод(ДатаНач, ДатаКон);

	НастройкаПериода.Редактировать();

	ДатаНач = НастройкаПериода.ДатаНачала;
	ДатаКон = НастройкаПериода.ДатаОкончания;

	КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ДатаНач").Значение = ДатаНач;
	КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ДатаКон").Значение = ДатаКон;

КонецПроцедуры

Процедура ДействияФормыПланКладовщиков(Кнопка)

	РегистрыСведений.ПланКладовщиков.ПолучитьФорму("ФормаСписка").Открыть();

КонецПроцедуры
