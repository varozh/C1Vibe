Процедура НачатьСинхронизациюИерархии() Экспорт
	Подключение = МегаКаунтСтатистикаФТП.ПодключениеКФТП(МегаКаунтСтатистикаНастройки.ПолучитьПараметрПоИдентификатору("АдресФТП"), 
														Число(МегаКаунтСтатистикаНастройки.ПолучитьПараметрПоИдентификатору("ПортФТП")), 
														МегаКаунтСтатистикаНастройки.ПолучитьПараметрПоИдентификатору("ЛогинФТП"), 
														МегаКаунтСтатистикаНастройки.ПолучитьПараметрПоИдентификатору("ПарольФТП"));
	
	Если Подключение <> Ложь Тогда
		Организации = МегаКаунтСтатистикаФТП.ПолучитьСписокДиректорий(Подключение, Подключение.ТекущийКаталог());
		
		Для каждого Организация из Организации Цикл
			ОбработкаОрганизации(Подключение, Организация);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура НачатьСинхронизациюДанных(ЭлементСинхронизации, ДатаНачало = Ложь, ДатаКонец = Ложь) Экспорт
	ЭлементыСинхронизации = Новый Массив();
	
	Если ЭлементСинхронизации = Справочники.МегаКаунтСтатистикаИерархия.ПустаяСсылка() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	МегаКаунтСтатистикаИерархия.Родитель,
			|	МегаКаунтСтатистикаИерархия.Ссылка
			|ИЗ
			|	Справочник.МегаКаунтСтатистикаИерархия КАК МегаКаунтСтатистикаИерархия
			|ГДЕ
			|	МегаКаунтСтатистикаИерархия.Родитель = &Родитель
			|	И НЕ МегаКаунтСтатистикаИерархия.ПометкаУдаления";

		Запрос.УстановитьПараметр("Родитель", ЭлементСинхронизации);

		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ЭлементыСинхронизации.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		КонецЦикла;
	Иначе                          
		ЭлементыСинхронизации.Добавить(ЭлементСинхронизации);
	КонецЕсли;
	
	Если ДатаНачало <> Ложь Тогда
		Если ДатаКонец = Ложь Тогда
			ДатаНачало = НачалоДня(ДатаНачало);
			ДатаКонец = ДатаНачало
		Иначе
			ДатаНачало = НачалоДня(ДатаНачало);
			ДатаКонец = КонецДня(ДатаКонец);
		КонецЕсли;
	Иначе
		ДатаНачало = НачалоДня(ТекущаяДата() - 60 * 60 * 24 * МегаКаунтСтатистикаНастройки.ПолучитьПараметрПоИдентификатору("ДнейСинхронизации"));
		ДатаКонец = КонецДня(ТекущаяДата());
	КонецЕсли;
	
	Если ДатаКонец < ДатаНачало Тогда
		ДатаКонец = ДатаНачало;
	КонецЕсли;
	
	Подключение = МегаКаунтСтатистикаФТП.ПодключениеКФТП(МегаКаунтСтатистикаНастройки.ПолучитьПараметрПоИдентификатору("АдресФТП"), 
														Число(МегаКаунтСтатистикаНастройки.ПолучитьПараметрПоИдентификатору("ПортФТП")), 
														МегаКаунтСтатистикаНастройки.ПолучитьПараметрПоИдентификатору("ЛогинФТП"), 
														МегаКаунтСтатистикаНастройки.ПолучитьПараметрПоИдентификатору("ПарольФТП"));
	
	Для Счетчик = 0 По ЭлементыСинхронизации.Количество() - 1 Цикл
		НачатьСинхронизациюДанных2(Подключение, ЭлементыСинхронизации[Счетчик], ДатаНачало, ДатаКонец);
	КонецЦикла;
КонецПроцедуры

Процедура НачатьСинхронизациюДанных2(Подключение, ЭлементСинхронизации, ДатаНачало, ДатаКонец)
	Если ЭлементСинхронизации.ЭтоГруппа Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	МегаКаунтСтатистикаИерархия.Ссылка
			|ИЗ
			|	Справочник.МегаКаунтСтатистикаИерархия КАК МегаКаунтСтатистикаИерархия
			|ГДЕ
			|	МегаКаунтСтатистикаИерархия.Родитель = &Родитель
			|	И НЕ МегаКаунтСтатистикаИерархия.ПометкаУдаления";

		Запрос.УстановитьПараметр("Родитель", ЭлементСинхронизации.Ссылка);

		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НачатьСинхронизациюДанных2(Подключение, ВыборкаДетальныеЗаписи.Ссылка, ДатаНачало, ДатаКонец);
		КонецЦикла;
	Иначе
		НаименованиеОрганизации = ЭлементСинхронизации.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Наименование2;
		НаименованиеСтраны = ЭлементСинхронизации.Родитель.Родитель.Родитель.Родитель.Родитель.Наименование2;
		НаименованиеРегиона = ЭлементСинхронизации.Родитель.Родитель.Родитель.Родитель.Наименование2;
		НаименованиеГорода = ЭлементСинхронизации.Родитель.Родитель.Родитель.Наименование2;
		НаименованиеОбъекта = ЭлементСинхронизации.Родитель.Родитель.Наименование2;
		НаименованиеСубъекта = ЭлементСинхронизации.Родитель.Наименование2;
		
		Путь = НаименованиеОрганизации + "/" + НаименованиеСтраны + "/" + НаименованиеРегиона;
		Путь = Путь + "/" + НаименованиеГорода + "/" + НаименованиеОбъекта + "/" + НаименованиеСубъекта;
		
		КоличествоДней = ДатаКонец - ДатаНачало;
		
		Если КоличествоДней <> 0 Тогда
			КоличествоДней = КоличествоДней / 86400;
		КонецЕсли;
		
		Для Счетчик = 0 По КоличествоДней Цикл
			ДатаПолучения = ДатаНачало + (Счетчик * 86400);
			//Сообщить(ДатаПолучения);
			
			ПолучитьИОбработатьДанныеПоУстройству(Подключение, Путь, ЭлементСинхронизации, ДатаПолучения);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

