Процедура СформироватьСтатистикуЗаЧасы(ЭлементСинхронизации, ТребуемаяДата, СтатистикаПоЧасамВход, СтатистикаПоЧасамВыход)
	ДатаСтатистикиОснова = НачалоДня(ТребуемаяДата);
	
	Для Счетчик = 0 По 23 Цикл
		Если СтатистикаПоЧасамВход.Свойство("h" + Строка(Счетчик)) Тогда
			ДатаСтатистики = ДатаСтатистикиОснова + (60 * 60 * Счетчик);
			
			ЗаписьСтатистики = Документы.МегаКаунтСтатистикаДанные.СоздатьДокумент();
			ЗаписьСтатистики.Дата = ДатаСтатистики;
			ЗаписьСтатистики.Период = Перечисления.МегаКаунтСтатистикаПериод.Час;
			ЗаписьСтатистики.Устройство = ЭлементСинхронизации.Ссылка;
			ЗаписьСтатистики.Вход = СтатистикаПоЧасамВход["h" + Строка(Счетчик)];
			ЗаписьСтатистики.Выход = СтатистикаПоЧасамВыход["h" + Строка(Счетчик)];
			ЗаписьСтатистики.Блокировка = Ложь;
				
			ЗаписьСтатистики.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура СформироватьСтатистикуЗаДень(ЭлементСинхронизации, ТребуемаяДата, СтатистикаПоЧасамВход, СтатистикаПоЧасамВыход)
	Вход = 0;
	Выход = 0;
	
	Для Счетчик = 0 По 24 Цикл
		Если СтатистикаПоЧасамВход.Свойство("h" + Строка(Счетчик)) Тогда
			Вход = Вход + СтатистикаПоЧасамВход["h" + Строка(Счетчик)];
			Выход = Выход + СтатистикаПоЧасамВыход["h" + Строка(Счетчик)];
		КонецЕсли;
	КонецЦикла;
	
	ЗаписьСтатистики = Документы.МегаКаунтСтатистикаДанные.СоздатьДокумент();
	ЗаписьСтатистики.Дата = НачалоДня(ТребуемаяДата);
	ЗаписьСтатистики.Период = Перечисления.МегаКаунтСтатистикаПериод.День;
	ЗаписьСтатистики.Устройство = ЭлементСинхронизации.Ссылка;
	ЗаписьСтатистики.Вход = Вход;
	ЗаписьСтатистики.Выход = Выход;
	ЗаписьСтатистики.Блокировка = Ложь;
		
	ЗаписьСтатистики.Записать();
КонецПроцедуры

Процедура СформироватьСтатистикуЗаМесяц(ЭлементСинхронизации, ТребуемаяДата)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МегаКаунтСтатистикаДанные.Ссылка
		|ИЗ
		|	Документ.МегаКаунтСтатистикаДанные КАК МегаКаунтСтатистикаДанные
		|ГДЕ
		|	МегаКаунтСтатистикаДанные.Устройство = &Устройство
		|	И МегаКаунтСтатистикаДанные.Период = &Период
		|	И МегаКаунтСтатистикаДанные.Дата >= &ДатаНачало
		|	И МегаКаунтСтатистикаДанные.Дата <= &ДатаКонец";

	

	Запрос.УстановитьПараметр("Период", Перечисления.МегаКаунтСтатистикаПериод.Месяц);
	Запрос.УстановитьПараметр("Устройство", ЭлементСинхронизации.Ссылка);
	Запрос.УстановитьПараметр("ДатаНачало", НачалоМесяца(ТребуемаяДата));
	Запрос.УстановитьПараметр("ДатаКонец", КонецМесяца(ТребуемаяДата));

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(МегаКаунтСтатистикаДанные.Вход) КАК Вход,
		|	СУММА(МегаКаунтСтатистикаДанные.Выход) КАК Выход
		|ИЗ
		|	Документ.МегаКаунтСтатистикаДанные КАК МегаКаунтСтатистикаДанные
		|ГДЕ
		|	МегаКаунтСтатистикаДанные.Устройство = &Устройство
		|	И МегаКаунтСтатистикаДанные.Период = &Период
		|	И МегаКаунтСтатистикаДанные.Дата >= &ДатаНачало
		|	И МегаКаунтСтатистикаДанные.Дата <= &ДатаКонец";

	Запрос.УстановитьПараметр("Период", Перечисления.МегаКаунтСтатистикаПериод.День);
	Запрос.УстановитьПараметр("Устройство", ЭлементСинхронизации.Ссылка);
	Запрос.УстановитьПараметр("ДатаНачало", НачалоМесяца(ТребуемаяДата));
	Запрос.УстановитьПараметр("ДатаКонец", КонецМесяца(ТребуемаяДата));

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаписьСтатистики = Документы.МегаКаунтСтатистикаДанные.СоздатьДокумент();
		ЗаписьСтатистики.Дата = НачалоМесяца(ТребуемаяДата);
		ЗаписьСтатистики.Период = Перечисления.МегаКаунтСтатистикаПериод.Месяц;
		ЗаписьСтатистики.Устройство = ЭлементСинхронизации.Ссылка;
		ЗаписьСтатистики.Вход = ВыборкаДетальныеЗаписи.Вход;
		ЗаписьСтатистики.Выход = ВыборкаДетальныеЗаписи.Выход;
		ЗаписьСтатистики.Блокировка = Ложь;
		
		ЗаписьСтатистики.Записать();
	КонецЦикла;
КонецПроцедуры

