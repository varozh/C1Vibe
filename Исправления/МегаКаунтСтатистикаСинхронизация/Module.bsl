Процедура ОбработкаОрганизации(Подключение, Организация)
	ФайлОрганизации = МегаКаунтСтатистикаФТП.ПолучитьСодержимоеФайла(Подключение, Организация.Путь + Организация.Имя + "/organization");
			
	Если ФайлОрганизации <> "" Тогда
		НазваниеОрганизации = ПолучитьНазваниеИзФайла(ФайлОрганизации);
		ГруппаОрганизации = ОбработатьУровеньИерархии(НазваниеОрганизации, Организация.Имя, Справочники.МегаКаунтСтатистикаИерархия.ПустаяСсылка(), Перечисления.МегаКаунтСтатистикаСтруктура.Компания);
		Страны = МегаКаунтСтатистикаФТП.ПолучитьСписокДиректорий(Подключение, Организация.Путь + Организация.Имя);
		
		Для Каждого Страна из Страны Цикл
			ОбработкаСтраны(Подключение, Страна, ГруппаОрганизации);
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

Процедура ОбработкаСтраны(Подключение, Страна, ГруппаОрганизации)
	ФайлСтраны = МегаКаунтСтатистикаФТП.ПолучитьСодержимоеФайла(Подключение, Страна.Путь + Страна.Имя + "/country");
	
	Если ФайлСтраны <> "" Тогда
		НазваниеСтраны = ПолучитьНазваниеИзФайла(ФайлСтраны);
		ГруппаСтраны = ОбработатьУровеньИерархии(НазваниеСтраны, Страна.Имя, ГруппаОрганизации, Перечисления.МегаКаунтСтатистикаСтруктура.Страна);
		Регионы = МегаКаунтСтатистикаФТП.ПолучитьСписокДиректорий(Подключение, Страна.Путь + Страна.Имя);
		
		Для Каждого Регион из Регионы Цикл
			ОбработкаРегиона(Подключение, Регион, ГруппаСтраны);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаРегиона(Подключение, Регион, ГруппаСтраны)
	ФайлРегиона = МегаКаунтСтатистикаФТП.ПолучитьСодержимоеФайла(Подключение, Регион.Путь + Регион.Имя + "/region");
	
	Если ФайлРегиона <> "" Тогда
		НазваниеРегиона = ПолучитьНазваниеИзФайла(ФайлРегиона);
		ГруппаРегиона = ОбработатьУровеньИерархии(НазваниеРегиона, Регион.Имя, ГруппаСтраны, Перечисления.МегаКаунтСтатистикаСтруктура.Регион);
		Города = МегаКаунтСтатистикаФТП.ПолучитьСписокДиректорий(Подключение, Регион.Путь + Регион.Имя);
		
		Для Каждого Город из Города Цикл
			ОбработкаГорода(Подключение, Город, ГруппаРегиона);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаГорода(Подключение, Город, ГруппаРегиона)
	ФайлГорода = МегаКаунтСтатистикаФТП.ПолучитьСодержимоеФайла(Подключение, Город.Путь + Город.Имя + "/city");
	
	Если ФайлГорода <> "" Тогда
		НазваниеГорода = ПолучитьНазваниеИзФайла(ФайлГорода);
		ГруппаГорода = ОбработатьУровеньИерархии(НазваниеГорода, Город.Имя, ГруппаРегиона, Перечисления.МегаКаунтСтатистикаСтруктура.Город);
		Объекты = МегаКаунтСтатистикаФТП.ПолучитьСписокДиректорий(Подключение, Город.Путь + Город.Имя);
		
		Для Каждого Объект из Объекты Цикл
			ОбработкаОбъекта(Подключение, Объект, ГруппаГорода);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаОбъекта(Подключение, Объект, ГруппаГорода)
	ФайлОбъекта = МегаКаунтСтатистикаФТП.ПолучитьСодержимоеФайла(Подключение, Объект.Путь + Объект.Имя + "/object");
	
	Если ФайлОбъекта <> "" Тогда
		НазваниеОбъекта = ПолучитьНазваниеИзФайла(ФайлОбъекта);
		ГруппаОбъекта = ОбработатьУровеньИерархии(НазваниеОбъекта, Объект.Имя, ГруппаГорода, Перечисления.МегаКаунтСтатистикаСтруктура.Объект);
		Субъекты = МегаКаунтСтатистикаФТП.ПолучитьСписокДиректорий(Подключение, Объект.Путь + Объект.Имя);
		
		Для Каждого Субъект из Субъекты Цикл
			ОбработкаСубъекта(Подключение, Субъект, ГруппаОбъекта);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаСубъекта(Подключение, Субъект, ГруппаОбъекта)
	ФайлСубъекта = МегаКаунтСтатистикаФТП.ПолучитьСодержимоеФайла(Подключение, Субъект.Путь + Субъект.Имя + "/subject");
	
	Если ФайлСубъекта <> "" Тогда
		НазваниеСубъекта = ПолучитьНазваниеИзФайла(ФайлСубъекта);
		ГруппаСубъекта = ОбработатьУровеньИерархии(НазваниеСубъекта, Субъект.Имя, ГруппаОбъекта, Перечисления.МегаКаунтСтатистикаСтруктура.Подобъект);
		
		Устройства = МегаКаунтСтатистикаФТП.ПолучитьСодержимоеФайла(Подключение, Субъект.Путь + Субъект.Имя + "/devices");
		ОбработкаУстройств(Подключение, Устройства, ГруппаСубъекта);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУстройств(Подключение, Устройства, ГруппаСубъекта)
	Если СтрДлина(Устройства) > 33 Тогда
		Устройства = Лев(Устройства, СтрДлина(Устройства) - 33);
		
		Для НомерСтроки = 1 по СтрЧислоСтрок(Устройства) Цикл
			Устройство = СтрПолучитьСтроку(Устройства, НомерСтроки);
			
			Если Устройство <> "" Тогда
				Разделитель = Найти(Устройство, " ");
				
				НомерУстройства = Лев(Устройство, Разделитель - 1);
				НаименованиеУстройства = Прав(Устройство, СтрДлина(Устройство) - СтрДлина(НомерУстройства)-1);
				
				ОбработкаУстройства(НомерУстройства, НаименованиеУстройства, ГруппаСубъекта, Перечисления.МегаКаунтСтатистикаСтруктура.Счетчик);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУстройства(НомерУстройства, НаименованиеУстройства, ГруппаСубъекта, УровеньИерархии)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МегаКаунтСтатистикаИерархия.НомерУстройства,
		|	МегаКаунтСтатистикаИерархия.Ссылка,
		|	МегаКаунтСтатистикаИерархия.Код,
		|	МегаКаунтСтатистикаИерархия.Наименование
		|ИЗ
		|	Справочник.МегаКаунтСтатистикаИерархия КАК МегаКаунтСтатистикаИерархия
		|ГДЕ
		|	МегаКаунтСтатистикаИерархия.НомерУстройства = &НомерУстройства
		|	И МегаКаунтСтатистикаИерархия.Родитель = &Родитель";

	Запрос.УстановитьПараметр("НомерУстройства", НомерУстройства);
	Запрос.УстановитьПараметр("Родитель", ГруппаСубъекта.Ссылка);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Обработано = Ложь;

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Обработано = Истина;
		Если ВыборкаДетальныеЗаписи.Наименование <> НаименованиеУстройства Тогда
			Устройство = Справочники.МегаКаунтСтатистикаИерархия.НайтиПоКоду(ВыборкаДетальныеЗаписи.Код);
			УстройствоОбъект = Устройство.ПолучитьОбъект();
			УстройствоОбъект.Наименование = НаименованиеУстройства;
			Попытка
				УстройствоОбъект.Записать();
			Исключение
				Сообщить("Не удалось записать устройство с наименованием """  + НаименованиеУстройства + """");
			КонецПопытки;
				
		КонецЕсли;
	КонецЦикла;
	
	Если Не Обработано Тогда
		Устройство = Справочники.МегаКаунтСтатистикаИерархия.СоздатьЭлемент();
		Устройство.НомерУстройства = НомерУстройства;
		Устройство.Наименование = НаименованиеУстройства;
		Устройство.Родитель = ГруппаСубъекта.Ссылка;
		Устройство.УровеньИерархии = УровеньИерархии;
		Устройство.Записать();
	КонецЕсли;
КонецПроцедуры

Функция ОбработатьУровеньИерархии(Наименование, Наименование2, ГруппаРодитель, УровеньИерархии)
	// Группа ищется по имени папки на FTP (Наименование2): оно не меняется. Отображаемое название из файла
	// может прийти пустым или «NoName» — раньше из-за поиска по нему создавалась вторая ветка структуры.
	// Помеченные на удаление группы берутся, только если других нет.
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	МегаКаунтСтатистикаИерархия.Ссылка,
	|	МегаКаунтСтатистикаИерархия.Наименование
	|ИЗ
	|	Справочник.МегаКаунтСтатистикаИерархия КАК МегаКаунтСтатистикаИерархия
	|ГДЕ
	|	МегаКаунтСтатистикаИерархия.Родитель = &Родитель
	|	И МегаКаунтСтатистикаИерархия.ЭтоГруппа
	|	И МегаКаунтСтатистикаИерархия.Наименование2 = &Наименование2
	|
	|УПОРЯДОЧИТЬ ПО
	|	МегаКаунтСтатистикаИерархия.ПометкаУдаления,
	|	МегаКаунтСтатистикаИерархия.Код");
		
	Запрос.УстановитьПараметр("Наименование2", Наименование2);
	Запрос.УстановитьПараметр("Родитель", ГруппаРодитель.Ссылка);
		
	ГруппаВыборка = Запрос.Выполнить().Выбрать();
	
	НазваниеЗадано = СокрЛП(Наименование) <> "" И СокрЛП(Наименование) <> "NoName";
		
	Если ГруппаВыборка.Следующий() Тогда
		Если НазваниеЗадано И ГруппаВыборка.Наименование <> Наименование Тогда
			ГруппаОбъект = ГруппаВыборка.Ссылка.ПолучитьОбъект();
			ГруппаОбъект.Наименование = Наименование;
			Попытка
				ГруппаОбъект.Записать();
			Исключение
				Сообщить("Не удалось переименовать группу """ + Наименование2 + """ в """ + Наименование + """");
			КонецПопытки;
		КонецЕсли;
		Возврат ГруппаВыборка.Ссылка;
	КонецЕсли;
		
	Группа = Справочники.МегаКаунтСтатистикаИерархия.СоздатьГруппу();
	Группа.Наименование = ?(НазваниеЗадано, Наименование, Наименование2);
	Группа.Наименование2 = Наименование2;
	Группа.Родитель = ГруппаРодитель.Ссылка;
	Группа.УровеньИерархии = УровеньИерархии;
	Группа.Записать();
	
	Возврат Группа.Ссылка;
КонецФункции

Функция ПолучитьНазваниеИзФайла(ФайлОрганизации)
	Если СтрДлина(ФайлОрганизации) > 33 Тогда
		НазваниеОрганизации = Лев(ФайлОрганизации, СтрДлина(ФайлОрганизации) - 33);
		Возврат НазваниеОрганизации;
	КонецЕсли;
	
	Возврат "";
КонецФункции

Функция ИзХСчислВЧисло(аф, Шаблон)
    аф = ВРег(аф); 
	ДлинаШаблона = СтрДлина(Шаблон);

    ДлинаСтроки = СтрДлина(аф);
    Результат = 0;

    Для ТекСимвол = 1 По ДлинаСтроки Цикл
        ОбрабатываемыйСимвол = Сред(аф, ТекСимвол,1);
        ПозицияВШаблоне = Найти(Шаблон, ОбрабатываемыйСимвол)-1;
        Результат = Результат * ДлинаШаблона + ПозицияВШаблоне;
    КонецЦикла;

    Возврат(Результат);

КонецФункции
