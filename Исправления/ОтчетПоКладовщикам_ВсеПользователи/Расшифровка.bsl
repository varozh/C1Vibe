// Расшифровка ячейки отчета — как в типовых отчетах УТ: открывается еще один экземпляр этого отчета
// с группировкой Ответственный → Склад → Документ и отбором по ответственному, складу и дню ячейки
// (период, склады и прочий отбор — как при последнем формировании). В отчете-расшифровке двойной щелчок
// по строке документа открывает документ.
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)

	Если ТипЗнч(Расшифровка) <> Тип("ИдентификаторРасшифровкиКомпоновкиДанных")
		Или НастройкиОтчета = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Отбор = Новый Структура;
	СобратьОтборРасшифровки(ДанныеРасшифровки.Элементы[Расшифровка], Отбор);

	Если Отбор.Свойство("Документ") Тогда
		Если ЗначениеЗаполнено(Отбор.Документ) Тогда
			ОткрытьЗначение(Отбор.Документ);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ОткрытьРасшифровкуПоДокументам(Отбор);

КонецПроцедуры

// Формирование отчета из другой формы (отчет-расшифровка).
Процедура Сформировать() Экспорт

	ДействияФормыСформировать(Неопределено);

КонецПроцедуры

Процедура ОткрытьРасшифровкуПоДокументам(Отбор)

	Настройки = НастройкиРасшифровкиПоДокументам(НастройкиОтчета, Отбор);
	ПараметрыДанных = Настройки.ПараметрыДанных.Элементы;

	Если Строка(ОтчетОбъект) = "ВнешнийОтчетОбъект." + ОтчетОбъект.Метаданные().Имя Тогда
		Попытка
			Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
			Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
			ОтчетРасшифровка = ВнешниеОтчеты.Создать(ОтчетОбъект.ИспользуемоеИмяФайла, Ложь, Защита);
		Исключение
			ОтчетРасшифровка = ВнешниеОтчеты.Создать(ОтчетОбъект.ИспользуемоеИмяФайла);
		КонецПопытки;
	Иначе
		ОтчетРасшифровка = Отчеты[ОтчетОбъект.Метаданные().Имя].Создать();
	КонецЕсли;

	Форма = ОтчетРасшифровка.ПолучитьФорму("ФормаОтчета", , Новый УникальныйИдентификатор);
	Форма.НастройкиРасшифровки = Настройки;
	Форма.ДатаНач = ПараметрыДанных.Найти("ДатаНач").Значение;
	Форма.ДатаКон = ПараметрыДанных.Найти("ДатаКон").Значение;
	Форма.Заголовок = "Отчет по кладовщикам: документы";
	Форма.Открыть();
	Форма.Сформировать();

КонецПроцедуры

// Детальные записи (строки складов в обычном режиме) не передают склад в расшифровку —
// заменяем их группировкой по складу: строки те же (запрос уже свернут по складу), а склад попадает в отбор.
Процедура ЗаменитьДетальныеЗаписиНаСклад(Структура)

	Для Каждого ЭлементСтруктуры Из Структура Цикл
		Если ТипЗнч(ЭлементСтруктуры) <> Тип("ГруппировкаКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Если ЭлементСтруктуры.ПоляГруппировки.Элементы.Количество() = 0 Тогда
			ПолеГруппировки = ЭлементСтруктуры.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Склад");
			ПолеГруппировки.Использование = Истина;
		КонецЕсли;
		ЗаменитьДетальныеЗаписиНаСклад(ЭлементСтруктуры.Структура);
	КонецЦикла;

КонецПроцедуры

Процедура СобратьОтборРасшифровки(ЭлементРасшифровки, Отбор)

	Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
		Для Каждого ЗначениеПоля Из ЭлементРасшифровки.ПолучитьПоля() Цикл
			Если (ЗначениеПоля.Поле = "Ответственный" Или ЗначениеПоля.Поле = "Склад"
				Или ЗначениеПоля.Поле = "День" Или ЗначениеПоля.Поле = "Документ")
				И Не Отбор.Свойство(ЗначениеПоля.Поле) Тогда
				Отбор.Вставить(ЗначениеПоля.Поле, ЗначениеПоля.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Родитель Из ЭлементРасшифровки.ПолучитьРодителей() Цикл
		СобратьОтборРасшифровки(Родитель, Отбор);
	КонецЦикла;

КонецПроцедуры

// Настройки отчета-расшифровки: Ответственный → Склад → Документ, принятые и собранные,
// отбор по ответственному и складу; день ячейки становится периодом отчета.
Функция НастройкиРасшифровкиПоДокументам(НастройкиОснова, Отбор)

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	Компоновщик.ЗагрузитьНастройки(НастройкиОснова);
	Настройки = Компоновщик.Настройки;

	Настройки.Выбор.Элементы.Очистить();
	ДобавитьВыбранноеПоле(Настройки.Выбор, "КоличествоПриход");
	ДобавитьВыбранноеПоле(Настройки.Выбор, "КоличествоРасход");

	Настройки.Структура.Очистить();
	Группировка = ДобавитьГруппировкуНастроек(Настройки.Структура, "Ответственный");
	Группировка = ДобавитьГруппировкуНастроек(Группировка.Структура, "Склад");
	Группировка = ДобавитьГруппировкуНастроек(Группировка.Структура, "Документ");
	Группировка.Порядок.Элементы.Очистить();
	ЭлементПорядка = Группировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("Документ.Дата");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	ЭлементПорядка.Использование = Истина;

	Для Каждого ЭлементОтбора Из Отбор Цикл
		Если ЭлементОтбора.Ключ = "День" Тогда
			Настройки.ПараметрыДанных.Элементы.Найти("ДатаНач").Значение = НачалоДня(ЭлементОтбора.Значение);
			Настройки.ПараметрыДанных.Элементы.Найти("ДатаКон").Значение = КонецДня(ЭлементОтбора.Значение);
			Продолжить;
		КонецЕсли;
		НовыйОтбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЭлементОтбора.Ключ);
		НовыйОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НовыйОтбор.ПравоеЗначение = ЭлементОтбора.Значение;
		НовыйОтбор.Использование = Истина;
	КонецЦикла;

	Возврат Компоновщик.ПолучитьНастройки();

КонецФункции

Функция ДобавитьГруппировкуНастроек(Структура, ИмяПоля)

	Группировка = Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ПолеГруппировки.Использование = Истина;
	Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Группировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));

	Возврат Группировка;

КонецФункции
