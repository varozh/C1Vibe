		<dataSource>ИсточникДанных1</dataSource>		<query>ВЫБРАТЬ
	ПланКладовщиков.Пользователь,
	ПланКладовщиков.Количество
ПОМЕСТИТЬ ПланКладовщиков
ИЗ
	РегистрСведений.ПланКладовщиков.СрезПоследних(&amp;ДатаНач, ) КАК ПланКладовщиков
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТоварыНаСкладах.Склад КАК Склад,
	ВЫБОР
		КОГДА ТоварыНаСкладах.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
			ТОГДА ТоварыНаСкладах.Регистратор.ДокументПеремещения.Ответственный
		КОГДА ТоварыНаСкладах.Регистратор ССЫЛКА Документ.РасходныйОрдерНаТовары
			ТОГДА ТоварыНаСкладах.Регистратор.ДокументПередачи.Ответственный
		ИНАЧЕ ТоварыНаСкладах.Регистратор.Ответственный
	КОНЕЦ КАК Ответственный,
	ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка) КАК ПустойПользователь,
	ВЫБОР
		КОГДА &amp;ПоДням
			ТОГДА НАЧАЛОПЕРИОДА(ТоварыНаСкладах.Период, ДЕНЬ)
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	КОНЕЦ КАК День,
	ВЫБОР
		КОГДА &amp;ПоДокументам
			ТОГДА ТоварыНаСкладах.Регистратор
		ИНАЧЕ NULL
	КОНЕЦ КАК Документ,
	СУММА(ТоварыНаСкладах.КоличествоПриход) КАК КоличествоПриход,
	СУММА(ТоварыНаСкладах.КоличествоРасход) КАК КоличествоРасход
ПОМЕСТИТЬ ТоварыНаСкладах
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Обороты(&amp;ДатаНач, &amp;ДатаКон, Регистратор, Склад В (&amp;Склады)) КАК ТоварыНаСкладах
ГДЕ
	(ТоварыНаСкладах.Регистратор ССЫЛКА Документ.ПеремещениеТоваров
			ИЛИ ТоварыНаСкладах.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
			ИЛИ ТоварыНаСкладах.Регистратор ССЫЛКА Документ.РасходныйОрдерНаТовары)

СГРУППИРОВАТЬ ПО
	ТоварыНаСкладах.Склад,
	ВЫБОР
		КОГДА ТоварыНаСкладах.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
			ТОГДА ТоварыНаСкладах.Регистратор.ДокументПеремещения.Ответственный
		КОГДА ТоварыНаСкладах.Регистратор ССЫЛКА Документ.РасходныйОрдерНаТовары
			ТОГДА ТоварыНаСкладах.Регистратор.ДокументПередачи.Ответственный
		ИНАЧЕ ТоварыНаСкладах.Регистратор.Ответственный
	КОНЕЦ,
	ВЫБОР
		КОГДА &amp;ПоДням
			ТОГДА НАЧАЛОПЕРИОДА(ТоварыНаСкладах.Период, ДЕНЬ)
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	КОНЕЦ,
	ВЫБОР
		КОГДА &amp;ПоДокументам
			ТОГДА ТоварыНаСкладах.Регистратор
		ИНАЧЕ NULL
	КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТоварыНаСкладах.Склад,
	ТоварыНаСкладах.Ответственный,
	ТоварыНаСкладах.ПустойПользователь,
	ТоварыНаСкладах.День,
	ТоварыНаСкладах.Документ,
	ТоварыНаСкладах.КоличествоПриход,
	ТоварыНаСкладах.КоличествоРасход,
	ВЫБОР
		КОГДА ЕСТЬNULL(ПланКладовщиков_Пользователь.Количество, 0) &gt; 0
			ТОГДА ПланКладовщиков_Пользователь.Количество
		КОГДА ЕСТЬNULL(ПланКладовщиков_Общий.Количество, 0) &gt; 0
			ТОГДА ПланКладовщиков_Общий.Количество
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоПлан
ИЗ
	ТоварыНаСкладах КАК ТоварыНаСкладах
		ЛЕВОЕ СОЕДИНЕНИЕ ПланКладовщиков КАК ПланКладовщиков_Пользователь
		ПО ТоварыНаСкладах.Ответственный = ПланКладовщиков_Пользователь.Пользователь
		ЛЕВОЕ СОЕДИНЕНИЕ ПланКладовщиков КАК ПланКладовщиков_Общий
		ПО ТоварыНаСкладах.ПустойПользователь = ПланКладовщиков_Общий.Пользователь
ГДЕ
	НЕ ТоварыНаСкладах.Ответственный ЕСТЬ NULL
	И ТоварыНаСкладах.Ответственный &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)</query>
