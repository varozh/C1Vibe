// Документ «Чек ККМ» → форма «ФормаРегистрацииПродаж» → модуль формы,
// процедура КнопкаРасчетСкидокНажатие, блок
// «проверяем контроль уникальности акции (т.е. должен быть только пакет и конкретная скидка)».
// Меняется только условие внутри цикла «для Каждого стр из скидки цикл».

// ===== БЫЛО =====
		для Каждого стр из скидки цикл
			если (стр.СкидкаНаценка <> РазрешСкидка и стр.СкидкаНаценка <> нужнаяскидка) и
				(стр.СкидкаНаценка <> РазрешСкидка2 и стр.СкидкаНаценка <> нужнаяскидка) и
				(стр.СкидкаНаценка <> РазрешСкидка3 и стр.СкидкаНаценка <> нужнаяскидка) и
				(стр.СкидкаНаценка <> РазрешСкидка4 и стр.СкидкаНаценка <> нужнаяскидка) и
				(стр.СкидкаНаценка <> РазрешСкидка5 и стр.СкидкаНаценка <> нужнаяскидка)
				Тогда

// ===== СТАЛО =====
		для Каждого стр из скидки цикл
			если (стр.СкидкаНаценка <> РазрешСкидка и стр.СкидкаНаценка <> нужнаяскидка) и
				(стр.СкидкаНаценка <> РазрешСкидка2 и стр.СкидкаНаценка <> нужнаяскидка) и
				(стр.СкидкаНаценка <> РазрешСкидка3 и стр.СкидкаНаценка <> нужнаяскидка) и
				(стр.СкидкаНаценка <> РазрешСкидка4 и стр.СкидкаНаценка <> нужнаяскидка) и
				(стр.СкидкаНаценка <> РазрешСкидка5 и стр.СкидкаНаценка <> нужнаяскидка)
				// Акция платья по товарам СП 13.11.2026: скидки с флагом «Только эта скидка»
				// из той же папки, что и нужнаяскидка, не убираем (1686, 1687, 1688 в одном чеке)
				и не (ЗначениеЗаполнено(нужнаяскидка.Родитель)
					и стр.СкидкаНаценка.Родитель = нужнаяскидка.Родитель
					и стр.СкидкаНаценка.ТолькоЭтаСкидка)
				Тогда
