				СтруктураОтбора.Вставить("Сегмент", СтрокаКомплект.Сегмент);
				
				МассивОтбор                  = НоменклатураСегмента_СкидкаНаценка.НайтиСтроки(СтруктураОтбора);
				НоменклатураСегмента_Сегмент = НоменклатураСегмента_СкидкаНаценка.Скопировать(МассивОтбор);
				
				ВсегоСтрок = ТаблицаТоваров_Остатки.Количество();
				Индекс     = ВсегоСтрок - 1;
				
				Для Номер = 1 По ВсегоСтрок Цикл
					
					СтрокаТовары = ТаблицаТоваров_Остатки[Индекс];
					
					СтруктураОтбора = Новый Структура;
					СтруктураОтбора.Вставить("Номенклатура",               СтрокаТовары.Номенклатура);
					СтруктураОтбора.Вставить("ХарактеристикаНоменклатуры", СтрокаТовары.ХарактеристикаНоменклатуры);
					
					НоменклатураСегмента_Номенклатура = НоменклатураСегмента_Сегмент.НайтиСтроки(СтруктураОтбора);
					
					Если НоменклатураСегмента_Номенклатура.Количество() > 0 Тогда
						
						Количество = Количество + СтрокаТовары.Количество;
						
						ТаблицаТоваров_Остатки.Удалить(Индекс);
						
						Если Количество >= СтрокаКомплект.Количество Тогда
							Прервать;
						КонецЕсли;
						
					КонецЕсли;
					
					Индекс = Индекс - 1;
					
				КонецЦикла;
				
				Если Количество < СтрокаКомплект.Количество Тогда
					
					КомплектВЧеке = Ложь;
					СтрокаСкидки.ЗначениеСкидкиНаценки = 0;
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	// Баранников Антон 01.09.2026 Конец
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("ТаблицаСкидок", ТаблицаСкидок);
	
