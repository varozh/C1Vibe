Функция ЦенаЗаканчиваетсяНа5(КлючСтроки, ТаблицаТоваров)

	Результат = Ложь;
	
	СтруктураОтбора = Новый Структура("КлючСтроки", КлючСтроки);
	МассивОтбор     = ТаблицаТоваров.НайтиСтроки(СтруктураОтбора);
	
	Если МассивОтбор.Количество() > 0 Тогда
		
		Цена = МассивОтбор[0].Цена;
		Цена = Цел(Цена);
		
		ЦенаОкончание = Прав(Цена, 1);
		ЦенаОкончание = Число(ЦенаОкончание);
		
		Если ЦенаОкончание = 5 Тогда
			Результат = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
