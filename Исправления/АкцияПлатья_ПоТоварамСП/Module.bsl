// Цикличная скидка «по товарам условия»: «Цикличная скидка», «По количеству»,
// «Сегмент номенклатуры» (условие) и «Сегмент базы расчета» (на что скидка) заполнены и различаются.
// На каждые ЗначениеУсловия штук товаров условия скидку получают ЗначениеУсловияМакс штук товаров базы.
// Пример: 1686 «50% на платья + собственное производство», ЗначениеУсловия = 1, ЗначениеУсловияМакс = 1:
// сколько в чеке товаров собственного производства, столько платьев (самых дешевых) получают 50%.
Функция ЭтоСкидкаПоТоварамУсловия(СкидкаНаценка)

	Если ТипЗнч(СкидкаНаценка) <> Тип("СправочникСсылка.СкидкиНаценки")
		Или Не ЗначениеЗаполнено(СкидкаНаценка)
		Или СкидкаНаценка.ЭтоГруппа Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СкидкаНаценка.ДополнительноеУсловиеСкидки = Перечисления.ДополнительныеУсловияСкидки.ЦикличнаяСкидка
		И СкидкаНаценка.УсловиеПредоставленияСкидки = Перечисления.УсловияПредоставленияСкидки.ПоКоличеству
		И ЗначениеЗаполнено(СкидкаНаценка.СегментНоменклатуры)
		И ЗначениеЗаполнено(СкидкаНаценка.СегментБазыРасчетаСкидки)
		И СкидкаНаценка.СегментНоменклатуры <> СкидкаНаценка.СегментБазыРасчетаСкидки
		И СкидкаНаценка.ЗначениеУсловия > 0
		И СкидкаНаценка.ЗначениеУсловияМакс > 0;

КонецФункции

// Количество единиц товаров чека, входящих в сегмент
Функция КоличествоТоваровСегмента(Сегмент, ТаблицаТоваров)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура,
	|	ТаблицаТоваров.ХарактеристикаНоменклатуры,
	|	ТаблицаТоваров.Количество
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ТаблицаТоваров.Количество), 0) КАК Количество
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
	|		ПО ТаблицаТоваров.Номенклатура = НоменклатураСегмента.Номенклатура
	|			И ТаблицаТоваров.ХарактеристикаНоменклатуры = НоменклатураСегмента.ХарактеристикаНоменклатуры
	|			И (НоменклатураСегмента.Сегмент = &Сегмент)";

	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	Запрос.УстановитьПараметр("Сегмент",        Сегмент);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Оставляет скидку «по товарам условия» только на разрешенном количестве товаров базы
// (от дешевых к дорогим). Остальные строки этой скидки удаляются, а не обнуляются:
// тогда в папке с вытеснением на эти товары может встать следующая скидка папки.
Процедура ОграничитьСкидкиПоТоварамУсловия(ТаблицаСкидок, ТаблицаТоваров)

	Скидки = ТаблицаСкидок.Скопировать(, "СкидкаНаценка");
	Скидки.Свернуть("СкидкаНаценка");

	Для Каждого СтрокаСкидки Из Скидки Цикл

		СкидкаНаценка = СтрокаСкидки.СкидкаНаценка;

		Если Не ЭтоСкидкаПоТоварамУсловия(СкидкаНаценка) Тогда
			Продолжить;
		КонецЕсли;

		КоличествоУсловия = КоличествоТоваровСегмента(СкидкаНаценка.СегментНоменклатуры, ТаблицаТоваров);
		КоличествоПоАкции = Цел(КоличествоУсловия / СкидкаНаценка.ЗначениеУсловия) * СкидкаНаценка.ЗначениеУсловияМакс;

		// Строки скидки от дешевых к дорогим
		Порядок = Новый ТаблицаЗначений;
		Порядок.Колонки.Добавить("СтрокаТаблицы");
		Порядок.Колонки.Добавить("СуммаБезСкидки", Новый ОписаниеТипов("Число"));

		Для Каждого СтрокаТаблицы Из ТаблицаСкидок.НайтиСтроки(Новый Структура("СкидкаНаценка", СкидкаНаценка)) Цикл

			НоваяСтрока = Порядок.Добавить();
			НоваяСтрока.СтрокаТаблицы = СтрокаТаблицы;

			Попытка
				НоваяСтрока.СуммаБезСкидки = СтрокаТаблицы.СуммаБезСкидки;
			Исключение
			КонецПопытки;

		КонецЦикла;

		Порядок.Сортировать("СуммаБезСкидки");

		КоличествоПрименений = 0;

		Для Каждого Элемент Из Порядок Цикл

			СтрокаТаблицы = Элемент.СтрокаТаблицы;

			Количество = 1;
			Попытка
				Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
					Количество = СтрокаТаблицы.Количество;
				КонецЕсли;
			Исключение
			КонецПопытки;

			Если КоличествоПрименений + Количество <= КоличествоПоАкции Тогда
				КоличествоПрименений = КоличествоПрименений + Количество;
				СтрокаТаблицы.КоличествоПоАкции = КоличествоПоАкции;
			Иначе
				ТаблицаСкидок.Удалить(СтрокаТаблицы);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Три платья в чеке: первое (самое дешевое) -50% по скидке 1688 «Платье + Платье»,
// второе - процент скидки 1687 «Скидка 30% на Платья», третье без скидки.
// Значение ставится в строку скидки 1688 (у нее «Значение условия макс» > 0, поэтому
// РассчитатьЗначениеСкидки() берет процент из строки таблицы скидок).
// Если на второе платье действует 1686 (есть товары СП), вытеснение оставит 1686 и ее 50%.
Процедура ДобавитьСкидкуНаВтороеИзТрехПлатьев(ТаблицаСкидок)

	КоличествоПлатьев = 3;

	СкидкаПары      = Справочники.СкидкиНаценки.НайтиПоКоду("000001688"); // Скидка 50% на Платье + Платье
	СкидкаОдноПлатье = Справочники.СкидкиНаценки.НайтиПоКоду("000001687"); // Скидка 30% на Платья

	Если СкидкаПары.Пустая() Или СкидкаОдноПлатье.Пустая() Тогда
		Возврат;
	КонецЕсли;

	СтрокиПары = ТаблицаСкидок.НайтиСтроки(Новый Структура("СкидкаНаценка", СкидкаПары));

	Если СтрокиПары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Порядок = Новый ТаблицаЗначений;
	Порядок.Колонки.Добавить("СтрокаТаблицы");
	Порядок.Колонки.Добавить("СуммаБезСкидки", Новый ОписаниеТипов("Число"));

	Количество = 0;

	Для Каждого СтрокаТаблицы Из СтрокиПары Цикл

		КоличествоСтроки = 1;
		Попытка
			Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
				КоличествоСтроки = СтрокаТаблицы.Количество;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Количество = Количество + КоличествоСтроки;

		НоваяСтрока = Порядок.Добавить();
		НоваяСтрока.СтрокаТаблицы = СтрокаТаблицы;

		Попытка
			НоваяСтрока.СуммаБезСкидки = СтрокаТаблицы.СуммаБезСкидки;
		Исключение
		КонецПопытки;

	КонецЦикла;

	Если Количество <> КоличествоПлатьев Тогда
		Возврат;
	КонецЕсли;

	Порядок.Сортировать("СуммаБезСкидки");

	// Первое платье без скидки 1688 получает процент 1687
	Для Каждого Элемент Из Порядок Цикл

		Если Элемент.СтрокаТаблицы.ЗначениеСкидкиНаценки = 0 Тогда
			Элемент.СтрокаТаблицы.ЗначениеСкидкиНаценки = СкидкаОдноПлатье.ЗначениеСкидкиНаценки;
			Прервать;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

