// Перекодировка дублей основного кода (Код) справочника «Информационные карты».
//
// У записей с одинаковым кодом в каждой группе дублей одной записи префикс кода (первые 3 символа)
// заменяется на «БЕЕ», остальные остаются как есть. Пример: Бвм997522 -> БЕЕ997522.
// Номер карты (реквизит КодКарты) не меняется.
//
// Обработка без формы (конфигурация работает в обычном приложении): открыть через Файл -> Открыть,
// дальше всё спрашивается диалогами:
//  1. магазины, карты которых перекодировать в первую очередь (можно ничего не отмечать);
//  2. список всех дублей: в каждой группе галочкой отмечена запись, которой меняется код.
//     Галочки можно переставить; группа, где отмечено не ровно одна запись, пропускается;
//  3. подтверждение.
// Если в группе дублей есть карта, помеченная на удаление, группа не меняется целиком
// (ни помеченная, ни непомеченная карта).
// Какую запись отметить по умолчанию (правила по очереди, пока не останется одна):
//  - карту магазина, выбранного в шаге 1;
//  - более позднюю по дате открытия.
// Каждая карта записывается отдельно (обычная запись, с регистрацией к обмену).
// Если новый код уже занят, карта пропускается. Изменения пишутся в журнал регистрации
// (событие «ПерекодировкаДублейИнфКарт») и в окно сообщений.

Перем НовыйПрефикс;
Перем ДлинаПрефикса;
Перем Дубли; // таблица записей с повторяющимся кодом

Функция КлючКода(Код)
	Возврат ВРег(СокрЛП(Код));
КонецФункции

Функция НовыйКод(Код)
	Возврат НовыйПрефикс + Сред(СокрЛП(Код), ДлинаПрефикса + 1);
КонецФункции

Процедура ЗагрузитьДубли()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Код КАК Код,
	|	Т.Наименование КАК Наименование,
	|	Т.КодКарты КАК КодКарты,
	|	Т.Магазин КАК Магазин,
	|	Т.ДатаОткрытия КАК ДатаОткрытия,
	|	Т.ПометкаУдаления КАК ПометкаУдаления,
	|	Т.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.ИнформационныеКарты КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Д.Код КАК Код
	|		ИЗ
	|			Справочник.ИнформационныеКарты КАК Д
	|		СГРУППИРОВАТЬ ПО
	|			Д.Код
	|		ИМЕЮЩИЕ
	|			КОЛИЧЕСТВО(Д.Ссылка) > 1) КАК Повторы
	|		ПО Т.Код = Повторы.Код
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Код,
	|	Т.ДатаОткрытия,
	|	Т.Ссылка";
	Дубли = Запрос.Выполнить().Выгрузить();

	Дубли.Колонки.Добавить("Ключ");
	Дубли.Колонки.Добавить("МагазинНаименование");
	Дубли.Колонки.Добавить("Менять");
	Для Каждого Стр Из Дубли Цикл
		Стр.Ключ = КлючКода(Стр.Код);
		Стр.МагазинНаименование = ?(ЗначениеЗаполнено(Стр.Магазин), СокрЛП(Стр.Магазин.Наименование), "");
		Стр.Менять = Ложь;
	КонецЦикла;
	Дубли.Индексы.Добавить("Ключ");

КонецПроцедуры

// Ключи групп дублей в порядке кодов
Функция КлючиГрупп()

	Ключи = Новый Массив;
	Были = Новый Соответствие;
	Для Каждого Стр Из Дубли Цикл
		Если Были.Получить(Стр.Ключ) = Неопределено Тогда
			Были.Вставить(Стр.Ключ, Истина);
			Ключи.Добавить(Стр.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Ключи;

КонецФункции

// Оставляет кандидатов из выбранных магазинов, если таких часть (но не все и не ни одного)
Функция СузитьПоМагазинам(Кандидаты, ВыбранныеМагазины)

	Подходящие = Новый Массив;
	Для Каждого Стр Из Кандидаты Цикл
		Если ВыбранныеМагазины.Получить(Стр.Магазин) <> Неопределено Тогда
			Подходящие.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;

	Если Подходящие.Количество() > 0 И Подходящие.Количество() < Кандидаты.Количество() Тогда
		Возврат Подходящие;
	КонецЕсли;
	Возврат Кандидаты;

КонецФункции

Функция ЕстьПомеченные(Ключ)

	Для Каждого Стр Из Дубли.НайтиСтроки(Новый Структура("Ключ", Ключ)) Цикл
		Если Стр.ПометкаУдаления Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ОтметитьПоУмолчанию(ВыбранныеМагазины)

	Для Каждого Ключ Из КлючиГрупп() Цикл
		Если ЕстьПомеченные(Ключ) Тогда
			Продолжить; // группу с помеченной на удаление картой не трогаем
		КонецЕсли;
		Кандидаты = Новый Массив;
		Для Каждого Стр Из Дубли.НайтиСтроки(Новый Структура("Ключ", Ключ)) Цикл
			Кандидаты.Добавить(Стр);
		КонецЦикла;
		Кандидаты = СузитьПоМагазинам(Кандидаты, ВыбранныеМагазины);
		// Строки упорядочены по дате открытия: последняя — самая поздняя
		Кандидаты[Кандидаты.ВГраница()].Менять = Истина;
	КонецЦикла;

КонецПроцедуры

Функция ПредставлениеСтроки(Стр)

	Текст = СокрЛП(Стр.Код) + "   " +?(Стр.ЭтоГруппа, "[папка] ", "") + СокрЛП(Стр.Наименование);
	Если Не Стр.ЭтоГруппа Тогда
		Текст = Текст + ", карта " + СокрЛП(Стр.КодКарты)
			+ ", " + ?(Стр.МагазинНаименование = "", "<магазин не указан>", Стр.МагазинНаименование)
			+ ", открыта " + Формат(Стр.ДатаОткрытия, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Если Стр.ПометкаУдаления Тогда
		Текст = Текст + "   (помечена на удаление — группа не меняется)";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция КодЗанят(Код)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИнформационныеКарты КАК Т
	|ГДЕ
	|	Т.Код = &Код";
	Запрос.УстановитьПараметр("Код", Код);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура ЗапуститьОбработку() Экспорт

	Если Не ПравоДоступа("Изменение", Метаданные.Справочники.ИнформационныеКарты) Тогда
		Предупреждение("Нет права на изменение справочника «Информационные карты»." + Символы.ПС
			+ "Запустите обработку под пользователем с правами администратора.");
		Возврат;
	КонецЕсли;

	ЗагрузитьДубли();
	Ключи = КлючиГрупп();
	Если Ключи.Количество() = 0 Тогда
		Предупреждение("В справочнике «Информационные карты» нет записей с одинаковым кодом.");
		Возврат;
	КонецЕсли;

	// 1. Магазины, карты которых перекодировать в первую очередь
	КартМагазина = Новый Соответствие;
	Магазины = Новый СписокЗначений;
	Для Каждого Стр Из Дубли Цикл
		Если Не ЗначениеЗаполнено(Стр.Магазин) Тогда
			Продолжить;
		КонецЕсли;
		Количество = КартМагазина.Получить(Стр.Магазин);
		Если Количество = Неопределено Тогда
			Магазины.Добавить(Стр.Магазин, Стр.МагазинНаименование);
			Количество = 0;
		КонецЕсли;
		КартМагазина.Вставить(Стр.Магазин, Количество + 1);
	КонецЦикла;
	Магазины.СортироватьПоПредставлению();
	Для Каждого ЭлементСписка Из Магазины Цикл
		ЭлементСписка.Представление = ЭлементСписка.Представление + "   (карт в дублях: "
			+ КартМагазина.Получить(ЭлементСписка.Значение) + ")";
	КонецЦикла;

	Если Не Магазины.ОтметитьЭлементы("Групп дублей: " + Ключи.Количество()
		+ ". Карты каких магазинов перекодировать в " + НовыйПрефикс + " в первую очередь? (можно не отмечать)") Тогда
		Возврат;
	КонецЕсли;
	ВыбранныеМагазины = Новый Соответствие;
	Для Каждого ЭлементСписка Из Магазины Цикл
		Если ЭлементСписка.Пометка Тогда
			ВыбранныеМагазины.Вставить(ЭлементСписка.Значение, Истина);
		КонецЕсли;
	КонецЦикла;

	ОтметитьПоУмолчанию(ВыбранныеМагазины);

	// 2. Просмотр и правка выбора
	Список = Новый СписокЗначений;
	Для Каждого Стр Из Дубли Цикл
		Список.Добавить(Стр.Ссылка, ПредставлениеСтроки(Стр), Стр.Менять);
	КонецЦикла;
	Если Не Список.ОтметитьЭлементы("Отмеченным записям префикс кода заменится на " + НовыйПрефикс
		+ " (в каждой группе дублей отметьте ровно одну)") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ЭлементСписка Из Список Цикл
		Дубли[Список.Индекс(ЭлементСписка)].Менять = ЭлементСписка.Пометка;
	КонецЦикла;

	// Что меняем
	КИзменению = Новый Массив;
	Пропуски = "";
	ГруппСПомеченными = 0;
	Для Каждого Ключ Из Ключи Цикл
		СтрокиГруппы = Дубли.НайтиСтроки(Новый Структура("Ключ", Ключ));
		Отмеченные = Новый Массив;
		Для Каждого Стр Из СтрокиГруппы Цикл
			Если Стр.Менять Тогда
				Отмеченные.Добавить(Стр);
			КонецЕсли;
		КонецЦикла;
		Код = СокрЛП(СтрокиГруппы[0].Код);
		Если ЕстьПомеченные(Ключ) Тогда
			ГруппСПомеченными = ГруппСПомеченными + 1;
			Если Отмеченные.Количество() > 0 Тогда
				Пропуски = Пропуски + Символы.ПС + "   " + Код + ": в группе есть карта, помеченная на удаление, — группа не меняется";
			КонецЕсли;
		ИначеЕсли Отмеченные.Количество() = 0 Тогда
			Пропуски = Пропуски + Символы.ПС + "   " + Код + ": ничего не отмечено";
		ИначеЕсли Отмеченные.Количество() > 1 Тогда
			Пропуски = Пропуски + Символы.ПС + "   " + Код + ": отмечено записей: " + Отмеченные.Количество();
		Иначе
			КИзменению.Добавить(Отмеченные[0]);
			Если СтрокиГруппы.Количество() > 2 Тогда
				Пропуски = Пропуски + Символы.ПС + "   " + Код + ": записей в группе " + СтрокиГруппы.Количество()
					+ ", меняется одна, остальные останутся дублями";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если КИзменению.Количество() = 0 Тогда
		Предупреждение("Нечего менять: ни в одной группе не отмечена ровно одна запись." + Пропуски);
		Возврат;
	КонецЕсли;

	// 3. Подтверждение
	ТекстВопроса = "Групп дублей: " + Ключи.Количество() + "." + Символы.ПС
		+ "Будет изменен код у записей: " + КИзменению.Количество() + " (префикс -> " + НовыйПрефикс + ")." + Символы.ПС
		+ "Не меняются группы с картой, помеченной на удаление: " + ГруппСПомеченными + ".";
	Если Пропуски <> "" Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС + "Особые группы:" + Пропуски;
	КонецЕсли;
	ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС + "Продолжить?";
	Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Изменено = 0;
	Ошибок = 0;
	Для Каждого Стр Из КИзменению Цикл
		СтарыйКод = СокрЛП(Стр.Код);
		Код = НовыйКод(СтарыйКод);
		Описание = СокрЛП(Стр.Наименование) + ", карта " + СокрЛП(Стр.КодКарты) + ", " + Стр.МагазинНаименование;
		Попытка
			Если КодЗанят(Код) Тогда
				ВызватьИсключение "код " + Код + " уже занят другой записью";
			КонецЕсли;
			Объект = Стр.Ссылка.ПолучитьОбъект();
			Если СокрЛП(Объект.Код) <> СтарыйКод Тогда
				ВызватьИсключение "код записи уже изменен на " + СокрЛП(Объект.Код);
			КонецЕсли;
			Если Объект.ПометкаУдаления Тогда
				ВызватьИсключение "запись помечена на удаление";
			КонецЕсли;
			Объект.Код = Код;
			Объект.Записать();
			Изменено = Изменено + 1;
			Сообщить("Изменен: " + СтарыйКод + " -> " + Код + "   " + Описание);
			ЗаписьЖурналаРегистрации("ПерекодировкаДублейИнфКарт", УровеньЖурналаРегистрации.Информация,
				Метаданные.Справочники.ИнформационныеКарты, Стр.Ссылка, "Код " + СтарыйКод + " -> " + Код);
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("НЕ изменен: " + СтарыйКод + "   " + Описание + ": " + ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;
	КонецЦикла;

	Предупреждение("Готово. Изменен код у записей: " + Изменено + ?(Ошибок > 0, ", не изменено из-за ошибок: " + Ошибок, "") + "."
		+ Символы.ПС + "Подробности — в окне сообщений.");

КонецПроцедуры

НовыйПрефикс = "БЕЕ";
ДлинаПрефикса = 3;

// Формы у обработки нет: при открытии файла сразу запускаем диалоги
ЗапуститьОбработку();
