Функция СформироватьПечатнуюФорму(ПараметрыОтчета) Экспорт
	печатнаяФорма = Новый ТабличныйДокумент;
	группаПродавцов = Справочники.ФизическиеЛица.НайтиПоКоду("ЦБР000014");
	подарочныеКарты = Новый Массив;
	подарочныеКарты.Добавить(Справочники.Номенклатура.НайтиПоКоду("УТ000045824"));
	подарочныеКарты.Добавить(Справочники.Номенклатура.НайтиПоКоду("УТ000042038"));
	// Запрос по ежедневным отчетам
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НАЧАЛОПЕРИОДА(ЕжедневныйОтчет.ДатаОтчета, ДЕНЬ) КАК ДатаОтчета,
	               |	ЕжедневныйОтчет.Магазин,
	               |	ЕжедневныйОтчет.Сотрудник
	               |ИЗ
	               |	Документ.ЕжедневныйОтчет КАК ЕжедневныйОтчет
	               |ГДЕ
	               |	ЕжедневныйОтчет.ДатаОтчета МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ЕжедневныйОтчет.Проведен
	               |	И ЕжедневныйОтчет.Магазин = &Магазин
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОтчета";
	
	Запрос.УстановитьПараметр("ДатаОкончания",КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("ДатаНачала",НачалоДня(ПараметрыОтчета.НачалоПериода));
	Если ЗначениеЗаполнено(ПараметрыОтчета.Магазин) Тогда 
		Запрос.УстановитьПараметр("Магазин", ПараметрыОтчета.Магазин);
	Иначе 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ЕжедневныйОтчет.Магазин = &Магазин","");
	КонецЕсли;
	ВыгрузкаЕжОтчет = Запрос.Выполнить().Выгрузить();
	
	// Запрос по директорам магазинов
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	т.Магазин,
	               |	МАКСИМУМ(т.Ссылка) КАК Сотрудник
	               |ПОМЕСТИТЬ ВТ_ДиректораМагазинов
	               |ИЗ
	               |	Справочник.ФизическиеЛица КАК т
	               |ГДЕ
	               |	т.Должность ПОДОБНО ""%"" + &Должность + ""%""
	               |	И т.Сотрудник
	               |	И т.Магазин <> ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка)
	               |	И НЕ т.Уволен
	               |	И НЕ т.ПометкаУдаления
	               |	И т.Ссылка В ИЕРАРХИИ(&ГруппаПродавцов)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т.Магазин
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	т.Продавец КАК Продавец,
	               |	т.Продавец.Должность КАК Должность,
	               |	т.Магазин КАК Магазин
	               |ПОМЕСТИТЬ ВТ_ПродавцыЧеков
	               |ИЗ
	               |	Документ.ЧекККМ КАК т
	               |ГДЕ
	               |	т.Дата МЕЖДУ &ДатаН И &ДатаК
	               |	И т.Проведен = ИСТИНА
	               |	И т.НомерЧекаККМ <> 0
	               |	И т.Продавец.Должность ПОДОБНО ""%"" + &Должность + ""%""
	               |	И т.Продавец В ИЕРАРХИИ(&ГруппаПродавцов)
	               |	И т.Продавец.Магазин = т.Магазин
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ЕСТЬNULL(т2.Продавец, т1.Сотрудник)) КАК Продавец,
	               |	МАКСИМУМ(ЕСТЬNULL(т2.Должность, т1.Сотрудник.Должность)) КАК ПродавецДолжность,
	               |	ЕСТЬNULL(т1.Магазин, т2.Магазин) КАК Магазин
	               |ПОМЕСТИТЬ ВТ_Продавцы
	               |ИЗ
	               |	ВТ_ДиректораМагазинов КАК т1
	               |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ПродавцыЧеков КАК т2
	               |		ПО (т2.Продавец = т1.Сотрудник)
	               |			И т1.Магазин = т2.Магазин
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЕСТЬNULL(т1.Магазин, т2.Магазин)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	т.Склад.Магазин КАК Магазин,
	               |	т.СтоимостьОборот КАК Выручка,
	               |	НАЧАЛОПЕРИОДА(т.Период, ДЕНЬ) КАК ДеньПродажи,
	               |	т.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ ВТ_ДокументыПродажи
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(&ДатаН, &ДатаК, Регистратор, ДокументПродажи ССЫЛКА Документ.ОтчетОРозничныхПродажах) КАК т
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	т.Склад.Магазин КАК Магазин,
	               |	т.СтоимостьОборот КАК СуммаПродажиПодарочнойКарты,
	               |	НАЧАЛОПЕРИОДА(т.Период, ДЕНЬ) КАК ДеньПродажи,
	               |	т.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ ВТ_ПродажиПодарочныхКарт
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(
	               |			&ДатаН,
	               |			&ДатаК,
	               |			Регистратор,
	               |			ДокументПродажи ССЫЛКА Документ.ОтчетОРозничныхПродажах
	               |				И Номенклатура В (&ПодарочныеКарты)) КАК т
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	т1.Ссылка.ОтчетОРозничныхПродажах КАК ДокументПродажи,
	               |	СУММА(т1.Сумма) КАК СуммаОплатыСертификатом,
	               |	т2.ДеньПродажи КАК ДеньПродажи
	               |ПОМЕСТИТЬ ВТ_ПродажиОплаченныеСертификатом
	               |ИЗ
	               |	Документ.ЧекККМ.Оплата КАК т1
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументыПродажи КАК т2
	               |		ПО т1.Ссылка.ОтчетОРозничныхПродажах = т2.Регистратор
	               |ГДЕ
	               |	т1.ВидОплаты = ЗНАЧЕНИЕ(Справочник.ВидыОплатЧекаККМ.ОплатаПодарочнымСертификатом)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т1.Ссылка.ОтчетОРозничныхПродажах,
	               |	т2.ДеньПродажи
	               |
	               |ИНДЕКСИРОВАТЬ ПО                                                                            
	               |	ДокументПродажи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	т1.Магазин КАК Магазин,
	               |	СУММА(т1.Выручка) КАК Выручка,
	               |	т1.ДеньПродажи КАК ДеньПродажи,
	               |	СУММА(ЕСТЬNULL(т2.СуммаОплатыСертификатом, 0)) КАК СуммаОплатыСертификатом,
	               |	СУММА(ЕСТЬNULL(т3.СуммаПродажиПодарочнойКарты, 0)) КАК СуммаПродажиПодарочнойКарты
	               |ПОМЕСТИТЬ ВТ_Продажи
	               |ИЗ
	               |	ВТ_ДокументыПродажи КАК т1
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПродажиОплаченныеСертификатом КАК т2
	               |		ПО т1.Регистратор = т2.ДокументПродажи
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПродажиПодарочныхКарт КАК т3
	               |		ПО т1.Регистратор = т3.Регистратор
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т1.Магазин,
	               |	т1.ДеньПродажи
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Магазин,
	               |	ДеньПродажи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	т.ЧекККМПродажа КАК ЧекВозврата
	               |ПОМЕСТИТЬ ВТ_ЧекиВозврата
	               |ИЗ
	               |	Документ.ЧекККМ КАК т
	               |ГДЕ
	               |	т.Проведен
	               |	И т.Дата МЕЖДУ &ДатаН И &ДатаК
	               |	И т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
				   |	И т.ЧекККМПродажа.СуммаДокумента = т.СуммаДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	т2.Ссылка КАК ЧекПродажи,
	               |	СУММА(т2.Количество) КАК КоличествоПодарочныхКарт
	               |ПОМЕСТИТЬ ВТ_ЧекиПродажПодарочныхКарт
	               |ИЗ
	               |	Документ.ЧекККМ.Товары КАК т2
	               |ГДЕ
	               |	т2.Ссылка.Проведен
	               |	И т2.Ссылка.Дата МЕЖДУ &ДатаН И &ДатаК
	               |	И т2.Номенклатура В(&ПодарочныеКарты)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т2.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               // Галантерея 05.11.2026 Начало
	               // Чеки, в которых есть хотя бы один товар не из галантереи (для КПЧ и среднего чека)
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	т.Ссылка КАК Чек
	               |ПОМЕСТИТЬ ВТ_ЧекиБезГалантереи
	               |ИЗ
	               |	Документ.ЧекККМ.Товары КАК т
	               |ГДЕ
	               |	т.Ссылка.Проведен
	               |	И т.Ссылка.Дата МЕЖДУ &ДатаН И &ДатаК
	               |	И т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
	               |	И НЕ т.Номенклатура.Родитель В ИЕРАРХИИ (&ИсключаемыеГруппыТоваров)
	               |	И НЕ т.Номенклатура В (&ПодарочныеКарты)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Чек
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	т.Склад.Магазин КАК Магазин,
	               |	НАЧАЛОПЕРИОДА(т.Период, ДЕНЬ) КАК ДеньПродажи,
	               |	СУММА(т.СтоимостьОборот) КАК ВыручкаБезГалантереи
	               |ПОМЕСТИТЬ ВТ_ВыручкаБезГалантереи
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(
	               |			&ДатаН,
	               |			&ДатаК,
	               |			Регистратор,
	               |			ДокументПродажи ССЫЛКА Документ.ОтчетОРозничныхПродажах
	               |				И НЕ Номенклатура.Родитель В ИЕРАРХИИ (&ИсключаемыеГруппыТоваров)
	               |				И НЕ Номенклатура В (&ПодарочныеКарты)) КАК т
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т.Склад.Магазин,
	               |	НАЧАЛОПЕРИОДА(т.Период, ДЕНЬ)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Магазин,
	               |	ДеньПродажи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               // Галантерея 05.11.2026 Конец
	               |ВЫБРАТЬ
	               |	НАЧАЛОПЕРИОДА(т1.Ссылка.Дата, ДЕНЬ) КАК ДеньПродаж,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т1.Ссылка) КАК КоличествоЧеков,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т3.ЧекПродажи) КАК ЧековПродажКарт,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т4.Чек) КАК ЧековБезГалантереи,
	               |	т1.Ссылка.Магазин КАК Магазин,
	               |	СУММА(ЕСТЬNULL(т3.КоличествоПодарочныхКарт, 0)) КАК КоличествоПодарочныхКарт
	               |ПОМЕСТИТЬ ВТ_ДанныеПоЧекам
	               |ИЗ
	               |	Документ.ЧекККМ.Оплата КАК т1
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЧекиВозврата КАК т2
	               |		ПО т1.Ссылка = т2.ЧекВозврата
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЧекиПродажПодарочныхКарт КАК т3
	               |		ПО т1.Ссылка = т3.ЧекПродажи
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЧекиБезГалантереи КАК т4
	               |		ПО т1.Ссылка = т4.Чек
	               |ГДЕ
	               |	т1.Ссылка.Проведен
	               |	И т1.Ссылка.Дата МЕЖДУ &ДатаН И &ДатаК
	               |	И т1.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
	               |	И т2.ЧекВозврата ЕСТЬ NULL
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НАЧАЛОПЕРИОДА(т1.Ссылка.Дата, ДЕНЬ),
	               |	т1.Ссылка.Магазин
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ДеньПродаж,
	               |	Магазин
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(т1.ДеньПродаж, т2.ДеньПродажи) КАК Дата,
	               |	ЕСТЬNULL(т1.Магазин, т2.Магазин) КАК Магазин,
	               |	ЕСТЬNULL(т1.КоличествоЧеков, 0) КАК ЧислоЧеков,
	               |	ЕСТЬNULL(т2.Выручка, 0) КАК СуммаДокумента,
	               |	ЕСТЬNULL(т2.Выручка, 0) - ЕСТЬNULL(т2.СуммаОплатыСертификатом, 0) КАК ВыручкаПродавца,
	               |	ЕСТЬNULL(т2.СуммаПродажиПодарочнойКарты, 0) КАК СуммаПродажиПодарочнойКарты,
	               |	ЕСТЬNULL(т1.КоличествоЧеков, 0) - ЕСТЬNULL(т1.ЧековПродажКарт, 0) КАК ЧековПродажБезКарт,
	               |	ЕСТЬNULL(т1.ЧековПродажКарт, 0) КАК ЧековПродажКарт,
	               |	ЕСТЬNULL(т1.КоличествоПодарочныхКарт, 0) КАК КоличествоПодарочныхКарт,
	               |	ЕСТЬNULL(т1.ЧековБезГалантереи, 0) КАК ЧековБезГалантереи,
	               |	ЕСТЬNULL(т2.СуммаОплатыСертификатом, 0) КАК СуммаОплатыСертификатом
	               |ПОМЕСТИТЬ ВТ_СуммаЧековИИхКоличество
	               |ИЗ
	               |	ВТ_ДанныеПоЧекам КАК т1
	               |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Продажи КАК т2
	               |		ПО т1.ДеньПродаж = т2.ДеньПродажи
	               |			И т1.Магазин = т2.Магазин
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Дата,
	               |	Магазин
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               // Галантерея 05.11.2026: средний чек = выручка без галантереи / чеки без галантереи
	               |ВЫБРАТЬ
	               |	т.Магазин,
	               |	СРЕДНЕЕ(ВЫБОР
	               |			КОГДА ЕСТЬNULL(т.ЧековБезГалантереи, 0) = 0
	               |				ТОГДА 0.000001
	               |			ИНАЧЕ (ЕСТЬNULL(вг.ВыручкаБезГалантереи, 0) - ЕСТЬNULL(т.СуммаОплатыСертификатом, 0)) / т.ЧековБезГалантереи
	               |		КОНЕЦ) КАК СреднийЧек,
	               |	СУММА(ЕСТЬNULL(вг.ВыручкаБезГалантереи, 0) - ЕСТЬNULL(т.СуммаОплатыСертификатом, 0)) КАК ВыручкаДляСЧ,
	               |	т.Дата
	               |ПОМЕСТИТЬ ВТ_СРЕДЧЕК
	               |ИЗ
	               |	ВТ_СуммаЧековИИхКоличество КАК т
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВыручкаБезГалантереи КАК вг
	               |		ПО т.Магазин = вг.Магазин
	               |			И т.Дата = вг.ДеньПродажи
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т.Магазин,
	               |	т.Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ПланПродажТЧМагазины.План) КАК План,
	               |	ПланПродажТЧМагазины.Магазин КАК Магазин,
	               |	ПланПродажТЧМагазины.Ссылка.ПериодС,
	               |	ПланПродажТЧМагазины.Ссылка.ПериодПо,
	               |	МАКСИМУМ(ЕСТЬNULL(ПлановыеПоказателиKPIМагазинов.Конверсия, 0)) КАК Конверсия,
	               |	МАКСИМУМ(ЕСТЬNULL(ПлановыеПоказателиKPIМагазинов.КПЧ, 0)) КАК КПЧ,
	               |	МАКСИМУМ(ЕСТЬNULL(ПлановыеПоказателиKPIМагазинов.СреднийЧек, 0)) КАК СреднийЧек,
	               |	МАКСИМУМ(ЕСТЬNULL(ПлановыеПоказателиKPIМагазинов.КолПК, 1)) КАК КолПК,
	               |	МАКСИМУМ(ЕСТЬNULL(ПлановыеПоказателиKPIМагазинов.ПроцТОПродаваец, 0)) КАК ПроцТОПродаваец,
	               |	МАКСИМУМ(ЕСТЬNULL(ПлановыеПоказателиKPIМагазинов.ПроцТОДиректор, 0)) КАК ПроцТОДиректор,
	               |	МАКСИМУМ(ЕСТЬNULL(ПлановыеПоказателиKPIМагазинов.КоэффицентКонверсии, 1)) КАК КоэффицентКонверсии,
