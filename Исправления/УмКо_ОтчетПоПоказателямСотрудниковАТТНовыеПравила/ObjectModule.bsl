	                       |	МАКСИМУМ(ПремияКонверсияПродавец),
	                       |	МАКСИМУМ(ПремияКПЧПродавец),
	                       |	МАКСИМУМ(ПремияСреднийЧекПродавец),
	                       |	МАКСИМУМ(ПланПродавца),
	                       |	СУММА(КоличествоТоваров),
	                       |	СУММА(ЧислоЧеков),
	                       |	СУММА(ЧековПродажиБезКарт),
	                       |	СУММА(СуммаПродажиПодарочнойКарты),
	                       |	СУММА(ЧековПродажиКарт),
	                       |	СУММА(КоличествоПодарочныхКарт),
	                       |	СУММА(ЧековБезГалантереи),
	                       |	СУММА(ВыручкаДляСЧ)
	                       |ПО
	                       |	Магазин,
	                       |	ПродавецДолжность,
	                       |	Продавец";
	
	ЗапросПродавцы.УстановитьПараметр("ВидПакет",Константы.УмКо_Пакет.Получить());
	ЗапросПродавцы.УстановитьПараметр("Дождевик",Справочники.Номенклатура.НайтиПоНаименованию("Плащ модель 7.24.3", Истина));    
	ЗапросПродавцы.УстановитьПараметр("ВидПС",Константы.УмКо_ВидНоменклатурыВнутреннийПодарочныйСертификат.Получить());
	ЗапросПродавцы.УстановитьПараметр("ДатаК",КонецДня(ПараметрыОтчета.КонецПериода));
	ЗапросПродавцы.УстановитьПараметр("ДатаН",НачалоДня(ПараметрыОтчета.НачалоПериода));
	ЗапросПродавцы.УстановитьПараметр("ПериодПо",НачалоДня(ПараметрыОтчета.КонецПериода));
	ЗапросПродавцы.УстановитьПараметр("ПериодС",НачалоДня(ПараметрыОтчета.НачалоПериода));
	ЗапросПродавцы.УстановитьПараметр("Должность","директор");
	ЗапросПродавцы.УстановитьПараметр("ПодарочныеКарты", подарочныеКарты);
	ЗапросПродавцы.УстановитьПараметр("ИсключаемыеГруппыТоваров",списокГрупп);
	ЗапросПродавцы.УстановитьПараметр("ГруппаПродавцов", группаПродавцов);
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.Магазин) Тогда 
		ЗапросПродавцы.УстановитьПараметр("Магазин", ПараметрыОтчета.Магазин);
	Иначе 
		ЗапросПродавцы.Текст = СтрЗаменить(ЗапросПродавцы.Текст,"И ВтИтог.Магазин = &Магазин","");
	КонецЕсли;
	
	РезультатДериктор = Запрос.Выполнить();
	ВыборкаДиректорМагазин = РезультатДериктор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	РезультатПродавец = ЗапросПродавцы.Выполнить();
	ВыборкаПродавецМагазин = РезультатПродавец.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = ПолучитьМакет("Макет");
	
	Пока ВыборкаДиректорМагазин.Следующий() Цикл 
		
		ОбластьШапкаМагазин = Макет.ПолучитьОбласть("ОбластьШапкаМагазин");
		ОбластьШапкаМагазин.Параметры.Магазин = ВыборкаДиректорМагазин.Магазин;
		ОбластьШапкаМагазин.Параметры.СуммаПлан = Формат(ВыборкаДиректорМагазин.План,"ЧДЦ=2");
		ОбластьШапкаМагазин.Параметры.СуммаФакт = Формат(ВыборкаДиректорМагазин.СуммаДокумента,"ЧДЦ=2");
		ПроцентВыполненияПлана = ВыборкаДиректорМагазин.СуммаДокумента / ВыборкаДиректорМагазин.План * 100;
		ОбластьШапкаМагазин.Параметры.Процент = Формат(ПроцентВыполненияПлана,"ЧДЦ=2");		
		
		печатнаяФорма.Вывести(ОбластьШапкаМагазин);
		
		ОбластьДиректор = Макет.ПолучитьОбласть("ОбластьДиректор");
		
		Если ЗначениеЗаполнено(ВыборкаДиректорМагазин.Продавец) И НЕ ВыборкаДиректорМагазин.Продавец.Пустая() Тогда
			ФИОСрез = РегистрыСведений.ФИОФизЛиц.ПолучитьПоследнее(,Новый Структура("ФизЛицо",ВыборкаДиректорМагазин.Продавец));
			ОбластьДиректор.Параметры.ФИО = ФИОСрез.Фамилия+" "+Лев(ФИОСрез.Имя,1)+". "+Лев(ФИОСрез.Отчество,1)+".";
		КонецЕсли;
		ОбластьДиректор.Параметры.ПланСумма = Формат(ВыборкаДиректорМагазин.План,"ЧДЦ=2");
		ОбластьДиректор.Параметры.ПланКонверсия = Формат(ВыборкаДиректорМагазин.КонверсияПланМесяц,"ЧДЦ=2");
		ОбластьДиректор.Параметры.ПланКПЧ = Формат(ВыборкаДиректорМагазин.КПЧПланМесяц,"ЧДЦ=2");
		ОбластьДиректор.Параметры.ПланСЧ = Формат(ВыборкаДиректорМагазин.СреднийЧекПланМесяц,"ЧДЦ=2");
		
		ОбластьДиректор.Параметры.ФактСумма = Формат(ВыборкаДиректорМагазин.СуммаДокумента,"ЧДЦ=2");
		
		ДеньПоследний = День(ПараметрыОтчета.КонецПериода);
		ИндДень = 1;
		Пока ИндДень <= ДеньПоследний Цикл 
			ИмяПараметра = "День"+Строка(ИндДень);
			ОбластьДиректор.Параметры[ИмяПараметра] = Формат(НачалоМесяца(ПараметрыОтчета.НачалоПериода) + (ИндДень*60*60*24) - 60*60*24, "ДФ='dd MMMM'");
			ИндДень=ИндДень+1;
		КонецЦикла;
		
		ВыборкаДиректорДень = ВыборкаДиректорМагазин.Выбрать();
		среднееКПЧ = 0;
		числоДнейКПЧ = 0;
		средняяКонверсия = 0;
		количествоТоваров = 0;
		чековПродажиБезКарт = 0;
		отбор = Новый Структура("Магазин, ДатаОтчета", ВыборкаДиректорМагазин.Магазин, ПараметрыОтчета.КонецПериода);
		рабочиеДниМагазинов = ВыгрузкаЕжОтчет.Скопировать();
		рабочиеДниМагазинов.Свернуть("Магазин, ДатаОтчета");
		рабочиеДниМагазинов.Сортировать("ДатаОтчета Убыв");
		последнийРабочийДень = ?(рабочиеДниМагазинов.Количество() > 0, рабочиеДниМагазинов[0].ДатаОтчета, ДеньПоследний);
		Пока ВыборкаДиректорДень.Следующий() Цикл 
			
			ИмяПараметра = "СуммаДень"+Строка(день(ВыборкаДиректорДень.Дата));
			ОбластьДиректор.Параметры[ИмяПараметра] = Формат(ВыборкаДиректорДень.СуммаДокумента,"ЧДЦ=2");
			
			ИмяПараметра = "КонверсияДень"+Строка(день(ВыборкаДиректорДень.Дата));
			ОбластьДиректор.Параметры[ИмяПараметра] = Формат(ВыборкаДиректорДень.Конверсия,"ЧДЦ=2");
			кпч = ВыборкаДиректорДень.СреднееКПЧ;
			Если кпч > 0.000001 И кпч < 1 Тогда
				кпч = 1;
			КонецЕсли;
			ИмяПараметра = "КПЧДень"+Строка(день(ВыборкаДиректорДень.Дата));
			ОбластьДиректор.Параметры[ИмяПараметра] = Формат(кпч, "ЧДЦ=2");
			
			ИмяПараметра = "СЧДень"+Строка(день(ВыборкаДиректорДень.Дата));
			ОбластьДиректор.Параметры[ИмяПараметра] = Формат(ВыборкаДиректорДень.СреднийЧек,"ЧДЦ=2");
			Если ВыборкаДиректорДень.СуммаДокумента > 0 Тогда
				среднееКПЧ = среднееКПЧ + ВыборкаДиректорДень.СреднееКПЧ;
			КонецЕсли;
			Если ВыборкаДиректорДень.СреднееКПЧ > 0 И ВыборкаДиректорДень.СуммаДокумента > 0 Тогда
				числоДнейКПЧ = числоДнейКПЧ + 1;
			КонецЕсли;
			средняяКонверсия = средняяКонверсия + ВыборкаДиректорДень.Конверсия;
			// Галантерея 05.11.2026: товары и чеки без галантереи (подарочные карты уже исключены в запросе)
			количествоТоваров = количествоТоваров + ВыборкаДиректорДень.КоличествоТоваров;
			чековПродажиБезКарт = чековПродажиБезКарт + ВыборкаДиректорДень.ЧековБезГалантереи;
		КонецЦикла;
		Если ТипЗнч(последнийРабочийДень) <> Тип("Дата") Тогда
			последнийРабочийДень = ПараметрыОтчета.КонецПериода;
		КонецЕсли;
		разностьДат = ОКР((КонецДня(последнийРабочийДень) - ПараметрыОтчета.НачалоПериода) / 86400);
		числоДнейКонверсии = разностьДат;
		
		ВремТЧЕжОтчет = ВыгрузкаЕжОтчет.Скопировать(Новый Структура("Магазин",ВыборкаДиректорМагазин.Магазин),"ДатаОтчета");
		ВремТЧЕжОтчет.Свернуть("ДатаОтчета");
		числоДнейКонверсии = ВремТЧЕжОтчет.Количество();
		
		числоДнейСЧ = разностьДат;
		среднееКПЧ = ?(чековПродажиБезКарт = 0, 0, количествоТоваров / чековПродажиБезКарт);
		Если среднееКПЧ > 0.000001 И среднееКПЧ < 1 Тогда
			среднееКПЧ = 1;
		КонецЕсли;
		// Галантерея 05.11.2026
		среднийЧек = ?(ВыборкаДиректорМагазин.ЧековБезГалантереи = 0, 0,
			ВыборкаДиректорМагазин.ВыручкаДляСЧ / ВыборкаДиректорМагазин.ЧековБезГалантереи);
		средняяКонверсия = ?(числоДнейКонверсии = 0, 0, средняяКонверсия / числоДнейКонверсии);
		ОбластьДиректор.Параметры.ФактКПЧ = Формат(среднееКПЧ, "ЧДЦ=2");
		ОбластьДиректор.Параметры.ФактСЧ = Формат(среднийЧек, "ЧДЦ=2");
		ОбластьДиректор.Параметры.ФактКонверсия = Формат(средняяКонверсия,"ЧДЦ=2");
		
		Если Окр(ВыборкаДиректорМагазин.СуммаДокумента, 2) >= ВыборкаДиректорМагазин.План Тогда 
			ОбластьДиректор.Параметры.ВыполняемостьПоСумме = "Выполнено";
			ОбластьДиректор.Область("ВыполняемостьПоСуммеДиректора").ЦветФона = WebЦвета.СветлоЗеленый;
		Иначе
			ОбластьДиректор.Параметры.ВыполняемостьПоСумме = "Не выполнено";
			ОбластьДиректор.Область("ВыполняемостьПоСуммеДиректора").ЦветФона = WebЦвета.Томатный;
		КонецЕсли;
		
		Если Окр(средняяКонверсия, 2) >= ВыборкаДиректорМагазин.КонверсияПланМесяц Тогда 
			ОбластьДиректор.Параметры.ВыполняемостьПоКонверсии = "Выполнено";
			ОбластьДиректор.Область("ВыполняемостьПоКонверсииДиректора").ЦветФона = WebЦвета.СветлоЗеленый;
		Иначе
			ОбластьДиректор.Параметры.ВыполняемостьПоКонверсии = "Не выполнено";
			ОбластьДиректор.Область("ВыполняемостьПоКонверсииДиректора").ЦветФона = WebЦвета.Томатный;
		КонецЕсли;
		
		Если Окр(среднееКПЧ, 2) >= ВыборкаДиректорМагазин.КПЧПланМесяц Тогда 
			ОбластьДиректор.Параметры.ВыполняемостьПоКПЧ = "Выполнено";
			ОбластьДиректор.Область("ВыполняемостьПоКПЧДиректора").ЦветФона = WebЦвета.СветлоЗеленый;
		Иначе
			ОбластьДиректор.Параметры.ВыполняемостьПоКПЧ = "Не выполнено";
			ОбластьДиректор.Область("ВыполняемостьПоКПЧДиректора").ЦветФона = WebЦвета.Томатный;
		КонецЕсли;
		
		Если Окр(среднийЧек, 2) >= ВыборкаДиректорМагазин.СреднийЧекПланМесяц Тогда 
			ОбластьДиректор.Параметры.ВыполняемостьПоСЧ = "Выполнено";
			ОбластьДиректор.Область("ВыполняемостьПоСЧДиректора").ЦветФона = WebЦвета.СветлоЗеленый;
		Иначе
			ОбластьДиректор.Параметры.ВыполняемостьПоСЧ = "Не выполнено";
			ОбластьДиректор.Область("ВыполняемостьПоСЧДиректора").ЦветФона = WebЦвета.Томатный;
		КонецЕсли;
		
		печатнаяФорма.Вывести(ОбластьДиректор);
		
		ОбластьШапкаПродавец = Макет.ПолучитьОбласть("ОбластьШапкаПродавец");
		печатнаяФорма.Вывести(ОбластьШапкаПродавец);
		
		ВыборкаПродавецМагазин.Сбросить();
		Пока ВыборкаПродавецМагазин.Следующий() Цикл 
			Если ВыборкаПродавецМагазин.Магазин <> ВыборкаДиректорМагазин.Магазин Тогда 
				Продолжить;
			КонецЕсли;
			
			ВыборкаПродавецДолжность = ВыборкаПродавецМагазин.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПродавецДолжность.Следующий() Цикл 
				
				ВыборкаПродавецФИО = ВыборкаПродавецДолжность.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаПродавецФИО.Следующий() Цикл 
					Если ВыборкаДиректорМагазин.Продавец = ВыборкаПродавецФИО.Продавец Тогда
						Продолжить;
					КонецЕсли;
					ОбластьПродавец = Макет.ПолучитьОбласть("ОбластьПродавец");
					
					НайдСтрЕжОтчет = ВыгрузкаЕжОтчет.НайтиСтроки(Новый Структура("Сотрудник,Магазин",ВыборкаПродавецФИО.Продавец,ВыборкаПродавецФИО.Магазин));
					КоличествоРабДней = 0;
					РабочиеДни = Новый СписокЗначений;
					Для Каждого СтрЕжОтчет из НайдСтрЕжОтчет Цикл 
						ИмяПараметра = "СуммаДень"+Строка(день(СтрЕжОтчет.ДатаОтчета));
						ОбластьПродавец.Параметры[ИмяПараметра] = Формат(0,"ЧДЦ=2");
						
						ИмяПараметра = "КонверсияДень"+Строка(день(СтрЕжОтчет.ДатаОтчета));
						ОбластьПродавец.Параметры[ИмяПараметра] = Формат(0,"ЧДЦ=2");
						
						ИмяПараметра = "КПЧДень"+Строка(день(СтрЕжОтчет.ДатаОтчета));
						ОбластьПродавец.Параметры[ИмяПараметра] = Формат(0,"ЧДЦ=2");
						
						ИмяПараметра = "СЧДень"+Строка(день(СтрЕжОтчет.ДатаОтчета));
						ОбластьПродавец.Параметры[ИмяПараметра] = Формат(0,"ЧДЦ=2");
						
						КоличествоРабДней = КоличествоРабДней+1;
						РабочиеДни.Добавить(СтрЕжОтчет.ДатаОтчета);
					КонецЦикла;
					
					ВыборкаДиректорДень.Сбросить();
					СуммаКонверсия = 0;
					Пока ВыборкаДиректорДень.Следующий() Цикл 				
						Если РабочиеДни.НайтиПоЗначению(ВыборкаДиректорДень.Дата) <> Неопределено Тогда 
							ИмяПараметра = "КонверсияДень"+Строка(день(ВыборкаДиректорДень.Дата));
							ОбластьПродавец.Параметры[ИмяПараметра] = Формат(ВыборкаДиректорДень.Конверсия,"ЧДЦ=2");
							СуммаКонверсия = СуммаКонверсия+ВыборкаДиректорДень.Конверсия;
						КонецЕсли;										
					КонецЦикла;
					
					ФактКонверсия = ?(КоличествоРабДней = 0, 0, СуммаКонверсия / КоличествоРабДней);
					
					ФИОСрез = РегистрыСведений.ФИОФизЛиц.ПолучитьПоследнее(,Новый Структура("ФизЛицо",ВыборкаПродавецФИО.Продавец));
					ОбластьПродавец.Параметры.ФИО = ФИОСрез.Фамилия+" "+Лев(ФИОСрез.Имя,1)+". "+Лев(ФИОСрез.Отчество,1)+".";
					ОбластьПродавец.Параметры.ПланСумма = Формат(ВыборкаПродавецФИО.ПланПродавца,"ЧДЦ=2");
					ОбластьПродавец.Параметры.ПланКонверсия = Формат(ВыборкаПродавецФИО.КонверсияПланМесяц,"ЧДЦ=2");
					ОбластьПродавец.Параметры.ПланКПЧ = Формат(ВыборкаПродавецФИО.КПЧПланМесяц,"ЧДЦ=2");
					ОбластьПродавец.Параметры.ПланСЧ = Формат(ВыборкаПродавецФИО.СреднийЧекПланМесяц,"ЧДЦ=2");
					ОбластьПродавец.Параметры.ФактСумма = Формат(ВыборкаПродавецФИО.СуммаДокумента,"ЧДЦ=2");
					
					Если Окр(ВыборкаПродавецФИО.СуммаДокумента, 2) >= ВыборкаПродавецФИО.ПланПродавца Тогда 
						ОбластьПродавец.Параметры.ВыполняемостьПоСумме = "Выполнено";
						ОбластьПродавец.Область("ВыполняемостьПоСуммеПродавца").ЦветФона = WebЦвета.СветлоЗеленый;
					Иначе
						ОбластьПродавец.Параметры.ВыполняемостьПоСумме = "Не выполнено";
						ОбластьПродавец.Область("ВыполняемостьПоСуммеПродавца").ЦветФона = WebЦвета.Томатный;
					КонецЕсли;
					
					ДеньПоследний = День(ПараметрыОтчета.КонецПериода);
					ИндДень = 1;
					Пока ИндДень <= ДеньПоследний Цикл 
						ИмяПараметра = "День"+Строка(ИндДень);
						ОбластьПродавец.Параметры[ИмяПараметра] = Формат(НачалоМесяца(ПараметрыОтчета.НачалоПериода) + (ИндДень*60*60*24) - 60*60*24, "ДФ='dd MMMM'");
						ИндДень=ИндДень+1;
					КонецЦикла;
					
					ВыборкаПродавецДень = ВыборкаПродавецФИО.Выбрать();
					среднееКПЧ = 0;
					среднийЧек = 0;
					средняяКонверсия = 0;
					числоДнейКПЧ = 0;
					числоДнейСЧ = 0;
					числоДнейКонверсии = 0;
					Пока ВыборкаПродавецДень.Следующий() Цикл 
						ИмяПараметра = "СуммаДень"+Строка(день(ВыборкаПродавецДень.Дата));
						ОбластьПродавец.Параметры[ИмяПараметра] = Формат(ВыборкаПродавецДень.СуммаДокумента,"ЧДЦ=2");
						
						ИмяПараметра = "КПЧДень"+Строка(день(ВыборкаПродавецДень.Дата));
						кпч = ВыборкаПродавецДень.СреднееКПЧ;
						Если кпч > 0.000001 И кпч < 1 Тогда
							кпч = 1;
						КонецЕсли;
						ОбластьПродавец.Параметры[ИмяПараметра] = Формат(кпч, "ЧДЦ=2");
						
						ИмяПараметра = "СЧДень" + Строка(день(ВыборкаПродавецДень.Дата));
						Если ВыборкаПродавецДень.ЧислоЧеков > 0 Тогда
							ОбластьПродавец.Параметры[ИмяПараметра] = Формат(ВыборкаПродавецДень.СреднийЧек,"ЧДЦ=2");
						КонецЕсли;
						Если ВыборкаПродавецДень.Конверсия > 0 И ВыборкаПродавецДень.ЧислоЧеков > 0 Тогда
							средняяКонверсия = средняяКонверсия + ВыборкаПродавецДень.Конверсия;
							числоДнейКонверсии = числоДнейКонверсии + 1;
						КонецЕсли;
						конверсия = ОбластьПродавец.Параметры[СтрШаблон("КонверсияДень%1", День(ВыборкаПродавецДень.Дата))];
						Если НЕ ЗначениеЗаполнено(конверсия) Тогда
							Если ВыборкаПродавецДень.СуммаДокумента <> 0 И ВыборкаПродавецДень.ЧислоЧеков > 0 Тогда
								ВыборкаДиректорДень.Сбросить();
								Если ВыборкаДиректорДень.НайтиСледующий(ВыборкаПродавецДень.Дата, "Дата") Тогда
									ОбластьПродавец.Параметры[СтрШаблон("КонверсияДень%1", День(ВыборкаПродавецДень.Дата))] = Формат(ВыборкаДиректорДень.Конверсия, "ЧДЦ=2");
									СуммаКонверсия = СуммаКонверсия + ВыборкаДиректорДень.Конверсия;
									учтено = Ложь;
									Для Каждого строкаОтчета Из НайдСтрЕжОтчет Цикл
										учтено = строкаОтчета.ДатаОтчета = ВыборкаПродавецДень.Дата;
										учтено = учтено И строкаОтчета.Сотрудник = ВыборкаПродавецДень.Продавец;
										учтено = учтено И строкаОтчета.Магазин = ВыборкаПродавецДень.Магазин;
										Если учтено Тогда
											Прервать;
										КонецЕсли;
									КонецЦикла;
									Если Не учтено Тогда
										КоличествоРабДней = КоличествоРабДней + 1;
									КонецЕсли;
								КонецЕсли
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					ФактКонверсия = ?(КоличествоРабДней = 0, 0, СуммаКонверсия / КоличествоРабДней);
					// Галантерея 05.11.2026: товары и чеки без галантереи (подарочные карты уже исключены в запросе)
					количествоТоваров = ВыборкаПродавецФИО.КоличествоТоваров;
					среднееКПЧ = ?(ВыборкаПродавецФИО.ЧековБезГалантереи = 0, 0, количествоТоваров / ВыборкаПродавецФИО.ЧековБезГалантереи);
					Если среднееКПЧ > 0.000001 И среднееКПЧ < 1 Тогда
						среднееКПЧ = 1;
					КонецЕсли;
					среднийЧек = ?(ВыборкаПродавецФИО.ЧековБезГалантереи = 0, 0,
						ВыборкаПродавецФИО.ВыручкаДляСЧ / ВыборкаПродавецФИО.ЧековБезГалантереи);
					ОбластьПродавец.Параметры.ФактКПЧ = Формат(среднееКПЧ, "ЧДЦ=2");
					ОбластьПродавец.Параметры.ФактСЧ = Формат(среднийЧек, "ЧДЦ=2");
					ОбластьПродавец.Параметры.ФактКонверсия = Формат(ФактКонверсия,"ЧДЦ=2");
					
					Если Окр(ФактКонверсия, 2) >= ВыборкаПродавецФИО.КонверсияПланМесяц Тогда 
						ОбластьПродавец.Параметры.ВыполняемостьПоКонверсии = "Выполнено";
						ОбластьПродавец.Область("ВыполняемостьПоКонверсииПродавца").ЦветФона = WebЦвета.СветлоЗеленый;
					Иначе
						ОбластьПродавец.Параметры.ВыполняемостьПоКонверсии = "Не выполнено";
						ОбластьПродавец.Область("ВыполняемостьПоКонверсииПродавца").ЦветФона = WebЦвета.Томатный;
					КонецЕсли;
					
					Если Окр(среднееКПЧ, 2) >= ВыборкаПродавецФИО.КПЧПланМесяц Тогда 
						ОбластьПродавец.Параметры.ВыполняемостьПоКПЧ = "Выполнено";
						ОбластьПродавец.Область("ВыполняемостьПоКПЧПродавца").ЦветФона = WebЦвета.СветлоЗеленый;
					Иначе
						ОбластьПродавец.Параметры.ВыполняемостьПоКПЧ = "Не выполнено";
						ОбластьПродавец.Область("ВыполняемостьПоКПЧПродавца").ЦветФона = WebЦвета.Томатный;
					КонецЕсли;
					
					Если Окр(среднийЧек, 2) >= ВыборкаПродавецФИО.СреднийЧекПланМесяц Тогда
						ОбластьПродавец.Параметры.ВыполняемостьПоСЧ = "Выполнено";
						ОбластьПродавец.Область("ВыполняемостьПоСЧПродавца").ЦветФона = WebЦвета.СветлоЗеленый;
					Иначе
						ОбластьПродавец.Параметры.ВыполняемостьПоСЧ = "Не выполнено";
						ОбластьПродавец.Область("ВыполняемостьПоСЧПродавца").ЦветФона = WebЦвета.Томатный;
					КонецЕсли;
					
					печатнаяФорма.Вывести(ОбластьПродавец);
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	Возврат печатнаяФорма;
КонецФункции

// Галантерея 05.11.2026
// Группы номенклатуры, которые не учитываются в КПЧ и среднем чеке.
// Чеки, в которых есть только товары из этих групп, тоже не учитываются.
Функция ГруппыГалантереи()

	имена = Новый Массив;
	имена.Добавить("1.1.25 РЕМНИ");
	имена.Добавить("1.1.9 ПЛАТКИ, ПАЛАНТИНЫ");
	имена.Добавить("1.2.9. БИЖУТЕРИЯ");
	имена.Добавить("2. ГАЛАНТЕРЕЯ");
	имена.Добавить("7. ПОДАРОЧНЫЕ СЕРТИФИКАТЫ");
	имена.Добавить("7.1. ВНУТРЕННИЕ ПОДАРОЧНЫЕ СЕРТИФИКАТЫ");
	имена.Добавить("8. ОБОРУДОВАНИЕ");
	имена.Добавить("9.1. ПАКЕТЫ");
	имена.Добавить("3. SoLi's");
	имена.Добавить("4. DUTY STYLE");

	списокГрупп = Новый СписокЗначений;
	Для Каждого имя Из имена Цикл
		группа = Справочники.Номенклатура.НайтиПоНаименованию(имя, Истина);
		Если ЗначениеЗаполнено(группа) Тогда
			списокГрупп.Добавить(группа);
		Иначе
			Сообщить("Отчет по показателям АТТ: не найдена группа номенклатуры """ + имя + """, она не исключена из КПЧ и среднего чека.");
		КонецЕсли;
	КонецЦикла;

	Возврат списокГрупп;

КонецФункции