// Документ «Чек ККМ» → форма «ФормаДК» (окно бонусов) → модуль формы.
// Изменения помечены комментарием «Бонусы и маркетинг 20.11.2026».

// ===== 1. Процедуру ОсновныеДействияФормыОтмена заменить целиком =====

Процедура ОсновныеДействияФормыОтмена(Кнопка)

	// НАЧАЛО 2023-05-12 Носкова Г.Н.
	Для Каждого СтрокаСкидки из ДокументЧекККМ.Скидки Цикл
		Если СтрокаСкидки.СкидкаНаценка.БонуснаяСхема Тогда

			// Баранников Антон 31.08.2026 Начало
			Если СтрокаСкидки.СкидкаНаценка.Маркетинг Тогда
				Продолжить;
			КонецЕсли;
			// Баранников Антон 31.08.2026 Конец

			СтрокаСкидки.Сумма = 0;
			кл = СтрокаСкидки.КлючСтроки;

			// Бонусы и маркетинг 20.11.2026 Начало
			// На товаре действует скидка маркетинга: его сумма уже посчитана с этой скидкой,
			// бонусы еще не применялись. Полную цену не возвращаем, иначе пропадает скидка маркетинга.
			Если ЕстьСкидкаМаркетинга(кл) Тогда
				Продолжить;
			КонецЕсли;
			// Бонусы и маркетинг 20.11.2026 Конец

			ИскомыйТовар = ДокументЧекККМ.товары.Найти(кл, "КлючСтроки");
			если не ИскомыйТовар = Неопределено Тогда
				ИскомыйТовар.ПроцентСкидкиНаценки = 0;
				ИскомыйТовар.Сумма = ИскомыйТовар.Количество * ИскомыйТовар.Цена;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ЭтаФорма.Модифицированность = Ложь;
	// ОКОНЧАНИЕ 2023-05-12 Носкова Г.Н.

	ЭтаФорма.Закрыть();
КонецПроцедуры

// Бонусы и маркетинг 20.11.2026 Начало
// Есть ли на строке товара скидка маркетинга с ненулевой суммой
Функция ЕстьСкидкаМаркетинга(КлючСтроки)

	Для Каждого СтрокаСкидки Из ДокументЧекККМ.Скидки Цикл
		Если СтрокаСкидки.КлючСтроки = КлючСтроки
			И СтрокаСкидки.Сумма <> 0
			И ЗначениеЗаполнено(СтрокаСкидки.СкидкаНаценка)
			И СтрокаСкидки.СкидкаНаценка.Маркетинг Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции
// Бонусы и маркетинг 20.11.2026 Конец


// ===== 2. В начало процедуры ОсновныеДействияФормыРаспределитьСкидку =====
// (сразу после строки «Процедура ОсновныеДействияФормыРаспределитьСкидку(Кнопка)») вставить:

	// Бонусы и маркетинг 20.11.2026 Начало
	// Бонусы не списываются: распределять нечего. Закрываем окно как по «Отмена»,
	// иначе пересчет с нулевым процентом вернет товарам полную цену и сбросит скидки маркетинга.
	Если ПримененнаяСкидка = 0 Тогда
		ОсновныеДействияФормыОтмена(Кнопка);
		Возврат;
	КонецЕсли;
	// Бонусы и маркетинг 20.11.2026 Конец
