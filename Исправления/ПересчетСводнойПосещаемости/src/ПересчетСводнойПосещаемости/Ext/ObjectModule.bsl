// Разовый пересчет регистра «Статистика посещаемости сводно (УмКо)» за произвольный период.
//
// Вызывает УмКо_НаправлениеСводногоОтчетаОтветственным.СвернутьСтатистикуПосещаемости(ДатаНач, ДатаКон) по месяцам,
// поэтому работает только после замены этой процедуры на исправленную версию (с параметрами дат).
// Каждый день периода пересобирается из детального регистра целиком: лишние записи удаляются,
// помеченные на удаление счетчики не учитываются.
//
// Обработка без формы (обычное приложение): открыть через Файл → Открыть, даты спрашиваются диалогами.

Процедура ЗапуститьПересчет() Экспорт

	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УмКо_СтатистикаПосещаемостиСводно) Тогда
		Предупреждение("Нет права на изменение регистра «Статистика посещаемости сводно (УмКо)»." + Символы.ПС
			+ "Запустите обработку под пользователем с правами администратора.");
		Возврат;
	КонецЕсли;

	ДатаНач = Дата(2026, 8, 1);
	Если Не ВвестиДату(ДатаНач, "Пересчитать свод С даты", ЧастиДаты.Дата) Тогда
		Возврат;
	КонецЕсли;
	ДатаКон = ТекущаяДата();
	Если Не ВвестиДату(ДатаКон, "Пересчитать свод ПО дату", ЧастиДаты.Дата) Тогда
		Возврат;
	КонецЕсли;
	ДатаНач = НачалоДня(ДатаНач);
	ДатаКон = КонецДня(ДатаКон);
	Если ДатаКон < ДатаНач Тогда
		Предупреждение("Дата окончания меньше даты начала.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Сводный регистр посещаемости будет пересобран за период с "
		+ Формат(ДатаНач, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаКон, "ДФ=dd.MM.yyyy") + "." + Символы.ПС
		+ "Записи за эти дни будут заменены суммами из детального регистра. Продолжить?";
	Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// По месяцу за вызов, чтобы не выгружать в память весь детальный регистр сразу
	Месяц = НачалоМесяца(ДатаНач);
	Пока Месяц <= ДатаКон Цикл

		Начало = Макс(Месяц, ДатаНач);
		Конец = Мин(КонецМесяца(Месяц), ДатаКон);
		Состояние("Пересчет свода посещаемости: " + Формат(Начало, "ДФ=dd.MM.yyyy") + " - " + Формат(Конец, "ДФ=dd.MM.yyyy"));

		Попытка
			УмКо_НаправлениеСводногоОтчетаОтветственным.СвернутьСтатистикуПосещаемости(Начало, Конец);
		Исключение
			Предупреждение("Ошибка при пересчете за " + Формат(Начало, "ДФ='MMMM yyyy'") + ":" + Символы.ПС + ОписаниеОшибки()
				+ Символы.ПС + Символы.ПС + "Предыдущие месяцы уже пересчитаны.");
			Возврат;
		КонецПопытки;

		Сообщить("Пересчитано: " + Формат(Начало, "ДФ=dd.MM.yyyy") + " - " + Формат(Конец, "ДФ=dd.MM.yyyy"));
		Месяц = ДобавитьМесяц(Месяц, 1);

	КонецЦикла;

	Предупреждение("Готово. Сводный регистр пересчитан с " + Формат(ДатаНач, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаКон, "ДФ=dd.MM.yyyy") + ".");

КонецПроцедуры

// Формы у обработки нет: при открытии файла сразу запускаем диалоги
ЗапуститьПересчет();
