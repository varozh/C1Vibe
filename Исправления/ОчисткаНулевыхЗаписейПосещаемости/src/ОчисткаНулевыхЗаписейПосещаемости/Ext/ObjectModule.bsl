// Удаление нулевых записей из регистра «Статистика посещаемости (УмКо)» (УмКо_СтатистикаПосещаемости).
//
// Удаляются записи, у которых одновременно КоличествоВходов = 0 и КоличествоВыходов = 0
// и не установлен признак Блокировка (строки блокировки счетчика сохраняются).
// Ненулевые записи не трогаются, поэтому суммы посещаемости в отчетах и в сводном регистре не меняются.
//
// Порядок работы: период → подсчет нулевых записей → подтверждение → удаление по дням.
// Каждый день — отдельная транзакция: при ошибке откатывается только этот день, остальные продолжаются.
// Прервать можно Ctrl+Break: уже обработанные дни останутся очищенными, повторный запуск продолжит с начала периода.
// Удаление НЕОБРАТИМО — перед запуском сделайте копию базы.
//
// Обработка без формы (обычное приложение): открыть через Файл → Открыть, дальше всё спрашивается диалогами.

Функция ЧислоСПробелами(Число)

	Возврат Формат(Число, "ЧН=0; ЧГ=3,0");

КонецФункции

Функция ПодсчитатьНулевые(ДатаНач, ДатаКон)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.УмКо_СтатистикаПосещаемости КАК Статистика
	|ГДЕ
	|	Статистика.Период МЕЖДУ &ДатаНач И &ДатаКон
	|	И Статистика.КоличествоВходов = 0
	|	И Статистика.КоличествоВыходов = 0
	|	И НЕ Статистика.Блокировка";
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

// Устройства, у которых за день есть нулевые записи
Функция УстройстваСНулями(День)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Статистика.Устройство КАК Устройство
	|ИЗ
	|	РегистрСведений.УмКо_СтатистикаПосещаемости КАК Статистика
	|ГДЕ
	|	Статистика.Период = &День
	|	И Статистика.КоличествоВходов = 0
	|	И Статистика.КоличествоВыходов = 0
	|	И НЕ Статистика.Блокировка";
	Запрос.УстановитьПараметр("День", День);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Устройство");

КонецФункции

// Удаляет нулевые записи за день; возвращает количество удаленных записей
Функция ОчиститьДень(День)

	Устройства = УстройстваСНулями(День);
	Если Устройства.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Удалено = 0;
	НачатьТранзакцию();
	Попытка

		Для Каждого Устройство Из Устройства Цикл

			Набор = РегистрыСведений.УмКо_СтатистикаПосещаемости.СоздатьНаборЗаписей();
			Набор.Отбор.Период.Установить(День);
			Набор.Отбор.Устройство.Установить(Устройство);
			Набор.Прочитать();

			УдаленоВНаборе = 0;
			Индекс = Набор.Количество() - 1;
			Пока Индекс >= 0 Цикл
				Запись = Набор[Индекс];
				Если Запись.КоличествоВходов = 0 И Запись.КоличествоВыходов = 0 И Не Запись.Блокировка Тогда
					Набор.Удалить(Индекс);
					УдаленоВНаборе = УдаленоВНаборе + 1;
				КонецЕсли;
				Индекс = Индекс - 1;
			КонецЦикла;

			Если УдаленоВНаборе > 0 Тогда
				Набор.Записать(Истина);
				Удалено = Удалено + УдаленоВНаборе;
			КонецЕсли;

		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОтменитьТранзакцию();
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Возврат Удалено;

КонецФункции

Процедура ЗапуститьОчистку() Экспорт

	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УмКо_СтатистикаПосещаемости) Тогда
		Предупреждение("Нет права на изменение регистра «Статистика посещаемости (УмКо)»." + Символы.ПС
			+ "Запустите обработку под пользователем с правами администратора.");
		Возврат;
	КонецЕсли;

	ДатаНач = Дата(2023, 1, 1);
	Если Не ВвестиДату(ДатаНач, "Удалить нулевые записи С даты", ЧастиДаты.Дата) Тогда
		Возврат;
	КонецЕсли;
	ДатаКон = ТекущаяДата();
	Если Не ВвестиДату(ДатаКон, "Удалить нулевые записи ПО дату", ЧастиДаты.Дата) Тогда
		Возврат;
	КонецЕсли;
	ДатаНач = НачалоДня(ДатаНач);
	ДатаКон = КонецДня(ДатаКон);
	Если ДатаКон < ДатаНач Тогда
		Предупреждение("Дата окончания меньше даты начала.");
		Возврат;
	КонецЕсли;

	Состояние("Подсчет нулевых записей...");
	ВсегоНулевых = ПодсчитатьНулевые(ДатаНач, ДатаКон);
	Если ВсегоНулевых = 0 Тогда
		Предупреждение("За период с " + Формат(ДатаНач, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаКон, "ДФ=dd.MM.yyyy")
			+ " нулевых записей нет.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "За период с " + Формат(ДатаНач, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаКон, "ДФ=dd.MM.yyyy") + Символы.ПС
		+ "найдено нулевых записей (входов = 0 и выходов = 0): " + ЧислоСПробелами(ВсегоНулевых) + "." + Символы.ПС + Символы.ПС
		+ "Они будут БЕЗВОЗВРАТНО удалены. Записи с ненулевыми значениями и строки блокировки не затрагиваются." + Символы.ПС
		+ "Обработка идет по дням и может занять продолжительное время; прервать — Ctrl+Break." + Символы.ПС + Символы.ПС
		+ "Копия базы сделана? Продолжить?";
	Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ВсегоУдалено = 0;
	УдаленоЗаМесяц = 0;
	ДнейСОшибкой = 0;
	День = ДатаНач;
	Пока День <= ДатаКон Цикл

		// Ctrl+Break между днями: обработанные дни уже записаны
		ОбработкаПрерыванияПользователя();

		Состояние("Удаление нулевых записей: " + Формат(День, "ДФ=dd.MM.yyyy")
			+ ", удалено " + ЧислоСПробелами(ВсегоУдалено) + " из " + ЧислоСПробелами(ВсегоНулевых));

		Попытка
			УдаленоЗаДень = ОчиститьДень(День);
			ВсегоУдалено = ВсегоУдалено + УдаленоЗаДень;
			УдаленоЗаМесяц = УдаленоЗаМесяц + УдаленоЗаДень;
		Исключение
			ДнейСОшибкой = ДнейСОшибкой + 1;
			Сообщить("ОШИБКА за " + Формат(День, "ДФ=dd.MM.yyyy") + ": " + ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;

		Если День = НачалоДня(КонецМесяца(День)) Или День + 86400 > ДатаКон Тогда
			Сообщить(Формат(День, "ДФ='MMMM yyyy'") + ": удалено " + ЧислоСПробелами(УдаленоЗаМесяц));
			УдаленоЗаМесяц = 0;
		КонецЕсли;

		День = День + 86400;

	КонецЦикла;

	Предупреждение("Готово. Удалено нулевых записей: " + ЧислоСПробелами(ВсегоУдалено)
		+ " из " + ЧислоСПробелами(ВсегоНулевых) + "."
		+ ?(ДнейСОшибкой > 0, Символы.ПС + "Дней с ошибкой: " + ДнейСОшибкой + " (подробности — в окне сообщений).", ""));

КонецПроцедуры

// Формы у обработки нет: при открытии файла сразу запускаем диалоги
ЗапуститьОчистку();
