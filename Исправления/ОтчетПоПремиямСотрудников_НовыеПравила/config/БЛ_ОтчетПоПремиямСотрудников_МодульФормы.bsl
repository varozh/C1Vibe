// ---- Именованные настройки отчета (магазин и группы товаров), хранятся для каждого пользователя ----

Функция ПолучитьХранилищеНастроек()
	Данные = Неопределено;
	Попытка
		Данные = ХранилищеОбщихНастроек.Загрузить("БЛ_ОтчетПоПремиямСотрудников", "ИменованныеНастройки");
	Исключение
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("Список") Или Не Данные.Свойство("Последняя") Тогда
		Данные = Новый Структура("Список, Последняя", Новый Соответствие, "");
	КонецЕсли;
	Возврат Данные;
КонецФункции

Процедура СохранитьХранилищеНастроек(Данные)
	Попытка
		ХранилищеОбщихНастроек.Сохранить("БЛ_ОтчетПоПремиямСотрудников", "ИменованныеНастройки", Данные);
	Исключение
		Предупреждение("Не удалось сохранить настройки: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция ТекущиеНастройкиФормы()
	Настройки = Новый Структура;
	Настройки.Вставить("Магазин", Магазин);
	Настройки.Вставить("Номенклатура", Номенклатура.ВыгрузитьЗначения());
	Настройки.Вставить("ГруппыСопутки", ГруппыСопутки.ВыгрузитьЗначения());
	Возврат Настройки;
КонецФункции

Процедура ПрименитьНастройкиФормы(Настройки)
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Настройки.Свойство("Магазин") Тогда
		Магазин = Настройки.Магазин;
	КонецЕсли;
	Если Настройки.Свойство("Номенклатура") И ТипЗнч(Настройки.Номенклатура) = Тип("Массив") Тогда
		Номенклатура.ЗагрузитьЗначения(Настройки.Номенклатура);
	КонецЕсли;
	Если Настройки.Свойство("ГруппыСопутки") И ТипЗнч(Настройки.ГруппыСопутки) = Тип("Массив") Тогда
		ГруппыСопутки.ЗагрузитьЗначения(Настройки.ГруппыСопутки);
	КонецЕсли;
КонецПроцедуры

// При открытии применяется последняя сохраненная/выбранная настройка.
Процедура ЗагрузитьНастройкиОтчета()
	Данные = ПолучитьХранилищеНастроек();
	Если Не ПустаяСтрока(Данные.Последняя) Тогда
		ПрименитьНастройкиФормы(Данные.Список[Данные.Последняя]);
	КонецЕсли;
КонецПроцедуры

Процедура КнопкаСохранитьНастройкиНажатие(Кнопка)
	Данные = ПолучитьХранилищеНастроек();
	Имя = Данные.Последняя;
	Если ПустаяСтрока(Имя) Тогда
		Имя = "Основная";
	КонецЕсли;
	Если Не ВвестиСтроку(Имя, "Название настройки (с тем же названием - перезапись)", 100) Тогда
		Возврат;
	КонецЕсли;
	Имя = СокрЛП(Имя);
	Если ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;
	Если Данные.Список[Имя] <> Неопределено Тогда
		Если Вопрос("Настройка """ + Имя + """ уже есть. Перезаписать?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Данные.Список.Вставить(Имя, ТекущиеНастройкиФормы());
	Данные.Последняя = Имя;
	СохранитьХранилищеНастроек(Данные);
	Сообщить("Настройка """ + Имя + """ сохранена.");
КонецПроцедуры

Процедура КнопкаВыбратьНастройкуНажатие(Кнопка)
	Данные = ПолучитьХранилищеНастроек();
	Если Данные.Список.Количество() = 0 Тогда
		Предупреждение("Сохраненных настроек нет. Нажмите ""Сохранить настройки"".");
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Для Каждого Элемент Из Данные.Список Цикл
		Список.Добавить(Элемент.Ключ);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Выбор = Список.ВыбратьЭлемент("Выберите настройку");
	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ответ = Вопрос("Настройка """ + Выбор.Значение + """:" + Символы.ПС + "Да - применить, Нет - удалить, Отмена - закрыть.", РежимДиалогаВопрос.ДаНетОтмена);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПрименитьНастройкиФормы(Данные.Список[Выбор.Значение]);
		Данные.Последняя = Выбор.Значение;
		СохранитьХранилищеНастроек(Данные);
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Данные.Список.Удалить(Выбор.Значение);
		Если Данные.Последняя = Выбор.Значение Тогда
			Данные.Последняя = "";
		КонецЕсли;
		СохранитьХранилищеНастроек(Данные);
	КонецЕсли;
КонецПроцедуры