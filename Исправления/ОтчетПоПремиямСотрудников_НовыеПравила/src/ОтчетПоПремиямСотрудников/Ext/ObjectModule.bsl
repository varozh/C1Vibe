	                           |	ЕСТЬNULL(ВТ_Нормы.КПЧ, 0),
	                           |	ЕСТЬNULL(ВТ_Нормы.СреднийЧек, 0),
	                           |	ЕСТЬNULL(ВТ_СуммаЧековИИхКоличество.ЧековПродажиБезКарт, 0),
	                           |	ЕСТЬNULL(ВТ_СуммаЧековИИхКоличество.СуммаПродажиПодарочнойКарты, 0),
