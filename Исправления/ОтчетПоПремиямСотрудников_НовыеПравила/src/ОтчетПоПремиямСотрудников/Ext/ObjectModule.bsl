	|ИЗ
	|	Документ.ЧекККМ КАК ЧекККМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЧекиВозврата КАК т2
	|		ПО ЧекККМ.Ссылка = т2.ЧекВозврата
	|ГДЕ
	|	ЧекККМ.Дата МЕЖДУ &ДатаН И &ДатаК
	|	И ЧекККМ.Проведен = ИСТИНА
	|	И ЧекККМ.НомерЧекаККМ <> 0
	|	И ЧекККМ.Продавец В ИЕРАРХИИ(&ГруппаПродавцов)
	|	И т2.ЧекВозврата ЕСТЬ NULL
	|	И ЧекККМ.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.Склад.Магазин КАК Магазин,
	|	т.СтоимостьОборот КАК Выручка,
