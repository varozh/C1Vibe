	|	Магазин";

	Запрос.УстановитьПараметр("ДатаК",КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("ДатаН",НачалоДня(ПараметрыОтчета.НачалоПериода));
	Запрос.УстановитьПараметр("Должность","директор");
	Запрос.УстановитьПараметр("ПодарочныеКарты", подарочныеКарты);
	Запрос.УстановитьПараметр("Дождевик",Справочники.Номенклатура.НайтиПоНаименованию("Плащ модель 7.24.3", Истина));
	Запрос.УстановитьПараметр("ГруппаПродавцов", группаПродавцов);
	Запрос.УстановитьПараметр("ГруппыСопутки",ПараметрыОтчета.ГруппыСопутки);
	Запрос.УстановитьПараметр("ИсключаемыеГруппыТоваров", списокГрупп);
