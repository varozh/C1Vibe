// Отчет БЛ_АнализОстатковТоваровНаСкладахШК — копия отчета конфигурации УТ 10.3 «Анализ доступности товаров на складах».
// Изменения (17.11.2026):
//  - только фактический остаток на складах (регистры ТоварыНаСкладах и ТоварыВРознице) в единицах хранения;
//    резервы, «к получению», «к передаче», «заказано у поставщиков», свободный остаток, остатки в базовых
//    единицах и единицах отчетов, документ-основание, серия, качество, свойства и категории убраны;
//  - группировки строк по умолчанию: склад, номенклатура, характеристика номенклатуры;
//  - после остатка выводятся штрихкоды 46 (номенклатура + характеристика) организаций
//    ООО Талисман, ИП Ланков Е.В., ИП Зубарева Е.В. — каждый в своей колонке.
//    Какие штрихкоды выводить, задается флажками отборов «Выводить ШК 46: ...».
//    В списке показателей штрихкоды не показываются: они добавляются только на время формирования.
//    Штрихкоды 22 (производственные) и прочие не выводятся.

#Если Клиент Тогда

////////////////////////////////////////////////////////////////////////////////
// ШТРИХКОДЫ 46 ОРГАНИЗАЦИЙ

// Описание выводимых штрихкодов: поле отчета, отбор-флажок, организация (код), представление.
Функция ОписаниеШтрихкодов()

	Описание = Новый Массив;
	Описание.Добавить(Новый Структура("Показатель, Отбор, КодОрганизации, Представление",
		"ШК46Талисман", "ВыводитьШК46Талисман", "УТ0000001", "ООО Талисман"));
	Описание.Добавить(Новый Структура("Показатель, Отбор, КодОрганизации, Представление",
		"ШК46Ланков", "ВыводитьШК46Ланков", "000000002", "ИП Ланков Е.В."));
	Описание.Добавить(Новый Структура("Показатель, Отбор, КодОрганизации, Представление",
		"ШК46Зубарева", "ВыводитьШК46Зубарева", "УТ0000004", "ИП Зубарева Е.В."));

	Возврат Описание;

КонецФункции // ОписаниеШтрихкодов()

// Имя группы показателей штрихкодов (существует только во время формирования отчета).
Функция ИмяГруппыШтрихкодов()

	Возврат "Штрихкод46";

КонецФункции // ИмяГруппыШтрихкодов()

// Добавляет флажки «Выводить ШК 46: ...» в отборы, если их там нет
// (например, после восстановления настройки, сохраненной без них). По умолчанию флажки включены.
Процедура ДобавитьОтборыШтрихкодов()

	Для каждого ОписаниеШК из ОписаниеШтрихкодов() Цикл

		Если УниверсальныйОтчет.ПостроительОтчета.Отбор.Найти(ОписаниеШК.Отбор) = Неопределено Тогда

			УниверсальныйОтчет.ДобавитьОтбор(ОписаниеШК.Отбор, Истина, ВидСравнения.Равно, Истина);

		Иначе

			УниверсальныйОтчет.ДобавитьОтбор(ОписаниеШК.Отбор);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры // ДобавитьОтборыШтрихкодов()

// Удаляет показатели штрихкодов из списка показателей.
Процедура УдалитьПоказателиШтрихкодов()

	Группа = УниверсальныйОтчет.Показатели.Строки.Найти(ИмяГруппыШтрихкодов(), "Имя", Ложь);

	Если Группа <> Неопределено Тогда

		УниверсальныйОтчет.Показатели.Строки.Удалить(Группа);

	КонецЕсли;

КонецПроцедуры // УдалитьПоказателиШтрихкодов()

// Перед формированием: по флажкам «Выводить ШК 46: ...» добавляет колонки штрихкодов после остатка
// и выключает сами флажки (условий на данные они не накладывают).
// Возвращает массив выключенных элементов отбора, чтобы включить их после формирования.
Функция ПрименитьОтборыШтрихкодов()

	УдалитьПоказателиШтрихкодов();
	ДобавитьОтборыШтрихкодов();

	ВыключенныеОтборы = Новый Массив;
	Группа = Неопределено;

	Для каждого ОписаниеШК из ОписаниеШтрихкодов() Цикл

		ЭлементОтбора = УниверсальныйОтчет.ПостроительОтчета.Отбор.Найти(ОписаниеШК.Отбор);

		Если ЭлементОтбора = Неопределено ИЛИ НЕ ЭлементОтбора.Использование Тогда

			Продолжить;

		КонецЕсли;

		Выводить = (ЭлементОтбора.Значение = Истина);
		ЭлементОтбора.Использование = Ложь;
		ВыключенныеОтборы.Добавить(ЭлементОтбора);

		Если Выводить Тогда

			УниверсальныйОтчет.ДобавитьПоказатель(ОписаниеШК.Показатель, ОписаниеШК.Представление, Истина, "",
				ИмяГруппыШтрихкодов(), "Штрихкод 46", 15);
			Группа = УниверсальныйОтчет.Показатели.Строки.Найти(ИмяГруппыШтрихкодов(), "Имя", Ложь);

		КонецЕсли;

	КонецЦикла;

	Если Группа <> Неопределено Тогда

		УниверсальныйОтчет.УстановитьПометкиРодителей(Группа);

	КонецЕсли;

	Возврат ВыключенныеОтборы;

КонецФункции // ПрименитьОтборыШтрихкодов()

// После формирования: убирает колонки штрихкодов из показателей и включает флажки обратно.
Процедура ВернутьОтборыШтрихкодов(ВыключенныеОтборы)

	УдалитьПоказателиШтрихкодов();

	Для каждого ЭлементОтбора из ВыключенныеОтборы Цикл

		ЭлементОтбора.Использование = Истина;

	КонецЦикла;

КонецПроцедуры // ВернутьОтборыШтрихкодов()

// Текст соединения со штрихкодами 46 организаций (по номенклатуре и характеристике):
// один проход по регистру штрихкодов, по колонке на организацию.
// Если у пары номенклатура + характеристика несколько штрихкодов 46 одной организации, берется наибольший.
Функция ТекстСоединенияШтрихкодов()

	ПоляОрганизаций = "";
	КодыОрганизаций = "";

	Для каждого ОписаниеШК из ОписаниеШтрихкодов() Цикл

		ПоляОрганизаций = ПоляОрганизаций + ",
		|			МАКСИМУМ(ВЫБОР
		|					КОГДА Штрихкоды.Организация.Код = """ + ОписаниеШК.КодОрганизации + """
		|						ТОГДА Штрихкоды.Штрихкод
		|				КОНЕЦ) КАК " + ОписаниеШК.Показатель;

		КодыОрганизаций = КодыОрганизаций + ?(КодыОрганизаций = "", "", ", ") + """" + ОписаниеШК.КодОрганизации + """";

	КонецЦикла;

	Текст = "
	|	ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Штрихкоды.Владелец КАК Номенклатура,
	|			Штрихкоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры" + ПоляОрганизаций + "
	|		ИЗ
	|			РегистрСведений.Штрихкоды КАК Штрихкоды
	|		ГДЕ
	|			Штрихкоды.Штрихкод ПОДОБНО ""46%""
	|			И Штрихкоды.Организация.Код В (" + КодыОрганизаций + ")
	|		СГРУППИРОВАТЬ ПО
	|			Штрихкоды.Владелец,
	|			Штрихкоды.ХарактеристикаНоменклатуры) КАК Штрихкоды46
	|	ПО ВложенныйЗапрос.Номенклатура = Штрихкоды46.Номенклатура
	|		И ВложенныйЗапрос.ХарактеристикаНоменклатуры = Штрихкоды46.ХарактеристикаНоменклатуры";

	Возврат Текст;

КонецФункции // ТекстСоединенияШтрихкодов()

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ НАЧАЛЬНОЙ НАСТРОЙКИ ОТЧЕТА

// Процедура установки начальных настроек отчета с использованием текста запроса
//
Процедура УстановитьНачальныеНастройки(ДополнительныеПараметры = Неопределено) Экспорт

	УниверсальныйОтчет.мНазваниеОтчета = СокрЛП(ЭтотОбъект.Метаданные().Синоним);
	УниверсальныйОтчет.мВыбиратьИмяРегистра = Ложь;
	УниверсальныйОтчет.ОтрицательноеКрасным = Истина;

	// Свойства и категории не используются: флажок в настройке скрыт и выключен.
	УниверсальныйОтчет.мВыбиратьИспользованиеСвойств = Ложь;
	УниверсальныйОтчет.ИспользоватьСвойстваИКатегории = Ложь;

	// Список показателей строится заново (только остаток).
	УниверсальныйОтчет.Показатели.Строки.Очистить();

	// Поля, отборы и итоги по штрихкодам 46
	ПоляШК = "";
	ВыбратьШК = "";
	ГдеШК = "";
	ИтогиШК = "";

	Для каждого ОписаниеШК из ОписаниеШтрихкодов() Цикл

		ПолеШК = "ЕСТЬNULL(Штрихкоды46." + ОписаниеШК.Показатель + ", """")";

		ПоляШК = ПоляШК + ",
		|	" + ПолеШК + " КАК " + ОписаниеШК.Показатель;

		ВыбратьШК = ВыбратьШК + ",
		|	" + ОписаниеШК.Показатель;

		ГдеШК = ГдеШК + ",
		|	" + ПолеШК + " КАК " + ОписаниеШК.Показатель + ",
		|	ИСТИНА КАК " + ОписаниеШК.Отбор;

		// Штрихкод выводится в группировке, где он один (номенклатура + характеристика);
		// в итогах по складу или по номенклатуре с несколькими характеристиками — пусто.
		ИтогиШК = ИтогиШК + ",
		|	ВЫБОР
		|		КОГДА МАКСИМУМ(" + ОписаниеШК.Показатель + ") = МИНИМУМ(" + ОписаниеШК.Показатель + ")
		|			ТОГДА МАКСИМУМ(" + ОписаниеШК.Показатель + ")
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК " + ОписаниеШК.Показатель;

	КонецЦикла;

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Склад КАК Склад,
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.Склад) КАК СкладПредставление,
	|	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.Номенклатура) КАК НоменклатураПредставление,
	|	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.ХарактеристикаНоменклатуры) КАК ХарактеристикаНоменклатурыПредставление,
	|	ВложенныйЗапрос.КоличествоОстаток КАК КоличествоОстаток" + ПоляШК + "
	|{ВЫБРАТЬ
	|	Склад.*,
	|	Номенклатура.*,
	|	ХарактеристикаНоменклатуры.*,
	|	КоличествоОстаток" + ВыбратьШК + "}
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВложенныйЗапрос.Склад КАК Склад,
	|		ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|		ВложенныйЗапрос.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		СУММА(ВложенныйЗапрос.КоличествоОстаток) КАК КоличествоОстаток
	|	{ВЫБРАТЬ
	|		Склад,
	|		Номенклатура,
	|		ХарактеристикаНоменклатуры}
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ТоварыНаСкладахОстатки.Склад КАК Склад,
	|			ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|			ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|			ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	|		ИЗ
	|			РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаКон, {(Склад).* КАК Склад, (Номенклатура).* КАК Номенклатура, (ХарактеристикаНоменклатуры).* КАК ХарактеристикаНоменклатуры}) КАК ТоварыНаСкладахОстатки
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			ТоварыВРозницеОстатки.Склад,
	|			ТоварыВРозницеОстатки.Номенклатура,
	|			ТоварыВРозницеОстатки.ХарактеристикаНоменклатуры,
	|			ТоварыВРозницеОстатки.КоличествоОстаток
	|		ИЗ
	|			РегистрНакопления.ТоварыВРознице.Остатки(&ДатаКон, {(Склад).* КАК Склад, (Номенклатура).* КАК Номенклатура, (ХарактеристикаНоменклатуры).* КАК ХарактеристикаНоменклатуры}) КАК ТоварыВРозницеОстатки
	|		) КАК ВложенныйЗапрос
	|
	|	СГРУППИРОВАТЬ ПО
	|		ВложенныйЗапрос.Склад,
	|		ВложенныйЗапрос.Номенклатура,
	|		ВложенныйЗапрос.ХарактеристикаНоменклатуры
	|	) КАК ВложенныйЗапрос" + ТекстСоединенияШтрихкодов() + "
	|{ГДЕ
	|	ВложенныйЗапрос.КоличествоОстаток КАК КоличествоОстаток" + ГдеШК + "}
	|{УПОРЯДОЧИТЬ ПО
	|	Склад.*,
	|	Номенклатура.*,
	|	ХарактеристикаНоменклатуры.*,
	|	КоличествоОстаток" + ВыбратьШК + "}
	|ИТОГИ
	|	СУММА(КоличествоОстаток)" + ИтогиШК + "
	|ПО
	|	ОБЩИЕ
	|{ИТОГИ ПО
	|	Склад.*,
	|	Номенклатура.*,
	|	ХарактеристикаНоменклатуры.*}";

	УниверсальныйОтчет.ПостроительОтчета.Текст = ТекстЗапроса;

	// Представления полей отчета.
	УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить("Склад", "Склад");
	УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить("Номенклатура", "Номенклатура");
	УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить("ХарактеристикаНоменклатуры", "Характеристика номенклатуры");
	УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить("КоличествоОстаток", "Остаток");

	Для каждого ОписаниеШК из ОписаниеШтрихкодов() Цикл

		УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить(ОписаниеШК.Показатель, "Штрихкод 46 " + ОписаниеШК.Представление);
		УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить(ОписаниеШК.Отбор, "Выводить ШК 46: " + ОписаниеШК.Представление);

	КонецЦикла;

	// Единственный показатель — фактический остаток (в единицах хранения).
	УниверсальныйОтчет.ДобавитьПоказатель("КоличествоОстаток", "Остаток", Истина, "ЧЦ=15; ЧДЦ=3");

	// Группировки строк: склад, номенклатура, характеристика номенклатуры.
	УниверсальныйОтчет.ДобавитьИзмерениеСтроки("Склад");
	УниверсальныйОтчет.ДобавитьИзмерениеСтроки("Номенклатура");
	УниверсальныйОтчет.ДобавитьИзмерениеСтроки("ХарактеристикаНоменклатуры");

	// Отборы: склад, номенклатура и флажки организаций, по которым выводить штрихкод 46.
	УниверсальныйОтчет.ДобавитьОтбор("Склад");
	УниверсальныйОтчет.ДобавитьОтбор("Номенклатура");
	ДобавитьОтборыШтрихкодов();

	УниверсальныйОтчет.УстановитьПредставленияПолей(УниверсальныйОтчет.мСтруктураПредставлениеПолей, УниверсальныйОтчет.ПостроительОтчета);

	// Заполнение начальных настроек универсального отчета
	УниверсальныйОтчет.УстановитьНачальныеНастройки(Ложь);

КонецПроцедуры // УстановитьНачальныеНастройки()

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ФОРМИРОВАНИЯ ОТЧЕТА

// Процедура формирования отчета
//
Процедура СформироватьОтчет(ТабличныйДокумент) Экспорт

	ВыключенныеОтборы = ПрименитьОтборыШтрихкодов();

	Попытка

		УниверсальныйОтчет.СформироватьОтчет(ТабличныйДокумент);

	Исключение

		ВернутьОтборыШтрихкодов(ВыключенныеОтборы);
		ВызватьИсключение;

	КонецПопытки;

	ВернутьОтборыШтрихкодов(ВыключенныеОтборы);

КонецПроцедуры // СформироватьОтчет()

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Процедура обработки расшифровки
//
Процедура ОбработкаРасшифровки(Расшифровка, Объект) Экспорт

	ДополнительныеПараметры = Неопределено;
	УниверсальныйОтчет.ОбработкаРасшифровкиУниверсальногоОтчета(Расшифровка, Объект, ДополнительныеПараметры);

КонецПроцедуры // ОбработкаРасшифровки()

// Формирует структуру для сохранения настроек отчета
