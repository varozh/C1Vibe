// Удаление непроведенных поступлений (Документ.ПоступлениеТоваровУслуг), загруженных в БП 3.0 обменом из УТ 10.3.
//
// Зачем: уже загруженные поступления обмен не перезаписывает (в правилах конвертации "Не замещать"),
// поэтому, чтобы они пришли заново по исправленным правилам, их нужно удалить в БП и повторно выгрузить из УТ.
//
// Порядок работы:
//   1. Задать отбор и нажать "Найти поступления" - в таблице появятся документы и причина (что в них не так).
//   2. Проверить список, снять лишние отметки.
//   3. Выбрать "Пометить на удаление" или "Удалить окончательно" и нажать "Выполнить для отмеченных".
//
// Защита:
//   - проведенные поступления не обрабатываются;
//   - изменения не регистрируются к обмену (пометка и удаление не уйдут в УТ);
//   - при окончательном удалении документ пропускается, если на него ссылаются другие документы или справочники
//     (кроме его собственного счета-фактуры); ссылки из независимых регистров сведений (предупреждения обмена,
//     версии объектов и т.п.) не мешают удалению;
//   - каждое поступление вместе со своим счетом-фактурой обрабатывается в отдельной транзакции.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НачалоПериода = Дата(2025, 12, 31);
	ИННОрганизаций = "732605380624, 7326046902, 732704968872";
	ТолькоИзУТ = Истина;
	Условие = "ЗачетАвансов";
	Режим = "Пометить";
	УдалятьСчетаФактуры = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого СтрокаТаблицы Из Поступления Цикл
		СтрокаТаблицы.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	Для Каждого СтрокаТаблицы Из Поступления Цикл
		СтрокаТаблицы.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПоступления(Команда)

	Количество = 0;
	Для Каждого СтрокаТаблицы Из Поступления Цикл
		Если СтрокаТаблицы.Пометка Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Если Количество = 0 Тогда
		ПоказатьПредупреждение(, "Нет отмеченных поступлений.");
		Возврат;
	КонецЕсли;

	Если Режим = "Удалить" Тогда
		Действие = "УДАЛИТЬ ОКОНЧАТЕЛЬНО (без возможности восстановления)";
	Иначе
		Действие = "пометить на удаление";
	КонецЕсли;

	ТекстВопроса = "Отмечено поступлений: " + Формат(Количество, "ЧГ=0") + "." + Символы.ПС
		+ "Действие: " + Действие
		+ ?(УдалятьСчетаФактуры, " вместе с их счетами-фактурами полученными", "") + "." + Символы.ПС
		+ "Продолжить?";

	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьПоступленияЗавершение", ЭтотОбъект),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПоступленияЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Итог = УдалитьПоступленияНаСервере();
	ПоказатьПредупреждение(, Итог);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СписокИзСтроки(Знач Строка)

	Результат = Новый Массив;
	Строка = СтрЗаменить(Строка, ";", ",");
	Строка = СтрЗаменить(Строка, Символы.ПС, ",");
	Строка = СтрЗаменить(Строка, " ", ",");
	Для Каждого Часть Из СтрРазделить(Строка, ",", Ложь) Цикл
		Значение = СокрЛП(Часть);
		Если Значение <> "" И Результат.Найти(Значение) = Неопределено Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьНаСервере()

	Поступления.Очистить();

	СписокИНН = СписокИзСтроки(ИННОрганизаций);
	Если СписокИНН.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Укажите ИНН организаций.");
		Возврат;
	КонецЕсли;
	СписокНомеров = СписокИзСтроки(НомераДокументов);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Документ,
	|	Д.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Д.Организация) КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(Д.Контрагент) КАК Контрагент,
	|	Д.СуммаДокумента КАК Сумма,
	|	Д.ПометкаУдаления КАК ПомеченНаУдаление,
	|	ЕСТЬNULL(ЗачетБезДокумента.Строк, 0) КАК СтрокЗачетаБезДокумента,
	|	ЕСТЬNULL(ТоварыБезСчета.Строк, 0) КАК СтрокБезСчетаУчета,
	|	ВЫБОР
	|		КОГДА Д.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|				И Д.Склад.Ссылка ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СкладНеНайден,
	|	ВЫБОР
	|		КОГДА Д.СчетУчетаРасчетовСКонтрагентом = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НетСчетаРасчетов
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Д
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			З.Ссылка КАК Ссылка,
	|			КОЛИЧЕСТВО(*) КАК Строк
	|		ИЗ
	|			Документ.ПоступлениеТоваровУслуг.ЗачетАвансов КАК З
	|		ГДЕ
	|			(З.ДокументАванса = НЕОПРЕДЕЛЕНО
	|				ИЛИ З.ДокументАванса.Ссылка ЕСТЬ NULL)
	|		СГРУППИРОВАТЬ ПО
	|			З.Ссылка) КАК ЗачетБезДокумента
	|		ПО (ЗачетБезДокумента.Ссылка = Д.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Т.Ссылка КАК Ссылка,
	|			КОЛИЧЕСТВО(*) КАК Строк
	|		ИЗ
	|			Документ.ПоступлениеТоваровУслуг.Товары КАК Т
	|		ГДЕ
	|			Т.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
	|		СГРУППИРОВАТЬ ПО
	|			Т.Ссылка) КАК ТоварыБезСчета
	|		ПО (ТоварыБезСчета.Ссылка = Д.Ссылка)
	|ГДЕ
	|	НЕ Д.Проведен
	|	И Д.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Д.Организация.ИНН В (&СписокИНН)
	|	И (НЕ &ТолькоИзУТ
	|			ИЛИ Д.Номер ПОДОБНО ""УТ%"")
	|	И (&ВсеНомера
	|			ИЛИ Д.Номер В (&СписокНомеров))
	|	И (&ВключатьПомеченные
	|			ИЛИ НЕ Д.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", ?(ЗначениеЗаполнено(КонецПериода), КонецДня(КонецПериода), Дата(3999, 12, 31)));
	Запрос.УстановитьПараметр("СписокИНН", СписокИНН);
	Запрос.УстановитьПараметр("ТолькоИзУТ", ТолькоИзУТ);
	Запрос.УстановитьПараметр("ВсеНомера", СписокНомеров.Количество() = 0);
	Запрос.УстановитьПараметр("СписокНомеров", СписокНомеров);
	// Уже помеченные показываем только для окончательного удаления
	Запрос.УстановитьПараметр("ВключатьПомеченные", Режим = "Удалить");

	Выборка = Запрос.Выполнить().Выбрать();
	МассивДокументов = Новый Массив;
	Пока Выборка.Следующий() Цикл

		ЕстьПустойЗачет = Выборка.СтрокЗачетаБезДокумента > 0;
		ЕстьПустыеСчета = Выборка.СтрокБезСчетаУчета > 0 Или Выборка.СкладНеНайден Или Выборка.НетСчетаРасчетов;

		Если Условие = "ЗачетАвансов" И Не ЕстьПустойЗачет Тогда
			Продолжить;
		ИначеЕсли Условие = "ПустыеСчета" И Не ЕстьПустыеСчета Тогда
			Продолжить;
		ИначеЕсли Условие = "Любое" И Не ЕстьПустойЗачет И Не ЕстьПустыеСчета Тогда
			Продолжить;
		КонецЕсли;

		Причины = Новый Массив;
		Если ЕстьПустойЗачет Тогда
			Причины.Добавить("зачет авансов без документа аванса: " + Выборка.СтрокЗачетаБезДокумента);
		КонецЕсли;
		Если Выборка.СтрокБезСчетаУчета > 0 Тогда
			Причины.Добавить("строк без счета учета: " + Выборка.СтрокБезСчетаУчета);
		КонецЕсли;
		Если Выборка.СкладНеНайден Тогда
			Причины.Добавить("склад ""Объект не найден""");
		КонецЕсли;
		Если Выборка.НетСчетаРасчетов Тогда
			Причины.Добавить("нет счета расчетов");
		КонецЕсли;
		Если Выборка.ПомеченНаУдаление Тогда
			Причины.Добавить("уже помечен на удаление");
		КонецЕсли;

		НоваяСтрока = Поступления.Добавить();
		НоваяСтрока.Пометка = Истина;
		НоваяСтрока.Документ = Выборка.Документ;
		НоваяСтрока.Организация = Выборка.Организация;
		НоваяСтрока.Контрагент = Выборка.Контрагент;
		НоваяСтрока.Сумма = Выборка.Сумма;
		НоваяСтрока.Причина = СтрСоединить(Причины, "; ");
		МассивДокументов.Добавить(Выборка.Документ);

	КонецЦикла;

	// Счета-фактуры полученные к найденным поступлениям
	СчетаФактуры = СчетаФактурыПоступлений(МассивДокументов);
	Для Каждого СтрокаТаблицы Из Поступления Цикл
		СФДокумента = СчетаФактуры.Получить(СтрокаТаблицы.Документ);
		Если СФДокумента <> Неопределено Тогда
			Представления = Новый Массив;
			Для Каждого СФ Из СФДокумента Цикл
				Представления.Добавить(Строка(СФ));
			КонецЦикла;
			СтрокаТаблицы.СчетаФактуры = СтрСоединить(Представления, "; ");
		КонецЕсли;
	КонецЦикла;

	ОбщегоНазначения.СообщитьПользователю("Найдено поступлений: " + Поступления.Количество());

КонецПроцедуры

// Возвращает Соответствие: поступление -> Массив счетов-фактур полученных,
// у которых основанием указано это поступление (в шапке или в табличной части).
&НаСервере
Функция СчетаФактурыПоступлений(МассивДокументов)

	Результат = Новый Соответствие;
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СФ.ДокументОснование КАК Документ,
	|	СФ.Ссылка КАК СчетФактура
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СФ
	|ГДЕ
	|	СФ.ДокументОснование В (&МассивДокументов)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Осн.ДокументОснование,
	|	Осн.Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования КАК Осн
	|ГДЕ
	|	Осн.ДокументОснование В (&МассивДокументов)";
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СФДокумента = Результат.Получить(Выборка.Документ);
		Если СФДокумента = Неопределено Тогда
			СФДокумента = Новый Массив;
			Результат.Вставить(Выборка.Документ, СФДокумента);
		КонецЕсли;
		Если СФДокумента.Найти(Выборка.СчетФактура) = Неопределено Тогда
			СФДокумента.Добавить(Выборка.СчетФактура);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все основания счетов-фактур (шапка + табличная часть): Соответствие СФ -> Массив оснований
&НаСервере
Функция ОснованияСчетовФактур(МассивСФ)

	Результат = Новый Соответствие;
	Если МассивСФ.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СФ.Ссылка КАК СчетФактура,
	|	СФ.ДокументОснование КАК Основание
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СФ
	|ГДЕ
	|	СФ.Ссылка В (&МассивСФ)
	|	И СФ.ДокументОснование <> НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Осн.Ссылка,
	|	Осн.ДокументОснование
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования КАК Осн
	|ГДЕ
	|	Осн.Ссылка В (&МассивСФ)";
	Запрос.УстановитьПараметр("МассивСФ", МассивСФ);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Основание) Тогда
			Продолжить;
		КонецЕсли;
		Основания = Результат.Получить(Выборка.СчетФактура);
		Если Основания = Неопределено Тогда
			Основания = Новый Массив;
			Результат.Вставить(Выборка.СчетФактура, Основания);
		КонецЕсли;
		Основания.Добавить(Выборка.Основание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ЭтоНезависимыйРегистрСведений(ОбъектМетаданных)

	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных)
		И ОбъектМетаданных.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый;

КонецФункции

// Пометка на удаление или удаление одного документа без регистрации к обмену
&НаСервере
Процедура ОбработатьДокумент(Ссылка)

	ОбъектДокумента = Ссылка.ПолучитьОбъект();
	Если ОбъектДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Изменения не должны уйти в УТ
	ОбъектДокумента.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
	ОбъектДокумента.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;

	Если ОбъектДокумента.Проведен Тогда
		// Проведенным может быть только счет-фактура: сначала отменяем его проведение
		ОбъектДокумента.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ОбъектДокумента = Ссылка.ПолучитьОбъект();
		ОбъектДокумента.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
		ОбъектДокумента.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
	КонецЕсли;

	ОбъектДокумента.ОбменДанными.Загрузка = Истина;

	Если Режим = "Удалить" Тогда
		ОбъектДокумента.Удалить();
	Иначе
		ОбъектДокумента.ПометкаУдаления = Истина;
		ОбъектДокумента.Записать();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция УдалитьПоступленияНаСервере()

	Отмеченные = Поступления.НайтиСтроки(Новый Структура("Пометка", Истина));

	МассивДокументов = Новый Массив;
	Для Каждого СтрокаТаблицы Из Отмеченные Цикл
		МассивДокументов.Добавить(СтрокаТаблицы.Документ);
	КонецЦикла;

	// Все ссылки, которые обрабатываем в этом запуске
	Удаляемые = Новый Соответствие;
	Для Каждого Документ Из МассивДокументов Цикл
		Удаляемые.Вставить(Документ, Истина);
	КонецЦикла;

	// Счета-фактуры: берем только те, все основания которых среди отмеченных поступлений
	СФПоДокументам = Новый Соответствие;
	СФНельзя = Новый Соответствие; // СФ -> текст, почему не удаляется вместе с поступлением
	Если УдалятьСчетаФактуры Тогда
		СчетаФактуры = СчетаФактурыПоступлений(МассивДокументов);
		ВсеСФ = Новый Массив;
		Для Каждого КлючИЗначение Из СчетаФактуры Цикл
			Для Каждого СФ Из КлючИЗначение.Значение Цикл
				Если ВсеСФ.Найти(СФ) = Неопределено Тогда
					ВсеСФ.Добавить(СФ);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Основания = ОснованияСчетовФактур(ВсеСФ);
		Для Каждого СФ Из ВсеСФ Цикл
			ОснованияСФ = Основания.Получить(СФ);
			Если ОснованияСФ <> Неопределено Тогда
				Для Каждого Основание Из ОснованияСФ Цикл
					Если Удаляемые.Получить(Основание) = Неопределено Тогда
						СФНельзя.Вставить(СФ, "у счета-фактуры " + СФ + " есть другое основание: " + Основание);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Для Каждого КлючИЗначение Из СчетаФактуры Цикл
			СФДокумента = Новый Массив;
			Для Каждого СФ Из КлючИЗначение.Значение Цикл
				Если СФНельзя.Получить(СФ) = Неопределено Тогда
					СФДокумента.Добавить(СФ);
					Удаляемые.Вставить(СФ, Истина);
				КонецЕсли;
			КонецЦикла;
			СФПоДокументам.Вставить(КлючИЗначение.Ключ, СФДокумента);
		КонецЦикла;
	КонецЕсли;

	// Ссылки на удаляемые объекты из других данных (только для окончательного удаления)
	Блокирующие = Новый Соответствие; // ссылка -> описание первой мешающей ссылки
	Если Режим = "Удалить" И Удаляемые.Количество() > 0 Тогда
		МассивСсылок = Новый Массив;
		Для Каждого КлючИЗначение Из Удаляемые Цикл
			МассивСсылок.Добавить(КлючИЗначение.Ключ);
		КонецЦикла;
		ТаблицаСсылок = НайтиПоСсылкам(МассивСсылок);
		Для Каждого СтрокаСсылки Из ТаблицаСсылок Цикл
			Если Удаляемые.Получить(СтрокаСсылки.Данные) <> Неопределено Тогда
				Продолжить; // ссылается сам удаляемый объект
			КонецЕсли;
			Если ЭтоНезависимыйРегистрСведений(СтрокаСсылки.Метаданные) Тогда
				Продолжить; // служебные записи (предупреждения обмена, версии и т.п.)
			КонецЕсли;
			Если Блокирующие.Получить(СтрокаСсылки.Ссылка) = Неопределено Тогда
				Блокирующие.Вставить(СтрокаСсылки.Ссылка,
					?(СтрокаСсылки.Метаданные = Неопределено, "", СтрокаСсылки.Метаданные.Представление() + ": ")
					+ Строка(СтрокаСсылки.Данные));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Обработано = 0;
	Пропущено = 0;
	Ошибок = 0;

	Для Каждого СтрокаТаблицы Из Отмеченные Цикл

		Группа = Новый Массив;
		СФДокумента = СФПоДокументам.Получить(СтрокаТаблицы.Документ);
		Если СФДокумента <> Неопределено Тогда
			Для Каждого СФ Из СФДокумента Цикл
				Группа.Добавить(СФ);
			КонецЦикла;
		КонецЕсли;
		Группа.Добавить(СтрокаТаблицы.Документ); // поступление обрабатываем последним

		// Проверки до изменения данных
		ТекстПропуска = "";
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы.Документ, "Проведен") = Истина Тогда
			ТекстПропуска = "поступление проведено";
		КонецЕсли;
		Если ТекстПропуска = "" И Режим = "Удалить" Тогда
			Для Каждого Ссылка Из Группа Цикл
				Мешает = Блокирующие.Получить(Ссылка);
				Если Мешает <> Неопределено Тогда
					ТекстПропуска = "на " + Ссылка + " ссылается " + Мешает;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ТекстПропуска <> "" Тогда
			СтрокаТаблицы.Результат = "Пропущен: " + ТекстПропуска;
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка
			Для Каждого Ссылка Из Группа Цикл
				ОбработатьДокумент(Ссылка);
			КонецЦикла;
			ЗафиксироватьТранзакцию();
			СтрокаТаблицы.Результат = ?(Режим = "Удалить", "Удален", "Помечен на удаление")
				+ ?(Группа.Количество() > 1, " (со счетом-фактурой)", "");
			СтрокаТаблицы.Пометка = Ложь;
			Обработано = Обработано + 1;
		Исключение
			ОтменитьТранзакцию();
			СтрокаТаблицы.Результат = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("Удаление поступлений из УТ", УровеньЖурналаРегистрации.Ошибка, ,
				СтрокаТаблицы.Документ, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Ошибок = Ошибок + 1;
		КонецПопытки;

	КонецЦикла;

	Итог = ?(Режим = "Удалить", "Удалено", "Помечено на удаление") + ": " + Обработано
		+ Символы.ПС + "Пропущено: " + Пропущено
		+ Символы.ПС + "Ошибок: " + Ошибок;
	Если СФНельзя.Количество() > 0 Тогда
		Итог = Итог + Символы.ПС + "Счетов-фактур оставлено (есть другие основания): " + СФНельзя.Количество();
	КонецЕсли;
	Итог = Итог + Символы.ПС + "Подробности - в колонке ""Результат"".";
	Возврат Итог;

КонецФункции

#КонецОбласти
