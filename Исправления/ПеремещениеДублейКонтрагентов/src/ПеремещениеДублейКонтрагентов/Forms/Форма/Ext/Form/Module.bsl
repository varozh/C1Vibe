// Перемещение в папку «Дубли» контрагентов, которые входили в группы дублей (прогоны «Поиска и удаления дублей»
// 17.11.2026 и 18.11.2026, тогда не были помечены на удаление) и затем были помечены на удаление при объединении.
// Меняются только Родитель (папка «Дубли») и Наименование (в конце дописывается « дубль»).
// Код, ИНН, полное наименование и пометка удаления не меняются.
// Изменение не регистрируется к обмену (ОтключитьМеханизмРегистрацииОбъектов).

&НаКлиенте
Процедура Переместить(Команда)

	Количество = 0;
	Для Каждого Строка Из Список Цикл
		Если Строка.Пометка Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Если Количество = 0 Тогда
		ПоказатьПредупреждение(, "Нет отмеченных карточек.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПереместитьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		СтрШаблон("Переместить в папку ""%1"" отмеченные карточки (%2) и дописать к наименованию ""дубль""?", ПапкаДубли, Количество),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПереместитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = ПереместитьНаСервере();
	ПоказатьПредупреждение(, Результат);

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	Для Каждого Строка Из Список Цикл
		Строка.Пометка = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Строка Из Список Цикл
		Строка.Пометка = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПапкаДубли = Справочники.Контрагенты.НайтиПоКоду("BE-001666");
	Если ПапкаДубли.Пустая() ИЛИ НЕ ПапкаДубли.ЭтоГруппа ИЛИ СокрЛП(ПапкаДубли.Наименование) <> "Дубли" Тогда
		ПапкаДубли = Справочники.Контрагенты.НайтиПоНаименованию("Дубли", Истина);
	КонецЕсли;
	Если ПапкаДубли.Пустая() ИЛИ НЕ ПапкаДубли.ЭтоГруппа Тогда
		ПапкаДубли = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()

	Список.Очистить();

	Если ПапкаДубли.Пустая() Тогда
		Итог = "В справочнике ""Контрагенты"" не найдена папка ""Дубли"".";
		Возврат;
	КонецЕсли;

	// Код -> наименование карточки на момент прогона
	Карточки = Новый Соответствие;
	Для НомерСтроки = 1 По СтрЧислоСтрок(СписокКарточек()) Цикл
		Стр = СтрПолучитьСтроку(СписокКарточек(), НомерСтроки);
		Позиция = СтрНайти(Стр, "|");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Карточки.Вставить(СокрЛП(Лев(Стр, Позиция - 1)), СокрЛП(Сред(Стр, Позиция + 1)));
	КонецЦикла;

	Коды = Новый Массив;
	Для Каждого КлючИЗначение Из Карточки Цикл
		Коды.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Ссылка КАК Контрагент,
	|	К.Код КАК Код,
	|	К.Наименование КАК Наименование,
	|	К.ИНН КАК ИНН,
	|	К.Родитель КАК Папка
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	К.Код В(&Коды)
	|	И НЕ К.ЭтоГруппа
	|	И К.ПометкаУдаления
	|	И К.Родитель <> &ПапкаДубли
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("Коды", Коды);
	Запрос.УстановитьПараметр("ПапкаДубли", ПапкаДубли);

	Выборка = Запрос.Выполнить().Выбрать();
	Пропущено = 0;
	Пока Выборка.Следующий() Цикл
		// Код в БП не уникален среди помеченных карточек: проверяем и наименование
		Если Карточки.Получить(СокрЛП(Выборка.Код)) <> СокрЛП(Выборка.Наименование) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Строка = Список.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Код = СокрЛП(Выборка.Код);
		Строка.Пометка = Истина;
	КонецЦикла;

	Итог = СтрШаблон("Помечены на удаление и ещё не в папке ""Дубли"": %1 (всего в списке: %2).",
		Список.Количество(), Карточки.Количество());

КонецПроцедуры

&НаСервере
Функция ПереместитьНаСервере()

	Перемещено = 0;
	Ошибок = 0;

	Для Каждого Строка Из Список Цикл

		Если НЕ Строка.Пометка Тогда
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.Контрагенты");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Строка.Контрагент);
			Блокировка.Заблокировать();

			КонтрагентОбъект = Строка.Контрагент.ПолучитьОбъект();
			Если КонтрагентОбъект = Неопределено ИЛИ НЕ КонтрагентОбъект.ПометкаУдаления ИЛИ КонтрагентОбъект.Родитель = ПапкаДубли Тогда
				ОтменитьТранзакцию();
				Продолжить;
			КонецЕсли;

			КонтрагентОбъект.Родитель = ПапкаДубли;
			Если НЕ СтрЗаканчиваетсяНа(НРег(СокрЛП(КонтрагентОбъект.Наименование)), "дубль") Тогда
				// Наименование — 100 символов: длинное обрезаем, чтобы « дубль» не потерялось
				КонтрагентОбъект.Наименование = СокрП(Лев(СокрП(КонтрагентОбъект.Наименование), 94)) + " дубль";
			КонецЕсли;
			КонтрагентОбъект.ОбменДанными.Загрузка = Истина;
			КонтрагентОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
			КонтрагентОбъект.Записать();

			ЗафиксироватьТранзакцию();
			Перемещено = Перемещено + 1;
		Исключение
			ОтменитьТранзакцию();
			Ошибок = Ошибок + 1;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("%1 %2: %3", Строка.Код, Строка.Контрагент,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Сообщение.Сообщить();
		КонецПопытки;

	КонецЦикла;

	ЗаполнитьНаСервере();

	Результат = СтрШаблон("Перемещено в папку ""Дубли"": %1.", Перемещено);
	Если Ошибок > 0 Тогда
		Результат = Результат + Символы.ПС + СтрШаблон("Не удалось переместить: %1 (см. сообщения).", Ошибок);
	КонецЕсли;
	Итог = Результат;
	Возврат Результат;

КонецФункции

