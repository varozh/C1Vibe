	                                         Единица, Количество,
	                                         УправлениеЗапасами.ПолучитьНовыйКлючСтроки(ЭтотОбъект));
											 
											 СтрокаТабличнойЧасти = ЭлементыФормы.Товары.ТекущиеДанные;
