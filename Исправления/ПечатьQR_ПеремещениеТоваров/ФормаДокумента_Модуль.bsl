Процедура ЗаполнитьКодМаркировки(Результат) Экспорт
	ИсходныеДанные = Новый Структура("Штрихкод,Количество",Результат,1);
	ШтрихкодированиеИСКлиентСервер.ЗакодироватьШтрихкодДанныхBase64(ИсходныеДанные);	
		
	ПараметрыСканирования = ШтрихкодированиеИСКлиент.ПараметрыСканирования(ЭтотОбъект.Ссылка,, Перечисления.ВидыПродукцииИС.ЛегкаяПромышленность);
	РезультатОбработки = ОбработатьВводШтрихкода(ИсходныеДанные, Неопределено, ПараметрыСканирования);
	
	Если РезультатОбработки = Неопределено Тогда 
		Сообщить("Не удалось обработать штрихкод");
		Возврат;
	КонецЕсли;
	Если РезультатОбработки.ТипШтрихкода = Перечисления.ТипыШтрихкодов.EAN13 Тогда 
		ОжиданиеКодаМаркировки = УмКо_РаботаСМаркировкой.ЭтоМаркируемаяПродукция(РезультатОбработки.Номенклатура);
		НайдСтрТовары = Товары.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",РезультатОбработки.Номенклатура,РезультатОбработки.Характеристика));
		Если НайдСтрТовары.Количество() = 0 Тогда 
			НовСтр = Товары.Добавить();
			НовСтр.Номенклатура = РезультатОбработки.Номенклатура;
			НовСтр.ХарактеристикаНоменклатуры = РезультатОбработки.Характеристика;
			НовСтр.ЕдиницаИзмерения = НовСтр.Номенклатура.ЕдиницаХраненияОстатков;
			НовСтр.Коэффициент = 1;
			НовСтр.Количество = 1;
			ТоварыПриИзмененииНоменклатуры(НовСтр,Истина);
		Иначе 
			НайдСтрТовары[0].Количество = НайдСтрТовары[0].Количество + 1;
			ТоварыПриИзмененииКоличества(ЭлементыФормы.Товары.ТекущиеДанные);
		КонецЕсли;
		Если ОжиданиеКодаМаркировки Тогда 
			ПоказатьПредупреждение(,"Считайте Код маркировки");
			Возврат;
		КонецЕсли;
	Иначе 
		НайдСтр = КодыМаркировок.Найти(ИсходныеДанные.Штрихкод);
		Если НайдСтр <> Неопределено Тогда 
			ПоказатьПредупреждение(, "Данный код маркировки уже присутствует в текущем документе");
			Возврат;
		КонецЕсли;
				
		Если ОжиданиеКодаМаркировки Тогда
			отбор = Новый Структура;
			отбор.Вставить("Номенклатура", РезультатОбработки.Номенклатура);
			отбор.Вставить("ХарактеристикаНоменклатуры", РезультатОбработки.Характеристика);
			НайдСтрТовары = Товары.НайтиСтроки(отбор);
			Если НайдСтрТовары.Количество() <> 0 Тогда 
				//НайдСтрТовары[0].Количество = НайдСтрТовары[0].Количество+1;
				
				НовСтр = КодыМаркировок.Добавить();
				НовСтр.Номенклатура = РезультатОбработки.Номенклатура;
				НовСтр.Характеристика = РезультатОбработки.Характеристика;
				НовСтр.КодМаркировки = РезультатОбработки.НормализованныйШтрихкод;
				НовСтр.ПолныйКодМаркировки = РезультатОбработки.ШтрихкодBase64;
			КонецЕсли;
		Иначе 
			
			НайдСтрТовары = Товары.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",РезультатОбработки.Номенклатура,РезультатОбработки.Характеристика));
			Если НайдСтрТовары.Количество() = 0 Тогда 
				НовСтр = Товары.Добавить();
				НовСтр.Номенклатура = РезультатОбработки.Номенклатура;
				НовСтр.ХарактеристикаНоменклатуры = РезультатОбработки.Характеристика;
				НовСтр.ЕдиницаИзмерения = НовСтр.Номенклатура.ЕдиницаХраненияОстатков;
				НовСтр.Коэффициент = 1;
				НовСтр.Количество = 1;
				ТоварыПриИзмененииНоменклатуры(НовСтр,Истина);
			Иначе 
				НайдСтрТовары[0].Количество = НайдСтрТовары[0].Количество + 1;
				ТоварыПриИзмененииКоличества(ЭлементыФормы.Товары.ТекущиеДанные);
			КонецЕсли;	
			
			НовСтр = КодыМаркировок.Добавить();
			НовСтр.Номенклатура = РезультатОбработки.Номенклатура;
			НовСтр.Характеристика = РезультатОбработки.Характеристика;
			НовСтр.КодМаркировки = РезультатОбработки.НормализованныйШтрихкод;
			НовСтр.ПолныйКодМаркировки = РезультатОбработки.ШтрихкодBase64;
			
		КонецЕсли;
		ОжиданиеКодаМаркировки = Ложь;
	КонецЕсли;			
КонецПроцедуры

