Процедура ОсновныеДействияФормыАктПриемкиПередачиОС(Кнопка)
	ТабДок = Новый ТабличныйДокумент;
	Макет = Документы.ПеремещениеТоваров.ПолучитьМакет("АктПриемкиПередачи");
	//Шапка
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Организация = СкладОтправитель.Организация.ПолноеНаименование();
	Шапка.Параметры.ИНН = СкладОтправитель.Организация.ИНН;
    Шапка.Параметры.Адрес = ПоискКонтактов(СкладОтправитель.Организация);
	//Шапка.Параметры.Подразделение = Склад.Подразделение; 
	Шапка.Параметры.получатель = СкладПолучатель.ПолноеНаименование();
	Шапка.Параметры.Отправитель = СкладОтправитель.ПолноеНаименование();
	Шапка.Параметры.Номер = Номер;
	Шапка.Параметры.Дата = Дата;
	ТабДок.Вывести(Шапка);
	// Товары
	ОбластьТовары = Макет.ПолучитьОбласть("Строка");
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		ОбластьТовары.Параметры.Заполнить(ТекСтрокаТовары);
		ОбластьТовары.Параметры.КодНоменклатуры = Строка(" ["+ТекСтрокаТовары.Номенклатура.Код+"]");
