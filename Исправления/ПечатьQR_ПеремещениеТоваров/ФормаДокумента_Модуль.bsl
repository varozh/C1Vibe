Функция ПоискКонтактов(Контакт)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &ВыбОбъект
		|	И КонтактнаяИнформация.Вид = &ВидКонтакта";

	Запрос.УстановитьПараметр("ВидКонтакта", Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Фактический адрес"));
	Запрос.УстановитьПараметр("ВыбОбъект", Контакт);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Представление;
	КонецЦикла;
КонецФункции

