Процедура ВыполнитьЗагрузкуИзУТ() Экспорт
	уо = ПланыОбмена.УмКо_ОбменКодовМаркировки.НайтиПоКоду("UTKM");
	Если НЕ уо.Пустая() Тогда
		о = уо.ПолучитьОбъект();
		о.ПрочитатьСообщениеСИзменениями();
		о.ЗаписатьСообщениеСИзменениями();
	КонецЕсли;
КонецПроцедуры

Функция ЭтоМаркируемаяПродукция(Номенклатура) Экспорт
	результат = Ложь;
	группыПродукцииИС = Новый Массив;
	исключаемыеГруппыПродукцииИС = Новый Массив;
	г = Справочники.Номенклатура.НайтиПоКоду("ЦБР00000786");
	Если НЕ г.Пустая() Тогда
		группыПродукцииИС.Добавить(г);
	КонецЕсли;
	г = Справочники.Номенклатура.НайтиПоКоду("ЦБР00001488");
	Если НЕ г.Пустая() Тогда
		группыПродукцииИС.Добавить(г);
	КонецЕсли;
	г = Справочники.Номенклатура.НайтиПоКоду("УТ000036682");
	Если НЕ г.Пустая() Тогда
		исключаемыеГруппыПродукцииИС.Добавить(г);
	КонецЕсли;
	Если Номенклатура <> Неопределено Тогда
		запрос = Новый Запрос;
		запрос.Текст =
		"ВЫБРАТЬ
		|	ИСТИНА КАК ПродукцияИС
		|ИЗ
		|	Справочник.Номенклатура КАК т
		|ГДЕ
		|	т.Ссылка = &Ссылка
		|	И т.Родитель В ИЕРАРХИИ(&ГруппыПродукцииИС)
		|	И НЕ т.Родитель В ИЕРАРХИИ (&ИсключаемыеГруппыПродукцииИС)";
		запрос.УстановитьПараметр("Ссылка", Номенклатура);
		запрос.УстановитьПараметр("ГруппыПродукцииИС", группыПродукцииИС);
		запрос.УстановитьПараметр("ИсключаемыеГруппыПродукцииИС", исключаемыеГруппыПродукцииИС);
		результатЗапроса = запрос.Выполнить();
		вГруппеПродукцииИС = Ложь;
		Если НЕ результатЗапроса.Пустой() Тогда
			выборка = результатЗапроса.Выбрать();
			вГруппеПродукцииИС = выборка.Следующий();
		КонецЕсли;
		результат = (Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ЛегкаяПромышленность) ИЛИ вГруппеПродукцииИС;
	КонецЕсли;
	Возврат результат;
КонецФункции

Процедура ОчиститьСвязанныеКодыМаркировки(СтрокаТабличнойЧасти, ТаблицаКодовМаркировки) Экспорт
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		счетчик = ТаблицаКодовМаркировки.Количество() - 1;
		Пока счетчик >= 0 Цикл
			скм = ТаблицаКодовМаркировки[счетчик];
			Если скм.Номенклатура = СтрокаТабличнойЧасти.Номенклатура
				И скм.Характеристика = СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры Тогда
				ТаблицаКодовМаркировки.Удалить(счетчик);
			КонецЕсли;
			счетчик = счетчик - 1;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ДополнитьКодМаркировкиРазделителямиГрупп(КодМаркировки) Экспорт
	позиция21 = СтрНайти(КодМаркировки, "21",, 15);
	символРазделителя = Символ(29);
	Если позиция21 > 0 Тогда
		Если СтрНайти(КодМаркировки, символРазделителя) > 0 Тогда
			Возврат;
		КонецЕсли;
		позиция91 = СтрНайти(КодМаркировки, "91",, позиция21 + 15);
		// Claude 17.11.2026 Начало
		// Без "91" (короткий код или не код GS1) разделитель не вставляем:
		// раньше при позиция91 = 0 он вставлялся в начало строки.
		Если позиция91 = 0 Тогда
			Возврат;
		КонецЕсли;
		// Claude 17.11.2026 Конец
		леваяЧасть = Лев(КодМаркировки, позиция91 - 1);
		праваяЧасть = Сред(КодМаркировки, позиция91);
		КодМаркировки = СтрШаблон("%1%2%3", леваяЧасть, символРазделителя, праваяЧасть);
		// Claude 17.11.2026: "92" ищем после GS, "91" и 4 символов ключа, а не внутри ключа
		//позиция92 = СтрНайти(КодМаркировки, "92",, позиция91);
		позиция92 = СтрНайти(КодМаркировки, "92",, позиция91 + 7);
		Если позиция92 > 0 Тогда
			леваяЧасть = Лев(КодМаркировки, позиция92 - 1);
			праваяЧасть = Сред(КодМаркировки, позиция92);
			КодМаркировки = СтрШаблон("%1%2%3", леваяЧасть, символРазделителя, праваяЧасть);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры