// Замена процедуры СвернутьСтатистикуПосещаемости
// в общем модуле УмКо_НаправлениеСводногоОтчетаОтветственным.
//
// Что изменено по сравнению с версией от 30.09.2026:
// 1. Запись идёт набором записей по дню (Отбор.Период) с замещением, а не менеджером записи по каждой строке.
//    Старая версия перезаписывала только запись с тем же ключом (Период + Устройство + ОтрезокВремени + Блокировка),
//    поэтому запись с другим ОтрезкомВремени (05.10.2026 15:50, 26.09.2026 с отрезком 26.08.2026) оставалась
//    в регистре навсегда и удваивала посещаемость. Теперь день полностью пересобирается из детального регистра.
// 2. В свод попадают только записи, у которых день отрезка совпадает с периодом:
//    ошибочная строка «период 26.09, отрезок 26.08» больше не задваивает данные.
// 3. ОтрезокВремени всегда равен началу дня.
// 4. Не учитываются помеченные на удаление устройства (задвоенная ветка структуры MegaCount после её пометки).
// 5. Окно пересчёта задаётся параметрами: по умолчанию последние ДнейПересчета дней,
//    для разового заполнения истории можно вызвать с явной датой начала.
// 6. Каждый день пишется в своей транзакции: при ошибке пропадает один день, а не весь прогон.

// Баранников Антон 30.09.2026 Начало
Процедура СвернутьСтатистикуПосещаемости(Знач ДатаНач = Неопределено, Знач ДатаКон = Неопределено) Экспорт

	ДнейПересчета = 14;

	Если ДатаКон = Неопределено Тогда
		ДатаКон = ТекущаяДата();
	КонецЕсли;
	ДатаКон = КонецДня(ДатаКон);

	Если ДатаНач = Неопределено Тогда
		ДатаНач = ДатаКон - ДнейПересчета * 86400;
	КонецЕсли;
	ДатаНач = НачалоДня(ДатаНач);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтатистикаПосещаемости.Период КАК Период,
	|	СтатистикаПосещаемости.Устройство КАК Устройство,
	|	СтатистикаПосещаемости.Период КАК ОтрезокВремени,
	|	СтатистикаПосещаемости.Блокировка КАК Блокировка,
	|	СУММА(СтатистикаПосещаемости.КоличествоВходов) КАК КоличествоВходов,
	|	СУММА(СтатистикаПосещаемости.КоличествоВыходов) КАК КоличествоВыходов
	|ИЗ
	|	РегистрСведений.УмКо_СтатистикаПосещаемости КАК СтатистикаПосещаемости
	|ГДЕ
	|	СтатистикаПосещаемости.Период МЕЖДУ &ДатаНач И &ДатаКон
	|	И НАЧАЛОПЕРИОДА(СтатистикаПосещаемости.ОтрезокВремени, ДЕНЬ) = СтатистикаПосещаемости.Период
	|	И НЕ СтатистикаПосещаемости.Устройство.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	СтатистикаПосещаемости.Период,
	|	СтатистикаПосещаемости.Устройство,
	|	СтатистикаПосещаемости.Блокировка";

	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);

	Статистика = Запрос.Выполнить().Выгрузить();
	Статистика.Индексы.Добавить("Период");

	// Дни без данных тоже обходим, чтобы очистить в своде то, чего уже нет в детальном регистре
	День = ДатаНач;
	Пока День <= ДатаКон Цикл

		НаборЗаписей = РегистрыСведений.УмКо_СтатистикаПосещаемостиСводно.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(День);

		Для Каждого СтрокаТаблицы Из Статистика.НайтиСтроки(Новый Структура("Период", День)) Цикл
			ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СтрокаТаблицы);
		КонецЦикла;

		Попытка
			НаборЗаписей.Записать(Истина);
		Исключение
			ЗаписьЖурналаРегистрации("УмКо.СвернутьСтатистикуПосещаемости", УровеньЖурналаРегистрации.Ошибка,
				Метаданные.РегистрыСведений.УмКо_СтатистикаПосещаемостиСводно, ,
				"Не удалось записать свод за " + Формат(День, "ДФ=dd.MM.yyyy") + ": " + ОписаниеОшибки());
		КонецПопытки;

		День = День + 86400;

	КонецЦикла;

КонецПроцедуры
// Баранников Антон 30.09.2026 Конец

