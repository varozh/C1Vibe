// Начисление дополнительных бонусов по маркетинговому мероприятию 22.10.2026 - 05.11.2026:
// за покупку товаров из папок номенклатуры «1.1.8. ПАЛЬТО», «1.1.81. ПЛАЩИ», «1.1.82. КУРТКИ»
// (с подпапками) покупателю начисляется 10 000 дополнительных бонусов со сроком действия
// до 30.11.2026 23:59:59. Начисление — один раз на дисконтную карту (за первый подходящий чек),
// сколько бы чеков акции у карты ни было. Картам сотрудников не начисляется.
//
// Обработка без формы (конфигурация работает в обычном приложении): открыть через Файл -> Открыть,
// дальше всё спрашивается диалогами:
//  1. виды дисконтных карт, по которым начислять (по умолчанию — карты программы лояльности,
//     как в обработке «Начисление бонусов по новой лояльности»; виды карт сотрудников не предлагаются);
//  2. список чеков к начислению (галочки можно снять);
//  3. подтверждение.
// Чеки отбираются так:
//  - проведённые чеки продажи за период акции (не помеченные на удаление);
//  - магазины сети Business Line (BL, БЛ) и «ОФИС»; SoLi's и Gesolina не учитываются;
//  - в чеке есть хотя бы один товар из папок акции;
//  - в чеке указана дисконтная карта, карта не помечена на удаление;
//  - карта не сотрудника: не входит в группу карт сотрудников (константа ТекущиеКартыСотрГруппа)
//    и её вид не «Карта сотрудника ...»;
//  - товары акции из чека не возвращены полностью. Возвраты берутся из чеков ККМ «Возврат»
//    (реквизит «Чек ККМ продажа») и из документов «Возврат товаров от покупателя» (колонка «Чек ККМ»
//    в товарах), только проведённые;
//  - по этой карте доп. бонусы этой акции ещё не начислялись; из нескольких чеков карты берётся первый.
// Создаётся и проводится один документ «Начисление бонусов покупателей», по строке на карту:
// Тип бонуса = Дополнительный, Док тип = ДокТипАкции (по нему же обработка находит уже
// начисленное и не начисляет повторно), Док номер / Док дата / Магазин — данные чека.
// Док тип нарочно не «Чек ККМ»: при перепроведении чека с оплатой бонусами модуль чека ищет
// документ начисления по «Чек ККМ» + номер + дата + магазин + карта и перезаписывает его строки.

Перем ДатаНачала;
Перем ДатаОкончания;
Перем КодыПапок;
Перем СуммаБонусовАкции;
Перем СрокГодности;
Перем ДокТипАкции;
Перем КомментарийДокумента;

Функция ЗагрузитьЧеки()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Папки.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ПапкиАкции
	|ИЗ
	|	Справочник.Номенклатура КАК Папки
	|ГДЕ
	|	Папки.ЭтоГруппа
	|	И Папки.Код В(&КодыПапок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Чек,
	|	СУММА(Т.Количество) КАК Количество,
	|	СУММА(Т.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ЧекиАкции
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Т.Ссылка.Проведен
	|	И НЕ Т.Ссылка.ПометкаУдаления
	|	И Т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
	|	И Т.Номенклатура В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ПапкиАкции.Ссылка
	|			ИЗ
	|				ПапкиАкции)
	|	И НЕ Т.Ссылка.Магазин.ЭтоГруппа
	|	И НЕ Т.Ссылка.Магазин.ПометкаУдаления
	|	И (Т.Ссылка.Магазин.Код = ""ЦБР000144""
	|			ИЛИ (Т.Ссылка.Магазин.Наименование ПОДОБНО ""%Business Line%""
	|				ИЛИ Т.Ссылка.Магазин.Наименование ПОДОБНО ""%BL%""
	|				ИЛИ Т.Ссылка.Магазин.Наименование ПОДОБНО ""%БЛ%"")
	|				И НЕ Т.Ссылка.Магазин.Наименование ПОДОБНО ""%SoLi%""
	|				И НЕ Т.Ссылка.Магазин.Наименование ПОДОБНО ""%Gesolin%"")
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВозврата.Ссылка.ЧекККМПродажа КАК Чек,
	|	ТоварыВозврата.Количество КАК Количество
	|ПОМЕСТИТЬ ВозвратыСтроки
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК ТоварыВозврата
	|ГДЕ
	|	ТоварыВозврата.Ссылка.Проведен
	|	И ТоварыВозврата.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|	И ТоварыВозврата.Ссылка.ЧекККМПродажа В
	|			(ВЫБРАТЬ
	|				ЧекиАкции.Чек
	|			ИЗ
	|				ЧекиАкции)
	|	И ТоварыВозврата.Номенклатура В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ПапкиАкции.Ссылка
	|			ИЗ
	|				ПапкиАкции)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыВозвратаОтПокупателя.ЧекККМ,
	|	ТоварыВозвратаОтПокупателя.Количество
	|ИЗ
	|	Документ.ВозвратТоваровОтПокупателя.Товары КАК ТоварыВозвратаОтПокупателя
	|ГДЕ
	|	ТоварыВозвратаОтПокупателя.Ссылка.Проведен
	|	И ТоварыВозвратаОтПокупателя.ЧекККМ В
	|			(ВЫБРАТЬ
	|				ЧекиАкции.Чек
	|			ИЗ
	|				ЧекиАкции)
	|	И ТоварыВозвратаОтПокупателя.Номенклатура В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ПапкиАкции.Ссылка
	|			ИЗ
	|				ПапкиАкции)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВозвратыСтроки.Чек КАК Чек,
	|	СУММА(ВозвратыСтроки.Количество) КАК Количество
	|ПОМЕСТИТЬ Возвраты
	|ИЗ
	|	ВозвратыСтроки КАК ВозвратыСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВозвратыСтроки.Чек
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б.ДокНомер КАК ДокНомер,
	|	Б.ДокДата КАК ДокДата,
	|	Б.Магазин КАК Магазин,
	|	Б.ДисконтнаяКарта КАК ДисконтнаяКарта
	|ПОМЕСТИТЬ Начислено
	|ИЗ
	|	Документ.НачислениеБонусовПокупателей.Бонусы КАК Б
	|ГДЕ
	|	Б.ДокТип = &ДокТипАкции
	|	И Б.СуммаБонусов > 0
	|	И НЕ Б.Ссылка.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЧекиАкции.Чек КАК Чек,
	|	ЧекиАкции.Чек.Номер КАК Номер,
	|	ЧекиАкции.Чек.Дата КАК Дата,
	|	ЧекиАкции.Чек.Магазин КАК Магазин,
	|	ЧекиАкции.Чек.ДисконтнаяКарта КАК ДисконтнаяКарта,
	|	ЧекиАкции.Чек.ДисконтнаяКарта.ВидДисконтнойКарты КАК ВидКарты,
	|	ЕСТЬNULL(ЧекиАкции.Чек.ДисконтнаяКарта.ПометкаУдаления, ЛОЖЬ) КАК КартаПомечена,
	|	ЧекиАкции.Количество КАК Количество,
	|	ЧекиАкции.Сумма КАК Сумма,
	|	ЕСТЬNULL(Возвраты.Количество, 0) КАК Возвращено,
	|	ВЫБОР
	|		КОГДА НачисленоПоЧеку.ДокНомер ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК НачисленоПоЧеку,
	|	ВЫБОР
	|		КОГДА НачисленоПоКарте.ДисконтнаяКарта ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК НачисленоПоКарте
	|ИЗ
	|	ЧекиАкции КАК ЧекиАкции
	|		ЛЕВОЕ СОЕДИНЕНИЕ Возвраты КАК Возвраты
	|		ПО ЧекиАкции.Чек = Возвраты.Чек
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			Начислено.ДокНомер КАК ДокНомер,
	|			Начислено.ДокДата КАК ДокДата,
	|			Начислено.Магазин КАК Магазин
	|		ИЗ
	|			Начислено КАК Начислено) КАК НачисленоПоЧеку
	|		ПО ЧекиАкции.Чек.Номер = НачисленоПоЧеку.ДокНомер
	|			И ЧекиАкции.Чек.Дата = НачисленоПоЧеку.ДокДата
	|			И ЧекиАкции.Чек.Магазин = НачисленоПоЧеку.Магазин
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			Начислено.ДисконтнаяКарта КАК ДисконтнаяКарта
	|		ИЗ
	|			Начислено КАК Начислено) КАК НачисленоПоКарте
	|		ПО ЧекиАкции.Чек.ДисконтнаяКарта = НачисленоПоКарте.ДисконтнаяКарта
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Чек";

	Запрос.УстановитьПараметр("КодыПапок", КодыПапок);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("ДокТипАкции", ДокТипАкции);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПапкиНайдены()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Папки.Код КАК Код,
	|	Папки.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Папки
	|ГДЕ
	|	Папки.ЭтоГруппа
	|	И Папки.Код В(&КодыПапок)";
	Запрос.УстановитьПараметр("КодыПапок", КодыПапок);
	Найдено = Запрос.Выполнить().Выгрузить();

	Если Найдено.Количество() = КодыПапок.Количество() Тогда
		Возврат Истина;
	КонецЕсли;

	Текст = "Не найдены папки номенклатуры акции. Ожидались коды: ";
	Для Каждого Код Из КодыПапок Цикл
		Текст = Текст + Код + " ";
	КонецЦикла;
	Текст = Текст + Символы.ПС + "Найдено:";
	Для Каждого Стр Из Найдено Цикл
		Текст = Текст + Символы.ПС + "   " + СокрЛП(Стр.Код) + " " + СокрЛП(Стр.Наименование);
	КонецЦикла;
	Предупреждение(Текст);
	Возврат Ложь;

КонецФункции

// Виды карт программы лояльности — как в обработке «Начисление бонусов по новой лояльности»
Функция ВидыКартЛояльности()

	Виды = Новый Соответствие;
	Вид = Константы.ТекущиеКартыВид.Получить();
	Если ЗначениеЗаполнено(Вид) Тогда
		Виды.Вставить(Вид, Истина);
	КонецЕсли;
	Для Каждого Код Из СтрРазделить_("ЦБР000023,ЦБР000024") Цикл
		Вид = Справочники.ВидыДисконтныхКарт.НайтиПоКоду(Код);
		Если ЗначениеЗаполнено(Вид) Тогда
			Виды.Вставить(Вид, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Виды;

КонецФункции

Функция ЭтоВидКартСотрудников(ВидКарты)

	Возврат ЗначениеЗаполнено(ВидКарты) И Найти(НРег(СокрЛП(ВидКарты.Наименование)), "сотрудник") > 0;

КонецФункции

Функция СтрРазделить_(Строка)

	Результат = Новый Массив;
	Остаток = Строка;
	Пока Остаток <> "" Цикл
		Поз = Найти(Остаток, ",");
		Если Поз = 0 Тогда
			Результат.Добавить(СокрЛП(Остаток));
			Остаток = "";
		Иначе
			Результат.Добавить(СокрЛП(Лев(Остаток, Поз - 1)));
			Остаток = Сред(Остаток, Поз + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПредставлениеЧека(Стр)

	Возврат Формат(Стр.Дата, "ДФ='dd.MM.yyyy HH:mm'") + "   " + СокрЛП(Стр.Номер)
		+ "   " + СокрЛП(Стр.Магазин)
		+ "   " + ?(ЗначениеЗаполнено(Стр.ДисконтнаяКарта), СокрЛП(Стр.ДисконтнаяКарта), "<без карты>")
		+ "   товаров акции: " + Формат(Стр.Количество, "ЧГ=0") + " на " + Формат(Стр.Сумма, "ЧДЦ=2; ЧГ=0") + " руб."
		+ ?(Стр.Возвращено > 0, ", возвращено: " + Формат(Стр.Возвращено, "ЧГ=0"), "");

КонецФункции

Процедура ЗапуститьОбработку() Экспорт

	Если Не ПравоДоступа("Добавление", Метаданные.Документы.НачислениеБонусовПокупателей)
		Или Не ПравоДоступа("Проведение", Метаданные.Документы.НачислениеБонусовПокупателей) Тогда
		Предупреждение("Нет права на добавление и проведение документов «Начисление бонусов покупателей».");
		Возврат;
	КонецЕсли;

	Если Не ПапкиНайдены() Тогда
		Возврат;
	КонецЕсли;

	Состояние("Поиск чеков акции...");
	Чеки = ЗагрузитьЧеки();
	Если Чеки.Количество() = 0 Тогда
		Предупреждение("За период " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
			+ " чеков продажи с товарами акции в магазинах Business Line не найдено.");
		Возврат;
	КонецЕсли;

	ОписаниеАкции = "Акция " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ ": куртки, пальто, плащи." + Символы.ПС
		+ "Начисляется " + Формат(СуммаБонусовАкции, "ЧГ=0") + " доп. бонусов, срок действия до "
		+ Формат(СрокГодности, "ДФ='dd.MM.yyyy HH:mm:ss'") + "." + Символы.ПС
		+ "Найдено чеков продажи с товарами акции: " + Чеки.Количество() + ".";

	// Начисление — один раз на карту (решение от 16.11.2026)
	НаКарту = Истина;

	// 1. Виды дисконтных карт (виды карт сотрудников не предлагаются)
	ГруппаКартСотрудников = Константы.ТекущиеКартыСотрГруппа.Получить();
	ВидыЛояльности = ВидыКартЛояльности();
	ЧековВида = Новый Соответствие;
	ВидыКарт = Новый СписокЗначений;
	Для Каждого Стр Из Чеки Цикл
		Если Не ЗначениеЗаполнено(Стр.ДисконтнаяКарта) Или ЭтоВидКартСотрудников(Стр.ВидКарты) Тогда
			Продолжить;
		КонецЕсли;
		Количество = ЧековВида.Получить(Стр.ВидКарты);
		Если Количество = Неопределено Тогда
			ВидыКарт.Добавить(Стр.ВидКарты, ?(ЗначениеЗаполнено(Стр.ВидКарты), СокрЛП(Стр.ВидКарты), "<вид не указан>"),
				ВидыЛояльности.Получить(Стр.ВидКарты) <> Неопределено);
			Количество = 0;
		КонецЕсли;
		ЧековВида.Вставить(Стр.ВидКарты, Количество + 1);
	КонецЦикла;
	Если ВидыКарт.Количество() = 0 Тогда
		Предупреждение(ОписаниеАкции + Символы.ПС + "Ни в одном из них нет дисконтной карты — начислять некому.");
		Возврат;
	КонецЕсли;
	ВидыКарт.СортироватьПоПредставлению();
	Для Каждого ЭлементСписка Из ВидыКарт Цикл
		ЭлементСписка.Представление = ЭлементСписка.Представление + "   (чеков: "
			+ ЧековВида.Получить(ЭлементСписка.Значение) + ")";
	КонецЦикла;
	Если Не ВидыКарт.ОтметитьЭлементы("По каким видам дисконтных карт начислять бонусы?") Тогда
		Возврат;
	КонецЕсли;
	ВыбранныеВиды = Новый Соответствие;
	Для Каждого ЭлементСписка Из ВидыКарт Цикл
		Если ЭлементСписка.Пометка Тогда
			ВыбранныеВиды.Вставить(ЭлементСписка.Значение, Истина);
		КонецЕсли;
	КонецЦикла;

	// 2. Отбор чеков
	КартыВСписке = Новый Соответствие;
	Пропущено = Новый Соответствие; // причина -> количество чеков
	ПорядокПричин = Новый Массив;
	КНачислению = Новый Массив;
	Список = Новый СписокЗначений;

	Для Каждого Стр Из Чеки Цикл
		Причина = "";
		Если Не ЗначениеЗаполнено(Стр.ДисконтнаяКарта) Тогда
			Причина = "в чеке нет дисконтной карты";
		ИначеЕсли Стр.КартаПомечена Тогда
			Причина = "карта помечена на удаление";
		ИначеЕсли ЭтоВидКартСотрудников(Стр.ВидКарты)
			Или ЗначениеЗаполнено(ГруппаКартСотрудников)
			И Стр.ДисконтнаяКарта.ПринадлежитЭлементу(ГруппаКартСотрудников) Тогда
			Причина = "карта сотрудника";
		ИначеЕсли ВыбранныеВиды.Получить(Стр.ВидКарты) = Неопределено Тогда
			Причина = "вид карты не выбран";
		ИначеЕсли Стр.Возвращено >= Стр.Количество Тогда
			Причина = "товары акции возвращены";
		ИначеЕсли Стр.НачисленоПоЧеку Тогда
			Причина = "по чеку уже начислено";
		ИначеЕсли НаКарту И Стр.НачисленоПоКарте Тогда
			Причина = "по карте уже начислено";
		ИначеЕсли НаКарту И КартыВСписке.Получить(Стр.ДисконтнаяКарта) <> Неопределено Тогда
			Причина = "повторный чек по той же карте";
		КонецЕсли;

		Если Причина <> "" Тогда
			Количество = Пропущено.Получить(Причина);
			Если Количество = Неопределено Тогда
				ПорядокПричин.Добавить(Причина);
				Количество = 0;
			КонецЕсли;
			Пропущено.Вставить(Причина, Количество + 1);
			Сообщить("Пропущен (" + Причина + "): " + ПредставлениеЧека(Стр));
			Продолжить;
		КонецЕсли;

		КартыВСписке.Вставить(Стр.ДисконтнаяКарта, Истина);
		КНачислению.Добавить(Стр);
		Список.Добавить(КНачислению.ВГраница(), ПредставлениеЧека(Стр), Истина);
	КонецЦикла;

	ТекстПропусков = "";
	Для Каждого Причина Из ПорядокПричин Цикл
		ТекстПропусков = ТекстПропусков + Символы.ПС + "   " + Причина + ": " + Пропущено.Получить(Причина);
	КонецЦикла;
	Если ТекстПропусков <> "" Тогда
		ТекстПропусков = Символы.ПС + "Пропущено чеков:" + ТекстПропусков + Символы.ПС + "(список — в окне сообщений)";
	КонецЕсли;

	Если КНачислению.Количество() = 0 Тогда
		Предупреждение(ОписаниеАкции + Символы.ПС + "Начислять не по чему." + ТекстПропусков);
		Возврат;
	КонецЕсли;

	// 4. Просмотр списка
	Если Не Список.ОтметитьЭлементы("Чеки, по которым будет начислено " + Формат(СуммаБонусовАкции, "ЧГ=0")
		+ " доп. бонусов " + ?(НаКарту, "(один раз на карту)", "(за каждый чек)")) Тогда
		Возврат;
	КонецЕсли;
	Отмеченные = Новый Массив;
	Для Каждого ЭлементСписка Из Список Цикл
		Если ЭлементСписка.Пометка Тогда
			Отмеченные.Добавить(КНачислению[ЭлементСписка.Значение]);
		КонецЕсли;
	КонецЦикла;
	Если Отмеченные.Количество() = 0 Тогда
		Предупреждение("Не отмечено ни одного чека.");
		Возврат;
	КонецЕсли;

	Карт = Новый Соответствие;
	Для Каждого Стр Из Отмеченные Цикл
		Карт.Вставить(Стр.ДисконтнаяКарта, Истина);
	КонецЦикла;

	// 5. Подтверждение
	ТекстВопроса = ОписаниеАкции + Символы.ПС + ТекстПропусков + Символы.ПС + Символы.ПС
		+ "Будет создан и проведён документ «Начисление бонусов покупателей»:" + Символы.ПС
		+ "   строк (чеков): " + Отмеченные.Количество() + ", дисконтных карт: " + Карт.Количество() + "," + Символы.ПС
		+ "   всего бонусов: " + Формат(Отмеченные.Количество() * СуммаБонусовАкции, "ЧГ=0")
		+ ", тип «Дополнительный», срок до " + Формат(СрокГодности, "ДФ='dd.MM.yyyy HH:mm:ss'") + "."
		+ Символы.ПС + Символы.ПС + "Продолжить?";
	Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// 6. Документ
	НовДок = Документы.НачислениеБонусовПокупателей.СоздатьДокумент();
	НовДок.Дата = ТекущаяДата();
	НовДок.Комментарий = КомментарийДокумента;
	Для Каждого Стр Из Отмеченные Цикл
		НовСтр = НовДок.Бонусы.Добавить();
		НовСтр.ДисконтнаяКарта = Стр.ДисконтнаяКарта;
		НовСтр.Магазин = Стр.Магазин;
		НовСтр.ДокТип = ДокТипАкции;
		НовСтр.ДокНомер = Стр.Номер;
		НовСтр.ДокДата = Стр.Дата;
		НовСтр.Количество = Стр.Количество - Стр.Возвращено;
		НовСтр.СуммаПокупки = Стр.Сумма;
		НовСтр.СуммаБонусов = СуммаБонусовАкции;
		НовСтр.СрокГодностиВкл = СрокГодности;
		НовСтр.ТипБонуса = Перечисления.ВидыБонусовПокупателей.Дополнительный;
	КонецЦикла;

	НачатьТранзакцию();
	Попытка
		НовДок.Записать(РежимЗаписиДокумента.Запись);
		НовДок.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ОписаниеОшибки();
		Сообщить("Документ не записан: " + ТекстОшибки, СтатусСообщения.Важное);
		Предупреждение("Документ не записан, бонусы не начислены:" + Символы.ПС + ТекстОшибки);
		Возврат;
	КонецПопытки;

	ЗаписьЖурналаРегистрации("НачислениеДопБонусов_АкцияВерхняяОдежда", УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.НачислениеБонусовПокупателей, НовДок.Ссылка,
		"Строк: " + Отмеченные.Количество() + ", бонусов: " + Отмеченные.Количество() * СуммаБонусовАкции);
	Для Каждого Стр Из Отмеченные Цикл
		Сообщить("Начислено " + Формат(СуммаБонусовАкции, "ЧГ=0") + ": " + ПредставлениеЧека(Стр));
	КонецЦикла;

	Предупреждение("Готово. Проведён документ " + СокрЛП(НовДок.Номер) + " от " + Формат(НовДок.Дата, "ДФ=dd.MM.yyyy") + "." + Символы.ПС
		+ "Начислено по " + Отмеченные.Количество() + " чекам, всего " + Формат(Отмеченные.Количество() * СуммаБонусовАкции, "ЧГ=0") + " бонусов.");
	НовДок.ПолучитьФорму().Открыть();

КонецПроцедуры

