Функция ЗаписатьДанные(ДанныеЗаписи) Экспорт
	результат = Новый Структура;
	результат.Вставить("Неудача", Ложь);
	результат.Вставить("Сообщение", "");
	наборЗаписей = РегистрыСведений.УмКо_СтатистикаПосещаемости.СоздатьНаборЗаписей();
	наборЗаписей.Отбор.Период.Установить(ДанныеЗаписи.Дата);
	наборЗаписей.Отбор.Устройство.Установить(ДанныеЗаписи.Устройство);
	наборЗаписей.Отбор.ОтрезокВремени.Установить(ДанныеЗаписи.ОтрезокВремени);
	наборЗаписей.Прочитать();
	// Нулевые отрезки (входов и выходов 0, без блокировки) не храним: на суммы они не влияют,
	// а занимали около 75% регистра. Если раньше в отрезке были данные, а теперь пришел ноль, запись удаляем.
	Если ДанныеЗаписи.КоличествоВходов = 0 И ДанныеЗаписи.КоличествоВыходов = 0 И Не ДанныеЗаписи.Блокировка Тогда
		Если наборЗаписей.Количество() > 0 Тогда
			наборЗаписей.Очистить();
			Попытка
				наборЗаписей.Записать();
			Исключение
				результат.Неудача = Истина;
				результат.Сообщение = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
		Возврат результат;
	КонецЕсли;
	запись = Неопределено;
	записьИзменена = Ложь;
	Если наборЗаписей.Количество() = 0 Тогда
		запись = наборЗаписей.Добавить();
		запись.Период = ДанныеЗаписи.Дата;
		запись.ОтрезокВремени = ДанныеЗаписи.ОтрезокВремени;
		запись.Устройство = ДанныеЗаписи.Устройство;
		записьИзменена = Истина;
	Иначе
		запись = наборЗаписей[0];
	КонецЕсли;
	Если запись.ОтрезокВремени <> ДанныеЗаписи.ОтрезокВремени Тогда
		запись.ОтрезокВремени = ДанныеЗаписи.ОтрезокВремени;
		записьИзменена = Истина;
	КонецЕсли;
	Если ДанныеЗаписи.КоличествоВходов <> запись.КоличествоВходов Тогда
		запись.КоличествоВходов = ДанныеЗаписи.КоличествоВходов;
		записьИзменена = Истина;
	КонецЕсли;
	Если ДанныеЗаписи.КоличествоВыходов <> запись.КоличествоВыходов Тогда
		запись.КоличествоВыходов = ДанныеЗаписи.КоличествоВыходов;
		записьИзменена = Истина;
	КонецЕсли;
	Если ДанныеЗаписи.Блокировка <> запись.Блокировка Тогда
		запись.Блокировка = ДанныеЗаписи.Блокировка;
		записьИзменена = Истина;
	КонецЕсли;
	Если записьИзменена Тогда
		Попытка
			наборЗаписей.Записать();
		Исключение
			результат.Неудача = Истина;
			результат.Сообщение = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
	Возврат результат;
КонецФункции