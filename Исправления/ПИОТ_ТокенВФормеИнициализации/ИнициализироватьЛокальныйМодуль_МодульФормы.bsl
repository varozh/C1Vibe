Процедура КнопкаВыполнитьНажатие(Кнопка)
	
	Если НЕ ЗначениеЗаполнено(Магазин) Тогда
		Предупреждение("Укажите магазин.");
		Возврат;
	КонецЕсли;
	
	настройкиМагазина = РегистрыСведений.НастройкиРазрешительногоРежимаМагазинов.НастройкиМагазина(Магазин);
	
	// Токен, введенный в форме, заменяет токен из регистра настроек магазина.
	токенФормы = СокрЛП(Токен);
	Если ЗначениеЗаполнено(токенФормы) Тогда
		настройкиМагазина.ТокенАвторизации = токенФормы;
	КонецЕсли;
	
	результатИнициализации = УмКо_ИнициализироватьЛокальныйМодуль(настройкиМагазина);
	
	Если результатИнициализации.Неудача Тогда
		Сообщить(результатИнициализации.Сообщение, СтатусСообщения.Важное);
	Иначе
		Сообщить("Локальный модуль инициализирован" + ?(ЗначениеЗаполнено(токенФормы), " (токен из формы).", " (токен из регистра)."));
	КонецЕсли;
	
КонецПроцедуры

Функция УмКо_ИнициализироватьЛокальныйМодуль(НастройкиМагазина)
	результат = Новый Структура("Неудача, Сообщение", Ложь, "");
	параметрыЗапроса = Новый Структура;
	параметрыЗапроса.Вставить("АдресСервера", НастройкиМагазина.СерверЛокальногоМодуля);
	Если НастройкиМагазина.ПортЛокальногоМодуля > 0 Тогда
		параметрыЗапроса.АдресСервера = СтрШаблон("%1:%2", параметрыЗапроса.АдресСервера, Формат(НастройкиМагазина.ПортЛокальногоМодуля, "ЧГ=0"));
	КонецЕсли;
	параметрыЗапроса.Вставить("Логин", НастройкиМагазина.ЛогинЛокальногоМодуля);
	параметрыЗапроса.Вставить("Пароль", НастройкиМагазина.ПарольЛокальногоМодуля);
	параметрыЗапроса.Вставить("Токен", НастройкиМагазина.ТокенАвторизации);
	параметрыЗапроса.Вставить("Таймаут", НастройкиМагазина.ТаймаутЛокальногоМодуля);
	
	//результатЗапроса = УмКо_ЛокальныйМодульЧЗ.ИнициализацияЛокальногоМодуля(параметрыЗапроса);
	результатЗапроса = ИнициализацияЛокальногоМодуля(параметрыЗапроса);
	
	Если результатЗапроса.Неудача Тогда
		результат.Неудача = Истина;
		результат.Сообщение = СтрШаблон("Не удалось инициализировать локальный модуль (Честный знак): %1", результатЗапроса.ОписаниеОшибки);
	КонецЕсли;
	Возврат результат;
КонецФункции

Функция ИнициализацияЛокальногоМодуля(ПараметрыЗапроса) Экспорт
	результат = Новый Структура;
	результат.Вставить("Неудача", Ложь);
	результат.Вставить("ОписаниеОшибки", "");
	результат.Вставить("Данные", Неопределено);
	соединение = СоздатьHTTPСоединение(ПараметрыЗапроса.АдресСервера, ПараметрыЗапроса.Таймаут);
	Если НЕ соединение.Неудача Тогда
		данныеТокена = Новый Структура("token", ПараметрыЗапроса.Токен);
		записьJSON = Новый ЗаписьJSON;
		записьJSON.УстановитьСтроку();
		ЗаписатьJSON(записьJSON, данныеТокена,);
		строкаТокена = записьJSON.Закрыть();
		
		//запрос = ОтправитьHTTPЗапрос(соединение.Соединение, ПараметрыЗапроса.Логин, ПараметрыЗапроса.Пароль, "POST", "/api/v1/init", строкаТокена);
		запрос = ОтправитьHTTPЗапрос(соединение.Соединение, "admin", "admin", "POST", "/api/v2/init", строкаТокена);
		
		Если НЕ запрос.Неудача Тогда
			Сообщить("Код состояния: " + запрос.Ответ.КодСостояния);
		КонецЕсли;
		
		Если НЕ запрос.Неудача Тогда
			Если запрос.Ответ.КодСостояния <> 200 Тогда
				результат.Неудача = Истина;
				результат.ОписаниеОшибки = СтрШаблон("Код состояния: %1", запрос.Ответ.КодСостояния);
				чтениеJSON = Новый ЧтениеJSON;
				чтениеJSON.УстановитьСтроку(запрос.Ответ.ПолучитьТелоКакСтроку());
				телоОтвета = ПрочитатьJSON(чтениеJSON);
				чтениеJSON.Закрыть();
				Если ТипЗнч(телоОтвета) = Тип("Структура") Тогда
					результат.ОписаниеОшибки = СтрШаблон("%1 (%2)", результат.ОписаниеОшибки, телоОтвета.reason);
				КонецЕсли;
			КонецЕсли;
		Иначе
			результат.Неудача = Истина;
			результат.ОписаниеОшибки = запрос.ОписаниеОшибки;
		КонецЕсли;
	Иначе
		результат.Неудача = Истина;
		результат.ОписаниеОшибки = соединение.ОписаниеОшибки;
	КонецЕсли;
	Возврат результат;
КонецФункции

Функция СоздатьHTTPСоединение(АдресСервера, Таймаут)
	// Продуктивный контур – https://rsapi.crpt.ru;
	// Тестовый контур – https://suz-rsapi.sandbox.crptech.ru.
	результат = Новый Структура;
	результат.Вставить("Неудача", Ложь);
	результат.Вставить("Соединение", Неопределено);
	результат.Вставить("ОписаниеОшибки", "");
	Попытка
		результат.Соединение = Новый HTTPСоединение(АдресСервера,,,,, Таймаут);
	Исключение
		результат.Неудача = Истина;
		результат.ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	Возврат результат;
КонецФункции

Функция ОтправитьHTTPЗапрос(Соединение, Логин, Пароль, ИмяМетода, АдресРесурса, СтрокаЗапроса = "")
	результат = Новый Структура;
	результат.Вставить("Неудача", Ложь);
	результат.Вставить("Ответ", Неопределено);
	результат.Вставить("ОписаниеОшибки", "");
	Если Соединение <> Неопределено Тогда
		httpЗаголовоки = Новый Соответствие;
		httpЗаголовоки.Вставить("Content-Type", "application/json");
		дв = ПолучитьДвоичныеДанныеИзСтроки(СтрШаблон("%1:%2", Логин, Пароль));
		данныеАвторизации = Base64Строка(дв);
		httpЗаголовоки.Вставить("Authorization", СтрШаблон("Basic %1", данныеАвторизации));
		httpЗапрос = Новый HTTPЗапрос(АдресРесурса, httpЗаголовоки);
		Если СтрокаЗапроса <> "" Тогда
			httpЗапрос.УстановитьТелоИзСтроки(СтрокаЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
		Попытка
			Если ИмяМетода = "POST" Тогда 
				результат.Ответ = Соединение.ОтправитьДляОбработки(httpЗапрос);
			Иначе 
				результат.Ответ = Соединение.ВызватьHTTPМетод(ИмяМетода, httpЗапрос);
			КонецЕсли;
		Исключение
			результат.Неудача = Истина;
			результат.ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
	Иначе
		результат.Неудача = Истина;
		результат.ОписаниеОшибки = "Отсутствует установленное HTTP/HTTPS-соединение.";
	КонецЕсли;
	Возврат результат;
КонецФункции
