Процедура ПриходныйОрдерИДоставкаНажатие(Элемент)
	//Интерсофт + Блок
	Если не ДокПеремещения.Пустая() тогда
		Для каждого стр из ТабличноеПоле1 Цикл
			Если не Стр.Отм тогда
				Продолжить;
			КонецЕсли;
			Если Стр.Документ <> ДокПеремещения тогда	
				Сообщить("Никаких действий не произведено");
				Сообщить("В табличной части указаны документы отличные от указанного в сверке перемещений");
				Сообщить("Либо уберите документ из сверки перемещений либо отметьте только его в текущей табличной части");
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ТабличноеПоле1.Количество() = 0 Тогда
		Сообщить("Нажмите 'перейти к оформлению' на странице 'Сверка перемещений', после того как отсканируете весь товар");
	КонецЕсли;
	Для Каждого Док из ТабличноеПоле1 Цикл
		Если Док.САктом = Истина Тогда 
			ДокументОбъект = Док.Документ.ПолучитьОбъект();
			ДокументОбъект.СоставленАкт = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		Если Док.Отм = Истина   Тогда
			
			ПринятьДокумент(Док.Документ);
			
			Док.ПрихОрдер = ПриходныйОрдер.Ссылка;
			Если Док.САктом Тогда
			Док.АктРасхождения = АктРасхождения.Ссылка;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ЗаполнитьНепринятымиНажатие(Элемент)
	ТабличноеПоле1.Очистить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ПеремещениеТоваров.Ссылка КАК Ссылка,
	|	ПриходныйОрдерНаТовары.Ссылка КАК прихордер,
	|	РеестрДокументов.ОтметкаБухгалтерии КАК вархиве
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйОрдерНаТовары КАК ПриходныйОрдерНаТовары
	|		ПО (ПриходныйОрдерНаТовары.ДокументПеремещения = ПеремещениеТоваров.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрДокументов КАК РеестрДокументов
	|		ПО (РеестрДокументов.Документ = ПеремещениеТоваров.Ссылка)
	|ГДЕ
	|	ПеремещениеТоваров.Дата > &ДатаХ
	|	И ПеремещениеТоваров.СкладПолучатель = &СкладПолучатель
	|	И ПеремещениеТоваров.Доставлено = &ПустаяДата
	|	И ПеремещениеТоваров.Проведен = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ПеремещениеТоваров.Ссылка,
	|	РеестрДокументов.ОтметкаБухгалтерии,
	|	ПриходныйОрдерНаТовары.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|АВТОУПОРЯДОЧИВАНИЕ");
	
	
	Запрос.УстановитьПараметр("ДатаХ", Дата("20150810000000"));
	ЗАпрос.УстановитьПараметр("СкладПолучатель",Получатель);
	Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101000000"));
	
	Рез = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр из Рез Цикл
		Нов = ТабличноеПоле1.Добавить();
		Нов.Дата = Стр.Ссылка.Дата;
		Нов.Номер = Стр.Ссылка.Номер;
		Нов.Документ = Стр.Ссылка;
		Нов.Отправитель = Стр.ССылка.СкладОтправитель;
		Нов.Получатель = Стр.Ссылка.СкладПолучатель;
		Нов.Организация = Стр.Ссылка.Организация;
		Нов.СуммаДокумента = Стр.Ссылка.Товары.Итог("Сумма");
		Нов.КолМест = стр.ссылка.количествомешков;
		нов.вархиве = стр.вархиве;
		нов.прихордер = стр.прихордер;
	КонецЦикла;
	
КонецПроцедуры


Процедура ТолькоДоставкаНажатие(Элемент)
	Для Каждого стр из ТабличноеПоле1 цикл
		если стр.отм = истина тогда
			Накл = стр.Документ.ПолучитьОбъект();
			Накл.Доставлено = ТекущаяДата();
			Накл.Записать(РежимЗаписиДокумента.Запись);
			
			Если стр.Документ.Отгружено = Дата("00010101000000") Тогда 
				Накл = стр.Документ.ПолучитьОбъект();
				Накл.Отгружено = ТекущаяДата();
				Накл.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


Функция ПолучитьСтрокиТаблицы(Таб,ИмяКолонки, ЗначениеВКолонке1 = ";;;", ЗначениеВКолонке2 = ";;;", ЗначениеВКолонке3 = ";;;", ЗначениеВКолонке4 = ";;;", ЗначениеВКолонке5 = ";;;", ЗначениеВКолонке6 = ";;;", ЗначениеВКолонке7 = ";;;", ЗначениеВКолонке8 = ";;;") Экспорт	 	
	Перем У, Мас;
	Если Найти(ИмяКолонки,",") > 0 Тогда
		Попытка
			Стр = "";
			Для Х = 1 По 8 Цикл				
				Выполнить("У = ЗначениеВКолонке" + СокрЛП(Х));
				Если  У <> ";;;" Тогда
					Стр = Стр + "ЗначениеВКолонке" + СокрЛП(Х)+",";
				КонецЕсли;	
			КонецЦикла;		
			Стр = Лев(Стр,СтрДлина(Стр)-1);
			Тмп = "Мас = Таб.НайтиСтроки(Новый Структура("""  + ИмяКолонки + """," + Стр + "))";
			Выполнить(Тмп);
			Возврат(Мас);
		Исключение
			Возврат("");
		КонецПопытки;
	Иначе
		Попытка
			Мас = Таб.НайтиСтроки(Новый Структура(ИмяКолонки, ЗначениеВКолонке1));
			Возврат(Мас);
		Исключение
			Мас = "";
			Возврат(Мас);		
		КонецПопытки;				
	КонецЕсли;
КонецФункции

Функция УдалитьСтрокиТаблицы(Таб, Мас = "", ИмяКолонки = "", ЗначениеВКолонке = "", ВернутьТаблицу = Ложь) Экспорт // Если задан мас, удалеются по массиву, иначе ищутся по значениям и удаляются
	Если Мас <> "" Тогда
		М = Мас;
	Иначе		
		М = ПолучитьСтрокиТаблицы(Таб, ИмяКолонки, ЗначениеВКолонке) 
	КонецЕсли; 
	
	Для Каждого Эл Из М Цикл
		Таб.Удалить(Эл);
	КонецЦикла;	
	Если ВернутьТаблицу тогда
		Возврат Таб;
	Иначе
		Возврат "";
	КонецЕсли;	
КонецФункции


Функция ШКвНомер(Номер)
	
	//транслитерация номера
	
	strRus = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"; 
	strEng = "A///B///V///G///D///E///YO//ZH//Z///I///Y///K///L///M///N///O///P///R///S///T///U///F///KH//TS//CH//SH//SHCH'///Y///////E///YU//JA//";
	strResult = ""; 
	Для i = 1 по СтрДлина(Номер) Цикл 
		s = Сред(Номер, i,1); 
		s=ВРег(s); 
		k = Найти(strENG, s); 
		Если k = 0 тогда 
			strResult = strResult + s; 
		Иначе 
			strResult = strResult + СтрЗаменить(Сред(strRUS, (k - 1) * 4 + 1, 4), "/", ""); 
		КонецЕсли 
	КонецЦикла ; 
	
	Номер = strResult;
	
	//формируем шк
	СтрокаШк =  Строка(Номер); 
	
	Возврат СтрокаШК;	
	
КонецФункции

// Только для внутреннего использования
Функция СтрокаЛатиницей(Знач Строка) Экспорт
	Результат = "";
	
	Соответствие = СоответствиеКириллицыИЛатиницы();
	
	ПредыдущийСимвол = "";
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Позиция, 1);
		СимволЛатиницей = Соответствие[НРег(Символ)]; // поиск соответствия без учета регистра
		Если СимволЛатиницей = Неопределено Тогда
			// другие символы остаются "как есть"
			СимволЛатиницей = Символ;
		Иначе
			Если Символ = ВРег(Символ) Тогда
				СимволЛатиницей = ТРег(СимволЛатиницей); // восстанавливаем регистр
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + СимволЛатиницей;
		ПредыдущийСимвол = СимволЛатиницей;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции
