Функция НайтиДокПеремещения()
	УЗЕЛ = Ложь;
	Если ЭлементыФормы.Панель1.ТекущаяСтраница.Имя = "СверкаПеремещений" Тогда	
		Если УЗЕЛ  Тогда //если узел ищем по номеру и дате т.к. там нет штрихкодов
			НомерДок =СтрокаЛатиницей(Прав(СокрЛП(вводШК),11));
			Дата = прав(Лев(СокрЛП(вводШК),8),6);
			Дата1с = ДатаИзСтроки(Дата);
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПеремещениеТоваров.Ссылка КАК ДокПеремещения
			|ИЗ
			|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
			|ГДЕ
			|	ПеремещениеТоваров.Номер = &Номер
			|	И  НАЧАЛОПЕРИОДА(ПеремещениеТоваров.Дата) = &Дата";
			
			Запрос.УстановитьПараметр("Номер", НомерДок);
			Запрос.УстановитьПараметр("Дата", Дата1с);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				Сообщить("По ШтрихКоду "+вводШК+" документов перемещения не найдено, повторите сканирование корректного документа");
				Возврат("");
			Иначе	
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				ВыборкаДетальныеЗаписи.Следующий();
				Возврат(ВыборкаДетальныеЗаписи.ДокПеремещения);		
			КонецЕсли;
			вводШК = "";
			
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеестрДокументов.Документ
			|ИЗ
			|	РегистрСведений.РеестрДокументов КАК РеестрДокументов
			|ГДЕ
			|	РеестрДокументов.Штрихкод = &Штрихкод";
			
			Запрос.УстановитьПараметр("Штрихкод", СокрЛП(вводШК));
			
			РезультатЗапроса = Запрос.Выполнить();
			Если РезультатЗапроса.Пустой() Тогда
				Сообщить("По ШтрихКоду "+вводШК+" документов перемещения не найдено, повторите сканирование корректного документа");
				Возврат("");
				
			Иначе	
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				ВыборкаДетальныеЗаписи.Следующий();
				Возврат(ВыборкаДетальныеЗаписи.Документ);		
			КонецЕсли;
			вводШК = "";
			
		КонецЕсли;
	КонецЕсли;
КонецФункции


Функция ДатаИзСтроки(СтрокаДата)
	Строка =          Сред(СтрокаДата,5,2) +"."+ //число
	+ Сред(СтрокаДата,3,2) +"."+//месяц
	+ "20" + Лев(СтрокаДата,2)  //год
	+" 00:00:00" ;
	Возврат Дата(Строка);
	
КонецФункции



