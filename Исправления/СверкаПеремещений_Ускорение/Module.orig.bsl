Процедура ПринятьДокумент(ДокументПрихода)
	Магазин = ПараметрыСеанса.ТекущийМагазин;	
	//обрабатываем цены
	НовПереоценка = Документы.УстановкаЦенНоменклатурыВМагазине.СоздатьДокумент();
	НовПереоценка.Дата = ТекущаяДата();
	НовПереоценка.Магазин = Магазин;
	НовПереоценка.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	ТЗПодозрительныхЦен = Новый ТаблицаЗначений;
	ТЗПодозрительныхЦен.Колонки.Добавить("Строка",,"Строка");
	ТЗПодозрительныхЦен.Колонки.Добавить("Номенклатура",,"Номенклатура");
	ТЗПодозрительныхЦен.Колонки.Добавить("Характеристика",,"Характеристика");
	ТЗПодозрительныхЦен.Колонки.Добавить("ЦенаДокумента",,"ЦенаДокумента");
	ТЗПодозрительныхЦен.Колонки.Добавить("ЦенаПоТипуЦен",,"ЦенаПоТипуЦен");
	ТЗПодозрительныхЦен.Колонки.Добавить("ЦенаМагазинаТек",,"ЦенаМагазинаТек");
	
	
	Для Каждого Стр из ДокументПрихода.Товары Цикл
		Отбор1 = Новый Структура;
		Отбор1.Вставить("Номенклатура",Стр.Номенклатура);
		Отбор1.Вставить("ХарактеристикаНоменклатуры", Стр.ХарактеристикаНоменклатуры);
		Отбор1.Вставить("ТипЦен", Магазин.ТипЦенРозничнойТорговли);
		ЦенаПоТипуЦен = РегистрыСведений.ЦеныНоменклатуры.ПолучитьПоследнее(ТекущаяДата(),Отбор1).Цена;
		Отбор2 = Новый Структура;
		Отбор2.Вставить("Номенклатура",Стр.Номенклатура);
		Отбор2.Вставить("ХарактеристикаНоменклатуры", Стр.ХарактеристикаНоменклатуры);
		Отбор2.Вставить("Магазин", Магазин);		
		ЦенаМагазинаТек = РегистрыСведений.ЦеныНоменклатурыМагазинов.ПолучитьПоследнее(ТекущаяДата(),Отбор2).Цена;
		
		Если (Стр.Цена <> ЦенаПоТипуЦен и Стр.Цена <> ЦенаМагазинаТек) и (ЦенаПоТипуЦен > 0 и ЦенаМагазинаТек > 0) Тогда 
			//подозрительные
			НовПодозр = ТЗПодозрительныхЦен.Добавить();
			НовПодозр.Строка = Стр.НомерСтроки;
			НовПодозр.Номенклатура = Стр.Номенклатура;
			НовПодозр.Характеристика = Стр.ХарактеристикаНоменклатуры;
			НовПодозр.ЦенаДокумента = Стр.Цена;
			НовПодозр.ЦенаПоТипуЦен = ЦенаПоТипуЦен;
			НовПодозр.ЦенаМагазинаТек = ЦенаМагазинаТек;
		ИначеЕсли (Стр.Цена = ЦенаПоТипуЦен и Стр.Цена <> ЦенаМагазинаТек) или ((Стр.Цена <> ЦенаПоТипуЦен и Стр.Цена <> ЦенаМагазинаТек) и (ЦенаПоТипуЦен = 0 или ЦенаМагазинаТек = 0)) Тогда 
			//переоценка
			НовЦена = НовПереоценка.Товары.Добавить();
			НовЦена.Номенклатура =  Стр.Номенклатура;
			НовЦена.ХарактеристикаНоменклатуры = Стр.ХарактеристикаНоменклатуры;
			НовЦена.ЦенаВРознице = Стр.Цена;
		КонецЕсли;
	КонецЦикла;
	
	Если НовПереоценка.Товары.Количество() > 0 Тогда 
		НовПереоценка.Товары.Свернуть("Номенклатура, ХарактеристикаНоменклатуры,ЦенаВРознице");
		НовПереоценка.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
	Если ТЗПодозрительныхЦен.Количество() > 0 Тогда 
		Табдок = Новый ТабличныйДокумент;
		Макет = ПолучитьМакет("Макет");
		
		Обл = Макет.ПолучитьОбласть("Заголовок");
		Обл.Параметры.Документ = ДокументПрихода.Ссылка;
		Табдок.Вывести(Обл);
		
		Обл = Макет.ПолучитьОбласть("Строка");
		Для Каждого СтрокаВывода из ТЗПодозрительныхЦен Цикл
			Обл.Параметры.СтрокаДок = СтрокаВывода.Строка;	
			Обл.Параметры.Номенклатура = СтрокаВывода.Номенклатура;	
			Обл.Параметры.Характеристика = СтрокаВывода.Характеристика;	
			Обл.Параметры.ЦенаДокумента	 = СтрокаВывода.ЦенаДокумента;
			Обл.Параметры.ЦенаПоТипуЦен	 = СтрокаВывода.ЦенаПоТипуЦен;
			Обл.Параметры.ЦенаМагазинаТек = СтрокаВывода.ЦенаМагазинаТек;
		КонецЦикла;
		Табдок.Вывести(Обл);
		
		Табдок.АвтоМасштаб = Истина;
		Табдок.Показать();
	КонецЕсли;
	
	
	//проверка оформлен ли уже приходный ордер
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриходныйОрдерНаТовары.Ссылка
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары КАК ПриходныйОрдерНаТовары
	|ГДЕ
	|	ПриходныйОрдерНаТовары.ДокументОснование = &Док
	|	И ПриходныйОрдерНаТовары.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("Док", ДокументПрихода.ссылка);
	
	Результат = Запрос.Выполнить().Выбрать();
	//помечаем на удаление приходные ордера если есть
	Пока Результат.Следующий() Цикл
		Документ = Результат.Ссылка.ПолучитьОбъект();
		Документ.УстановитьПометкуУдаления(Истина);
		Документ.Записать();
	КонецЦикла;
	
	
	ТЗИзбыток = Новый ТаблицаЗначений;
	ТЗИзбыток.Колонки.Добавить("Строка",,"Строка");
	ТЗИзбыток.Колонки.Добавить("Номенклатура",,"Номенклатура");
	ТЗИзбыток.Колонки.Добавить("ХарактеристикаНоменклатуры",,"ХарактеристикаНоменклатуры");
	ТЗИзбыток.Колонки.Добавить("ЕдиницаИзмерения",,"ЕдиницаИзмерения");
	ТЗИзбыток.Колонки.Добавить("Цена",,"Цена");
	ТЗИзбыток.Колонки.Добавить("СуммаИзлишка",,"Сумма");
	ТЗИзбыток.Колонки.Добавить("Коэффициент",,"Коэффициент");
	ТЗИзбыток.Колонки.Добавить("КоличествоПоДокументу",,"КоличествоПоДок");
	ТЗИзбыток.Колонки.Добавить("КоличествоПоФакту",,"Количество");
	ТЗИзбыток.Колонки.Добавить("Излишек",,"КоличествоРазницпа");
	
	
	
	
	ТЗНедостача = Новый ТаблицаЗначений;
	ТЗНедостача.Колонки.Добавить("Строка",,"Строка");
	ТЗНедостача.Колонки.Добавить("Номенклатура",,"Номенклатура");
	ТЗНедостача.Колонки.Добавить("ХарактеристикаНоменклатуры",,"ХарактеристикаНоменклатуры");
	ТЗНедостача.Колонки.Добавить("ЕдиницаИзмерения",,"ЕдиницаИзмерения");
	ТЗНедостача.Колонки.Добавить("Цена",,"Цена");
	ТЗНедостача.Колонки.Добавить("СуммаНедостачи",,"Сумма");
	ТЗНедостача.Колонки.Добавить("Коэффициент",,"Коэффициент");
	ТЗНедостача.Колонки.Добавить("КоличествоПоДокументу",,"КоличествоПоДок"); 
	ТЗНедостача.Колонки.Добавить("КоличествоПоФакту",,"Количество");
	ТЗНедостача.Колонки.Добавить("Недостача",,"КоличествоРазницпа");
	ТЗНедостача.Колонки.Добавить("НомерСтрокиВНакладной",,"НомерСтрокиВНакладной");	
	
	
	//формируем приходный ордер
	Новприх = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
	Новприх.Дата = ТекущаяДата();
	Новприх.ДокументОснование = ДокументПрихода;
	Новприх.Магазин = Магазин;
	Новприх.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Новприх.Склад = Магазин.ОсновнойСклад;
	Новприх.Записать(РежимЗаписиДокумента.Запись);
	Ордер = Новприх.Ссылка.ПолучитьОбъект();
	Если НЕ ДокументПрихода.СоставленАкт Тогда
		Ордер.Товары.Загрузить(ДокументПрихода.Товары.Выгрузить());
	Иначе
		Если не ДокПеремещения.Пустая() тогда
			Т  = Товары.Выгрузить();
			Для каждого строкаТовары из ДокументПрихода.Товары Цикл
				М = ПолучитьСтрокиТаблицы(Т, "ХарактеристикаНоменклатуры,Номенклатура", строкаТовары.ХарактеристикаНоменклатуры, строкаТовары.Номенклатура);
				Темп = Т.Скопировать(М);
				ИтогКолФакт = Темп.Итог("Количество");
				
				Если М[0].Количество < М[0].КоличествоПоДок Тогда   //количество = количество по факту
					//Недосатача
					
					
					нс = ТЗНедостача.Добавить();
					нс.Номенклатура = строкаТовары.Номенклатура;
					нс.ХарактеристикаНоменклатуры = строкаТовары.ХарактеристикаНоменклатуры;
					нс.ЕдиницаИзмерения = нс.Номенклатура.ЕдиницаХраненияОстатков;
					нс.Цена  = М[0].цена; 
					нс.СуммаНедостачи = -1*(ИтогКолФакт - СтрокаТовары.Количество) * строкаТовары.цена ;
					нс.Коэффициент = 1;
					нс.КоличествоПоДокументу = СтрокаТовары.Количество;
					нс.КоличествоПоФакту = ИтогКолФакт;
					нс.Недостача = -1 * (ИтогКолФакт - СтрокаТовары.Количество);			
					нс.НомерСтрокиВНакладной =0 ;
				ИначеЕсли М[0].Количество > М[0].КоличествоПоДок Тогда
					//избыток
					
					
					
					нс = ТЗИзбыток.Добавить();
					нс.Номенклатура = строкаТовары.Номенклатура;
					нс.ХарактеристикаНоменклатуры = строкаТовары.ХарактеристикаНоменклатуры;
					нс.ЕдиницаИзмерения = нс.Номенклатура.ЕдиницаХраненияОстатков;
					нс.Цена  =  М[0].цена; 
					нс.СуммаИзлишка = (ИтогКолФакт - СтрокаТовары.Количество) * строкаТовары.цена;
					нс.Коэффициент = 1;
					нс.КоличествоПоДокументу = СтрокаТовары.Количество;
					нс.КоличествоПоФакту = ИтогКолФакт; 					
					нс.ИЗлишек = ИтогКолФакт-СтрокаТовары.Количество;
					
				КонецЕсли;
				
				Если ИтогКолФакт  = 0 тогда
					УдалитьСтрокиТаблицы(Т,М);	
					Продолжить;
				КонецЕсли;	
				Если М.Количество() = 0 Тогда
					Сообщить("не найдена в таблице сверки номенклатура " + СокрЛП(строкаТовары.Номенклатура), СокрЛП(строкаТовары.ХарактеристикаНоменклатуры) + " = Эта номенклатура не попала в приходный ордер");										
					Продолжить;
				КонецЕсли;										
				
				
				Ордер.Товары.Загрузить(ДокументПрихода.Товары.Выгрузить());
				
				//нс = Ордер.Товары.Добавить();						
				//нс.Номенклатура = строкаТовары.Номенклатура;
				//нс.ХарактеристикаНоменклатуры = строкаТовары.ХарактеристикаНоменклатуры;
				//нс.ЕдиницаИзмерения = нс.Номенклатура.ЕдиницаХраненияОстатков;
				//нс.Цена  = строкаТовары.цена; 
				//нс.Сумма = ИтогКолФакт *строкаТовары.цена ;
