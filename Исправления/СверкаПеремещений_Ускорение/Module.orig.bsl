// Функция осуществляет обработку считывания штрих-кода номенклатуры
//
// Параметры:
//  Номенклатура                - <СправочникСсылка.Номенклатура>
//                              - Номенклатура, штрих-код которой был отсканирован.
//
//  ХарактеристикаНоменклатуры  - <СправочникСсылка.ХарактеристикаНоменклатуры>
//                              - Характеристика номенклатуры отсканированной номенклатуры.
//
//  Единица                     - <СправочникСсылка.ЕдиницыИзмерения>
//                              - Единица измерения отсканированной номенклатуры.
//
//  КоличествоПоДок                  - <Число>
//                              - КоличествоПоДок отсканированной номенклатуры.
//
// Возвращаемое значение:
//  <Булево>                    - Данная ситуация обработана.
//
Функция СШКНоменклатура(Номенклатура, ХарактеристикаНоменклатуры, Единица, Количество) Экспорт
	
	//РаботаСДиалогами.ОбработкаПодбора(ЭтаФорма, Товары,
	//Номенклатура,
	//ХарактеристикаНоменклатуры,
	//Единица, КоличествоПоДок,
	//УправлениеЗапасами.ПолучитьНовыйКлючСтроки(ЭтотОбъект));
	//
	//Возврат Истина;
	Результат        = Истина;
	Склад = ДокПеремещения.СкладПолучатель;	
	МассивТовары = Товары.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры", Номенклатура, ХарактеристикаНоменклатуры));
	Если Не МассивТовары.Количество() = 0 Тогда
		текСтрока = МассивТовары[0];
		текСтрока.Количество = текСтрока.Количество + Количество;
		
		Если текСтрока.Цена = 0 Тогда
			текСтрока.Цена = Ценообразование.ПолучитьЦенуНоменклатурыВРознице(, Склад, Номенклатура, ХарактеристикаНоменклатуры, Единица);
			
		КонецЕсли;
		ЭлементыФормы.ТоварыПеремещение.ТекущаяСтрока = текСтрока;
		ЭлементыФормы.ТоварыПеремещение.ТекущаяКолонка = ЭлементыФормы.ТоварыПеремещение.Колонки.Количество;
		ЭлементыФормы.ТоварыПеремещение.ИзменитьСтроку();
	Иначе
		ТоварНаименование = СокрЛП(Номенклатура) + ?(ЗначениеЗаполнено(ХарактеристикаНоменклатуры), " (" + ХарактеристикаНоменклатуры + ")", "");
		Ответ = Вопрос("Номенклатура """ + ТоварНаименование + """ в списке товаров не найдена! Добавить в список товаров?", РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			НовСтрока = Товары.Добавить();
			НовСтрока.Номенклатура               = Номенклатура;
			НовСтрока.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
			НовСтрока.Количество      = 1;
			
			НовСтрока.ЕдиницаИзмерения           = Единица;
			НовСтрока.Коэффициент                = Единица.Коэффициент;
			
			НовСтрока.Цена               = Ценообразование.ПолучитьЦенуНоменклатурыВРознице(, Склад, Номенклатура, ХарактеристикаНоменклатуры, Единица);
			НовСтрока.Код = НовСтрока.Номенклатура.Код;
			
			НовСтрока.КлючСтроки                 = УправлениеЗапасами.ПолучитьНовыйКлючСтроки(ЭтотОбъект);
			ТоварыПриИзмененииНоменклатуры(НовСтрока, Истина);
		КонецЕсли;
	КонецЕсли;
	  СохранитьВоВременныйФайл(1);
	Возврат Результат;
КонецФункции // СШКНоменклатура()


Процедура ТоварыПеремещениеНоменклатураПриИзменении(Элемент)
	СтрокаТабличнойЧасти= ЭлементыФормы.ТоварыПеремещение.ТекущиеДанные;
	ТоварыПриИзмененииНоменклатуры(СтрокаТабличнойЧасти);
	
	СтрокаТабличнойЧасти.Артикул = СтрокаТабличнойЧасти.Номенклатура.Артикул;
	
	
	// Вставить содержимое обработчика.
КонецПроцедуры

// Процедура обрабатывает изменение номенклатуры в ТЧ товары. Для обращений извне.
//
Процедура ТоварыПриИзмененииНоменклатуры(СтрокаТабличнойЧасти, ПерейтиНаКоличество = Ложь) Экспорт
	
	Если СтрокаТабличнойЧасти.КлючСтроки = 0  Тогда
		СтрокаТабличнойЧасти.КлючСтроки = УправлениеЗапасами.ПолучитьНовыйКлючСтроки(ЭтотОбъект);
	КонецЕсли;
	
	ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(СтрокаТабличнойЧасти,ЭтотОбъект);
	
	//ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦенуТабЧасти(СтрокаТабличнойЧасти, ЭтотОбъект);
	
	УправлениеЗапасами.ОчиститьСерийныеНомера(СтрокаТабличнойЧасти, ЭтотОбъект,,Ложь);
	
	ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти, ЭтотОбъект);
	
	РаботаСДиалогами.УстановитьВидимостьКолонокХарактеристикаНоменклатуры(СтрокаТабличнойЧасти.Номенклатура.ВидНоменклатуры, мКолонкиТовары.ХарактеристикаНоменклатуры);
	
	// Для поля "Характеристика номенклатуры" и его элемента управления произведем установку признака автоматической подсветки незаполненного значения
	мКолонкиТовары.ХарактеристикаНоменклатуры.АвтоОтметкаНезаполненного                   = ОбщегоНазначения.ПолучитьФлагУчетаХарактеристик(СтрокаТабличнойЧасти.Номенклатура.ВидНоменклатуры);
	мКолонкиТовары.ХарактеристикаНоменклатуры.ЭлементУправления.ОтметкаНезаполненного     = ЛОЖЬ;
	мКолонкиТовары.ХарактеристикаНоменклатуры.ЭлементУправления.АвтоОтметкаНезаполненного = ОбщегоНазначения.ПолучитьФлагУчетаХарактеристик(СтрокаТабличнойЧасти.Номенклатура.ВидНоменклатуры);
	
	СтрокаТабличнойЧасти.Артикул = СтрокаТабличнойЧасти.Номенклатура.Артикул;
	
	
	// Если учет по характеристикам не ведется или вызов из обработки подбора, тогда пропустим колонку характеристики
	Если (НЕ ПерейтиНаКоличество) И ОбщегоНазначения.ПолучитьФлагУчетаХарактеристик(СтрокаТабличнойЧасти.Номенклатура.ВидНоменклатуры) Тогда
		
		//Активизирует колонку "Характеристика номенклатуры"
		РаботаСДиалогами.АктивизироватьЯчейкуТабличногоПоля(ЭлементыФормы.ТоварыПеремещение, СтрокаТабличнойЧасти, мКолонкиТовары.ХарактеристикаНоменклатуры);
		
	Иначе
		
		Если СтрокаТабличнойЧасти.Номенклатура.ВестиСерийныеНомера Тогда
			// открываем ввод серийных номеров
			ЭлементыФормы.ТоварыПеремщение.ЗакончитьРедактированиеСтроки(Ложь);
		Иначе
			//Активизирует колонку "Количество"
			РаботаСДиалогами.АктивизироватьЯчейкуТабличногоПоля(ЭлементыФормы.ТоварыПеремещение, СтрокаТабличнойЧасти, мКолонкиТовары.КоличествоПоДок);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ТоварыПеремещениеХарактеристикаНоменклатурыАвтоПодборТекста(Элемент, Текст, ТекстАвтоПодбора, СтандартнаяОбработка)
