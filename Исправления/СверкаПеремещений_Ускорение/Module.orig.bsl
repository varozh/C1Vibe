	ДатаНач = Дата("20140701000000");
	Магазин = ПараметрыСеанса.ТекущийМагазин;
	
	ЗапросДоков = Новый Запрос("ВЫБРАТЬ
	|	ТоварыКПоступлениюРеализацииОстатки.ДокументОснование КАК Ссылка,
	|	СУММА(ТоварыКПоступлениюРеализацииОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыКПоступлениюРеализации.Остатки(
	|			&НачалоПериода,
	|			Склад.Магазин = &Магазин
	|				И ДокументОснование.Дата > &ДатаНач) КАК ТоварыКПоступлениюРеализацииОстатки
	|ГДЕ
	|	ТоварыКПоступлениюРеализацииОстатки.КоличествоОстаток > 0
	|	И ТоварыКПоступлениюРеализацииОстатки.ДокументОснование.СоставленАкт = ЛОЖЬ
	|	И ТоварыКПоступлениюРеализацииОстатки.ДокументОснование.Проведен = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКПоступлениюРеализацииОстатки.ДокументОснование
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|АВТОУПОРЯДОЧИВАНИЕ");
	ЗапросДоков.УстановитьПараметр("НачалоПериода", ТекущаяДата()+1);
