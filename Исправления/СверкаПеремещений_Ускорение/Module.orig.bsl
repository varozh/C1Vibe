Процедура ДокПеремещенияПриИзменении(Элемент)
	Если ДокПеремещения.Пустая() тогда
		Товары.Очистить();  			
	КонецЕсли;
	ЭтаФорма.ТекущийЭлемент = ЭлементыФормы.вводШК;
	
	
	//финт ушами чтобы поле "количество"было свободным для стандартных обработок
	ТЗТовары = Новый ТаблицаЗначений;
	ТЗТовары = ЭтотОбъект.ДокПеремещения.Товары.Выгрузить();
	ТЗТовары.Колонки.Количество.Имя = "КоличествоПоДок";
	Товары.Загрузить(ТЗТовары);
	//конецфинта
	
	Для Каждого Стр из Товары Цикл
		Стр.Артикул = Стр.Номенклатура.Артикул;
		Стр.Код = Стр.Номенклатура.Код;
	КонецЦикла;	
	
	ТЗТовары = Новый ТаблицаЗначений;
	ТЗТовары = ЭтотОбъект.ДокПеремещения.КодыМаркировок.Выгрузить();
	КодыМаркировок.Загрузить(ТЗТовары);
	
	вводШК = "";
	ЭтаФорма.ТекущийЭлемент = ЭлементыФормы.вводШК;
	
КонецПроцедуры

Процедура СоздатьДокументыНажатие(Элемент)
	
	Если ЕстьНеотсканированные Тогда 
		Ответ = Вопрос("Вы точно отсканировали весь товар. Уверены?", РежимДиалогаВопрос.ДаНет, );
		Если Ответ = КодВозвратаДиалога.Нет Тогда 
			ЭтаФорма.ТекущийЭлемент = ЭлементыФормы.вводШК;
			
			Возврат;
		Иначе
			
		КонецЕсли;
		
	Иначе
		
	КонецЕсли;
	
	
	Сактом = Ложь;
	Для Каждого Стр Из Товары Цикл
		Если Стр.КоличествоПоДок <> Стр.Количество Тогда
			Сактом = Истина;
			Прервать;
		КонецЕсли;			
	КонецЦикла;	
	
	
	ТабличноеПоле1.Очистить();		
	Стр = ТабличноеПоле1.Добавить();
	Стр.Сактом = Сактом;
	Стр.Документ = ДокПеремещения;
	Стр.Отм = Истина;	
	Стр.Документ = ДокПеремещения.Ссылка;
	Стр.Номер = ДокПеремещения.Номер;
	Стр.КолМест = ДокПеремещения.КоличествоМешков;
	Стр.Отправитель = ДокПеремещения.СкладОтправитель;
	Стр.Получатель = ДокПеремещения.СкладПолучатель;
	Стр.Организация = ДокПеремещения.СкладОтправитель.Организация;
	Стр.СуммаДокумента = ДокПеремещения.Товары.Итог("Сумма");
	ЭлементыФормы.Панель1.ТекущаяСтраница = ЭлементыФормы.Панель1.Страницы.ПриёмПеремещений;//.Панель1.Страницы.Страница1;
	ПечататьПриходники = Истина;
	НаПринтер = Истина;
	ЭлементыФормы.ТабличноеПоле1.Колонки.ВидОперации.Видимость = ложь;
КонецПроцедуры

