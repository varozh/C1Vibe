Процедура ТоварыПеремещениеПриПолученииДанных(Элемент, ОформленияСтрок)
	Для каждого Эл Из ОформленияСтрок цикл
		Если 	Эл.Ячейки.Количество.Значение = 0 Тогда
			Х = Новый Цвет(255, 255, 255); //белый
			ЕстьНеотсканированные = Истина;
		ИначеЕсли Эл.Ячейки.Количество.Значение = Эл.Ячейки.КоличествоПоДок.Значение Тогда
			Х = Новый Цвет(213, 240, 199);    //зеленый
			ЕстьНеотсканированные = Ложь;
		ИначеЕсли  Эл.Ячейки.Количество.Значение < Эл.Ячейки.КоличествоПоДок.Значение Тогда
			Х = Новый Цвет(240, 199, 199); //красный
		ИначеЕсли  Эл.Ячейки.Количество.Значение > Эл.Ячейки.КоличествоПоДок.Значение Тогда
			Х = Новый Цвет(255, 255, 122); //жёлтый
		КонецЕсли;
		Эл.ЦветФона = Х;
	КонецЦикла;	
	
	
КонецПроцедуры

Процедура СохранитьВоВременныйФайл(Элемент)
	
	Если  НеСохранятьДокумент <> Истина тогда
		ВремКаталог = КаталогВременныхФайлов();
		ИмяФайла = "Temp";
		ВыбФайл = Новый Файл(ВремКаталог+ИмяФайла+".mxl");	
		ТЗ = Новый ТаблицаЗначений;
		ТЗ = Товары.Выгрузить();
		
		
		Если ВыбФайл.Существует() = Ложь тогда
			ВременнаяТаблица = Новый ТабличныйДокумент;
			постр=новый построительотчета;
			постр.источникданных=новый описаниеисточникаданных(ТЗ);
			постр.вывести(ВременнаяТаблица); 
			ВременнаяТаблица.Записать(ВремКаталог+ИмяФайла+".mxl");
		иначе
			УдалитьФайлы(ВыбФайл); 
			ВременнаяТаблица = Новый ТабличныйДокумент;
			постр=новый построительотчета;  
			постр.источникданных=новый описаниеисточникаданных(ТЗ);
			постр.вывести(ВременнаяТаблица);       
			ВременнаяТаблица.Записать(ВремКаталог+ИмяФайла+".mxl");
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры


Процедура ДокПеремещенияНачалоВыбора(Элемент, СтандартнаяОбработка)
