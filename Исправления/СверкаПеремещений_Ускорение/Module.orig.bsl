Процедура КоманднаяПанельСверкаШтрихкодМаркировки(Кнопка)
	Результат = РаботаСТорговымОборудованием.ВвестиШтрихкод();
	Если Не ПустаяСтрока(Результат) Тогда
		ЗаполнитьКодМаркировки(Результат);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьКодМаркировки(Результат) Экспорт 
	ИсходныеДанные = Новый Структура("Штрихкод,Количество",Результат,1);
	ШтрихкодированиеИСКлиентСервер.ЗакодироватьШтрихкодДанныхBase64(ИсходныеДанные);	
		
	ПараметрыСканирования = ШтрихкодированиеИСКлиент.ПараметрыСканирования(ЭтотОбъект.ДокПеремещения);
	РезультатОбработки = ОбработатьВводШтрихкода(ИсходныеДанные, Неопределено, ПараметрыСканирования);
	
	Если РезультатОбработки = Неопределено Тогда 
		Сообщить("Не удалось обработать штрихкод");
		Возврат;
	КонецЕсли;
	
	Если РезультатОбработки.ТипШтрихкода = Перечисления.ТипыШтрихкодов.EAN13 Тогда 
		
		Если РезультатОбработки.Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ЛегкаяПромышленность Тогда
			Результат = ВвестиШтрихкодМаркировки();
			Если Не ПустаяСтрока(Результат) Тогда
				ЗаполнитьКодМаркировки(Результат);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		Если ОжиданиеКодаМаркировки Тогда 
			Сообщить("Считайте код маркировки");
			Возврат;
		КонецЕсли;
		НайдСтрТовары = Товары.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",РезультатОбработки.Номенклатура,РезультатОбработки.Характеристика));
		Если НайдСтрТовары.Количество() = 0 Тогда 
			Сообщить("Номенклатуры с таким штрихкодом нет в документе");
			Возврат;
		КонецЕсли;
		НайдСтрТовары[0].Количество = НайдСтрТовары[0].Количество + 1;
		Если НайдСтрТовары[0].Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ЛегкаяПромышленность Тогда 
			Сообщить("Считайте код маркировки");
			ОжиданиеКодаМаркировки = Истина;
		КонецЕсли;
	Иначе 
		НайдСтр = КодыМаркировок.Найти(ИсходныеДанные.Штрихкод);
		Если НайдСтр = Неопределено Тогда 
			Сообщить("Данный код маркировки не присутствует в текущем документе");
			Возврат;
		КонецЕсли;
		
		Если НайдСтр.Подтверждено Тогда 
			Сообщить("Данный код маркировки уже подтвержден");
			Возврат;
		КонецЕсли;
		
		НайдСтр.Подтверждено = Истина;
		
		Если ОжиданиеКодаМаркировки Тогда 
			НайдСтрТовары = Товары.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",НайдСтр.Номенклатура,НайдСтр.Характеристика));
			Если НайдСтрТовары.Количество() <> 0 Тогда 
				НайдСтрТовары[0].КоличествоМарок = НайдСтрТовары[0].КоличествоМарок+1;
			КонецЕсли;
		Иначе 
			НайдСтрТовары = Товары.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",НайдСтр.Номенклатура,НайдСтр.Характеристика));
			Если НайдСтрТовары.Количество() <> 0 Тогда 
				НайдСтрТовары[0].КоличествоМарок = НайдСтрТовары[0].КоличествоМарок+1;
				НайдСтрТовары[0].Количество = НайдСтрТовары[0].Количество+1;
			КонецЕсли;
		КонецЕсли;
		ОжиданиеКодаМаркировки = Ложь;
	КонецЕсли;			
КонецПроцедуры

