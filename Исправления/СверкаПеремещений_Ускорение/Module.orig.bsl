Функция ПолучитьТЗИзМакета(Макет) Экспорт
	Перем ТЗ;
	ТЗ=Новый ТаблицаЗначений();

		//Считываем колонки
		Для Стр=4 По Макет.ВысотаТаблицы Цикл
			Если Стр>1 Тогда
				ТекСтр=ТЗ.Добавить();
			КонецЕсли;
			ПустаяСтрока=истина;
			Для Кол=1 По Макет.ШиринаТаблицы Цикл
				Яч=Макет.Область(Стр, Кол);
				Если Яч.СодержитЗначение Тогда
					Зн=Яч.Значение;
				Иначе
					Зн=Яч.Текст;
				КонецЕсли;
				Если ТипЗнч(Зн)=Тип("Строка") И ПустаяСтрока(Зн) Тогда
					Зн=Неопределено;
				КонецЕсли;
				
				//Добавляем колонку
				Если Стр=4 Тогда
					ТЗ.Колонки.Добавить(Зн);
				Иначе
					ТекСтр[Кол-1]=Зн;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Мас = Новый Массив; //Массив индексов ТЗ для удаления
	Для Сч=0 По ТЗ.Количество()-1 Цикл
		Мас.Добавить(Сч); //При входе сразу добавляем строку для удаления
		Для К=0 По ТЗ.Колонки.Количество()-1 Цикл
			Если Не ПустаяСтрока(Строка(ТЗ[Сч][К])) Тогда //Проверяем если в строке есть хотябы одна заполненая колонка, то строку удалять нельзя, удаляем ее из массива
				Мас.Удалить(Мас.ВГраница());
				Прервать; 
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Сч=0 По Мас.ВГраница() Цикл //переберем массив и удалим строки
		ТЗ.Удалить(Мас[Мас.ВГраница()-Сч]);
	КонецЦикла;
	
	Возврат ТЗ;
КонецФункции

