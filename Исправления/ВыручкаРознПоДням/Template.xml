				<field>Территория</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Территория</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	УмКо_ТерриторииМагазины.Ссылка КАК Территория,
	УмКо_ТерриторииМагазины.Магазин.Ссылка КАК Магазин,
	NULL КАК Нал,
	NULL КАК Безнал,
	NULL КАК Период,
	NULL КАК Регистратор
ИЗ
	Справочник.УмКо_Территории.Магазины КАК УмКо_ТерриторииМагазины

СГРУППИРОВАТЬ ПО
	УмКо_ТерриторииМагазины.Ссылка,
	УмКо_ТерриторииМагазины.Магазин.Ссылка

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Терр.Территория,
	ДенежныеСредства.Касса.Магазин,
	СУММА(ВЫБОР
			КОГДА ДенежныеСредства.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
				ТОГДА ДенежныеСредства.Сумма
			ИНАЧЕ -ДенежныеСредства.Сумма
		КОНЕЦ),
	СУММА(0),
	НАЧАЛОПЕРИОДА(ДенежныеСредства.Период, ДЕНЬ),
	ДенежныеСредства.Регистратор
ИЗ
	РегистрНакопления.ДенежныеСредства КАК ДенежныеСредства
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			ТМ.Ссылка КАК Территория,
			ТМ.Магазин КАК Магазин
		ИЗ
			Справочник.УмКо_Территории.Магазины КАК ТМ) КАК Терр
		ПО ДенежныеСредства.Касса.Магазин = Терр.Магазин
ГДЕ
	ДенежныеСредства.Период МЕЖДУ НАЧАЛОПЕРИОДА(&amp;Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&amp;Период, ДЕНЬ)
	И ДенежныеСредства.Активность
	И НЕ ДенежныеСредства.Регистратор ССЫЛКА Документ.УмКо_ВнесениеДенежныхСредств

СГРУППИРОВАТЬ ПО
	ДенежныеСредства.Касса.Магазин,
	ДенежныеСредства.Регистратор,
	НАЧАЛОПЕРИОДА(ДенежныеСредства.Период, ДЕНЬ),
	Терр.Территория

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Терр.Территория,
	ПродажиПоПлатежнымКартамОбороты.Магазин,
	СУММА(0),
	СУММА(ЕСТЬNULL(ПродажиПоПлатежнымКартамОбороты.СуммаОборот, 0)),
	НАЧАЛОПЕРИОДА(ПродажиПоПлатежнымКартамОбороты.ПериодДень, ДЕНЬ),
	ПродажиПоПлатежнымКартамОбороты.Регистратор
ИЗ
	РегистрНакопления.ПродажиПоПлатежнымКартам.Обороты(НАЧАЛОПЕРИОДА(&amp;Период, ДЕНЬ), КОНЕЦПЕРИОДА(&amp;Период, ДЕНЬ), Авто, ) КАК ПродажиПоПлатежнымКартамОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			ТМ.Ссылка КАК Территория,
			ТМ.Магазин КАК Магазин
		ИЗ
			Справочник.УмКо_Территории.Магазины КАК ТМ) КАК Терр
		ПО ПродажиПоПлатежнымКартамОбороты.Магазин = Терр.Магазин

СГРУППИРОВАТЬ ПО
	ПродажиПоПлатежнымКартамОбороты.Магазин,
	НАЧАЛОПЕРИОДА(ПродажиПоПлатежнымКартамОбороты.ПериодДень, ДЕНЬ),
	ПродажиПоПлатежнымКартамОбороты.Регистратор,
	Терр.Территория</query>
		</item>
