		<item xsi:type="DataSetQuery">
			<name>бонусы дня</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Магазин</dataPath>
				<field>Магазин</field>
			</field>
			<field xsi:type="DataSetFieldField">
