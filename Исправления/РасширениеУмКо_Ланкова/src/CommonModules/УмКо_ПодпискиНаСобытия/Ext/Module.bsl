
Процедура УмКо_ПриЗагрузкеПоступленийИРеализцийИзУТПередЗаписьюПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка = истина
		или не ЗначениеЗаполнено(Источник.Ссылка) Тогда 
		
		Источник.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда 
			Для Каждого Стр из Источник.ШтрихкодыУпаковок Цикл 
				Если ЗначениеЗаполнено(Стр.ШтрихкодУпаковки) 
					и ЗначениеЗаполнено(Стр.ШтрихкодУпаковки.Номенклатура) Тогда 
					Если не Стр.ШтрихкодУпаковки.Номенклатура.ЛегкаяПромышленность Тогда 
						НомОб = Стр.ШтрихкодУпаковки.Номенклатура.ПолучитьОбъект();
						// 13.11.2026: номенклатура могла прийти ссылкой на еще не загруженный объект
						Если НомОб <> Неопределено Тогда
							НомОб.ОбменДанными.Загрузка = Истина;
							НомОб.ЛегкаяПромышленность = Истина;
							НомОб.Записать();
						КонецЕсли;
					КонецЕсли; 
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
				
	КонецЕсли;
		
КонецПроцедуры  


