// Очистка данных счетчиков MegaCount, помеченных на удаление.
//
// Удаляет записи помеченных счетчиков из регистров сведений, которые на них ссылаются:
//  - УмКо_СтатистикаПосещаемости (детальная статистика, 10-минутные отрезки);
//  - УмКо_СтатистикаПосещаемостиСводно (свод по дням);
//  - УмКо_МагазиныУстройства (привязка к магазину — у дублей ее нет, но если есть, тоже удаляется).
// После этого помеченные счетчики и их папки можно удалить штатным «Удалением помеченных объектов».
//
// Счетчики выбираются вручную: показываются только помеченные на удаление, изначально ничего не отмечено.
// Каждый счетчик очищается в своей транзакции. Удаление записей НЕОБРАТИМО — перед запуском сделайте копию базы.
//
// Обработка без формы (обычное приложение): открыть через Файл → Открыть, дальше всё спрашивается диалогами.

Функция ПолучитьПомеченныеСчетчики()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Счетчики.Ссылка КАК Ссылка,
	|	Счетчики.Код КАК Код,
	|	Счетчики.Наименование КАК Наименование,
	|	Счетчики.НомерУстройства КАК НомерУстройства,
	|	Счетчики.Родитель.Родитель.Наименование2 КАК ПапкаТЦ,
	|	ЕСТЬNULL(Детальные.Строк, 0) КАК СтрокДетальных,
	|	ЕСТЬNULL(Сводные.Строк, 0) КАК СтрокСводных,
	|	ЕСТЬNULL(Привязки.Строк, 0) КАК СтрокПривязок,
	|	ЕСТЬNULL(Привязки.Магазин, """") КАК Магазин
	|ИЗ
	|	Справочник.МегаКаунтСтатистикаИерархия КАК Счетчики
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Статистика.Устройство КАК Устройство,
	|			КОЛИЧЕСТВО(*) КАК Строк
	|		ИЗ
	|			РегистрСведений.УмКо_СтатистикаПосещаемости КАК Статистика
	|		ГДЕ
	|			Статистика.Устройство.ПометкаУдаления
	|		СГРУППИРОВАТЬ ПО
	|			Статистика.Устройство) КАК Детальные
	|		ПО Счетчики.Ссылка = Детальные.Устройство
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Статистика.Устройство КАК Устройство,
	|			КОЛИЧЕСТВО(*) КАК Строк
	|		ИЗ
	|			РегистрСведений.УмКо_СтатистикаПосещаемостиСводно КАК Статистика
	|		ГДЕ
	|			Статистика.Устройство.ПометкаУдаления
	|		СГРУППИРОВАТЬ ПО
	|			Статистика.Устройство) КАК Сводные
	|		ПО Счетчики.Ссылка = Сводные.Устройство
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МагазиныУстройства.Устройство КАК Устройство,
	|			КОЛИЧЕСТВО(*) КАК Строк,
	|			МАКСИМУМ(МагазиныУстройства.Магазин.Наименование) КАК Магазин
	|		ИЗ
	|			РегистрСведений.УмКо_МагазиныУстройства КАК МагазиныУстройства
	|		ГДЕ
	|			МагазиныУстройства.Устройство.ПометкаУдаления
	|		СГРУППИРОВАТЬ ПО
	|			МагазиныУстройства.Устройство) КАК Привязки
	|		ПО Счетчики.Ссылка = Привязки.Устройство
	|ГДЕ
	|	НЕ Счетчики.ЭтоГруппа
	|	И Счетчики.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПапкаТЦ,
	|	Код";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ЧислоСПробелами(Число)

	Возврат Формат(Число, "ЧН=0; ЧГ=3,0");

КонецФункции

Процедура ОчиститьСчетчик(Счетчик)

	НачатьТранзакцию();
	Попытка

		Набор = РегистрыСведений.УмКо_СтатистикаПосещаемости.СоздатьНаборЗаписей();
		Набор.Отбор.Устройство.Установить(Счетчик);
		Набор.Записать(Истина);

		Набор = РегистрыСведений.УмКо_СтатистикаПосещаемостиСводно.СоздатьНаборЗаписей();
		Набор.Отбор.Устройство.Установить(Счетчик);
		Набор.Записать(Истина);

		Набор = РегистрыСведений.УмКо_МагазиныУстройства.СоздатьНаборЗаписей();
		Набор.Отбор.Устройство.Установить(Счетчик);
		Набор.Записать(Истина);

		ЗафиксироватьТранзакцию();

	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОтменитьТранзакцию();
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

КонецПроцедуры

Процедура ЗапуститьОчистку() Экспорт

	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УмКо_СтатистикаПосещаемости)
		Или Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УмКо_СтатистикаПосещаемостиСводно)
		Или Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УмКо_МагазиныУстройства) Тогда
		Предупреждение("Нет права на изменение регистров статистики посещаемости." + Символы.ПС
			+ "Запустите обработку под пользователем с правами администратора.");
		Возврат;
	КонецЕсли;

	Состояние("Подсчет записей помеченных счетчиков...");
	Счетчики = ПолучитьПомеченныеСчетчики();
	Если Счетчики.Количество() = 0 Тогда
		Предупреждение("В справочнике «Структура» нет счетчиков, помеченных на удаление.");
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Стр Из Счетчики Цикл
		Представление = СокрЛП(Стр.Код) + " " + СокрЛП(Стр.Наименование) + ", № " + СокрЛП(Стр.НомерУстройства)
			+ " — " + СокрЛП(Стр.ПапкаТЦ)
			+ "   [записей: детальных " + ЧислоСПробелами(Стр.СтрокДетальных)
			+ ", сводных " + ЧислоСПробелами(Стр.СтрокСводных) + "]";
		Если Стр.СтрокПривязок > 0 Тогда
			Представление = Представление + "   !!! ПРИВЯЗАН К МАГАЗИНУ: " + Стр.Магазин;
		КонецЕсли;
		Список.Добавить(Стр.Ссылка, Представление, Ложь);
	КонецЦикла;

	Если Не Список.ОтметитьЭлементы("Отметьте помеченные на удаление счетчики, данные которых нужно удалить") Тогда
		Возврат;
	КонецЕсли;

	Выбранные = Новый Массив;
	ВсегоДетальных = 0;
	ВсегоСводных = 0;
	СМагазином = "";
	Для Каждого ЭлементСписка Из Список Цикл
		Если Не ЭлементСписка.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Стр = Счетчики.Найти(ЭлементСписка.Значение, "Ссылка");
		Выбранные.Добавить(Стр);
		ВсегоДетальных = ВсегоДетальных + Стр.СтрокДетальных;
		ВсегоСводных = ВсегоСводных + Стр.СтрокСводных;
		Если Стр.СтрокПривязок > 0 Тогда
			СМагазином = СМагазином + Символы.ПС + "   " + СокрЛП(Стр.Код) + " " + СокрЛП(Стр.Наименование) + " — " + Стр.Магазин;
		КонецЕсли;
	КонецЦикла;

	Если Выбранные.Количество() = 0 Тогда
		Предупреждение("Не отмечено ни одного счетчика.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Будут БЕЗВОЗВРАТНО удалены данные счетчиков: " + Выбранные.Количество() + Символы.ПС
		+ "записей детальной статистики: " + ЧислоСПробелами(ВсегоДетальных) + Символы.ПС
		+ "записей сводной статистики: " + ЧислоСПробелами(ВсегоСводных);
	Если СМагазином <> "" Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС
			+ "ВНИМАНИЕ! Среди них есть счетчики, привязанные к магазинам (привязка тоже будет удалена):" + СМагазином;
	КонецЕсли;
	ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС
		+ "Отменить удаление будет нельзя. Копия базы сделана? Продолжить?";
	Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Очищено = 0;
	Ошибок = 0;
	Номер = 0;
	Для Каждого Стр Из Выбранные Цикл
		Номер = Номер + 1;
		Описание = СокрЛП(Стр.Код) + " " + СокрЛП(Стр.Наименование) + " (" + СокрЛП(Стр.ПапкаТЦ) + ")";
		Состояние("Удаление данных счетчика " + Номер + " из " + Выбранные.Количество() + ": " + Описание);
		Попытка
			ОчиститьСчетчик(Стр.Ссылка);
			Очищено = Очищено + 1;
			Сообщить("Удалены данные счетчика " + Описание + ": детальных " + ЧислоСПробелами(Стр.СтрокДетальных)
				+ ", сводных " + ЧислоСПробелами(Стр.СтрокСводных));
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("ОШИБКА при удалении данных счетчика " + Описание + ": " + ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;
	КонецЦикла;

	Предупреждение("Готово. Очищено счетчиков: " + Очищено + ", с ошибками: " + Ошибок + "." + Символы.ПС
		+ "Подробности — в окне сообщений." + Символы.ПС + Символы.ПС
		+ "Теперь помеченные счетчики и их папки можно удалить через «Операции → Удаление помеченных объектов».");

КонецПроцедуры

// Формы у обработки нет: при открытии файла сразу запускаем диалоги
ЗапуститьОчистку();
