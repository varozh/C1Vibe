Процедура ВыплатаНажатие(Элемент)
	
	Магазин 	= ПараметрыСеанса.ТекущийМагазин;
	колотм		= 0;
	Ошибка		= Неопределено;
	Результат	= Неопределено;
	
	ДокументыДляВыплаты = Новый СписокЗначений;
	для Каждого стр из ТЧДокументыВозвратов цикл
		если стр.отм=Истина Тогда 
			колотм = колотм + 1;
			НайдСтр = ДокументыДляВыплаты.НайтиПоЗначению(стр.Документ);
			Если НайдСтр = Неопределено Тогда 
				ДокументыДляВыплаты.Добавить(стр.Документ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если колотм = 0 Тогда 
		Предупреждение("Не указан документ для выплаты");
	ИначеЕсли колотм > 1
		и ДокументыДляВыплаты.Количество() > 1 Тогда 
		Предупреждение("Количество одновременно выплачиваемых документов не должно быть больше 1");
	Иначе
		
		для Каждого стр из ТЧДокументыВозвратов цикл
			если стр.Отм = истина Тогда 
				// вызываем форму подтверждения
				формаподтв = ПолучитьФорму("ФормаЗапросаКодаСмс");
				формаподтв.Накладная = стр.Документ;
				
				// ТЕСТ
				успешно = формаподтв.ОткрытьМодально();
				//успешно = Истина;
				// =ТЕСТ
				если успешно Тогда 
					
					// УмКо ниже
					// получим список денежных документов
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ОплатаОтПокупателяПлатежнойКартой.Ссылка КАК ссылка
					               |ИЗ
					               |	Документ.ОплатаОтПокупателяПлатежнойКартой КАК ОплатаОтПокупателяПлатежнойКартой
					               |ГДЕ
					               |	ОплатаОтПокупателяПлатежнойКартой.ДокументОснование = &ДокОснование
					               |	И ОплатаОтПокупателяПлатежнойКартой.ПометкаУдаления = ЛОЖЬ
					               |
					               |ОБЪЕДИНИТЬ ВСЕ
					               |
					               |ВЫБРАТЬ
					               |	РасходныйКассовыйОрдер.Ссылка
					               |ИЗ
					               |	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
					               |ГДЕ
					               |	РасходныйКассовыйОрдер.ДокументОснование = &ДокОснование
					               |	И РасходныйКассовыйОрдер.ПометкаУдаления = ЛОЖЬ
					               |
					               |ОБЪЕДИНИТЬ ВСЕ
					               |
					               |ВЫБРАТЬ
					               |	ПриходныйКассовыйОрдер.Ссылка
					               |ИЗ
					               |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
					               |ГДЕ
					               |	ПриходныйКассовыйОрдер.ДокументОснование = &ДокОснование
					               |	И ПриходныйКассовыйОрдер.ПометкаУдаления = ЛОЖЬ
					               |
					               |УПОРЯДОЧИТЬ ПО
					               |	ссылка
					               |АВТОУПОРЯДОЧИВАНИЕ";
					Запрос.УстановитьПараметр("ДокОснование",Стр.Документ);
					Выгрузка = Запрос.Выполнить().Выгрузить();
					СписокДенежныхДокументов = Новый СписокЗначений;
					Для Каждого СтрДенежныеДокументы из Выгрузка Цикл 
						СписокДенежныхДокументов.Добавить(СтрДенежныеДокументы.ссылка);
					КонецЦикла;
					// УмКо выше
					
					ДенежныйДокументОбъект = Стр.ДенежныйДокумент.ПолучитьОбъект();
					
					ДокументВозврат = Стр.Документ;
					Если ЗначениеЗаполнено(ДокументВозврат.НомерЧекаККМ) Тогда 
						ОбщегоНазначения.СообщитьОбОшибке("Чек возврата уже пробит на кассу");
						ЗаполнитьВозвратами();
						Возврат;
					КонецЕсли;
					
					ФУ = Неопределено;
					
					Если Не РаботаСТорговымОборудованием.ПолучитьПроверитьПараметрыДляПробитияЧека(ФУ, Истина, ДокументВозврат.Склад.Организация, Истина) Тогда
						Возврат;
					КонецЕсли;
					
					// Доработка
					ВидФУ = ПолучитьСерверТО().ПолучитьВид(ФУ);
					
					ОбъектДрайвера = Неопределено;
					ОбработкаОбслуживания = Неопределено;
					ПолучитьСерверТО().ПолучитьОбъектДрайвера(ФУ, ОбработкаОбслуживания, ОбъектДрайвера);
					
					Если ОбработкаОбслуживания = Неопределено Тогда
						ОбщегоНазначения.СообщитьИнформациюПользователю("Ошибка получения обработки обслуживания");
						Возврат;
					КонецЕсли;
					
					ОбработкаОбслуживания.ПолучитьПараметрыККТ(ОбъектДрайвера);
					ВерсияФормата = МенеджерОборудованияКлиентСервер.ВерсияФФД(ОбъектДрайвера.ВыходныеПараметры);
					Если ВерсияФормата <= "1.0" Тогда
						ОбщегоНазначения.СообщитьИнформациюПользователю("При использовании ФФД 1.0 фискализация чека из товарных документов не поддерживается");
						Возврат;
					КонецЕсли;
					
					ОписаниеПКС = КассовыеСменыВызовСервера.ОписаниеПоследнейКассовойСмены(ФУ);
					Если ОписаниеПКС = Неопределено ИЛИ ОписаниеПКС.Статус = Перечисления.СтатусыКассовойСмены.Закрыта Тогда
						ОбщегоНазначения.СообщитьОбОшибке("Кассовая смена не открыта");
						Возврат;
					КонецЕсли;
					
					ПараметрыЧека = МенеджерОборудованияКлиентСервер.ПараметрыОперацииФискализацииЧека();
					ПараметрыЧека.Вставить("ОписаниеПКС", ОписаниеПКС);
					
					ДокументВозвратОбъект = ДокументВозврат.ПолучитьОбъект();
					Ответ = "";
					ВозвратФискализирован = ДокументВозвратОбъект.ФискализироватьЧек(ФУ, ПараметрыЧека, Ответ, Ложь);
					Если ВозвратФискализирован Тогда
						ДокументВозвратОбъект.НомерЧекаККМ = ОбъектДрайвера.ВыходныеПараметры[1];
						ДокументВозвратОбъект.Оплачено = Истина;
						ДокументВозвратОбъект.Дата = ТекущаяДата();
					Иначе
						ОбщегоНазначения.СообщитьОбОшибке(ОбъектДрайвера.ОписаниеОшибки);
						Возврат;
					КонецЕсли;
					
					ТребуетсяОплатаЭквайрингом = ТипЗнч(Стр.ДенежныйДокумент) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой");
					Если не ТребуетсяОплатаЭквайрингом Тогда
						Попытка					
							ДокументВозвратОбъект.Записать(РежимЗаписиДокумента.Проведение);
							ДокументВозвратОбъект.Печать("Накладная",,);
							Для Каждого ДенежныйДокСсылка из СписокДенежныхДокументов Цикл 
								ДенежныйДокументОбъект = ДенежныйДокСсылка.Значение.ПолучитьОбъект();
								ДенежныйДокументОбъект.Дата = ТекущаяДата();
								ДенежныйДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
							КонецЦикла;
						Исключение
							ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки());
							Для Каждого ДенежныйДокСсылка из СписокДенежныхДокументов Цикл 
								ДенежныйДокументОбъект = ДенежныйДокСсылка.Значение.ПолучитьОбъект();
								ДенежныйДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения); //отменяем проведение, если ошибка печати чека
							КонецЦикла;
						КонецПопытки;
						ЗаполнитьВозвратами();
						Возврат;
					КонецЕсли;
					
					РезультатЭквайринга = "";
					
					Если стр.ВидОперации = Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ВозвратДенежныхСредствПокупателю Тогда 
						если не Магазин.ДополнительныйДоговорЭквайринга = Справочники.ДоговорыЭквайринга.ПустаяСсылка() и
							стр.ДенежныйДокумент.ДоговорЭквайринга = Магазин.ДополнительныйДоговорЭквайринга Тогда 
							попытка
								Если РаботаСТорговымОборудованием.ПолучитьПроверитьПараметрыДляОплатыКартой(ЭС, мФР) Тогда
									КодRRN = Неопределено;
									
									Результат = ПолучитьСерверТО().ВернутьПлатежПоПлатежнойКарте(ЭС, стр.СуммаЧека, КодRRN, мФР);
									
									Если ЗначениеЗаполнено(Результат) Тогда
										РезультатЭквайринга = Результат;
										если Магазин.ПереподключатьЭквайринг = истина тогда
											Попытка
												ответ = Вопрос("Невозможно достучаться до эквайринга. Попробовать переподключить?", РежимДиалогаВопрос.ДаНет);
												если ответ = КодВозвратаДиалога.Да Тогда 
													//ПолучитьСерверТО().отключитьклиента();
													обработка = Обработки.ПереподключениеТорговогоОборудования.Создать();
													обработка.Вид = Перечисления.ВидыТорговогоОборудования.ЭквайринговаяСистема;
													обработка.Переподключить();
													Результат2 = ПолучитьСерверТО().ВернутьПлатежПоПлатежнойКарте(ЭС, стр.СуммаЧека, КодRRN, мФР);
													если ЗначениеЗаполнено(Результат2) Тогда 
														РезультатЭквайринга = Результат2;
														Ошибка = ПолучитьСерверТО().ПолучитьТекстОшибкиТО(Результат2);
														Предупреждение(Ошибка);
													КонецЕсли;
													РезультатЭквайринга = "";
												иначе
													Ошибка = ПолучитьСерверТО().ПолучитьТекстОшибкиТО(Результат);
													Предупреждение(Ошибка);
													Предупреждение("Операция по терминалу не прошла. Обратитесь в службу поддержки");
												КонецЕсли;
											Исключение
												Ошибка = ПолучитьСерверТО().ПолучитьТекстОшибкиТО(Результат);
												Предупреждение(Ошибка);
												РезультатЭквайринга = Ошибка;
											КонецПопытки;
										иначе 
											Ошибка = ПолучитьСерверТО().ПолучитьТекстОшибкиТО(Результат);
											Предупреждение(Ошибка);
											РезультатЭквайринга = Ошибка;
										КонецЕсли;
										
									КонецЕсли;
								КонецЕсли;
							Исключение
								Предупреждение("Не удалось провести операцию на терминале. Пожалуйста, сообщите об этом администратору 1С. Мы обязательно доработаем программу");
							КонецПопытки;
						КонецЕсли;
												
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(РезультатЭквайринга) Тогда
						Оплачено = Истина;
					Иначе
						Оплачено = Ложь;
						ТекстОшибки = ПолучитьСерверТО().ПолучитьТекстОшибкиФРТО(Результат);
						Предупреждение(ТекстОшибки);
						Для Каждого ДенежныйДокСсылка из СписокДенежныхДокументов Цикл 
							ДенежныйДокументОбъект = ДенежныйДокСсылка.Значение.ПолучитьОбъект();
							ДенежныйДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения); //отменяем проведение, если ошибка печати чека
						КонецЦикла;
					КонецЕсли;
					
					Если Оплачено Тогда
						Попытка					
							ДокументВозвратОбъект.Записать(РежимЗаписиДокумента.Проведение);
							ДокументВозвратОбъект.Печать("Накладная",,);
							Для Каждого ДенежныйДокСсылка из СписокДенежныхДокументов Цикл 
								ДенежныйДокументОбъект = ДенежныйДокСсылка.Значение.ПолучитьОбъект();
								ДенежныйДокументОбъект.Дата = ТекущаяДата();
								ДенежныйДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
							КонецЦикла;
						Исключение
							Сообщить(ОписаниеОшибки());
							Для Каждого ДенежныйДокСсылка из СписокДенежныхДокументов Цикл 
								ДенежныйДокументОбъект = ДенежныйДокСсылка.Значение.ПолучитьОбъект();
								ДенежныйДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения); //отменяем проведение, если ошибка печати чека
							КонецЦикла;
						КонецПопытки;
					КонецЕсли;
				КонецЕсли;		
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьВозвратами();
КонецПроцедуры


