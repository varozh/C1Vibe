// Обработка.МенюРМК, форма «Форма», модуль формы.
// Заменить процедуру ВыплатаНажатие целиком на код ниже и добавить вспомогательные процедуры и функции
// (их можно вставить сразу перед ВыплатаНажатие). Процедуру ВыплатаНажатие_олд не трогать.
//
// Что изменено (БЛ, 19.11.2026):
//  - при безналичной выплате сначала выполняется возврат на эквайринговом терминале и только после
//    подтверждения от терминала пробивается фискальный чек возврата;
//  - любая ошибка терминала (ошибка драйвера, исключение, неудачное переподключение, терминал не выбран)
//    останавливает выплату: чек не печатается;
//  - если терминал вернул деньги, а чек не пробился, в комментарий денежного документа пишется отметка
//    #ТЕРМИНАЛ_ОК, и при повторной «Выплате» печатается только чек, без повторного возврата на терминале;
//  - если попытка на терминале закончилась ошибкой, пишется отметка #ТЕРМИНАЛ_ОШИБКА, и при повторной
//    «Выплате» кассира спрашивают, напечатал ли терминал слип об успешном возврате (защита от двойного
//    возврата, когда банк деньги вернул, а ответ до 1С не дошёл);
//  - возврат через терминал выполняется и для продаж, пробитых по старому договору эквайринга магазина
//    (см. функцию НуженВозвратЧерезТерминал); договор в денежном документе при этом меняется на текущий.


Функция ОтметкаТерминалОК()
	Возврат "#ТЕРМИНАЛ_ОК";
КонецФункции

Функция ОтметкаТерминалОшибка()
	Возврат "#ТЕРМИНАЛ_ОШИБКА";
КонецФункции

// Нужно ли возвращать деньги через эквайринговый терминал, подключенный к 1С.
// Терминал из 1С подключен в магазинах, где заполнен «Договор эквайринга (СБЕРБАНК) прямого подключения»
// (реквизит ДополнительныйДоговорЭквайринга). Не идут через терминал из 1С:
//  - магазины, где этот договор не заполнен;
//  - продажи по договору «Договор эквайринга (ВТБ)» (ОсновнойДоговорЭквайринга), если он отличается
//    от договора прямого подключения: это отдельный терминал, возврат на нём делают вручную.
// Продажи по старым договорам магазина (до замены терминала) возвращаются через текущий терминал.
Функция НуженВозвратЧерезТерминал(ДенежныйДокумент, Магазин)

	Если Не ЗначениеЗаполнено(Магазин.ДополнительныйДоговорЭквайринга) Тогда
		Возврат Ложь;
	КонецЕсли;

	ДоговорДокумента = ДенежныйДокумент.ДоговорЭквайринга;
	Если ДоговорДокумента = Магазин.ДополнительныйДоговорЭквайринга Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(Магазин.ОсновнойДоговорЭквайринга)
		И ДоговорДокумента = Магазин.ОсновнойДоговорЭквайринга Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Убирает из комментария отметки о попытках возврата на терминале.
Функция КомментарийБезОтметок(Комментарий)

	Результат = СтрЗаменить(Комментарий, " " + ОтметкаТерминалОК(), "");
	Результат = СтрЗаменить(Результат, ОтметкаТерминалОК(), "");
	Результат = СтрЗаменить(Результат, " " + ОтметкаТерминалОшибка(), "");
	Результат = СтрЗаменить(Результат, ОтметкаТерминалОшибка(), "");
	Возврат СокрЛП(Результат);

КонецФункции

// Записывает в денежный документ отметку о результате операции на терминале (без перепроведения).
Процедура УстановитьОтметкуТерминала(ДенежныйДокумент, Отметка, Магазин = Неопределено)

	Попытка
		Объект = ДенежныйДокумент.ПолучитьОбъект();
		Объект.Комментарий = СокрЛП(КомментарийБезОтметок(Объект.Комментарий) + " " + Отметка);

		// Возврат прошёл через текущий терминал магазина: договор документа приводим к нему
		Если Отметка = ОтметкаТерминалОК()
			И Магазин <> Неопределено
			И ЗначениеЗаполнено(Магазин.ДополнительныйДоговорЭквайринга)
			И Объект.ДоговорЭквайринга <> Магазин.ДополнительныйДоговорЭквайринга Тогда
			Объект.ДоговорЭквайринга = Магазин.ДополнительныйДоговорЭквайринга;
			Объект.Эквайрер          = Магазин.ДополнительныйДоговорЭквайринга.Эквайрер;
			ВидОплаты = ПолучитьВидОплатыПоЭквайрингу(Магазин.ДополнительныйДоговорЭквайринга);
			Если ЗначениеЗаполнено(ВидОплаты) Тогда
				Объект.ВидОплаты = ВидОплаты;
			КонецЕсли;
		КонецЕсли;

		Объект.ОбменДанными.Загрузка = Истина; // только сохранить отметку, движения не трогаем
		Объект.Записать();
	Исключение
		ОбщегоНазначения.СообщитьОбОшибке("Не удалось сохранить отметку о возврате на терминале: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Возврат денег на эквайринговом терминале. Возвращает Истина только при подтверждении от терминала.
Функция ВыполнитьВозвратНаТерминале(Сумма, Магазин)

	ЭС = Неопределено;
	ФРЭквайринга = Неопределено;

	Попытка
		Если Не РаботаСТорговымОборудованием.ПолучитьПроверитьПараметрыДляОплатыКартой(ЭС, ФРЭквайринга) Тогда
			Предупреждение("Эквайринговый терминал не выбран или не подключен. Возврат не выполнен, чек не пробит.");
			Возврат Ложь;
		КонецЕсли;

		КодRRN = Неопределено;
		Результат = ПолучитьСерверТО().ВернутьПлатежПоПлатежнойКарте(ЭС, Сумма, КодRRN, ФРЭквайринга);
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Возврат Истина;
		КонецЕсли;

		Если Магазин.ПереподключатьЭквайринг Тогда
			Ответ = Вопрос("Операция на терминале не прошла:
				|" + ПолучитьСерверТО().ПолучитьТекстОшибкиТО(Результат) + "
				|
				|Переподключить терминал и повторить возврат?", РежимДиалогаВопрос.ДаНет);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Обработка = Обработки.ПереподключениеТорговогоОборудования.Создать();
				Обработка.Вид = Перечисления.ВидыТорговогоОборудования.ЭквайринговаяСистема;
				Обработка.Переподключить();

				КодRRN = Неопределено;
				Результат = ПолучитьСерверТО().ВернутьПлатежПоПлатежнойКарте(ЭС, Сумма, КодRRN, ФРЭквайринга);
				Если Не ЗначениеЗаполнено(Результат) Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Предупреждение("Возврат на терминале не выполнен, чек возврата не пробит.
			|" + ПолучитьСерверТО().ПолучитьТекстОшибкиФРТО(Результат));
		Возврат Ложь;

	Исключение
		Предупреждение("Не удалось провести операцию на терминале, чек возврата не пробит.
			|Если терминал всё же напечатал слип об успешном возврате, сохраните его и сообщите администратору 1С.
			|" + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Проводит возврат и денежные документы после пробития чека. Возвращает Истина, если всё записано.
Функция ПровестиВозвратИДенежныеДокументы(ДокументВозвратОбъект, СписокДенежныхДокументов, ОтменятьПриОшибке)

	Попытка
		ДокументВозвратОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Для Каждого ДенежныйДокСсылка Из СписокДенежныхДокументов Цикл
			ДенежныйДокументОбъект = ДенежныйДокСсылка.Значение.ПолучитьОбъект();
			ДенежныйДокументОбъект.Дата = ТекущаяДата();
			Если ТипЗнч(ДенежныйДокСсылка.Значение) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда
				ДенежныйДокументОбъект.Комментарий = КомментарийБезОтметок(ДенежныйДокументОбъект.Комментарий);
			КонецЕсли;
			ДенежныйДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
	Исключение
		ОбщегоНазначения.СообщитьОбОшибке("Чек возврата пробит, но документы не записаны: " + ОписаниеОшибки()
			+ Символы.ПС + "Сообщите администратору 1С, чек повторно НЕ пробивайте.");
		Если ОтменятьПриОшибке Тогда
			Для Каждого ДенежныйДокСсылка Из СписокДенежныхДокументов Цикл
				Попытка
					ДенежныйДокументОбъект = ДенежныйДокСсылка.Значение.ПолучитьОбъект();
					ДенежныйДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;

	Попытка
		ДокументВозвратОбъект.Печать("Накладная",,);
	Исключение
		ОбщегоНазначения.СообщитьОбОшибке("Не удалось напечатать накладную: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Истина;

КонецФункции


Процедура ВыплатаНажатие(Элемент)

	Магазин 	= ПараметрыСеанса.ТекущийМагазин;
	колотм		= 0;

	ДокументыДляВыплаты = Новый СписокЗначений;
	для Каждого стр из ТЧДокументыВозвратов цикл
		если стр.отм=Истина Тогда
			колотм = колотм + 1;
			НайдСтр = ДокументыДляВыплаты.НайтиПоЗначению(стр.Документ);
			Если НайдСтр = Неопределено Тогда
				ДокументыДляВыплаты.Добавить(стр.Документ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если колотм = 0 Тогда
		Предупреждение("Не указан документ для выплаты");
		Возврат;
	ИначеЕсли колотм > 1
		и ДокументыДляВыплаты.Количество() > 1 Тогда
		Предупреждение("Количество одновременно выплачиваемых документов не должно быть больше 1");
		Возврат;
	КонецЕсли;

	Для Каждого стр Из ТЧДокументыВозвратов Цикл
		Если стр.Отм <> Истина Тогда
			Продолжить;
		КонецЕсли;

		ВыполнитьВыплатуПоСтроке(стр, Магазин);
		Прервать;
	КонецЦикла;

	ЗаполнитьВозвратами();

КонецПроцедуры

Процедура ВыполнитьВыплатуПоСтроке(стр, Магазин)

	// вызываем форму подтверждения
	формаподтв = ПолучитьФорму("ФормаЗапросаКодаСмс");
	формаподтв.Накладная = стр.Документ;
	успешно = формаподтв.ОткрытьМодально();
	Если успешно <> Истина Тогда
		Возврат;
	КонецЕсли;

	// список денежных документов по возврату
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОплатаОтПокупателяПлатежнойКартой.Ссылка КАК ссылка
	               |ИЗ
	               |	Документ.ОплатаОтПокупателяПлатежнойКартой КАК ОплатаОтПокупателяПлатежнойКартой
	               |ГДЕ
	               |	ОплатаОтПокупателяПлатежнойКартой.ДокументОснование = &ДокОснование
	               |	И ОплатаОтПокупателяПлатежнойКартой.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	РасходныйКассовыйОрдер.Ссылка
	               |ИЗ
	               |	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	               |ГДЕ
	               |	РасходныйКассовыйОрдер.ДокументОснование = &ДокОснование
	               |	И РасходныйКассовыйОрдер.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдер.Ссылка
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	               |ГДЕ
	               |	ПриходныйКассовыйОрдер.ДокументОснование = &ДокОснование
	               |	И ПриходныйКассовыйОрдер.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ссылка
	               |АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("ДокОснование", стр.Документ);
	Выгрузка = Запрос.Выполнить().Выгрузить();
	СписокДенежныхДокументов = Новый СписокЗначений;
	Для Каждого СтрДенежныеДокументы Из Выгрузка Цикл
		СписокДенежныхДокументов.Добавить(СтрДенежныеДокументы.ссылка);
	КонецЦикла;

	ДокументВозврат = стр.Документ;
	Если ЗначениеЗаполнено(ДокументВозврат.НомерЧекаККМ) Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Чек возврата уже пробит на кассу");
		Возврат;
	КонецЕсли;

	// 1. Проверки ККТ и смены — до любых операций с деньгами
	ФУ = Неопределено;
	Если Не РаботаСТорговымОборудованием.ПолучитьПроверитьПараметрыДляПробитияЧека(ФУ, Истина, ДокументВозврат.Склад.Организация, Истина) Тогда
		Возврат;
	КонецЕсли;

	ОбъектДрайвера = Неопределено;
	ОбработкаОбслуживания = Неопределено;
	ПолучитьСерверТО().ПолучитьОбъектДрайвера(ФУ, ОбработкаОбслуживания, ОбъектДрайвера);
	Если ОбработкаОбслуживания = Неопределено Тогда
		ОбщегоНазначения.СообщитьИнформациюПользователю("Ошибка получения обработки обслуживания");
		Возврат;
	КонецЕсли;

	ОбработкаОбслуживания.ПолучитьПараметрыККТ(ОбъектДрайвера);
	ВерсияФормата = МенеджерОборудованияКлиентСервер.ВерсияФФД(ОбъектДрайвера.ВыходныеПараметры);
	Если ВерсияФормата <= "1.0" Тогда
		ОбщегоНазначения.СообщитьИнформациюПользователю("При использовании ФФД 1.0 фискализация чека из товарных документов не поддерживается");
		Возврат;
	КонецЕсли;

	ОписаниеПКС = КассовыеСменыВызовСервера.ОписаниеПоследнейКассовойСмены(ФУ);
	Если ОписаниеПКС = Неопределено ИЛИ ОписаниеПКС.Статус = Перечисления.СтатусыКассовойСмены.Закрыта Тогда
		ОбщегоНазначения.СообщитьОбОшибке("Кассовая смена не открыта");
		Возврат;
	КонецЕсли;

	// 2. Безналичный возврат: сначала терминал, чек — только после подтверждения
	ОплатаКартой = ТипЗнч(стр.ДенежныйДокумент) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой");
	ЧерезТерминал = ОплатаКартой
		И стр.ВидОперации = Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ВозвратДенежныхСредствПокупателю
		И НуженВозвратЧерезТерминал(стр.ДенежныйДокумент, Магазин);

	Если ЧерезТерминал Тогда
		Комментарий = стр.ДенежныйДокумент.Комментарий;
		ТерминалУжеВернул = Найти(Комментарий, ОтметкаТерминалОК()) > 0;

		Если Не ТерминалУжеВернул И Найти(Комментарий, ОтметкаТерминалОшибка()) > 0 Тогда
			Ответ = Вопрос("Прошлая попытка возврата по карте на сумму " + Формат(стр.СуммаЧека, "ЧДЦ=2") + " руб. закончилась ошибкой.
				|
				|Терминал напечатал слип об УСПЕШНОМ возврате по этому документу?
				|  «Да» — деньги уже вернулись, будет напечатан только чек;
				|  «Нет» — повторить возврат на терминале.", РежимДиалогаВопрос.ДаНетОтмена);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				ТерминалУжеВернул = Истина;
				УстановитьОтметкуТерминала(стр.ДенежныйДокумент, ОтметкаТерминалОК(), Магазин);
			ИначеЕсли Ответ <> КодВозвратаДиалога.Нет Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;

		Если Не ТерминалУжеВернул Тогда
			Если ВыполнитьВозвратНаТерминале(стр.СуммаЧека, Магазин) Тогда
				УстановитьОтметкуТерминала(стр.ДенежныйДокумент, ОтметкаТерминалОК(), Магазин);
			Иначе
				УстановитьОтметкуТерминала(стр.ДенежныйДокумент, ОтметкаТерминалОшибка());
				Для Каждого ДенежныйДокСсылка Из СписокДенежныхДокументов Цикл
					Попытка
						ДенежныйДокументОбъект = ДенежныйДокСсылка.Значение.ПолучитьОбъект();
						Если ДенежныйДокументОбъект.Проведен Тогда
							ДенежныйДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
						КонецЕсли;
					Исключение
						ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки());
					КонецПопытки;
				КонецЦикла;
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// 3. Фискальный чек возврата
	ПараметрыЧека = МенеджерОборудованияКлиентСервер.ПараметрыОперацииФискализацииЧека();
	ПараметрыЧека.Вставить("ОписаниеПКС", ОписаниеПКС);

	ДокументВозвратОбъект = ДокументВозврат.ПолучитьОбъект();
	Ответ = "";
	ВозвратФискализирован = ДокументВозвратОбъект.ФискализироватьЧек(ФУ, ПараметрыЧека, Ответ, Ложь);
	Если Не ВозвратФискализирован Тогда
		ОбщегоНазначения.СообщитьОбОшибке(ОбъектДрайвера.ОписаниеОшибки);
		Если ЧерезТерминал Тогда
			Предупреждение("Деньги на карту покупателю УЖЕ ВОЗВРАЩЕНЫ, но чек возврата не пробит.
				|Устраните неисправность кассы и нажмите «Выплата» ещё раз — будет напечатан только чек,
				|повторного возврата на терминале не будет.");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ДокументВозвратОбъект.НомерЧекаККМ = ОбъектДрайвера.ВыходныеПараметры[1];
	ДокументВозвратОбъект.Оплачено = Истина;
	ДокументВозвратОбъект.Дата = ТекущаяДата();

	// 4. Проведение документов. Если деньги уже ушли через терминал, проведение денежных документов не отменяем.
	ПровестиВозвратИДенежныеДокументы(ДокументВозвратОбъект, СписокДенежныхДокументов, Не ЧерезТерминал);

КонецПроцедуры
