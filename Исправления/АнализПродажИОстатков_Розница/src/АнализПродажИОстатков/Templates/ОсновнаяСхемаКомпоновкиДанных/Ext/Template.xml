		<query>ВЫБРАТЬ
	Ц.Номенклатура КАК Номенклатура,
	Ц.ХарактеристикаНоменклатуры КАК Характеристика,
	Ц.Цена КАК Цена,
	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Ц.Цена КАК ЧИСЛО(15, 0)) - ВЫРАЗИТЬ((ВЫРАЗИТЬ(Ц.Цена КАК ЧИСЛО(15, 0)) - 4.5) / 10 КАК ЧИСЛО(15, 0)) * 10 КАК ЧИСЛО(2, 0)) КАК Окончание
ПОМЕСТИТЬ ВТЦены
ИЗ
	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&amp;КонецРасчета, ТипЦен.Наименование = &amp;ТипЦенНаименование) КАК Ц
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	О.Склад.Магазин КАК Магазин,
	СУММА(О.КоличествоОстаток) КАК Количество,
	СУММА(О.КоличествоОстаток * ЕСТЬNULL(Ц.Цена, ЕСТЬNULL(Ц0.Цена, 0))) КАК Сумма,
	СУММА(ВЫБОР КОГДА ЕСТЬNULL(Ц.Окончание, Ц0.Окончание) = 5 ТОГДА О.КоличествоОстаток ИНАЧЕ 0 КОНЕЦ) КАК Количество5,
	СУММА(ВЫБОР КОГДА ЕСТЬNULL(Ц.Окончание, Ц0.Окончание) = 5 ТОГДА О.КоличествоОстаток * ЕСТЬNULL(Ц.Цена, ЕСТЬNULL(Ц0.Цена, 0)) ИНАЧЕ 0 КОНЕЦ) КАК Сумма5,
	СУММА(ВЫБОР КОГДА ЕСТЬNULL(Ц.Окончание, Ц0.Окончание) = 0 ТОГДА О.КоличествоОстаток ИНАЧЕ 0 КОНЕЦ) КАК Количество0,
	СУММА(ВЫБОР КОГДА ЕСТЬNULL(Ц.Окончание, Ц0.Окончание) = 0 ТОГДА О.КоличествоОстаток * ЕСТЬNULL(Ц.Цена, ЕСТЬNULL(Ц0.Цена, 0)) ИНАЧЕ 0 КОНЕЦ) КАК Сумма0
ПОМЕСТИТЬ ВТОстатки
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(&amp;КонецРасчета, {(Номенклатура).* КАК Номенклатура}) КАК О
		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК Ц
		ПО О.Номенклатура = Ц.Номенклатура
			И О.ХарактеристикаНоменклатуры = Ц.Характеристика
		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК Ц0
		ПО О.Номенклатура = Ц0.Номенклатура
			И Ц0.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
СГРУППИРОВАТЬ ПО
	О.Склад.Магазин
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Т.Склад.Магазин КАК Магазин,
	ВЫБОР
		КОГДА &amp;СпособПродаж = "По фактической стоимости"
			ТОГДА Т.Стоимость
		ИНАЧЕ Т.Количество * ЕСТЬNULL(Ц.Цена, ЕСТЬNULL(Ц0.Цена, 0))
	КОНЕЦ КАК Сумма,
	ЕСТЬNULL(Ц.Окончание, Ц0.Окончание) КАК Окончание
ПОМЕСТИТЬ ВТПродажиСтроки
ИЗ
	РегистрНакопления.Продажи КАК Т
		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК Ц
		ПО Т.Номенклатура = Ц.Номенклатура
			И Т.ХарактеристикаНоменклатуры = Ц.Характеристика
		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК Ц0
		ПО Т.Номенклатура = Ц0.Номенклатура
			И Ц0.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
ГДЕ
	Т.Период МЕЖДУ &amp;НачалоРасчета И &amp;КонецРасчета
	{ГДЕ
		Т.Номенклатура.* КАК Номенклатура}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	П.Магазин КАК Магазин,
	СУММА(П.Сумма) КАК Сумма,
	СУММА(ВЫБОР КОГДА П.Окончание = 5 ТОГДА П.Сумма ИНАЧЕ 0 КОНЕЦ) КАК Сумма5,
	СУММА(ВЫБОР КОГДА П.Окончание = 0 ТОГДА П.Сумма ИНАЧЕ 0 КОНЕЦ) КАК Сумма0
ПОМЕСТИТЬ ВТПродажи
ИЗ
	ВТПродажиСтроки КАК П
СГРУППИРОВАТЬ ПО
	П.Магазин
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТЧ.Магазин КАК Магазин,
	ТЧ.Ссылка.ПериодС КАК ПериодС,
	СУММА(ТЧ.План) КАК План
ПОМЕСТИТЬ ВТПланыВсе
ИЗ
	Документ.ПланПродаж.ТЧМагазины КАК ТЧ
ГДЕ
	НЕ ТЧ.Ссылка.ПометкаУдаления
	И ТЧ.Ссылка.ПериодС &lt;= &amp;КонецРасчета
	И ТЧ.Ссылка.ПериодПо &gt;= &amp;НачалоРасчета
СГРУППИРОВАТЬ ПО
	ТЧ.Магазин,
	ТЧ.Ссылка.ПериодС
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Пл.Магазин КАК Магазин,
	Пл.План КАК План
ПОМЕСТИТЬ ВТПлан
ИЗ
	ВТПланыВсе КАК Пл
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ
			(ВЫБРАТЬ
				Пл2.Магазин КАК Магазин,
				МАКСИМУМ(Пл2.ПериодС) КАК ПериодС
			ИЗ
				ВТПланыВсе КАК Пл2
			СГРУППИРОВАТЬ ПО
				Пл2.Магазин) КАК М2
		ПО Пл.Магазин = М2.Магазин
			И Пл.ПериодС = М2.ПериодС
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Н.Магазин КАК Магазин
ПОМЕСТИТЬ ВТМагазины
ИЗ
	ВТОстатки КАК Н
ГДЕ
	Н.Магазин &lt;&gt; ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка)
	И НЕ Н.Магазин.ПометкаУдаления
	И Н.Магазин.Наименование &lt;&gt; "ОФИС"

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	Н.Магазин
ИЗ
	ВТПродажи КАК Н
ГДЕ
	Н.Магазин &lt;&gt; ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка)
	И НЕ Н.Магазин.ПометкаУдаления
	И Н.Магазин.Наименование &lt;&gt; "ОФИС"

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	Н.Магазин
ИЗ
	ВТПлан КАК Н
ГДЕ
	Н.Магазин &lt;&gt; ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка)
	И НЕ Н.Магазин.ПометкаУдаления
	И Н.Магазин.Наименование &lt;&gt; "ОФИС"
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Маг.Магазин КАК Магазин,
	ЕСТЬNULL(Пл.План, 0) КАК План,
	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК ПроцентВыполнения,
	ЕСТЬNULL(Ост.Количество, 0) КАК Количество,
	ЕСТЬNULL(Ост.Сумма, 0) КАК СуммаОстатков,
	ЕСТЬNULL(Пр.Сумма, 0) КАК СуммаПродаж,
	ЕСТЬNULL(Ост.Количество5, 0) КАК Количество5,
	ЕСТЬNULL(Ост.Сумма5, 0) КАК СуммаОстатков5,
	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК ПроцентКоличества5,
	ЕСТЬNULL(Пр.Сумма5, 0) КАК СуммаПродаж5,
	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК ПроцентПродаж5,
	ЕСТЬNULL(Ост.Количество0, 0) КАК Количество0,
	ЕСТЬNULL(Ост.Сумма0, 0) КАК СуммаОстатков0,
	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК ПроцентКоличества0,
	ЕСТЬNULL(Пр.Сумма0, 0) КАК СуммаПродаж0,
	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК ПроцентПродаж0
ИЗ
	ВТМагазины КАК Маг
		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК Ост
		ПО Маг.Магазин = Ост.Магазин
		ЛЕВОЕ СОЕДИНЕНИЕ ВТПродажи КАК Пр
		ПО Маг.Магазин = Пр.Магазин
		ЛЕВОЕ СОЕДИНЕНИЕ ВТПлан КАК Пл
		ПО Маг.Магазин = Пл.Магазин</query>
	</dataSet>
